---
import FormulaToolPage from 'theme/templates/FormulaToolPage.astro';
import { RIGHT_TRIANGLE_FORMULAS } from 'src/data/rightTriangleFormulas';
import {
  getLocaleFromParams,
  getLocaleStaticPaths
} from 'theme/i18n/locales';

export function getStaticPaths() {
  return getLocaleStaticPaths().flatMap((item) =>
    RIGHT_TRIANGLE_FORMULAS.map((formula) => ({
      params: { ...item.params, slug: formula.slug }
    }))
  );
}

const { locale: rawLocale, slug = '' } = Astro.params;
const locale = getLocaleFromParams(rawLocale);
---
<FormulaToolPage locale={locale} slug={slug} />
