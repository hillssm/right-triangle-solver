---
import {
  FOCUSED_SIDE_CALCULATOR_PAGE_SLUGS,
  getFocusedSideCalculatorPage
} from 'src/data/focusedSideCalculatorPages';
import { GROUPED_PAGE_SLUGS } from 'src/data/rightTriangleGroupedPages';
import FocusedSideCalculatorPage from 'theme/templates/FocusedSideCalculatorPage.astro';
import GroupedCalculatorPage from 'theme/templates/GroupedCalculatorPage.astro';
import {
  getLocaleFromParams,
  getLocaleStaticPaths
} from 'theme/i18n/locales';

export function getStaticPaths() {
  return getLocaleStaticPaths().flatMap((item) =>
    [...GROUPED_PAGE_SLUGS, ...FOCUSED_SIDE_CALCULATOR_PAGE_SLUGS].map((slug) => ({
      params: { ...item.params, slug }
    }))
  );
}

const { locale: rawLocale, slug = '' } = Astro.params;
const locale = getLocaleFromParams(rawLocale);
const focusedPage = getFocusedSideCalculatorPage(slug, locale);
---
{
  focusedPage ? (
    <FocusedSideCalculatorPage page={focusedPage} locale={locale} />
  ) : (
    <GroupedCalculatorPage locale={locale} slug={slug} />
  )
}
