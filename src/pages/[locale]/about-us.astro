---
import { getLocaleStaticPaths, getLocaleFromParams, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale: rawLocale } = Astro.params;
const locale = getLocaleFromParams(rawLocale);
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, any>;
const about = content.about ?? {};
---

<BaseLayout
  locale={locale}
  title={pick(about, 'title', 'About Us')}
  description={pick(about, 'description', 'About this project')}
  canonicalPath="/about-us/"
  schemaPage="about"
>
  <header class="mb-10 text-center">
    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10">
      <span class="material-symbols-outlined text-3xl text-primary">groups</span>
    </div>
    <p class="font-label text-xs uppercase tracking-widest text-outline">{pick(about, 'subHeading', 'Who we are')}</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">{pick(about, 'heading', 'About Us')}</h1>
  </header>

  <article class="section-shell prose-shell" style="animation: fade-in-up 0.5s cubic-bezier(0.22,1,0.36,1) both;">

    <div class="mt-8 space-y-8">
      <div class="rounded-xl border border-outline-variant/15 bg-surface-container-lowest/50 p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="material-symbols-outlined text-lg text-primary">auto_awesome</span>
          <h2 class="text-xl font-headline text-on-surface">{pick(about, 'missionTitle', 'Our Mission')}</h2>
        </div>
        <p class="leading-relaxed text-on-surface-variant">{pick(about, 'missionBody', 'We built Right Triangle Solver to simplify geometry for students, teachers, and professionals.')}</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-3 anim-stagger">
        <div class="surface-card flex flex-col items-center text-center gap-3 py-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
            <span class="material-symbols-outlined text-xl text-primary">precision_manufacturing</span>
          </div>
          <h3 class="font-semibold text-on-surface">{pick(about, 'precisionTitle', 'Precision')}</h3>
          <p class="text-xs leading-relaxed text-on-surface-variant">{pick(about, 'precisionDesc', 'Accurate to 4+ decimal places.')}</p>
        </div>
        <div class="surface-card flex flex-col items-center text-center gap-3 py-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
            <span class="material-symbols-outlined text-xl text-primary">speed</span>
          </div>
          <h3 class="font-semibold text-on-surface">{pick(about, 'instantTitle', 'Instant')}</h3>
          <p class="text-xs leading-relaxed text-on-surface-variant">{pick(about, 'instantDesc', 'Real-time calculation.')}</p>
        </div>
        <div class="surface-card flex flex-col items-center text-center gap-3 py-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
            <span class="material-symbols-outlined text-xl text-primary">school</span>
          </div>
          <h3 class="font-semibold text-on-surface">{pick(about, 'educationalTitle', 'Educational')}</h3>
          <p class="text-xs leading-relaxed text-on-surface-variant">{pick(about, 'educationalDesc', 'Step-by-step guides.')}</p>
        </div>
      </div>

      <div class="rounded-xl border border-outline-variant/15 bg-surface-container-lowest/50 p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="material-symbols-outlined text-lg text-primary">handshake</span>
          <h2 class="text-xl font-headline text-on-surface">{pick(about, 'promiseTitle', 'Our Promise')}</h2>
        </div>
        <p class="leading-relaxed text-on-surface-variant">{pick(about, 'promiseBody', 'We respect your privacy and never collect personal data.')}</p>
      </div>
    </div>
  </article>
</BaseLayout>
