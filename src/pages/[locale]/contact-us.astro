---
import ContactPage from 'theme/templates/ContactPage.astro';
import { getLocaleFromParams, getLocaleStaticPaths } from 'theme/i18n/locales';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params.locale);
---

<ContactPage locale={locale} />
