---
import Faq from 'theme/components/Faq.astro';
import {
  getLocaleStaticPaths, 
  getLocaleFromParams,
  localizePath, 
  type Locale 
} from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params.locale);
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, any>;
const faqHub = content.faqHub ?? {};

const groupedFaqs = bundle.faq.reduce((acc, item) => {
  const cat = item.category || 'Detailed FAQs';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {} as Record<string, typeof bundle.faq>);

const pageTitle = `${pick(faqHub, 'title', 'Frequently Asked Questions')} | Right Triangle Solver`;
const pageDescription = pick(faqHub, 'description', 'Find answers to all your questions about the tools, formulas, units, and solutions.');
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/faqs/"
  mainClass="mx-auto w-full max-w-[900px] px-4 py-16 sm:px-6 lg:px-8"
>
  <header class="relative z-10 flex flex-col items-center justify-center pb-12 text-center text-on-surface">
    <div class="pointer-events-none absolute -top-12 -z-10 h-72 w-full bg-gradient-to-b from-primary/10 to-transparent opacity-30"></div>
    <h1 class="font-headline text-4xl font-bold tracking-tight drop-shadow-sm sm:text-5xl lg:text-6xl text-gradient-primary">
      {pick(faqHub, 'heading', 'Frequently Asked Questions')}
    </h1>
    <p class="mt-4 max-w-2xl text-base text-on-surface-variant sm:text-lg">
      {pick(faqHub, 'intro', 'Everything you need to know about our solvers, unit systems, and geometric calculations.')}
    </p>
  </header>

  <nav class="sticky top-20 z-20 mb-12 flex flex-wrap justify-center gap-2 rounded-2xl border border-outline-variant/20 bg-surface-container-lowest/80 p-3 backdrop-blur-md shadow-sm">
    {Object.keys(groupedFaqs).map((category, idx) => (
      <a 
        href={`#faq-cat-${idx}`}
        class="interactive-chip text-[10px] sm:text-xs"
      >
        {category}
      </a>
    ))}
  </nav>

  <div class="mt-8 space-y-12">
    {Object.entries(groupedFaqs).map(([category, items], idx) => (
      <div id={`faq-cat-${idx}`} class="scroll-mt-32">
        <div class="rounded-3xl border border-outline-variant/30 bg-surface-container shadow-[var(--shadow-luxury)] p-8">
          <Faq heading={category} items={items} />
        </div>
      </div>
    ))}
  </div>

  <div class="mt-20 grid gap-8 lg:grid-cols-2">
    <section class="rounded-3xl border border-secondary/20 bg-secondary/5 p-8 shadow-sm transition-all hover:bg-secondary/8">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-secondary/15 text-secondary mb-6">
        <span class="material-symbols-outlined text-2xl">menu_book</span>
      </div>
      <h2 class="text-2xl font-bold text-on-surface">{pick(faqHub, 'formulasTitle', 'Formula Hub')}</h2>
      <p class="mt-3 text-on-surface-variant leading-relaxed">
        {pick(faqHub, 'formulasIntro', 'Explore our curated directory of specific right-triangle calculators.')}
      </p>
      <div class="mt-6">
        <a href={localizePath(locale, '/formulas/')} class="btn-primary inline-flex items-center gap-2">
          {pick(faqHub, 'formulasCta', 'Browse Formula Directory')}
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>
    </section>

    <section class="rounded-3xl border border-primary/20 bg-primary/5 p-8 shadow-sm transition-all hover:bg-primary/8">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15 text-primary mb-6">
        <span class="material-symbols-outlined text-2xl">calculate</span>
      </div>
      <h2 class="text-2xl font-bold text-on-surface">{pick(faqHub, 'solveTitle', 'Start Solving Now')}</h2>
      <p class="mt-3 text-on-surface-variant leading-relaxed">
        {pick(faqHub, 'solveIntro', 'Our multi-variable solver handles any valid right-triangle combination instantly.')}
      </p>
      <div class="mt-6">
        <a href={localizePath(locale, '/')} class="btn-secondary inline-flex items-center gap-2">
          {pick(faqHub, 'solveCta', 'Back to Calculator')}
          <span class="material-symbols-outlined text-sm">home</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
