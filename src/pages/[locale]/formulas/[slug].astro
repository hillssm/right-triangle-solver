---
import { RIGHT_TRIANGLE_FORMULAS, getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  localizePath
} from 'theme/i18n/locales';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths().flatMap((item) =>
    RIGHT_TRIANGLE_FORMULAS.map((formula) => ({
      params: { ...item.params, slug: formula.slug }
    }))
  );
}

const locale = getLocaleFromParams(Astro.params.locale);
const slug = Astro.params.slug ?? '';
const formula = getFormulaBySlug(slug);

if (!formula) {
  throw new Error(`Unknown formula slug: ${slug}`);
}

const formulasRoot = localizePath(locale, '/formulas/');
const formulaPath = `${formulasRoot}${formula.slug}/`;
---

<BaseLayout
  locale={locale}
  title={`${formula.title} | Right Triangle Formula`}
  description={formula.description}
  canonicalPath={formulaPath}
>
  <nav class="mb-6">
    <a class="btn-secondary" href={formulasRoot}>Back To Formula Directory</a>
  </nav>

  <article class="section-shell">
    <p class="font-label text-xs uppercase tracking-widest text-primary">{formula.category}</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{formula.title}</h1>
    <p class="mt-4 text-on-surface-variant">{formula.description}</p>

    <div class="mt-6 rounded-lg border border-outline-variant/35 bg-surface-container-lowest p-4">
      <p class="font-label text-xs uppercase tracking-widest text-slate-400">Main Formula</p>
      <p class="mt-2 font-mono text-lg text-tertiary">{formula.expression}</p>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <section class="surface-card">
        <h2 class="text-xl font-semibold">Variables</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-on-surface-variant">
          {formula.variables.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>

      <section class="surface-card">
        <h2 class="text-xl font-semibold">Usage Notes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-on-surface-variant">
          {formula.notes.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    </div>
  </article>

  <section
    class="mt-8 section-shell"
    data-formula-calculator
    data-kind={formula.calculator.kind}
    data-output-label={formula.calculator.outputLabel}
    data-output-unit={formula.calculator.outputUnit ?? ''}
  >
    <h2 class="text-2xl font-semibold">Quick Calculator</h2>
    <p class="mt-2 text-sm text-on-surface-variant">
      Enter the required values below and compute using this formula.
    </p>

    <form class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-calc-form>
      {formula.calculator.fields.map((field) => (
        <label class="grid gap-2 text-sm font-medium">
          <span>{field.label}</span>
          <div class="relative">
            <input
              class="input-shell pr-16"
              type="number"
              step="any"
              min={field.min ?? 0}
              name={field.key}
              required
            />
            {field.unit && (
              <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs text-on-surface-variant">
                {field.unit}
              </span>
            )}
          </div>
        </label>
      ))}

      <div class="sm:col-span-2 lg:col-span-3 flex flex-wrap gap-3">
        <button type="submit" class="btn-primary">Calculate</button>
        <button type="reset" class="btn-secondary">Reset</button>
      </div>
    </form>

    <p class="mt-4 text-sm text-on-surface-variant" data-calc-status role="status" aria-live="polite">
      Fill values and click calculate.
    </p>

    <div class="mt-4 hidden surface-card border-primary/30 bg-surface-container-high" data-calc-result-wrap>
      <p class="font-label text-xs uppercase tracking-widest text-primary" data-calc-output-label>
        Result
      </p>
      <p class="mt-2 font-mono text-2xl text-tertiary" data-calc-output-value>-</p>
      <p class="mt-2 text-xs text-on-surface-variant" data-calc-output-detail></p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const section = document.querySelector('[data-formula-calculator]');
      if (!section) return;

      const form = section.querySelector('[data-calc-form]');
      const statusEl = section.querySelector('[data-calc-status]');
      const resultWrap = section.querySelector('[data-calc-result-wrap]');
      const labelEl = section.querySelector('[data-calc-output-label]');
      const valueEl = section.querySelector('[data-calc-output-value]');
      const detailEl = section.querySelector('[data-calc-output-detail]');
      const kind = section.getAttribute('data-kind') ?? '';
      const outputLabel = section.getAttribute('data-output-label') ?? 'Result';
      const outputUnit = section.getAttribute('data-output-unit') ?? '';

      if (!form || !statusEl || !resultWrap || !labelEl || !valueEl || !detailEl) return;

      const toNumber = (value) => Number.parseFloat(String(value));
      const deg = (rad) => (rad * 180) / Math.PI;
      const format = (n, digits = 6) => Number(n).toFixed(digits).replace(/\.?0+$/, '');

      const parseInputs = () => {
        const data = new FormData(form);
        const values = {};
        for (const [key, val] of data.entries()) {
          const num = toNumber(val);
          if (!Number.isFinite(num)) {
            throw new Error(`Invalid value for ${key}.`);
          }
          values[key] = num;
        }
        return values;
      };

      const requirePositive = (...nums) => {
        if (nums.some((n) => !(n > 0))) {
          throw new Error('All values must be positive.');
        }
      };

      const solve = (values) => {
        switch (kind) {
          case 'pythagorean_c': {
            const { a, b } = values;
            requirePositive(a, b);
            return { result: Math.hypot(a, b), detail: 'c = sqrt(a^2 + b^2)' };
          }
          case 'leg_from_ac': {
            const { a, c } = values;
            requirePositive(a, c);
            if (c <= a) throw new Error('Hypotenuse c must be greater than leg a.');
            return { result: Math.sqrt(c * c - a * a), detail: 'b = sqrt(c^2 - a^2)' };
          }
          case 'leg_from_bc': {
            const { b, c } = values;
            requirePositive(b, c);
            if (c <= b) throw new Error('Hypotenuse c must be greater than leg b.');
            return { result: Math.sqrt(c * c - b * b), detail: 'a = sqrt(c^2 - b^2)' };
          }
          case 'area_legs': {
            const { a, b } = values;
            requirePositive(a, b);
            return { result: (a * b) / 2, detail: 'Area = (a * b) / 2' };
          }
          case 'perimeter': {
            const { a, b, c } = values;
            requirePositive(a, b, c);
            return { result: a + b + c, detail: 'P = a + b + c' };
          }
          case 'semiperimeter': {
            const { a, b, c } = values;
            requirePositive(a, b, c);
            return { result: (a + b + c) / 2, detail: 's = (a + b + c) / 2' };
          }
          case 'sine': {
            const { a, c } = values;
            requirePositive(a, c);
            if (a >= c) throw new Error('For a right triangle, a must be less than c.');
            return { result: a / c, detail: 'sin(A) = a / c' };
          }
          case 'cosine': {
            const { b, c } = values;
            requirePositive(b, c);
            if (b >= c) throw new Error('For a right triangle, b must be less than c.');
            return { result: b / c, detail: 'cos(A) = b / c' };
          }
          case 'tangent': {
            const { a, b } = values;
            requirePositive(a, b);
            return { result: a / b, detail: 'tan(A) = a / b' };
          }
          case 'angle_asin': {
            const { a, c } = values;
            requirePositive(a, c);
            if (a >= c) throw new Error('For a right triangle, a must be less than c.');
            return { result: deg(Math.asin(a / c)), detail: 'A = asin(a / c)' };
          }
          case 'angle_acos': {
            const { b, c } = values;
            requirePositive(b, c);
            if (b >= c) throw new Error('For a right triangle, b must be less than c.');
            return { result: deg(Math.acos(b / c)), detail: 'A = acos(b / c)' };
          }
          case 'angle_atan': {
            const { a, b } = values;
            requirePositive(a, b);
            return { result: deg(Math.atan(a / b)), detail: 'A = atan(a / b)' };
          }
          case 'altitude': {
            let { a, b, c } = values;
            requirePositive(a, b, c);
            if (c <= a || c <= b) {
              c = Math.hypot(a, b);
            }
            return { result: (a * b) / c, detail: 'h = (a * b) / c' };
          }
          case 'projection_p': {
            const { a, c } = values;
            requirePositive(a, c);
            return { result: (a * a) / c, detail: 'p = a^2 / c' };
          }
          case 'projection_q': {
            const { b, c } = values;
            requirePositive(b, c);
            return { result: (b * b) / c, detail: 'q = b^2 / c' };
          }
          case 'inradius': {
            const { a, b, c } = values;
            requirePositive(a, b, c);
            return { result: (a + b - c) / 2, detail: 'r = (a + b - c) / 2' };
          }
          case 'circumradius': {
            const { c } = values;
            requirePositive(c);
            return { result: c / 2, detail: 'R = c / 2' };
          }
          default:
            throw new Error('Calculator type is not configured.');
        }
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        try {
          const values = parseInputs();
          const output = solve(values);
          labelEl.textContent = outputLabel;
          valueEl.textContent = `${format(output.result)}${outputUnit ? ` ${outputUnit}` : ''}`;
          detailEl.textContent = output.detail;
          statusEl.textContent = 'Calculated successfully.';
          resultWrap.classList.remove('hidden');
        } catch (err) {
          statusEl.textContent = err instanceof Error ? err.message : 'Unable to calculate.';
          resultWrap.classList.add('hidden');
        }
      });

      form.addEventListener('reset', () => {
        setTimeout(() => {
          statusEl.textContent = 'Fill values and click calculate.';
          resultWrap.classList.add('hidden');
        }, 0);
      });
    })();
  </script>
</BaseLayout>
