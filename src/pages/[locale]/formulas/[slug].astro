---
import { RIGHT_TRIANGLE_FORMULAS, getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  localizePath
} from 'theme/i18n/locales';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import Faq from 'theme/components/Faq.astro';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { getTranslations } from 'theme/i18n/translations';
import katex from 'katex';
import 'katex/dist/katex.min.css';

export function getStaticPaths() {
  return getLocaleStaticPaths().flatMap((item) =>
    RIGHT_TRIANGLE_FORMULAS.map((formula) => ({
      params: { ...item.params, slug: formula.slug }
    }))
  );
}

const locale = getLocaleFromParams(Astro.params.locale);
const slug = Astro.params.slug ?? '';
const formula = getFormulaBySlug(slug);

if (!formula) {
  throw new Error(`Unknown formula slug: ${slug}`);
}

const bundle = getTranslations(locale);
// Pick a few general FAQs for the tool page
const toolFaqs = bundle.faq.slice(0, 5);

const formulasRoot = localizePath(locale, '/formulas/');
const formulaPath = `${formulasRoot}${formula.slug}/`;
---

<BaseLayout
  locale={locale}
  title={`${formula.title} | Right Triangle Formula`}
  description={formula.description}
  canonicalPath={formulaPath}
>
  <nav class="mb-6">
    <a class="btn-secondary" href={formulasRoot}>Back To Formula Directory</a>
  </nav>

  <header class="mb-8">
    <p class="font-label text-xs uppercase tracking-widest text-primary">{formula.category}</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{formula.title}</h1>
    <p class="mt-4 text-on-surface-variant max-w-3xl">{formula.description}</p>
  </header>

  {formula.calculator && <FormulaCalculator formula={formula} />}
  
  <article class="mt-8 section-shell">
    <div class="rounded-lg border border-outline-variant/35 bg-surface-container-lowest p-6 shadow-sm overflow-x-auto text-center">
      <p class="font-label text-xs uppercase tracking-widest text-outline text-left mb-4">Main Formula</p>
      <div 
        class="text-2xl text-tertiary math-textbook"
        set:html={katex.renderToString(formula.expression, { throwOnError: false, displayMode: true })}
      />
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <section class="surface-card">
        <h2 class="text-xl font-semibold">Variables</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-on-surface-variant">
          {(formula.variables || []).map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>

      <section class="surface-card">
        <h2 class="text-xl font-semibold">Usage Notes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-on-surface-variant">
          {(formula.notes || []).map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    </div>
  </article>

  <div class="mt-12">
    <Faq heading={`FAQ: ${formula.title}`} items={toolFaqs} />
  </div>

  <section class="mt-12 rounded-3xl border border-outline-variant/20 bg-surface-container-low p-6 sm:p-8">
    <div class="flex items-center gap-3 mb-6">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-secondary/12 text-secondary">
        <span class="material-symbols-outlined text-xl">explore</span>
      </div>
      <div>
        <h2 class="text-2xl font-semibold">Related Tools</h2>
        <p class="text-sm text-on-surface-variant">Explore other calculators in the {formula.category} category.</p>
      </div>
    </div>
    
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {RIGHT_TRIANGLE_FORMULAS
        .filter(f => f.category === formula.category && f.slug !== formula.slug)
        .slice(0, 6)
        .map(f => (
          <a 
            href={`${formulasRoot}${f.slug}/`}
            class="group relative overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest p-4 transition-all hover:border-primary/40 hover:shadow-md"
          >
            <h3 class="text-sm font-semibold text-on-surface group-hover:text-primary transition-colors">{f.title}</h3>
            <p class="mt-1 line-clamp-2 text-xs text-on-surface-variant">{f.description}</p>
            <div class="mt-3 flex items-center text-[10px] font-bold uppercase tracking-wider text-primary opacity-0 group-hover:opacity-100 transition-opacity">
              Open Tool <span class="material-symbols-outlined ml-1 text-xs">arrow_forward</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
