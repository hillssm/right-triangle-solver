---
import { RIGHT_TRIANGLE_FORMULAS, getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  localizePath
} from 'theme/i18n/locales';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths().flatMap((item) =>
    RIGHT_TRIANGLE_FORMULAS.map((formula) => ({
      params: { ...item.params, slug: formula.slug }
    }))
  );
}

const locale = getLocaleFromParams(Astro.params.locale);
const slug = Astro.params.slug ?? '';
const formula = getFormulaBySlug(slug);

if (!formula) {
  throw new Error(`Unknown formula slug: ${slug}`);
}

const formulasRoot = localizePath(locale, '/formulas/');
const formulaPath = `${formulasRoot}${formula.slug}/`;
---

<BaseLayout
  locale={locale}
  title={`${formula.title} | Right Triangle Formula`}
  description={formula.description}
  canonicalPath={formulaPath}
>
  <nav class="mb-6">
    <a class="btn-secondary" href={formulasRoot}>Back To Formula Directory</a>
  </nav>

  <header class="mb-8">
    <p class="font-label text-xs uppercase tracking-widest text-primary">{formula.category}</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{formula.title}</h1>
    <p class="mt-4 text-on-surface-variant max-w-3xl">{formula.description}</p>
  </header>

  <FormulaCalculator formula={formula} />
  
  <article class="mt-8 section-shell">
    <div class="rounded-lg border border-outline-variant/35 bg-surface-container-lowest p-4">
      <p class="font-label text-xs uppercase tracking-widest text-outline">Main Formula</p>
      <p class="mt-2 text-lg text-tertiary math-textbook">{formula.expression}</p>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <section class="surface-card">
        <h2 class="text-xl font-semibold">Variables</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-on-surface-variant">
          {formula.variables.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>

      <section class="surface-card">
        <h2 class="text-xl font-semibold">Usage Notes</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-on-surface-variant">
          {formula.notes.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
