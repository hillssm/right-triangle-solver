---
import CalculatorCatalog from 'theme/components/CalculatorCatalog.astro';
import ChartTableSection from 'theme/components/ChartTableSection.astro';
import Faq from 'theme/components/Faq.astro';
import HomeSchema from 'theme/components/HomeSchema.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import RightTriangleTool from 'theme/components/RightTriangleTool.astro';
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  localizePath
} from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params.locale);
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const home = (content.home as Record<string, string>) ?? {};
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = pick(home, 'title', `${siteTitle} | Geometry`);
const pageDescription = pick(
  home,
  'description',
  'Solve right triangles quickly with formulas and examples.'
);

const localizedPath = localizePath(locale, '/');
const localizedPracticePath = localizePath(locale, '/practice/');
const localizedFormulasPath = localizePath(locale, '/formulas/');
const chartRows = [
  { label: '3-4-5 triangle', value: '5.000', ratio: 5 },
  { label: '5-12-13 triangle', value: '13.000', ratio: 13 },
  { label: '8-15-17 triangle', value: '17.000', ratio: 17 },
  { label: '9-12-15 triangle', value: '15.000', ratio: 15 }
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={localizedPath}
  mainClass="w-full px-4 py-8 sm:px-6 lg:px-8"
>
  <HomeSchema
    slot="head"
    locale={locale}
    title={pageTitle}
    description={pageDescription}
    path={localizedPath}
    faqs={bundle.faq}
  />

  <section class="section-shell w-full overflow-hidden">
    <div class="pointer-events-none absolute -left-10 -top-20 h-64 w-64 rounded-full bg-primary/14 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 right-8 h-52 w-52 rounded-full bg-tertiary/14 blur-3xl"></div>
    <div dir="ltr" class="relative grid grid-cols-1 gap-6 md:grid-cols-[minmax(0,1.65fr)_minmax(18rem,1fr)] md:items-start lg:gap-8">
      <div class="w-full min-w-0">
        <RightTriangleTool
          heading={pick(home, 'toolHeading', 'Triangle Tool')}
          description={pick(home, 'toolDescription', 'Enter any two legs to calculate hypotenuse, area, and perimeter instantly.')}
        />
      </div>

      <div class="grid w-full gap-6 md:min-w-0">
        <div class="grid gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="interactive-chip is-active">Right Triangle Studio</span>
            <span class="interactive-chip">Live Geometry</span>
            <span class="interactive-chip">Exam Ready</span>
          </div>
          <h1 class="mt-4 text-4xl sm:text-5xl">{pick(home, 'heading', siteTitle)}</h1>
          <p class="mt-4 max-w-2xl text-on-surface-variant">
            {pick(home, 'intro', 'Calculate missing values fast, review formulas, and validate your geometry work with confidence.')}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="btn-primary" href={localizedFormulasPath}>Explore Formula Directory</a>
            <a class="btn-secondary" href={localizedPracticePath}>Open Practice Workspace</a>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-3 md:grid-cols-1 xl:grid-cols-3">
          <div class="lux-stat">
            <p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">Solve Time</p>
            <p class="mt-2 text-2xl font-bold text-on-surface">0.2s</p>
          </div>
          <div class="lux-stat">
            <p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">Output Metrics</p>
            <p class="mt-2 text-2xl font-bold text-on-surface">7+</p>
          </div>
          <div class="lux-stat">
            <p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">Visual Checks</p>
            <p class="mt-2 text-2xl font-bold text-on-surface">Real-time</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mt-8">
    <HowItWorks heading={pick(home, 'howHeading', 'How Right Triangle Solver works')} />
  </div>

  <div class="mt-8">
    <ChartTableSection heading={pick(home, 'chartHeading', 'Reference Values')} rows={chartRows} />
  </div>

  <div class="mt-8">
    <CalculatorCatalog
      locale={locale}
      heading={pick(home, 'catalogHeading', 'All Tool Calculators')}
      description={pick(
        home,
        'catalogDescription',
        'Browse every formula tool. Each page has a dedicated calculator built for that title intent.'
      )}
    />
  </div>

  <div class="mt-8">
    <Faq heading={pick(home, 'faqHeading', 'Frequently Asked Questions')} items={bundle.faq} />
  </div>
</BaseLayout>
