---
import HomePage from 'theme/templates/HomePage.astro';
import {
  getLocaleFromParams,
  getLocaleStaticPaths
} from 'theme/i18n/locales';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale: rawLocale } = Astro.params;
const locale = getLocaleFromParams(rawLocale);
---
<HomePage locale={locale} />
