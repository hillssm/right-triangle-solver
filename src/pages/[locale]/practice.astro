---
import MusePractice from 'theme/components/MusePractice.astro';
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  localizePath
} from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params.locale);
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const practiceText = (content.practice as Record<string, string>) ?? {};
const siteTitle = pick(content, 'title', 'Right Triangle Solver');
const pageTitle = `${pick(practiceText, 'title', 'Practice Mode')} | ${siteTitle}`;
const pageDescription = pick(practiceText, 'description', 'Train with right triangle challenges in an interactive practice workspace.');
const localizedCalculatorPath = localizePath(locale, '/');
const localizedLibraryPath = localizePath(locale, '/library/');
const localizedPracticePath = localizePath(locale, '/practice/');
---


<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={localizedPracticePath}
  hideHeader={true}
  hideFooter={true}
  mainClass="w-full min-h-screen p-0"
>
  <MusePractice
    locale={locale}
    calculatorHref={localizedCalculatorPath}
    libraryHref={localizedLibraryPath}
    practiceHref={localizedPracticePath}
  />
</BaseLayout>

