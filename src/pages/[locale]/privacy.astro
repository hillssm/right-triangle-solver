---
import PrivacyPage from 'theme/templates/PrivacyPage.astro';
import { getLocaleFromParams, getLocaleStaticPaths } from 'theme/i18n/locales';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params.locale);
---

<PrivacyPage locale={locale} />
