---
import { getLocaleStaticPaths, getLocaleFromParams, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale: rawLocale } = Astro.params;
const locale = getLocaleFromParams(rawLocale);
const bundle = getTranslations('en');
const content = bundle.content as Record<string, any>;
const privacy = content.privacy ?? {};
---

<BaseLayout
  locale={locale}
  title={pick(privacy, 'title', 'Privacy')}
  description={pick(privacy, 'description', 'Privacy policy')}
  canonicalPath="/privacy/"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Compliance</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">{pick(privacy, 'heading', 'Privacy Policy')}</h1>
    <p class="mt-2 text-xs uppercase tracking-wide text-outline">{pick(privacy, 'updatedLabel', '')}</p>
  </header>

  <article class="section-shell prose-shell">
    <p class="text-on-surface-variant font-body">{pick(privacy, 'body', 'This is our privacy policy.')}</p>
  </article>
</BaseLayout>
