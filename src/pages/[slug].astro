---
import FormulaToolPage from 'theme/templates/FormulaToolPage.astro';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { RIGHT_TRIANGLE_FORMULAS } from 'src/data/rightTriangleFormulas';

export function getStaticPaths() {
  return RIGHT_TRIANGLE_FORMULAS.map((formula) => ({
    params: { slug: formula.slug }
  }));
}

const { slug } = Astro.params;
---
<FormulaToolPage locale={DEFAULT_LOCALE} slug={slug!!} />
