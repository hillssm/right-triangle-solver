---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogCard from 'theme/components/BlogCard.astro';
import Pagination from 'theme/components/Pagination.astro';
import { DEFAULT_LOCALE, localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';

export async function getStaticPaths() {
  const pageSize = 12;
  const allPosts = await getCollection('blog');
  const sortedPosts = allPosts.sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
  const totalPages = Math.max(Math.ceil(allPosts.length / pageSize), 1);

  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const currentPage = index + 2;
    const startIndex = (currentPage - 1) * pageSize;
    const posts = sortedPosts.slice(startIndex, startIndex + pageSize);
    return {
      params: { page: String(currentPage) },
      props: {
        posts,
        currentPage,
        totalPages,
        totalPosts: allPosts.length
      }
    };
  });
}

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;
const locale = DEFAULT_LOCALE;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, any>;
const common = bundle.common as Record<string, any>;
const blogText = content.blog ?? {};
const commonWords = common.common ?? {};

const pageTitle = `${pick(blogText, 'title', 'Blog')} - Page ${currentPage} | Right Triangle Solver`;
const pageDescription = pick(blogText, 'description', 'Read the latest posts');
const canonicalUrl = localizePath(locale, `/blog/${currentPage}/`);

const start = (currentPage - 1) * 12 + 1;
const end = start + posts.length - 1;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + start,
    url: toAbsoluteUrl(localizePath(locale, `/blog/${post.id}/`))
  }))
};
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalUrl}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>

  <section class="section-shell">
    <h1 class="text-3xl font-bold sm:text-4xl">{pick(blogText, 'title', 'Blog')}</h1>
    <p class="truncate mt-3 max-w-2xl text-on-surface-variant">{pick(blogText, 'description', 'Latest geometry insights.')}</p>
    <p class="mt-4 text-sm text-outline">
      {pick(commonWords, 'results', 'Results')}: {start}-{end} {pick(commonWords, 'of', 'of')} {totalPosts}
    </p>
  </section>

  <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {posts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        image={post.data.image}
        href={localizePath(locale, `/blog/${post.id}/`)}
        ctaLabel={pick(commonWords, 'readMore', 'Read article')}
      />
    ))}
  </div>

  <div class="mt-12">
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      basePath={localizePath(locale, '/blog/')}
      previousLabel={pick(commonWords, 'previous', 'Previous')}
      nextLabel={pick(commonWords, 'next', 'Next')}
    />
  </div>
</BaseLayout>
