---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const locale = DEFAULT_LOCALE;
const bundle = getTranslations(locale);
const common = bundle.common as Record<string, unknown>;
const commonWords = (common.common as Record<string, string>) ?? {};

const { post } = Astro.props as {
  post: CollectionEntry<'blog'>;
};

const { Content } = await render(post);

const canonicalPath = `/blog/${post.id}/`;
const canonicalUrl = toAbsoluteUrl(canonicalPath);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: [toAbsoluteUrl(post.data.image)],
  author: {
    '@type': 'Person',
    name: post.data.author
  },
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: canonicalUrl
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: toAbsoluteUrl('/')
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: toAbsoluteUrl('/blog/')
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonicalUrl
    }
  ]
};
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} | Right Triangle Solver`}
  description={post.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <article class="overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-low shadow-sm">
    <img src={post.data.image} alt={post.data.title} class="h-64 w-full object-cover" />
    <div class="p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-primary">{post.data.category}</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{post.data.title}</h1>
      <p class="mt-3 text-on-surface-variant">{post.data.description}</p>
      <p class="mt-4 text-xs text-outline">
        {post.data.author} | {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      <div class="prose-shell mt-8">
        <Content />
      </div>
    </div>
  </article>

  <a href="/blog/" class="btn-secondary mt-8 inline-flex">
    {pick(commonWords, 'backToBlog', 'Back to Blog')}
  </a>
</BaseLayout>
