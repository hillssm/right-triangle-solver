---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogCard from 'theme/components/BlogCard.astro';
import Pagination from 'theme/components/Pagination.astro';
import { DEFAULT_LOCALE, localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations('en');
const content = bundle.content as Record<string, unknown>;
const common = bundle.common as Record<string, unknown>;
const blogText = (content.blog as Record<string, string>) ?? {};
const commonWords = (common.common as Record<string, string>) ?? {};

const PAGE_SIZE = 12;

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const totalPosts = sortedPosts.length;
const totalPages = Math.max(Math.ceil(totalPosts / PAGE_SIZE), 1);
const currentPage = 1;
const posts = sortedPosts.slice(0, PAGE_SIZE);
const start = 1;
const end = posts.length;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: pick(blogText, 'title', 'Blog'),
  description: pick(blogText, 'description', 'Latest posts'),
  url: toAbsoluteUrl(localizePath(locale, '/blog/'))
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((post: CollectionEntry<'blog'>, index) => ({
    '@type': 'ListItem',
    position: index + start,
    url: toAbsoluteUrl(localizePath(locale, `/blog/${post.id}/`))
  }))
};
---

<BaseLayout
  locale={locale}
  title={`${pick(blogText, 'title', 'Blog')} | Right Triangle Solver`}
  description={pick(blogText, 'description', 'Read the latest posts')}
  canonicalPath={localizePath(locale, '/blog/')}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(blogSchema)}></script>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>

  <section class="section-shell">
    <h1 class="text-3xl font-bold sm:text-4xl">{pick(blogText, 'title', 'Blog')}</h1>
    <p class="mt-3 max-w-2xl text-on-surface-variant">{pick(blogText, 'description', 'Latest geometry insights.')}</p>
    <p class="mt-4 text-sm text-outline">
      {pick(commonWords, 'results', 'Results')}: {start}-{end} {pick(commonWords, 'of', 'of')} {totalPosts}
    </p>
  </section>

  <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {posts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        image={post.data.image}
        href={localizePath(locale, `/blog/${post.id}/`)}
        ctaLabel={pick(commonWords, 'readMore', 'Read article')}
      />
    ))}
  </div>

  {totalPages > 1 && (
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      basePath={localizePath(locale, '/blog/')}
      previousLabel={pick(commonWords, 'previous', 'Previous')}
      nextLabel={pick(commonWords, 'next', 'Next')}
    />
  )}
</BaseLayout>
