---
import ContactForm from 'theme/components/ContactForm.astro';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { site } from 'theme/utils/site';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations('en');
const content = bundle.content as Record<string, any>;
const common = bundle.common as Record<string, any>;
const contact = content.contact ?? {};
const commonWords = common.common ?? {};
const contactEmail = site.contactEmail || 'hello@righttrianglesolver.app';

const supportChannels = [
  {
    icon: 'mail',
    title: 'Email Support',
    value: contactEmail,
    href: `mailto:${contactEmail}`,
    description: 'Best for bug reports, account issues, or detailed questions.'
  },
  {
    icon: 'schedule',
    title: 'Typical Reply Time',
    value: 'Within 1 business day',
    href: null,
    description: 'We usually respond quickly on weekdays.'
  },
  {
    icon: 'support_agent',
    title: 'Best Message Format',
    value: 'Short + specific',
    href: null,
    description: 'Include what you tried, expected result, and what happened.'
  }
];

const beforeYouSend = [
  'Check our FAQs first for common calculator and formula questions.',
  'Do not include sensitive personal, financial, or confidential data.',
  'If reporting a bug, include the page URL and the exact values entered.'
];

const checklist = [
  'What you were trying to do',
  'Inputs you entered',
  'Expected outcome vs actual outcome',
  'Device/browser information (if relevant)'
];
---

<BaseLayout
  locale={locale}
  title={pick(contact, 'title', 'Contact Us')}
  description={pick(contact, 'description', 'Get in touch')}
  canonicalPath="/contact-us/"
  schemaPage="contact"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Support</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">{pick(contact, 'heading', 'Contact Us')}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-on-surface-variant">{pick(contact, 'helper', 'Send us your message.')}</p>
  </header>

  <section class="section-shell mb-8">
    <h2 class="text-xl font-headline text-on-surface">Fastest Ways to Reach Us</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3 anim-stagger">
      {supportChannels.map((channel) => (
        <article class="surface-card">
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
            <span class="material-symbols-outlined text-lg text-primary">{channel.icon}</span>
          </div>
          <h3 class="text-sm font-semibold text-on-surface">{channel.title}</h3>
          {channel.href ? (
            <a href={channel.href} class="mt-1 block text-sm text-primary hover:text-primary-fixed">
              {channel.value}
            </a>
          ) : (
            <p class="mt-1 text-sm text-on-surface">{channel.value}</p>
          )}
          <p class="mt-2 text-xs leading-relaxed text-on-surface-variant">{channel.description}</p>
        </article>
      ))}
    </div>
  </section>

  <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <section class="section-shell prose-shell">
      <h2>Before You Send</h2>
      <ul>
        {beforeYouSend.map((item) => <li>{item}</li>)}
      </ul>

      <h3>Include These Details for Faster Help</h3>
      <ul>
        {checklist.map((item) => <li>{item}</li>)}
      </ul>

      <div class="mt-6 rounded-lg border border-outline-variant/40 bg-surface-container-low p-4">
        <p class="text-xs uppercase tracking-widest text-outline">Helpful Links</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href="/faqs/" class="btn-secondary px-4 py-2 text-xs">Browse FAQs</a>
          <a href="/privacy/" class="btn-secondary px-4 py-2 text-xs">Privacy Policy</a>
          <a href="/terms/" class="btn-secondary px-4 py-2 text-xs">Terms of Use</a>
        </div>
      </div>
    </section>

    <ContactForm
      labels={{
        name: pick(commonWords, 'name', 'Name'),
        email: pick(commonWords, 'email', 'Email'),
        message: pick(commonWords, 'message', 'Message'),
        send: pick(commonWords, 'send', 'Send Message'),
        sending: pick(commonWords, 'sending', 'Sending...'),
        success: pick(commonWords, 'success', 'Message sent successfully.'),
        apiError: pick(commonWords, 'apiError', 'We could not send your message.'),
        networkError: pick(commonWords, 'networkError', 'Network error. Please retry.'),
        fallbackEmail: pick(commonWords, 'fallbackEmail', 'Or email us directly at')
      }}
    />
  </div>
</BaseLayout>
