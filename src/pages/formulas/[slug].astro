---
import { DEFAULT_LOCALE, localizePath } from 'theme/i18n/locales';
import { RIGHT_TRIANGLE_FORMULAS } from 'theme/data/formulas';

export function getStaticPaths() {
  return RIGHT_TRIANGLE_FORMULAS.map(f => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
return Astro.redirect(localizePath(DEFAULT_LOCALE, `/formulas/${slug}/`));
---
