---
import { RIGHT_TRIANGLE_FORMULAS } from 'src/data/rightTriangleFormulas';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';

const locale = DEFAULT_LOCALE;

const groupedFormulas = RIGHT_TRIANGLE_FORMULAS.reduce<
  Record<string, typeof RIGHT_TRIANGLE_FORMULAS>
>((acc, item) => {
  acc[item.category] = acc[item.category] ?? [];
  acc[item.category].push(item);
  return acc;
}, {});

const categoryOrder = [
  'Trigonometry',
  'Side Calculations',
  'Area & Geometry',
  'Advanced Relations',
  'Special Triangles'
];

// Provide anchor ids by slugifying categories
const categoryId = (cat: string) => cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout
  locale={locale}
  title="Right Triangle Formula Directory"
  description="Every key right-triangle formula with separate pages and quick calculators."
  canonicalPath="/formulas/"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Formula Hub</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-[#5b4000]">All Right Triangle Formulas</h1>
    <p class="mx-auto mt-4 max-w-3xl text-on-surface-variant">
      Every formula has its own page with definitions, usage notes, and a quick calculator.
    </p>
    
    <nav class="mt-6 flex flex-wrap justify-center gap-3">
      {categoryOrder.map(cat => (
        <a href={`#${categoryId(cat)}`} class="rounded-full bg-surface-container-high px-4 py-2 text-sm font-medium hover:bg-primary hover:text-white transition-colors border border-outline-variant/50">
          {cat}
        </a>
      ))}
    </nav>
  </header>

  {
    categoryOrder.map((category) => {
      const items = groupedFormulas[category] ?? [];
      if (items.length === 0) return null;

      return (
        <section id={categoryId(category)} class="mt-12 section-shell scroll-mt-24">
          <h2 class="text-2xl font-semibold border-b border-outline-variant/35 pb-2 mb-6">{category}</h2>
          <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {items.map((formula) => (
              <a
                href={`/formulas/${formula.slug}/`}
                class="surface-card block border-outline-variant/35 hover:border-primary/50 hover:bg-surface-container-high transition-transform hover:-translate-y-1 shadow-sm"
              >
                <div class="flex flex-col h-full">
                  <p class="font-label text-xs uppercase tracking-widest text-primary">Formula</p>
                  <h3 class="mt-2 text-lg font-semibold">{formula.title}</h3>
                  <p class="mt-3 text-sm text-on-surface-variant flex-grow">{formula.description}</p>
                  
                  <div 
                    class="mt-4 rounded-md bg-surface-container-lowest border border-outline-variant/20 px-4 py-3 text-center math-textbook overflow-x-auto text-lg"
                    set:html={katex.renderToString(formula.expression, { throwOnError: false, displayMode: true })}
                  />
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })
  }

  <div class="mt-20 grid gap-8 lg:grid-cols-2">
    <section class="rounded-3xl border border-primary/20 bg-primary/5 p-8 shadow-sm transition-all hover:bg-primary/8">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15 text-primary mb-6">
        <span class="material-symbols-outlined text-2xl">help_outline</span>
      </div>
      <h2 class="text-2xl font-bold text-on-surface">Geometric Knowledge Base</h2>
      <p class="mt-3 text-on-surface-variant leading-relaxed">
        Have questions about decimal precision, measurement units, or step-by-step logic? Our comprehensive FAQ hub covers all {RIGHT_TRIANGLE_FORMULAS.length} tools in detail.
      </p>
      <div class="mt-6">
        <a href="/faqs/" class="btn-primary inline-flex items-center gap-2">
          Browse Detailed FAQ
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>
    </section>

    <section class="rounded-3xl border border-tertiary/20 bg-tertiary/5 p-8 shadow-sm transition-all hover:bg-tertiary/8">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-tertiary/15 text-tertiary mb-6">
        <span class="material-symbols-outlined text-2xl">calculate</span>
      </div>
      <h2 class="text-2xl font-bold text-on-surface">Ready to Solve?</h2>
      <p class="mt-3 text-on-surface-variant leading-relaxed">
        Return to our high-precision right triangle calculator to instantly solve for hypotenuse, area, and angles using any two known variables.
      </p>
      <div class="mt-6">
        <a href="/" class="btn-secondary inline-flex items-center gap-2">
          Instant Tool Home
          <span class="material-symbols-outlined text-sm">home</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
