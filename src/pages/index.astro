---
import ChartTableSection from 'theme/components/ChartTableSection.astro';
import Faq from 'theme/components/Faq.astro';
import HomeSchema from 'theme/components/HomeSchema.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import RightTriangleTool from 'theme/components/RightTriangleTool.astro';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const home = (content.home as Record<string, string>) ?? {};
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = pick(home, 'title', `${siteTitle} | Geometry`);
const pageDescription = pick(
  home,
  'description',
  'Solve right triangles quickly with formulas and examples.'
);

const chartRows = [
  { label: '3-4-5 triangle', value: '5.000', ratio: 5 },
  { label: '5-12-13 triangle', value: '13.000', ratio: 13 },
  { label: '8-15-17 triangle', value: '17.000', ratio: 17 },
  { label: '9-12-15 triangle', value: '15.000', ratio: 15 }
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
>
  <HomeSchema
    slot="head"
    locale={locale}
    title={pageTitle}
    description={pageDescription}
    path="/"
    faqs={bundle.faq}
  />

  <section class="section-shell overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-52 bg-[radial-gradient(circle_at_top,rgba(212,175,116,0.24),transparent_72%)]"></div>
    <div class="relative grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
      <div>
        <p class="font-label text-[10px] uppercase tracking-[0.24em] text-primary/80">Precision Geometry Lab</p>
        <h1 class="mt-3 text-4xl sm:text-5xl">{pick(home, 'heading', siteTitle)}</h1>
        <p class="mt-4 max-w-2xl text-on-surface-variant">
          {pick(home, 'intro', 'Calculate missing values fast, review formulas, and validate your geometry work with confidence.')}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-primary" href="/formulas/">Explore Formula Directory</a>
          <a class="btn-secondary" href="/practice/">Open Practice Workspace</a>
        </div>
      </div>

      <div class="surface-card border-primary/25 bg-[linear-gradient(155deg,rgba(36,28,20,0.95)_0%,rgba(20,15,11,0.95)_100%)] p-5">
        <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Solver Highlights</p>
        <div class="mt-4 grid gap-3">
          <div class="lux-data-cell">
            <span>Solve Modes</span>
            <strong>Leg + Leg, Leg + Hypotenuse, Angle + Side</strong>
          </div>
          <div class="lux-data-cell">
            <span>Live Outputs</span>
            <strong>Hypotenuse, area, perimeter, angles</strong>
          </div>
          <div class="lux-data-cell">
            <span>Visualization</span>
            <strong>Dynamic SVG triangle and side scaling</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mt-8">
    <RightTriangleTool
      heading={pick(home, 'toolHeading', 'Triangle Tool')}
      description={pick(home, 'toolDescription', 'Enter any two legs to calculate hypotenuse, area, and perimeter instantly.')}
    />
  </div>

  <div class="mt-8">
    <HowItWorks heading={pick(home, 'howHeading', 'How Right Triangle Solver works')} />
  </div>

  <div class="mt-8">
    <ChartTableSection heading={pick(home, 'chartHeading', 'Reference Values')} rows={chartRows} />
  </div>

  <div class="mt-8">
    <Faq heading={pick(home, 'faqHeading', 'Frequently Asked Questions')} items={bundle.faq} />
  </div>
</BaseLayout>
