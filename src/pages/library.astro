---
import MuseLibrary from 'theme/components/MuseLibrary.astro';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = `Formula Library | ${siteTitle}`;
const pageDescription =
  'Browse theorem references, trigonometry mnemonics, and geometry formulas in a focused dark-mode library.';
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/library/"
  mainClass="mx-auto w-full max-w-[1200px] px-4 py-8 sm:px-6 lg:px-8"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Knowledge Hub</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">Geometric Formula <span class="text-gradient-primary">Library</span></h1>
    <p class="mx-auto mt-4 max-w-2xl text-on-surface-variant">
      A curated collection of geometric principles and algebraic identities for precise solving.
    </p>
  </header>
  <MuseLibrary
    calculatorHref="/"
    libraryHref="/library/"
    practiceHref="/practice/"
    formulasHref="/formulas/"
  />
</BaseLayout>
