---
import MusePractice from 'theme/components/MusePractice.astro';
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = `Practice Mode | ${siteTitle}`;
const pageDescription =
  'Train with right triangle challenges in an interactive practice workspace with progress and keypad input.';
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/practice/"
  mainClass="mx-auto w-full max-w-[1200px] px-4 py-8 sm:px-6 lg:px-8"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Interactive Training</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">Geometry Practice Mode</h1>
    <p class="mx-auto mt-4 max-w-2xl text-on-surface-variant">
      Build your skills with real-time challenges. Test your understanding of right triangles and trigonometry.
    </p>
  </header>
  <MusePractice
    calculatorHref="/"
    libraryHref="/library/"
    practiceHref="/practice/"
    formulasHref="/formulas/"
  />
</BaseLayout>
