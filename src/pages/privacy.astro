---
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { site } from 'theme/utils/site';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations('en');
const content = bundle.content as Record<string, any>;
const privacy = content.privacy ?? {};
const updatedLabel = pick(privacy, 'updatedLabel', 'Last updated: April 12, 2026');
const contactEmail = site.contactEmail || 'hello@righttrianglesolver.app';
---

<BaseLayout
  locale={locale}
  title={pick(privacy, 'title', 'Privacy')}
  description={pick(privacy, 'description', 'Privacy policy')}
  canonicalPath="/privacy/"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Compliance</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">{pick(privacy, 'heading', 'Privacy Policy')}</h1>
    <p class="mt-2 text-xs uppercase tracking-wide text-outline">{updatedLabel}</p>
    <p class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-on-surface-variant">
      This Privacy Policy explains what information Right Triangle Solver may collect, how it is used,
      and the choices you have.
    </p>
  </header>

  <section class="section-shell mb-6">
    <h2 class="text-xl font-headline text-on-surface">Quick Summary</h2>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-on-surface-variant">
      <li>You can use most of the site without creating an account.</li>
      <li>Calculator usage is generally anonymous and intended for educational use.</li>
      <li>If you contact us, we process the details you submit so we can respond.</li>
      <li>Basic technical data may be collected by hosting and security systems.</li>
      <li>You can contact us any time with privacy questions.</li>
    </ul>
  </section>

  <section class="section-shell mb-6">
    <h2 class="text-xl font-headline text-on-surface">Contents</h2>
    <nav aria-label="Privacy sections" class="mt-4 grid gap-2 sm:grid-cols-2">
      <a href="#scope" class="text-sm text-primary hover:text-primary-fixed">1. Scope</a>
      <a href="#collect" class="text-sm text-primary hover:text-primary-fixed">2. Information We Collect</a>
      <a href="#use" class="text-sm text-primary hover:text-primary-fixed">3. How We Use Information</a>
      <a href="#cookies" class="text-sm text-primary hover:text-primary-fixed">4. Cookies and Similar Technologies</a>
      <a href="#sharing" class="text-sm text-primary hover:text-primary-fixed">5. Sharing and Third Parties</a>
      <a href="#retention" class="text-sm text-primary hover:text-primary-fixed">6. Data Retention</a>
      <a href="#choices" class="text-sm text-primary hover:text-primary-fixed">7. Your Choices</a>
      <a href="#security" class="text-sm text-primary hover:text-primary-fixed">8. Security</a>
      <a href="#children" class="text-sm text-primary hover:text-primary-fixed">9. Children's Privacy</a>
      <a href="#changes" class="text-sm text-primary hover:text-primary-fixed">10. Policy Changes</a>
      <a href="#contact" class="text-sm text-primary hover:text-primary-fixed">11. Contact</a>
    </nav>
  </section>

  <article class="section-shell prose-shell">
    <div class="space-y-8 text-on-surface-variant">
      <section id="scope">
        <h2>1. Scope</h2>
        <p>
          This policy applies to Right Triangle Solver websites, tools, and public pages that link to this Privacy Policy.
          It describes how information is handled when you browse, calculate, or contact us.
        </p>
      </section>

      <section id="collect">
        <h2>2. Information We Collect</h2>
        <h3>Information you provide directly</h3>
        <ul>
          <li>Name, email address, and message details when you use the contact form.</li>
          <li>Any information you include voluntarily in support requests or feedback.</li>
        </ul>

        <h3>Technical information collected automatically</h3>
        <ul>
          <li>IP address, browser type, device information, referral page, and timestamps.</li>
          <li>Diagnostic or security logs generated by hosting infrastructure.</li>
        </ul>

        <h3>Calculator usage data</h3>
        <p>
          Calculator interactions are primarily designed for immediate problem solving. Input and output values are
          generally processed within the site experience and are not intended to identify you personally.
        </p>
      </section>

      <section id="use">
        <h2>3. How We Use Information</h2>
        <ul>
          <li>To provide and maintain the calculator and related educational pages.</li>
          <li>To respond to contact requests and improve support quality.</li>
          <li>To detect abuse, protect site integrity, and maintain security.</li>
          <li>To improve usability, performance, and content clarity.</li>
          <li>To comply with legal obligations when required.</li>
        </ul>
      </section>

      <section id="cookies">
        <h2>4. Cookies and Similar Technologies</h2>
        <p>
          The site may use essential cookies or local storage for functionality, security, and performance.
          You can manage browser settings to block or remove cookies, but some features may work less effectively.
        </p>
      </section>

      <section id="sharing">
        <h2>5. Sharing and Third Parties</h2>
        <p>
          We do not sell your personal information. We may share limited data with service providers who help operate
          the site, such as hosting or contact-form infrastructure, only as needed to deliver the service.
        </p>
        <p>
          If you submit a form, your message may be processed by configured form-delivery providers to route your
          request to our support inbox.
        </p>
      </section>

      <section id="retention">
        <h2>6. Data Retention</h2>
        <p>
          We retain information only for as long as reasonably necessary to operate the service, respond to requests,
          resolve disputes, enforce agreements, and meet legal requirements.
        </p>
      </section>

      <section id="choices">
        <h2>7. Your Choices</h2>
        <ul>
          <li>You may choose not to submit personal details through the contact form.</li>
          <li>You may request correction or deletion of contact-form data, subject to legal obligations.</li>
          <li>You can control cookies through browser settings.</li>
        </ul>
      </section>

      <section id="security">
        <h2>8. Security</h2>
        <p>
          We use reasonable technical and organizational measures to protect information from unauthorized access,
          loss, misuse, or alteration. No internet transmission or storage system is completely secure, so absolute
          security cannot be guaranteed.
        </p>
      </section>

      <section id="children">
        <h2>9. Children's Privacy</h2>
        <p>
          The service is designed for educational audiences, but it is not directed to children under 13 to submit
          personal information. If you believe a child has provided personal data through the site, contact us and
          we will review and remove it when appropriate.
        </p>
      </section>

      <section id="changes">
        <h2>10. Policy Changes</h2>
        <p>
          We may update this Privacy Policy from time to time to reflect service, legal, or operational changes.
          When updates are material, we will revise the "Last updated" date on this page.
        </p>
      </section>

      <section id="contact">
        <h2>11. Contact</h2>
        <p>
          For privacy questions or requests, email us at
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
