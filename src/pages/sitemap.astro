---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES
} from 'src/data/rightTriangleGroupedPages';
import { FOCUSED_ALTITUDE_CALCULATOR_PAGES } from 'src/data/focusedAltitudeCalculatorPages';
import { FOCUSED_SIDE_CALCULATOR_PAGES } from 'src/data/focusedSideCalculatorPages';
import { FOCUSED_MEASUREMENT_CALCULATOR_PAGES } from 'src/data/focusedMeasurementCalculatorPages';
import { FOCUSED_TRIG_RATIO_CALCULATOR_PAGES } from 'src/data/focusedTrigRatioCalculatorPages';
import { FOCUSED_ANGLE_CALCULATOR_PAGES } from 'src/data/focusedAngleCalculatorPages';
import { FOCUSED_RADIUS_CALCULATOR_PAGES } from 'src/data/focusedRadiusCalculatorPages';
import { FOCUSED_PROJECTION_CALCULATOR_PAGES } from 'src/data/focusedProjectionCalculatorPages';
import { FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES } from 'src/data/focusedSpecialTriangleCalculatorPages';
import { focusedTriplesCalculatorPages } from 'src/data/focusedTriplesCalculatorPages';
import { DEFAULT_LOCALE, localizePath } from 'theme/i18n/locales';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const locale = DEFAULT_LOCALE;
const blogPosts = await getCollection('blog');

const GENERAL_PAGES = [
  { href: '/', label: 'Home' },
  { href: '/about-us/', label: 'About Us' },
  { href: '/contact-us/', label: 'Contact Us' },
  { href: '/faqs/', label: 'FAQs' },
  { href: '/blog/', label: 'Blog' },
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Use' }
];
---

<BaseLayout
  locale={locale}
  title="Sitemap | Right Triangle Solver"
  description="Navigate all resources on Right Triangle Solver."
  canonicalPath="/sitemap/"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Directory</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">Website Sitemap</h1>
  </header>

  <div class="grid gap-8 lg:grid-cols-2">
    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Grouped Calculators</h2>
      <ul class="space-y-2">
        <li>
          <a
            href={localizePath(locale, RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url)}
            class="text-primary hover:underline"
          >
            {RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1}
          </a>
        </li>
        {RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Side Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_SIDE_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Measurement Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_MEASUREMENT_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Radius Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_RADIUS_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Altitude Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_ALTITUDE_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Projection Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_PROJECTION_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Trigonometric Ratio Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_TRIG_RATIO_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Angle Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_ANGLE_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Special Triangle Calculators</h2>
      <ul class="space-y-2">
        {FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Patterns and Triples Calculators</h2>
      <ul class="space-y-2">
        {focusedTriplesCalculatorPages.map((page) => (
          <li>
            <a href={localizePath(locale, page.url)} class="text-primary hover:underline">
              {page.h1}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Blog Posts</h2>
      <ul class="space-y-2">
        {blogPosts.map((post) => (
          <li>
            <a href={localizePath(locale, `/blog/${post.id}/`)} class="text-primary hover:underline">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell">
      <h2 class="text-xl font-bold mb-4">Pages</h2>
      <ul class="space-y-2">
        {GENERAL_PAGES.map((page) => (
          <li>
            <a href={localizePath(locale, page.href)} class="text-primary hover:underline">
              {page.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
