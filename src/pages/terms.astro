---
import { DEFAULT_LOCALE } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

const locale = DEFAULT_LOCALE;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const terms = (content.terms as Record<string, string>) ?? {};
---

<BaseLayout
  locale={locale}
  title={pick(terms, 'title', 'Terms')}
  description={pick(terms, 'description', 'Terms of use')}
  canonicalPath="/terms/"
>
  <header class="mb-10 text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">Agreement</p>
    <h1 class="mt-3 text-3xl font-headline sm:text-4xl lg:text-5xl text-on-surface">{pick(terms, 'heading', 'Terms of Use')}</h1>
    <p class="mt-2 text-xs uppercase tracking-wide text-outline">{pick(terms, 'updatedLabel', '')}</p>
  </header>

  <article class="section-shell prose-shell">
    <p class="mt-4 text-on-surface-variant">{pick(terms, 'body', 'These are the terms of use.')}</p>
  </article>
</BaseLayout>
