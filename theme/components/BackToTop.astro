---
interface Props {
  label?: string;
}

const { label = 'Back to Top' } = Astro.props;
---

<button
  id="back-to-top"
  class="fixed bottom-8 right-8 z-[100] flex h-12 w-12 translate-y-20 opacity-0 items-center justify-center rounded-full bg-primary/90 text-on-primary shadow-lg transition-all duration-300 hover:scale-110 hover:bg-primary active:scale-95 sm:bottom-10 sm:right-10"
  aria-label={label}
>
  <span class="material-symbols-outlined">expand_less</span>
</button>

<script is:inline>
  const btn = document.getElementById('back-to-top');

  if (btn) {
    const initBackToTop = () => {
      let isVisible = false;
      let ticking = false;

      const setVisibility = (nextVisible) => {
        if (nextVisible === isVisible) return;
        isVisible = nextVisible;

        if (nextVisible) {
          btn.classList.remove('translate-y-20', 'opacity-0');
          btn.classList.add('translate-y-0', 'opacity-100');
        } else {
          btn.classList.add('translate-y-20', 'opacity-0');
          btn.classList.remove('translate-y-0', 'opacity-100');
        }
      };

      const handleScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          setVisibility(window.scrollY > 400);
          ticking = false;
        });
      };

      window.addEventListener('scroll', handleScroll, { passive: true });

      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    };

    const scheduleInit = () => {
      const idleWindow = window;
      if (typeof idleWindow.requestIdleCallback === 'function') {
        idleWindow.requestIdleCallback(() => {
          initBackToTop();
        }, { timeout: 3000 });
      } else {
        window.setTimeout(initBackToTop, 1500);
      }
    };

    if (document.readyState === 'complete') {
      scheduleInit();
    } else {
      window.addEventListener('load', scheduleInit, { once: true });
    }
  }
</script>
