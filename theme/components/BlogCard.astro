---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
  ctaLabel: string;
}

const { title, description, image, href, ctaLabel } = Astro.props;
---

<article class="surface-card overflow-hidden border-outline-variant/30 p-0">
  <a href={href} class="block" aria-label={title}>
    <img
      src={image}
      alt={title}
      width="1200"
      height="630"
      loading="lazy"
      class="h-48 w-full bg-[#0f172a] object-contain"
    />
  </a>
  <div class="space-y-3 p-5">
    <h2 class="text-lg font-semibold leading-tight text-on-surface">
      <a href={href} class="transition-colors hover:text-primary">{title}</a>
    </h2>
    <p class="text-sm leading-relaxed text-on-surface-variant">{description}</p>
    <a href={href} class="inline-flex text-sm font-semibold text-primary transition-colors hover:text-primary-fixed">
      {ctaLabel}
    </a>
  </div>
</article>
