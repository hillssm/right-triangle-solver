---
import { RIGHT_TRIANGLE_FORMULAS, type RightTriangleFormula } from 'src/data/rightTriangleFormulas';
import { localizePath, type Locale } from 'theme/i18n/locales';

interface Props {
  locale: Locale;
  heading?: string;
  description?: string;
}

const {
  locale,
  heading = 'All Formula Calculators',
  description = 'Each tool has its own calculator page with title-specific inputs and direct output.'
} = Astro.props;

const formulasRoot = localizePath(locale, '/formulas/');

type SideFeature = 'a' | 'b' | 'c';
type DiagramFeature =
  | SideFeature
  | 'area'
  | 'perimeter'
  | 'semiperimeter'
  | 'angleA'
  | 'altitude'
  | 'projectionP'
  | 'projectionQ'
  | 'inradius'
  | 'circumradius';

const outputFeatureByKind: Record<RightTriangleFormula['calculator']['kind'], DiagramFeature> = {
  pythagorean_c: 'c',
  leg_from_ac: 'b',
  leg_from_bc: 'a',
  area_legs: 'area',
  perimeter: 'perimeter',
  semiperimeter: 'semiperimeter',
  sine: 'angleA',
  cosine: 'angleA',
  tangent: 'angleA',
  angle_asin: 'angleA',
  angle_acos: 'angleA',
  angle_atan: 'angleA',
  altitude: 'altitude',
  projection_p: 'projectionP',
  projection_q: 'projectionQ',
  inradius: 'inradius',
  circumradius: 'circumradius'
};

const sideFeatureByFieldKey: Partial<Record<string, SideFeature>> = {
  a: 'a',
  b: 'b',
  c: 'c'
};

const buildDiagramState = (formula: RightTriangleFormula) => {
  const inputSides = new Set<SideFeature>();
  for (const field of formula.calculator.fields) {
    const side = sideFeatureByFieldKey[field.key];
    if (side) inputSides.add(side);
  }
  return {
    inputSides,
    outputFeature: outputFeatureByKind[formula.calculator.kind]
  };
};

const strokeForSide = (side: SideFeature, inputSides: Set<SideFeature>, outputFeature: DiagramFeature) => {
  if (outputFeature === 'perimeter' || outputFeature === 'semiperimeter') return 'var(--color-primary)';
  if (outputFeature === side) return 'var(--color-primary)';
  if (inputSides.has(side)) return 'var(--color-secondary-fixed)';
  return 'var(--color-outline-variant)';
};

const strokeWidthForSide = (side: SideFeature, inputSides: Set<SideFeature>, outputFeature: DiagramFeature) => {
  if (outputFeature === 'perimeter' || outputFeature === 'semiperimeter') return 2.5;
  if (outputFeature === side) return 2.5;
  if (inputSides.has(side)) return 2;
  return 1.5;
};
---

<section class="relative mt-12 w-full overflow-hidden rounded-3xl border border-outline-variant/40 bg-surface-container px-6 py-12 shadow-[var(--shadow-luxury)] sm:px-12 sm:py-16" aria-labelledby="calculator-catalog-heading">
  <!-- Luxury Ambient Glows -->
  <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-primary/10 blur-[100px]"></div>
  <div class="pointer-events-none absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-tertiary-fixed/10 blur-[120px]"></div>

  <div class="relative z-10 flex flex-col items-center text-center">
    <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 backdrop-blur-md">
      <span class="material-symbols-outlined text-[14px] text-primary">auto_awesome</span>
      <span class="font-label text-xs uppercase tracking-[0.2em] text-primary">{RIGHT_TRIANGLE_FORMULAS.length} Precision Tools</span>
    </div>
    
    <h2 id="calculator-catalog-heading" class="text-glow-primary font-headline text-3xl tracking-tight text-on-surface sm:text-4xl lg:text-5xl">
      {heading}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base text-on-surface-variant/80 sm:text-lg">
      {description}
    </p>
  </div>

  <div class="relative z-10 mx-auto mt-14 grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {RIGHT_TRIANGLE_FORMULAS.map((formula, index) => {
      const diagram = buildDiagramState(formula);
      const isArea = diagram.outputFeature === 'area';
      
      return (
        <a
          href={`${formulasRoot}${formula.slug}/`}
          class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest/50 p-6 transition-all duration-500 hover:-translate-y-1.5 hover:border-primary/50 hover:bg-surface-container-low/80 hover:shadow-[var(--shadow-glow-primary)]"
          aria-label={`${formula.title} calculator`}
        >
          <!-- Hover Highlight -->
          <div class="pointer-events-none absolute -inset-px rounded-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: radial-gradient(400px circle at 50% 100%, rgba(241, 201, 125, 0.12), transparent 45%);"></div>

          <div>
            <div class="flex items-center justify-between">
              <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline transition-colors group-hover:text-primary/70">
                Tool {String(index + 1).padStart(2, '0')}
              </span>
              <span class="material-symbols-outlined text-[16px] text-outline/50 transition-colors group-hover:text-primary">arrow_outward</span>
            </div>
            <h3 class="mt-4 break-words text-lg font-semibold leading-snug tracking-tight text-on-surface transition-colors group-hover:text-primary">
              {formula.title}
            </h3>
          </div>

          <div class="mt-6 flex h-36 w-full items-center justify-center rounded-xl border border-outline-variant/20 bg-surface/50 shadow-inner transition-colors group-hover:border-primary/20">
            <!-- Simplified, elegant SVG Diagram -->
            <svg class="h-24 w-full" viewBox="0 0 112 96" role="img" aria-label={`${formula.title} diagram`}>
              <defs>
                <linearGradient id={`grad-${index}`} x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color={isArea ? "rgba(241, 201, 125, 0.3)" : "rgba(241, 201, 125, 0.05)"} />
                  <stop offset="100%" stop-color={isArea ? "rgba(212, 173, 101, 0.1)" : "rgba(241, 201, 125, 0.0)"} />
                </linearGradient>
              </defs>

              <!-- Base Triangle Fill -->
              <path d="M 24 14 L 24 82 L 88 82 Z" fill={`url(#grad-${index})`} stroke="none"></path>

              <!-- Conditionally rendered advanced features -->
              {diagram.outputFeature === 'altitude' && (
                <line x1="24" y1="82" x2="54" y2="46" stroke="var(--color-primary)" stroke-width="2" stroke-dasharray="3 3"></line>
              )}
              {diagram.outputFeature === 'projectionP' && (
                <line x1="24" y1="14" x2="54" y2="46" stroke="var(--color-primary)" stroke-width="2.5"></line>
              )}
              {diagram.outputFeature === 'projectionQ' && (
                <line x1="54" y1="46" x2="88" y2="82" stroke="var(--color-primary)" stroke-width="2.5"></line>
              )}
              {diagram.outputFeature === 'inradius' && (
                <circle cx="43" cy="63" r="13" fill="none" stroke="var(--color-primary)" stroke-width="2"></circle>
              )}
              {diagram.outputFeature === 'circumradius' && (
                <circle cx="56" cy="48" r="41" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-dasharray="3 3"></circle>
              )}
              {diagram.outputFeature === 'angleA' && (
                <path d="M 75 82 A 13 13 0 0 0 78 72" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round"></path>
              )}

              <!-- Base Triangle Sides -->
              <line
                x1="24" y1="14" x2="24" y2="82"
                stroke={strokeForSide('a', diagram.inputSides, diagram.outputFeature)}
                stroke-width={strokeWidthForSide('a', diagram.inputSides, diagram.outputFeature)}
                stroke-linecap="round"
              ></line>
              <line
                x1="24" y1="82" x2="88" y2="82"
                stroke={strokeForSide('b', diagram.inputSides, diagram.outputFeature)}
                stroke-width={strokeWidthForSide('b', diagram.inputSides, diagram.outputFeature)}
                stroke-linecap="round"
              ></line>
              <line
                x1="24" y1="14" x2="88" y2="82"
                stroke={strokeForSide('c', diagram.inputSides, diagram.outputFeature)}
                stroke-width={strokeWidthForSide('c', diagram.inputSides, diagram.outputFeature)}
                stroke-linecap="round"
              ></line>

              <!-- Right angle marker -->
              <path d="M 24 73 L 33 73 L 33 82" fill="none" stroke="var(--color-outline-variant)" stroke-width="1"></path>
            </svg>
          </div>

          <div class="mt-6 flex flex-col gap-3">
            <div class="flex items-center gap-2">
              <span class="rounded border border-outline-variant/30 bg-surface-container-high px-2 py-1 font-mono text-[10px] text-on-surface-variant/80">Input</span>
              <span class="text-xs font-medium text-on-surface">
                {formula.calculator.fields.map((f) => f.label.replace('Leg ', '').replace('Hypotenuse ', '').replace('Adjacent ', '').replace('Opposite ', '')).join(' + ')}
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded border border-primary/20 bg-primary/10 px-2 py-1 font-mono text-[10px] text-primary">Output</span>
              <span class="text-xs font-medium text-primary">
                {formula.calculator.outputLabel}
              </span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>

