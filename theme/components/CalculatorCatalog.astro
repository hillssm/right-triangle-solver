---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES
} from 'src/data/rightTriangleGroupedPages';
import { localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';

interface Props {
  locale: Locale;
  heading?: string;
  uiTools?: string;
}

const {
  locale,
  heading = 'Premium Calculator Collection',
  uiTools = 'Calculator Groups'
} = Astro.props;

const bundle = getTranslations(locale);
const content = (bundle.content as Record<string, any>) ?? {};
const grouped = (content.grouped as Record<string, any>) ?? {};
const groupedUi = (grouped.ui as Record<string, any>) ?? {};
const groupedHub = (grouped.hub as Record<string, any>) ?? {};
const groupedPages = (grouped.pages as Record<string, any>) ?? {};

const hubHref = localizePath(locale, RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url);
const hubTitle = pick(groupedHub, 'h1', RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1);
const openToolLabel = pick(groupedUi, 'openTool', 'Open Tool');
const getLocalizedPageTitle = (slug: string, fallback: string) => {
  const localized = groupedPages[slug] as Record<string, unknown> | undefined;
  return pick(localized ?? {}, 'h1', fallback);
};
const CARD_ICONS = [
  'calculate',
  'square_foot',
  'functions',
  'angle',
  'timeline',
  'grid_on',
  'straighten',
  'schema',
  'radio_button_checked',
  'diamond'
];

const SUPPORT_TOOL_PAGES = [
  {
    title: 'Pythagorean Triples Calculator',
    href: '/pythagorean-triples-calculator/',
    description: 'Check or generate whole-number right triangle triples.',
    icon: 'format_list_numbered'
  },
  {
    title: '3 4 5 Triangle Calculator',
    href: '/3-4-5-triangle-calculator/',
    description: 'Solve the most common Pythagorean triple and scale its sides.',
    icon: 'looks_3'
  },
  {
    title: '5 12 13 Triangle Calculator',
    href: '/5-12-13-triangle-calculator/',
    description: 'Scale a 5 12 13 right triangle and find sides, area, and perimeter.',
    icon: 'looks_5'
  },
  {
    title: 'Similar Right Triangles Calculator',
    href: '/similar-right-triangles-calculator/',
    description: 'Find scale factor and missing matching sides in similar right triangles.',
    icon: 'compare_arrows'
  }
];

const totalToolCount = RIGHT_TRIANGLE_GROUPED_PAGES.length + SUPPORT_TOOL_PAGES.length;
---

<section
  class="relative mt-12 w-full overflow-hidden rounded-3xl border border-outline-variant/40 bg-surface-container px-6 py-12 shadow-[var(--shadow-luxury)] sm:px-12 sm:py-16"
  aria-labelledby="calculator-catalog-heading"
>
  <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-primary/10 blur-[100px]"></div>
  <div class="pointer-events-none absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-tertiary-fixed/10 blur-[120px]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(241,201,125,0.08),transparent_45%)]"></div>

  <div class="relative z-10 flex flex-col items-center text-center">
    <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 backdrop-blur-md">
      <span class="material-symbols-outlined text-[14px] text-primary">auto_awesome</span>
      <span class="font-label text-xs uppercase tracking-[0.2em] text-primary">
        {totalToolCount} {uiTools}
      </span>
    </div>

    <h2 id="calculator-catalog-heading" class="text-glow-primary font-headline text-3xl tracking-tight text-on-surface sm:text-4xl lg:text-5xl">
      {heading}
    </h2>
    <a href={hubHref} class="btn-primary mt-6">{openToolLabel} {hubTitle}</a>
  </div>

  <div class="relative z-10 mx-auto mt-12 max-w-7xl">
    <h3 class="font-label text-xs uppercase tracking-[0.2em] text-outline">
      Core Right Triangle Calculators
    </h3>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {RIGHT_TRIANGLE_GROUPED_PAGES.map((page, index) => (
        <a
          href={localizePath(locale, page.url)}
          class="group relative flex h-full min-h-[180px] flex-col justify-between overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest/70 p-5 transition-all duration-500 hover:-translate-y-1.5 hover:border-primary/45 hover:shadow-[0_18px_40px_-24px_rgba(241,201,125,0.6)]"
        >
          <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,rgba(241,201,125,0.1),transparent_45%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          <div>
            <div class="flex items-center justify-between">
              <span class="font-label text-[10px] uppercase tracking-[0.22em] text-outline">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-primary/25 bg-primary/10 text-primary transition-transform duration-500 group-hover:scale-110">
                <span class="material-symbols-outlined text-[16px]">{CARD_ICONS[index] ?? 'calculate'}</span>
              </span>
            </div>
            <h3 class="mt-4 text-[15px] font-semibold leading-snug text-on-surface group-hover:text-primary">
              {getLocalizedPageTitle(page.slug, page.h1)}
            </h3>
          </div>
          <p class="relative z-10 mt-5 text-[10px] uppercase tracking-[0.2em] text-primary">{openToolLabel}</p>
        </a>
      ))}
    </div>

    <div class="mt-10 border-t border-outline-variant/30 pt-8">
      <h3 class="font-label text-xs uppercase tracking-[0.2em] text-outline">
        Right Triangle Patterns and Triples
      </h3>

      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {SUPPORT_TOOL_PAGES.map((page, index) => (
          <a
            href={localizePath(locale, page.href)}
            class="group relative flex h-full min-h-[180px] flex-col justify-between overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest/70 p-5 transition-all duration-500 hover:-translate-y-1.5 hover:border-primary/45 hover:shadow-[0_18px_40px_-24px_rgba(241,201,125,0.6)]"
          >
            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,rgba(241,201,125,0.1),transparent_45%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div>
              <div class="flex items-center justify-between">
                <span class="font-label text-[10px] uppercase tracking-[0.22em] text-outline">
                  {String(RIGHT_TRIANGLE_GROUPED_PAGES.length + index + 1).padStart(2, '0')}
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-primary/25 bg-primary/10 text-primary transition-transform duration-500 group-hover:scale-110">
                  <span class="material-symbols-outlined text-[16px]">{page.icon}</span>
                </span>
              </div>
              <h3 class="mt-4 text-[15px] font-semibold leading-snug text-on-surface group-hover:text-primary">
                {page.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
                {page.description}
              </p>
            </div>
            <p class="relative z-10 mt-5 text-[10px] uppercase tracking-[0.2em] text-primary">{openToolLabel}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
