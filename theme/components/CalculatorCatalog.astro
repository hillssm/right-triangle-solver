---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES
} from 'src/data/rightTriangleGroupedPages';
import { FOCUSED_SIDE_CALCULATOR_PAGES } from 'src/data/focusedSideCalculatorPages';
import { FOCUSED_MEASUREMENT_CALCULATOR_PAGES } from 'src/data/focusedMeasurementCalculatorPages';
import { FOCUSED_TRIG_RATIO_CALCULATOR_PAGES } from 'src/data/focusedTrigRatioCalculatorPages';
import { FOCUSED_ANGLE_CALCULATOR_PAGES } from 'src/data/focusedAngleCalculatorPages';
import { FOCUSED_ALTITUDE_CALCULATOR_PAGES } from 'src/data/focusedAltitudeCalculatorPages';
import { FOCUSED_PROJECTION_CALCULATOR_PAGES } from 'src/data/focusedProjectionCalculatorPages';
import { FOCUSED_RADIUS_CALCULATOR_PAGES } from 'src/data/focusedRadiusCalculatorPages';
import { FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES } from 'src/data/focusedSpecialTriangleCalculatorPages';
import { focusedTriplesCalculatorPages } from 'src/data/focusedTriplesCalculatorPages';
import { localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';

interface Props {
  locale: Locale;
  heading?: string;
  uiTools?: string;
}

const {
  locale,
  heading = 'Premium Calculator Collection',
  uiTools = 'Calculator Groups'
} = Astro.props;

const bundle = getTranslations(locale);
const content = (bundle.content as Record<string, any>) ?? {};
const grouped = (content.grouped as Record<string, any>) ?? {};
const groupedHub = (grouped.hub as Record<string, any>) ?? {};
const groupedPages = (grouped.pages as Record<string, any>) ?? {};

const hubTitle = pick(groupedHub, 'h1', RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1);
const getLocalizedPageTitle = (slug: string, fallback: string) => {
  const localized = groupedPages[slug] as Record<string, unknown> | undefined;
  return pick(localized ?? {}, 'h1', fallback);
};

type DirectoryEntry = { url: string; title: string };

const groupedBySlug = new Map(RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => [page.slug, page]));
const groupedEntry = (slug: string): DirectoryEntry => {
  const page = groupedBySlug.get(slug);
  if (!page) throw new Error(`Unknown grouped page slug: ${slug}`);
  return { url: page.url, title: getLocalizedPageTitle(page.slug, page.h1) };
};
const focusedEntries = (pages: { url: string; h1: string }[]): DirectoryEntry[] =>
  pages.map((page) => ({ url: page.url, title: page.h1 }));
const byTitle = (a: DirectoryEntry, b: DirectoryEntry) => a.title.localeCompare(b.title);

const categories = [
  {
    title: 'All-in-one calculator',
    intro:
      'Enter any two values of a right triangle and solve for every missing side and angle, or jump to a focused calculator.',
    entries: [{ url: RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url, title: hubTitle }]
  },
  {
    title: 'Sides and hypotenuse',
    intro: 'Solve c, a, or b from Pythagorean relations, or find sides using trigonometric input.',
    entries: [
      groupedEntry('right-triangle-side-calculator'),
      groupedEntry('right-triangle-side-from-angle-calculator'),
      ...focusedEntries(FOCUSED_SIDE_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Angles',
    intro: 'Find A or B with inverse trig.',
    entries: [
      groupedEntry('right-triangle-angle-calculator'),
      ...focusedEntries(FOCUSED_ANGLE_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Trigonometric ratios',
    intro: 'For sin, cos, tan, sec, csc, and cot.',
    entries: [
      groupedEntry('right-triangle-trig-ratios-calculator'),
      ...focusedEntries(FOCUSED_TRIG_RATIO_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Area, perimeter, and semiperimeter',
    intro: 'Multiple area methods, plus perimeter and semiperimeter.',
    entries: [
      groupedEntry('right-triangle-area-calculator'),
      groupedEntry('right-triangle-measurements-calculator'),
      ...focusedEntries(FOCUSED_MEASUREMENT_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Altitude and hypotenuse projections',
    intro: 'Altitude relations, plus segment and projection theorems.',
    entries: [
      groupedEntry('right-triangle-altitude-calculator'),
      groupedEntry('right-triangle-projection-calculator'),
      ...focusedEntries(FOCUSED_ALTITUDE_CALCULATOR_PAGES),
      ...focusedEntries(FOCUSED_PROJECTION_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Inradius and circumradius',
    intro: 'For inradius and circumradius.',
    entries: [
      groupedEntry('right-triangle-radius-calculator'),
      ...focusedEntries(FOCUSED_RADIUS_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Special right triangles',
    intro: 'Shortcuts for 45-45-90 and 30-60-90 triangles.',
    entries: [
      groupedEntry('special-right-triangle-calculator'),
      ...focusedEntries(FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: 'Pythagorean triples',
    intro: 'Integer side lengths satisfying the Pythagorean relationship.',
    entries: [...focusedEntries(focusedTriplesCalculatorPages)].sort(byTitle)
  }
];

let runningNumber = 0;
const numberedCategories = categories.map((category) => ({
  ...category,
  entries: category.entries.map((entry) => ({
    ...entry,
    number: String(++runningNumber).padStart(2, '0')
  }))
}));
const totalCount = runningNumber;
---

<section class="section-shell" aria-labelledby="calculator-catalog-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-label text-[10px] uppercase tracking-[0.28em] text-primary/70">
        The Complete Collection
      </p>
      <h2 id="calculator-catalog-heading" class="mt-3 text-2xl font-bold text-on-surface">{heading}</h2>
    </div>
    <p class="font-headline text-lg text-primary">{totalCount} calculators</p>
  </div>

  {numberedCategories.map((category) => (
    <div class="mt-12 border-t border-primary/25 pt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h3 class="font-headline text-xl font-bold text-on-surface">{category.title}</h3>
        <p class="font-headline text-sm text-primary">
          {category.entries.length === 1
            ? '1 calculator'
            : `${category.entries.length} calculators`}
        </p>
      </div>
      <p class="mt-2 max-w-2xl text-sm text-on-surface-variant">{category.intro}</p>
      <ul class="mt-6 grid gap-x-12 sm:grid-cols-2">
        {category.entries.map((entry) => (
          <li class="border-b border-primary/10">
            <a
              href={localizePath(locale, entry.url)}
              class="group flex items-baseline gap-4 py-3.5"
            >
              <span class="font-headline text-sm text-primary/70 transition-colors group-hover:text-primary">
                {entry.number}
              </span>
              <span class="text-[15px] leading-snug text-on-surface transition-colors group-hover:text-primary">
                {entry.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
