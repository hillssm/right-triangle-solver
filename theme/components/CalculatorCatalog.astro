---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES
} from 'src/data/rightTriangleGroupedPages';
import { FOCUSED_SIDE_CALCULATOR_PAGES } from 'src/data/focusedSideCalculatorPages';
import { FOCUSED_MEASUREMENT_CALCULATOR_PAGES } from 'src/data/focusedMeasurementCalculatorPages';
import { FOCUSED_TRIG_RATIO_CALCULATOR_PAGES } from 'src/data/focusedTrigRatioCalculatorPages';
import { FOCUSED_ANGLE_CALCULATOR_PAGES } from 'src/data/focusedAngleCalculatorPages';
import { FOCUSED_ALTITUDE_CALCULATOR_PAGES } from 'src/data/focusedAltitudeCalculatorPages';
import { FOCUSED_PROJECTION_CALCULATOR_PAGES } from 'src/data/focusedProjectionCalculatorPages';
import { FOCUSED_RADIUS_CALCULATOR_PAGES } from 'src/data/focusedRadiusCalculatorPages';
import { FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES } from 'src/data/focusedSpecialTriangleCalculatorPages';
import { focusedTriplesCalculatorPages, getFocusedTriplesCalculatorPage } from 'src/data/focusedTriplesCalculatorPages';
import { getFocusedSideCalculatorPage } from 'src/data/focusedSideCalculatorPages';
import { getFocusedMeasurementCalculatorPage } from 'src/data/focusedMeasurementCalculatorPages';
import { getFocusedTrigRatioCalculatorPage } from 'src/data/focusedTrigRatioCalculatorPages';
import { getFocusedAngleCalculatorPage } from 'src/data/focusedAngleCalculatorPages';
import { getFocusedAltitudeCalculatorPage } from 'src/data/focusedAltitudeCalculatorPages';
import { getFocusedProjectionCalculatorPage } from 'src/data/focusedProjectionCalculatorPages';
import { getFocusedRadiusCalculatorPage } from 'src/data/focusedRadiusCalculatorPages';
import { getFocusedSpecialTriangleCalculatorPage } from 'src/data/focusedSpecialTriangleCalculatorPages';
import { localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';

interface Props {
  locale: Locale;
  heading?: string;
  uiTools?: string;
}

const {
  locale,
  heading = 'Premium Calculator Collection',
  uiTools = 'Calculator Groups'
} = Astro.props;

const bundle = getTranslations(locale);
const content = (bundle.content as Record<string, any>) ?? {};
const home = (content.home as Record<string, any>) ?? {};
const grouped = (content.grouped as Record<string, any>) ?? {};
const groupedHub = (grouped.hub as Record<string, any>) ?? {};
const groupedPages = (grouped.pages as Record<string, any>) ?? {};

const hubTitle = pick(groupedHub, 'h1', RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1);
const getLocalizedPageTitle = (slug: string, fallback: string) => {
  const localized = groupedPages[slug] as Record<string, unknown> | undefined;
  return pick(localized ?? {}, 'h1', fallback);
};

type DirectoryEntry = { url: string; title: string };

const groupedBySlug = new Map(RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => [page.slug, page]));
const groupedEntry = (slug: string): DirectoryEntry => {
  const page = groupedBySlug.get(slug);
  if (!page) throw new Error(`Unknown grouped page slug: ${slug}`);
  return { url: page.url, title: getLocalizedPageTitle(page.slug, page.h1) };
};
// Localized directory titles: each focused page getter applies the locale's
// translations (falling back to the English h1 when a translation is missing).
// Radius pages have no locale variants, so they keep the English h1 to match
// the destination page exactly.
const localizedFocusedEntries = (
  pages: { slug: string; url: string; h1: string }[],
  getPage: (slug: string, locale: Locale) => { h1: string } | undefined
): DirectoryEntry[] =>
  pages.map((page) => ({
    url: page.url,
    title: getPage(page.slug, locale)?.h1 ?? page.h1
  }));
const focusedEntries = (pages: { slug: string; url: string; h1: string }[]): DirectoryEntry[] =>
  pages.map((page) => ({ url: page.url, title: page.h1 }));
const byTitle = (a: DirectoryEntry, b: DirectoryEntry) => a.title.localeCompare(b.title);

const catalogCategories = (content.home as Record<string, any>)?.catalogCategories as
  Array<{ title: string; intro: string }> | undefined;
const catText = (index: number, field: 'title' | 'intro', fallback: string): string =>
  catalogCategories?.[index]?.[field] ?? fallback;

const categories = [
  {
    title: catText(0, 'title', 'All-in-one calculator'),
    intro: catText(0, 'intro', 'Enter any two values of a right triangle and solve for every missing side and angle, or jump to a focused calculator.'),
    entries: [{ url: RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url, title: hubTitle }]
  },
  {
    title: catText(1, 'title', 'Sides and hypotenuse'),
    intro: catText(1, 'intro', 'Solve c, a, or b from Pythagorean relations, or find sides using trigonometric input.'),
    entries: [
      groupedEntry('right-triangle-side-calculator'),
      groupedEntry('right-triangle-side-from-angle-calculator'),
      ...localizedFocusedEntries(FOCUSED_SIDE_CALCULATOR_PAGES, getFocusedSideCalculatorPage)
    ].sort(byTitle)
  },
  {
    title: catText(2, 'title', 'Angles'),
    intro: catText(2, 'intro', 'Find A or B with inverse trig.'),
    entries: [
      groupedEntry('right-triangle-angle-calculator'),
      ...localizedFocusedEntries(FOCUSED_ANGLE_CALCULATOR_PAGES, getFocusedAngleCalculatorPage)
    ].sort(byTitle)
  },
  {
    title: catText(3, 'title', 'Trigonometric ratios'),
    intro: catText(3, 'intro', 'For sin, cos, tan, sec, csc, and cot.'),
    entries: [
      groupedEntry('right-triangle-trig-ratios-calculator'),
      ...localizedFocusedEntries(FOCUSED_TRIG_RATIO_CALCULATOR_PAGES, getFocusedTrigRatioCalculatorPage)
    ].sort(byTitle)
  },
  {
    title: catText(4, 'title', 'Area, perimeter, and semiperimeter'),
    intro: catText(4, 'intro', 'Multiple area methods, plus perimeter and semiperimeter.'),
    entries: [
      groupedEntry('right-triangle-area-calculator'),
      groupedEntry('right-triangle-measurements-calculator'),
      ...localizedFocusedEntries(FOCUSED_MEASUREMENT_CALCULATOR_PAGES, getFocusedMeasurementCalculatorPage)
    ].sort(byTitle)
  },
  {
    title: catText(5, 'title', 'Altitude and hypotenuse projections'),
    intro: catText(5, 'intro', 'Altitude relations, plus segment and projection theorems.'),
    entries: [
      groupedEntry('right-triangle-altitude-calculator'),
      groupedEntry('right-triangle-projection-calculator'),
      ...localizedFocusedEntries(FOCUSED_ALTITUDE_CALCULATOR_PAGES, getFocusedAltitudeCalculatorPage),
      ...localizedFocusedEntries(FOCUSED_PROJECTION_CALCULATOR_PAGES, getFocusedProjectionCalculatorPage)
    ].sort(byTitle)
  },
  {
    title: catText(6, 'title', 'Inradius and circumradius'),
    intro: catText(6, 'intro', 'For inradius and circumradius.'),
    entries: [
      groupedEntry('right-triangle-radius-calculator'),
      ...focusedEntries(FOCUSED_RADIUS_CALCULATOR_PAGES)
    ].sort(byTitle)
  },
  {
    title: catText(7, 'title', 'Special right triangles'),
    intro: catText(7, 'intro', 'Shortcuts for 45-45-90 and 30-60-90 triangles.'),
    entries: [
      groupedEntry('special-right-triangle-calculator'),
      ...localizedFocusedEntries(FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES, getFocusedSpecialTriangleCalculatorPage)
    ].sort(byTitle)
  },
  {
    title: catText(8, 'title', 'Pythagorean triples'),
    intro: catText(8, 'intro', 'Integer side lengths satisfying the Pythagorean relationship.'),
    entries: [...localizedFocusedEntries(focusedTriplesCalculatorPages, getFocusedTriplesCalculatorPage)].sort(byTitle)
  }
];

let runningNumber = 0;
const numberedCategories = categories.map((category) => ({
  ...category,
  entries: category.entries.map((entry) => ({
    ...entry,
    number: String(++runningNumber).padStart(2, '0')
  }))
}));
const totalCount = runningNumber;
---

<section class="section-shell" aria-labelledby="calculator-catalog-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-label text-[10px] uppercase tracking-[0.28em] text-primary/70">
        {pick(home, 'catalogEyebrow', 'The Complete Collection')}
      </p>
      <h2 id="calculator-catalog-heading" class="mt-3 text-2xl font-bold text-on-surface">{heading}</h2>
    </div>
    <p class="font-headline text-lg text-primary">{(pick(home, 'catalogCount', '{n} calculators') as string).replace('{n}', String(totalCount))}</p>
  </div>

  {numberedCategories.map((category) => (
    <div class="mt-12 border-t border-primary/25 pt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h3 class="font-headline text-xl font-bold text-on-surface">{category.title}</h3>
        <p class="font-headline text-sm text-primary">
          {category.entries.length === 1
            ? pick(home, 'catalogCountOne', '1 calculator')
            : (pick(home, 'catalogCount', '{n} calculators') as string).replace('{n}', String(category.entries.length))}
        </p>
      </div>
      <p class="mt-2 max-w-2xl text-sm text-on-surface-variant">{category.intro}</p>
      <ul class="mt-6 grid gap-x-12 sm:grid-cols-2">
        {category.entries.map((entry) => (
          <li class="border-b border-primary/10">
            <a
              href={localizePath(locale, entry.url)}
              class="group flex items-baseline gap-4 py-3.5"
            >
              <span class="font-headline text-sm text-primary/70 transition-colors group-hover:text-primary">
                {entry.number}
              </span>
              <span class="text-[15px] leading-snug text-on-surface transition-colors group-hover:text-primary">
                {entry.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
