---
import { RIGHT_TRIANGLE_FORMULAS, type RightTriangleFormula } from 'src/data/rightTriangleFormulas';
import { localizePath, type Locale } from 'theme/i18n/locales';

interface Props {
  locale: Locale;
  heading?: string;
  description?: string;
}

const {
  locale,
  heading = 'All Formula Calculators',
  description = 'Each tool has its own calculator page with title-specific inputs and direct output.'
} = Astro.props;

const formulasRoot = localizePath(locale, '/formulas/');

type SideFeature = 'a' | 'b' | 'c';
type DiagramFeature =
  | SideFeature
  | 'area'
  | 'perimeter'
  | 'semiperimeter'
  | 'angleA'
  | 'altitude'
  | 'projectionP'
  | 'projectionQ'
  | 'inradius'
  | 'circumradius';

const categoryClasses: Record<string, string> = {
  'Core Side Relations': 'bg-primary/12 text-primary border-primary/35',
  'Area and Perimeter': 'bg-primary-container/18 text-primary-fixed border-primary-container/45',
  'Trigonometric Ratios': 'bg-tertiary-fixed/12 text-tertiary-fixed border-tertiary-fixed-dim/45',
  'Inverse Angle Formulas': 'bg-secondary-container/45 text-secondary-fixed border-secondary-container/65',
  'Derived Geometry': 'bg-surface-container-high text-on-surface-variant border-outline-variant'
};

const outputFeatureByKind: Record<RightTriangleFormula['calculator']['kind'], DiagramFeature> = {
  pythagorean_c: 'c',
  leg_from_ac: 'b',
  leg_from_bc: 'a',
  area_legs: 'area',
  perimeter: 'perimeter',
  semiperimeter: 'semiperimeter',
  sine: 'angleA',
  cosine: 'angleA',
  tangent: 'angleA',
  angle_asin: 'angleA',
  angle_acos: 'angleA',
  angle_atan: 'angleA',
  altitude: 'altitude',
  projection_p: 'projectionP',
  projection_q: 'projectionQ',
  inradius: 'inradius',
  circumradius: 'circumradius'
};

const outputGlyphByFeature: Record<DiagramFeature, string> = {
  a: 'a',
  b: 'b',
  c: 'c',
  area: 'Ar',
  perimeter: 'P',
  semiperimeter: 's',
  angleA: 'A',
  altitude: 'h',
  projectionP: 'p',
  projectionQ: 'q',
  inradius: 'r',
  circumradius: 'R'
};

const sideFeatureByFieldKey: Partial<Record<string, SideFeature>> = {
  a: 'a',
  b: 'b',
  c: 'c'
};

const buildDiagramState = (formula: RightTriangleFormula) => {
  const inputSides = new Set<SideFeature>();
  for (const field of formula.calculator.fields) {
    const side = sideFeatureByFieldKey[field.key];
    if (side) inputSides.add(side);
  }
  return {
    inputSides,
    outputFeature: outputFeatureByKind[formula.calculator.kind]
  };
};

const strokeForSide = (side: SideFeature, inputSides: Set<SideFeature>, outputFeature: DiagramFeature) => {
  if (outputFeature === 'perimeter' || outputFeature === 'semiperimeter') return 'var(--color-primary)';
  if (outputFeature === side) return 'var(--color-primary)';
  if (inputSides.has(side)) return 'var(--color-secondary-fixed)';
  return 'var(--color-outline-variant)';
};

const strokeWidthForSide = (side: SideFeature, inputSides: Set<SideFeature>, outputFeature: DiagramFeature) => {
  if (outputFeature === 'perimeter' || outputFeature === 'semiperimeter') return 3;
  if (outputFeature === side) return 3;
  if (inputSides.has(side)) return 2.6;
  return 2.1;
};
---

<section class="section-shell" aria-labelledby="calculator-catalog-heading">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
        <span class="material-symbols-outlined text-xl">calculate</span>
      </div>
      <h2 id="calculator-catalog-heading" class="text-2xl sm:text-3xl">{heading}</h2>
    </div>
    <p class="rounded-md border border-primary/35 bg-primary/10 px-3 py-1.5 font-label text-[10px] uppercase tracking-[0.16em] text-primary">
      {RIGHT_TRIANGLE_FORMULAS.length} Tools
    </p>
  </div>
  <p class="mt-3 max-w-3xl text-sm text-on-surface-variant">{description}</p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {RIGHT_TRIANGLE_FORMULAS.map((formula, index) => {
      const diagram = buildDiagramState(formula);
      const outputGlyph = outputGlyphByFeature[diagram.outputFeature];
      const areaFill = diagram.outputFeature === 'area' ? 'rgba(241, 201, 125, 0.24)' : 'rgba(233, 193, 118, 0.08)';
      const angleStroke = diagram.outputFeature === 'angleA' ? 'var(--color-primary)' : 'var(--color-outline-variant)';
      const altitudeOpacity = diagram.outputFeature === 'altitude' ? 1 : 0.18;
      const projectionPOpacity = diagram.outputFeature === 'projectionP' ? 1 : 0.2;
      const projectionQOpacity = diagram.outputFeature === 'projectionQ' ? 1 : 0.2;
      const inradiusOpacity = diagram.outputFeature === 'inradius' ? 1 : 0.15;
      const circumradiusOpacity = diagram.outputFeature === 'circumradius' ? 1 : 0.12;
      const outputChipClass =
        diagram.outputFeature === 'perimeter' || diagram.outputFeature === 'semiperimeter'
          ? 'border-primary/40 bg-primary/10 text-primary'
          : 'border-outline-variant/45 bg-surface-container-lowest/60 text-on-surface-variant';

      return (
        <a
          href={`${formulasRoot}${formula.slug}/`}
          class="surface-card block border-outline-variant/50 hover:border-primary/45 hover:bg-surface-container-high"
          aria-label={`${formula.title} calculator`}
        >
          <div class="flex items-start justify-between gap-3">
            <span
              class:list={[
                'rounded-md border px-2 py-1 font-label text-[10px] uppercase tracking-[0.14em]',
                categoryClasses[formula.category] ?? 'bg-surface-container-high text-on-surface border-outline-variant'
              ]}
            >
              {formula.category}
            </span>
            <span class="font-label text-[10px] uppercase tracking-[0.14em] text-outline">Tool {String(index + 1).padStart(2, '0')}</span>
          </div>

          <h3 class="mt-3 line-clamp-2 text-base font-semibold sm:text-lg">{formula.title}</h3>

          <div class="mt-3 rounded-xl border border-outline-variant/30 bg-surface-container-lowest/70 p-3">
            <svg class="h-28 w-full" viewBox="0 0 112 96" role="img" aria-label={`${formula.title} diagram`}>
              <path d="M 18 14 L 18 82 L 94 82 Z" fill={areaFill}></path>

              <line
                x1="18"
                y1="14"
                x2="18"
                y2="82"
                stroke={strokeForSide('a', diagram.inputSides, diagram.outputFeature)}
                stroke-width={strokeWidthForSide('a', diagram.inputSides, diagram.outputFeature)}
                stroke-linecap="round"
              ></line>
              <line
                x1="18"
                y1="82"
                x2="94"
                y2="82"
                stroke={strokeForSide('b', diagram.inputSides, diagram.outputFeature)}
                stroke-width={strokeWidthForSide('b', diagram.inputSides, diagram.outputFeature)}
                stroke-linecap="round"
              ></line>
              <line
                x1="18"
                y1="14"
                x2="94"
                y2="82"
                stroke={strokeForSide('c', diagram.inputSides, diagram.outputFeature)}
                stroke-width={strokeWidthForSide('c', diagram.inputSides, diagram.outputFeature)}
                stroke-linecap="round"
              ></line>

              <path d="M 18 82 L 29 82 L 29 71" fill="none" stroke="var(--color-outline)" stroke-width="1.6"></path>

              <path d="M 79 82 A 14 14 0 0 0 72 69" fill="none" stroke={angleStroke} stroke-width="2" stroke-linecap="round"></path>

              <line
                x1="18"
                y1="82"
                x2="52"
                y2="44"
                stroke="var(--color-primary)"
                stroke-width="2"
                stroke-dasharray="4 3"
                opacity={altitudeOpacity}
              ></line>

              <line
                x1="18"
                y1="14"
                x2="52"
                y2="44"
                stroke="var(--color-primary)"
                stroke-width="3"
                opacity={projectionPOpacity}
              ></line>
              <line
                x1="52"
                y1="44"
                x2="94"
                y2="82"
                stroke="var(--color-primary)"
                stroke-width="3"
                opacity={projectionQOpacity}
              ></line>

              <circle
                cx="39"
                cy="61"
                r="15"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="2"
                opacity={inradiusOpacity}
              ></circle>
              <circle
                cx="56"
                cy="48"
                r="47"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="1.8"
                stroke-dasharray="4 4"
                opacity={circumradiusOpacity}
              ></circle>

              <rect x="72" y="8" width="30" height="14" rx="4" fill="rgba(14, 14, 14, 0.72)" stroke="var(--color-outline-variant)"></rect>
              <text x="87" y="18" text-anchor="middle" fill="var(--color-primary)" font-size="9" font-family="var(--font-label)" font-weight="700">
                {outputGlyph}
              </text>
            </svg>
          </div>

          <div class="mt-3 space-y-2 text-[11px] text-on-surface-variant">
            <p>
              <span class="font-label uppercase tracking-[0.14em] text-outline">Inputs</span>
              <span class="ml-2">{formula.calculator.fields.map((field) => field.label).join(' + ')}</span>
            </p>
            <p>
              <span class="font-label uppercase tracking-[0.14em] text-outline">Output</span>
              <span class:list={['ml-2 rounded-md border px-2 py-0.5 font-medium', outputChipClass]}>{formula.calculator.outputLabel}</span>
            </p>
          </div>

          <p class="mt-3 rounded-lg border border-outline-variant/45 bg-surface px-3 py-2 font-mono text-[11px] text-primary">
            {formula.expression}
          </p>
        </a>
      );
    })}
  </div>
</section>
