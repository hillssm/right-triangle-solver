---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES
} from 'src/data/rightTriangleGroupedPages';
import { FOCUSED_SIDE_CALCULATOR_PAGES } from 'src/data/focusedSideCalculatorPages';
import { FOCUSED_MEASUREMENT_CALCULATOR_PAGES } from 'src/data/focusedMeasurementCalculatorPages';
import { FOCUSED_TRIG_RATIO_CALCULATOR_PAGES } from 'src/data/focusedTrigRatioCalculatorPages';
import { FOCUSED_ANGLE_CALCULATOR_PAGES } from 'src/data/focusedAngleCalculatorPages';
import { FOCUSED_ALTITUDE_CALCULATOR_PAGES } from 'src/data/focusedAltitudeCalculatorPages';
import { FOCUSED_PROJECTION_CALCULATOR_PAGES } from 'src/data/focusedProjectionCalculatorPages';
import { FOCUSED_RADIUS_CALCULATOR_PAGES } from 'src/data/focusedRadiusCalculatorPages';
import { FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES } from 'src/data/focusedSpecialTriangleCalculatorPages';
import { focusedTriplesCalculatorPages } from 'src/data/focusedTriplesCalculatorPages';
import { getFocusedTriplesHomeUi } from 'src/data/focusedTriplesCalculatorTranslations';
import { localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';

interface Props {
  locale: Locale;
  heading?: string;
  uiTools?: string;
}

const {
  locale,
  heading = 'Premium Calculator Collection',
  uiTools = 'Calculator Groups'
} = Astro.props;

const bundle = getTranslations(locale);
const content = (bundle.content as Record<string, any>) ?? {};
const grouped = (content.grouped as Record<string, any>) ?? {};
const groupedUi = (grouped.ui as Record<string, any>) ?? {};
const groupedHub = (grouped.hub as Record<string, any>) ?? {};
const groupedPages = (grouped.pages as Record<string, any>) ?? {};

const hubHref = localizePath(locale, RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url);
const hubTitle = pick(groupedHub, 'h1', RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1);
const openToolLabel = pick(groupedUi, 'openTool', 'Open Tool');
const triplesHomeUi = getFocusedTriplesHomeUi(locale);
const getLocalizedPageTitle = (slug: string, fallback: string) => {
  const localized = groupedPages[slug] as Record<string, unknown> | undefined;
  return pick(localized ?? {}, 'h1', fallback);
};
const CARD_ICONS = [
  'calculate',
  'square_foot',
  'functions',
  'angle',
  'timeline',
  'grid_on',
  'straighten',
  'schema',
  'radio_button_checked',
  'diamond'
];

const SUPPORT_TOOL_ICONS = ['format_list_numbered', 'looks_3', 'looks_5', 'compare_arrows'];
const SUPPORT_TOOL_PAGES = triplesHomeUi.tools.map((tool, index) => ({
  ...tool,
  icon: SUPPORT_TOOL_ICONS[index] ?? 'calculate'
}));

const totalToolCount = RIGHT_TRIANGLE_GROUPED_PAGES.length + SUPPORT_TOOL_PAGES.length;

const allCalculatorPages = [
  ...RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_SIDE_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_MEASUREMENT_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_TRIG_RATIO_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_ANGLE_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_ALTITUDE_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_PROJECTION_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_RADIUS_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...FOCUSED_SPECIAL_TRIANGLE_CALCULATOR_PAGES.map((page) => ({ url: page.url, title: page.h1 })),
  ...focusedTriplesCalculatorPages.map((page) => ({ url: page.url, title: page.h1 }))
].sort((a, b) => a.title.localeCompare(b.title));
---

<section class="section-shell" aria-labelledby="calculator-catalog-heading">
  <div class="flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/12 text-primary">
      <span class="material-symbols-outlined text-xl">grid_view</span>
    </div>
    <h2 id="calculator-catalog-heading" class="text-2xl sm:text-3xl">{heading}</h2>
  </div>
  <p class="mt-3 max-w-2xl text-sm text-on-surface-variant">
    {totalToolCount} {uiTools}
  </p>

  <div class="mt-6">
    <h3 class="font-label text-xs uppercase tracking-[0.2em] text-outline">
      {triplesHomeUi.coreHeading}
    </h3>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {RIGHT_TRIANGLE_GROUPED_PAGES.map((page, index) => (
        <a
          href={localizePath(locale, page.url)}
          class="group relative flex h-full min-h-[190px] flex-col justify-between overflow-hidden rounded-2xl border border-primary/20 bg-surface-container-lowest/80 p-6 shadow-[inset_0_1px_0_rgba(241,201,125,0.10)] transition-all duration-500 hover:-translate-y-1.5 hover:border-primary/55 hover:shadow-[0_24px_48px_-24px_rgba(241,201,125,0.45)]"
        >
          <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,rgba(241,201,125,0.12),transparent_45%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          <div>
            <div class="flex items-center justify-between">
              <span class="font-label text-[10px] uppercase tracking-[0.22em] text-primary/70">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-primary/40 bg-primary/12 text-primary shadow-[0_0_18px_-6px_rgba(241,201,125,0.55)] transition-transform duration-500 group-hover:scale-110">
                <span class="material-symbols-outlined text-[16px]">{CARD_ICONS[index] ?? 'calculate'}</span>
              </span>
            </div>
            <h3 class="mt-4 text-[15px] font-semibold leading-snug text-on-surface group-hover:text-primary">
              {getLocalizedPageTitle(page.slug, page.h1)}
            </h3>
          </div>
          <p class="relative z-10 mt-5 text-[10px] uppercase tracking-[0.2em] text-primary">{openToolLabel}</p>
        </a>
      ))}
    </div>

    <div class="mt-10 border-t border-outline-variant/30 pt-8">
      <h3 class="font-label text-xs uppercase tracking-[0.2em] text-outline">
        {triplesHomeUi.supportHeading}
      </h3>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {SUPPORT_TOOL_PAGES.map((page, index) => (
          <a
            href={localizePath(locale, page.href)}
            class="group relative flex h-full min-h-[190px] flex-col justify-between overflow-hidden rounded-2xl border border-primary/20 bg-surface-container-lowest/80 p-6 shadow-[inset_0_1px_0_rgba(241,201,125,0.10)] transition-all duration-500 hover:-translate-y-1.5 hover:border-primary/55 hover:shadow-[0_24px_48px_-24px_rgba(241,201,125,0.45)]"
          >
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,rgba(241,201,125,0.12),transparent_45%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
              <div>
              <div class="flex items-center justify-between">
                <span class="font-label text-[10px] uppercase tracking-[0.22em] text-primary/70">
                  {String(RIGHT_TRIANGLE_GROUPED_PAGES.length + index + 1).padStart(2, '0')}
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-primary/40 bg-primary/12 text-primary shadow-[0_0_18px_-6px_rgba(241,201,125,0.55)] transition-transform duration-500 group-hover:scale-110">
                  <span class="material-symbols-outlined text-[16px]">{page.icon}</span>
                </span>
              </div>
              <h3 class="mt-4 text-[15px] font-semibold leading-snug text-on-surface group-hover:text-primary">
                {page.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
                {page.description}
              </p>
            </div>
            <p class="relative z-10 mt-5 text-[10px] uppercase tracking-[0.2em] text-primary">{openToolLabel}</p>
          </a>
        ))}
      </div>
    </div>
    <div class="mt-10 border-t border-outline-variant/30 pt-8">
      <h3 class="font-label text-xs uppercase tracking-[0.2em] text-outline">
        All Calculators A to Z
      </h3>

      <ul class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        {allCalculatorPages.map((page) => (
          <li>
            <a
              href={localizePath(locale, page.url)}
              class="text-sm text-primary hover:underline"
            >
              {page.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-8 flex justify-center">
      <a href={hubHref} class="btn-secondary flex items-center gap-2">
        {openToolLabel} {hubTitle}
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
