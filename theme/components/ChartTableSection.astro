---
interface ChartRow {
  label: string;
  value: string;
  ratio: number;
}

interface Props {
  heading: string;
  rows: ChartRow[];
}

const { heading, rows } = Astro.props;
const maxRatio = Math.max(...rows.map((row) => row.ratio), 1);
---

<section class="section-shell" aria-labelledby="chart-table-heading">
  <h2 id="chart-table-heading" class="text-2xl font-bold sm:text-3xl">{heading}</h2>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <div class="overflow-hidden rounded-xl border border-slate-200">
      <table class="w-full border-collapse text-left text-sm">
        <thead class="bg-cyan-50 text-slate-700">
          <tr>
            <th class="px-4 py-3 font-semibold">Example</th>
            <th class="px-4 py-3 font-semibold">Computed Hypotenuse</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-slate-200">
              <td class="px-4 py-3 text-slate-700">{row.label}</td>
              <td class="px-4 py-3 font-mono text-slate-900">{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="surface-card space-y-4">
      {rows.map((row) => (
        <div>
          <div class="mb-1 flex items-center justify-between text-xs text-slate-600">
            <span>{row.label}</span>
            <span class="font-mono">{row.value}</span>
          </div>
          <div class="h-2 rounded-full bg-slate-100">
            <div
              class="h-2 rounded-full bg-gradient-to-r from-cyan-600 to-amber-500"
              style={`width: ${(row.ratio / maxRatio) * 100}%`}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
