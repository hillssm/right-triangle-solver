---
interface ChartRow {
  label: string;
  value: string;
  ratio: number;
}

interface Props {
  heading: string;
  rows: ChartRow[];
}

const { heading, rows } = Astro.props;
const maxRatio = Math.max(...rows.map((row) => row.ratio), 1);
---

<section class="section-shell" aria-labelledby="chart-table-heading">
  <div class="flex items-center gap-3 mb-2">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
      <span class="material-symbols-outlined text-xl text-primary">bar_chart</span>
    </div>
    <h2 id="chart-table-heading" class="text-2xl font-headline sm:text-3xl">{heading}</h2>
  </div>
  <p class="text-sm text-slate-400 mb-6">Visual comparison of common right triangle configurations.</p>

  <div class="mt-4 grid gap-6 lg:grid-cols-2">
    <!-- Table -->
    <div class="overflow-hidden rounded-xl border border-outline-variant/15 shadow-sm">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="bg-surface-container-high/50">
            <th class="px-5 py-3.5 font-label text-[10px] font-semibold uppercase tracking-widest text-slate-400">Example</th>
            <th class="px-5 py-3.5 font-label text-[10px] font-semibold uppercase tracking-widest text-slate-400">Computed Hypotenuse</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class="group border-t border-outline-variant/10 transition-colors hover:bg-surface-container-high/20">
              <td class="px-5 py-3 text-slate-300">{row.label}</td>
              <td class="px-5 py-3 font-mono text-primary">{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Bar chart -->
    <div class="surface-card space-y-5">
      {rows.map((row) => (
        <div class="group">
          <div class="mb-2 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-medium">{row.label}</span>
            <span class="font-mono text-primary">{row.value}</span>
          </div>
          <div class="h-2.5 rounded-full bg-surface-container-highest/40 overflow-hidden">
            <div
              class="h-2.5 rounded-full transition-all duration-1000 ease-out group-hover:brightness-125"
              style={`width: ${(row.ratio / maxRatio) * 100}%; background: linear-gradient(90deg, #00daf3 0%, #00bcd2 60%, #7ed1f7 100%);`}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
