---
interface ChartRow {
  label: string;
  value: string;
  ratio: number;
  href?: string;
}

interface Props {
  heading: string;
  subHeading?: string;
  label1?: string;
  label2?: string;
  rows: ChartRow[];
}

const {
  heading,
  rows,
  subHeading = 'Compare common right-triangle families and their hypotenuse values.',
  label1 = 'Triangle',
  label2 = 'Hypotenuse'
} = Astro.props;
const maxRatio = Math.max(...rows.map((row) => row.ratio), 1);
---

<section class="section-shell" aria-labelledby="chart-table-heading">
  <div class="flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/12 text-primary">
      <span class="material-symbols-outlined text-xl">bar_chart</span>
    </div>
    <h2 id="chart-table-heading" class="text-2xl sm:text-3xl">{heading}</h2>
  </div>
  <p class="mt-3 max-w-2xl text-sm text-on-surface-variant">
    {subHeading}
  </p>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <div class="overflow-hidden rounded-2xl border border-outline-variant/45 bg-surface-container-lowest/70">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-outline-variant/35 bg-surface-container-high/50">
            <th class="px-5 py-3 font-label text-[10px] uppercase tracking-[0.2em] text-outline">{label1}</th>
            <th class="px-5 py-3 font-label text-[10px] uppercase tracking-[0.2em] text-outline">{label2}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-outline-variant/20 last:border-b-0">
              <td class="px-5 py-3 text-on-surface-variant">
                {row.href ? (
                  <a href={row.href} class="font-medium text-on-surface-variant transition-colors hover:text-primary">
                    {row.label}
                  </a>
                ) : (
                  row.label
                )}
              </td>
              <td class="px-5 py-3 font-mono text-primary">{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="surface-card space-y-5">
      {rows.map((row) => (
        <div class="group">
          <div class="mb-2 flex items-center justify-between text-xs">
            {row.href ? (
              <a href={row.href} class="font-medium text-on-surface-variant transition-colors hover:text-primary">
                {row.label}
              </a>
            ) : (
              <span class="font-medium text-on-surface-variant">{row.label}</span>
            )}
            <span class="font-mono text-primary">{row.value}</span>
          </div>
          <div class="h-2.5 overflow-hidden rounded-full bg-surface-container-highest/50">
            <div
              class="h-2.5 rounded-full transition-all duration-1000 ease-out group-hover:brightness-125"
              style={`width: ${(row.ratio / maxRatio) * 100}%; background: linear-gradient(90deg, #f1c97d 0%, #d4ad65 55%, #b58c45 100%);`}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
