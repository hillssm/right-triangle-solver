---
import { site } from 'theme/utils/site';

interface Labels {
  name: string;
  email: string;
  message: string;
  send: string;
  sending: string;
  success: string;
  apiError: string;
  networkError: string;
  fallbackEmail: string;
}

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
const endpoint = site.contact.formEndpoint;
const fallbackEmail = site.contactEmail;
const accessKey =
  import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? site.contact.formAccessKey ?? '';
---

<section class="section-shell" aria-labelledby="contact-form-heading">
  <div class="flex items-center gap-3 mb-2">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
      <span class="material-symbols-outlined text-xl text-primary">mail</span>
    </div>
    <h2 id="contact-form-heading" class="text-xl font-headline">Contact Form</h2>
  </div>
  <p class="mb-6 text-sm text-on-surface-variant">Fill in the fields below and we'll get back to you promptly.</p>

  <form
    class="mt-4 grid gap-5"
    data-contact-form
    data-endpoint={endpoint}
    data-access-key={accessKey}
    data-sending-label={labels.sending}
    data-success-label={labels.success}
    data-api-error-label={labels.apiError}
    data-network-error-label={labels.networkError}
  >
    <label class="grid gap-2.5 text-sm">
      <span class="flex items-center gap-2 font-label text-xs uppercase tracking-widest text-outline">
        <span class="material-symbols-outlined text-sm text-primary/60">person</span>
        {labels.name}
      </span>
      <input class="input-shell" type="text" name="name" required autocomplete="name" placeholder="Your full name" />
    </label>

    <label class="grid gap-2.5 text-sm">
      <span class="flex items-center gap-2 font-label text-xs uppercase tracking-widest text-outline">
        <span class="material-symbols-outlined text-sm text-primary/60">alternate_email</span>
        {labels.email}
      </span>
      <input class="input-shell" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>

    <label class="grid gap-2.5 text-sm">
      <span class="flex items-center gap-2 font-label text-xs uppercase tracking-widest text-outline">
        <span class="material-symbols-outlined text-sm text-primary/60">chat</span>
        {labels.message}
      </span>
      <textarea class="input-shell min-h-36 resize-y" name="message" required placeholder="Describe your question or feedback..."></textarea>
    </label>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <button class="btn-primary gap-2" type="submit" data-submit-button>
        <span class="material-symbols-outlined text-base">send</span>
        {labels.send}
      </button>
      <p class="text-xs text-on-surface-variant">
        {labels.fallbackEmail} <a href={`mailto:${fallbackEmail}`} class="text-primary underline decoration-primary/30 underline-offset-2 transition-colors hover:text-primary-container">{fallbackEmail}</a>
      </p>
    </div>

    <div class="flex items-center gap-2 text-sm text-on-surface-variant" role="status" aria-live="polite" data-contact-status>
    </div>
  </form>

  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      if (!currentScript) return;

      const section = currentScript.closest('section');
      if (!section) return;

      const form = section.querySelector('[data-contact-form]');
      const statusEl = section.querySelector('[data-contact-status]');
      const submitButton = section.querySelector('[data-submit-button]');

      if (!form || !statusEl || !submitButton) {
        return;
      }

      const endpoint = form.getAttribute('data-endpoint') || '';
      const accessKey = form.getAttribute('data-access-key') || '';

      const setSubmitting = (sending) => {
        submitButton.disabled = sending;
        if (sending) {
          submitButton.style.opacity = '0.7';
          submitButton.style.pointerEvents = 'none';
        } else {
          submitButton.style.opacity = '1';
          submitButton.style.pointerEvents = 'auto';
        }
      };

      const showStatus = (message, isError) => {
        const icon = isError ? 'error' : 'check_circle';
        const color = isError ? 'text-error' : 'text-secondary-container';
        statusEl.innerHTML = `<span class="material-symbols-outlined text-base ${color}" style="font-variation-settings: 'FILL' 1;">${icon}</span><span>${message}</span>`;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!accessKey) {
          showStatus('Form configuration is missing. Please use direct email for now.', true);
          return;
        }

        const formData = new FormData(form);
        formData.append('access_key', accessKey);

        setSubmitting(true);
        statusEl.innerHTML = `<span class="material-symbols-outlined text-base text-primary animate-spin">progress_activity</span><span>${(form.dataset.sendingLabel || '').trim() || 'Sending...'}</span>`;

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData
          });

          const payload = await response.json();

          if (response.ok && payload.success) {
            showStatus(form.dataset.successLabel || 'Message sent successfully. Thank you!', false);
            form.reset();
          } else {
            showStatus(
              payload.message ||
              form.dataset.apiErrorLabel ||
              'We could not send your message. Please try again.',
              true
            );
          }
        } catch {
          showStatus(
            form.dataset.networkErrorLabel ||
            'Network error. Please check your connection and retry.',
            true
          );
        } finally {
          setSubmitting(false);
        }
      });
    })();
  </script>
</section>
