---
import type { FaqItem } from 'theme/i18n/translations';

interface Props {
  heading: string;
  items: FaqItem[];
  description?: string;
}

const {
  heading,
  items,
  description = 'Answers to the most common right-triangle solving questions.'
} = Astro.props;
const visibleItems = items.filter((item) => item.display !== false);
---

<section id="faq" class="section-shell" aria-labelledby="faq-heading">
  <div class="flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/12 text-primary">
      <span class="material-symbols-outlined text-xl">quiz</span>
    </div>
    <h2 id="faq-heading" class="text-2xl sm:text-3xl">{heading}</h2>
  </div>
  <p class="mt-3 max-w-2xl text-sm text-on-surface-variant">
    {description}
  </p>

  <div class="mt-6 grid gap-3 anim-stagger">
    {visibleItems.map((item, index) => (
      <details class="group overflow-hidden rounded-xl border border-outline-variant/20 bg-surface-container-lowest/55 transition-all duration-300 hover:border-primary/30" name="faq-item">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-on-surface">
          <span class="flex items-center gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary/12 font-label text-[10px] uppercase tracking-[0.14em] text-primary">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item.question}
          </span>
          <span class="material-symbols-outlined text-lg text-outline transition-transform duration-300 group-open:rotate-180">
            expand_more
          </span>
        </summary>
        <div class="border-t border-outline-variant/15 px-5 py-4">
          <p class="pl-10 text-sm leading-relaxed text-on-surface-variant">{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
