---
import type { FaqItem } from 'theme/i18n/translations';

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
const visibleItems = items.filter((item) => item.display !== false);
---

<section id="faq" class="section-shell" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-bold sm:text-3xl">{heading}</h2>
  <div class="mt-6 grid gap-3">
    {visibleItems.map((item, index) => (
      <details class="rounded-xl border border-slate-200 bg-white p-4" name="faq-item">
        <summary class="cursor-pointer list-none pr-7 text-sm font-semibold text-slate-900">
          {item.question}
          <span class="sr-only">FAQ item {index + 1}</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
