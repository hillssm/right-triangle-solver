        <tr><td class="border-gray-600 px-4 py-2">Longer leg b</td><td class="border-gray-600 px-4 py-2">12</td><td class="border-gray-600 px-4 py-2">Opposite the 67.38° angle</td></tr>
        <tr><td class="border-gray-600 px-4 py-2">Hypotenuse c</td><td class="border-gray-600 px-4 py-2">13</td><td class="border-gray-600 px-4 py-2">Opposite the 90° angle</td></tr>
