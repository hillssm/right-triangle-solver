---
import SocialIcon from 'theme/components/SocialIcon.astro';
import { localizePath, SUPPORTED_LOCALES, LOCALE_LABELS, type Locale } from 'theme/i18n/locales';
import { getEnabledSocialLinks, getLocalizedNavItems } from 'theme/utils/site';

interface Props {
  locale: Locale;
  siteTitle: string;
  logo: string;
  description: string;
  navLabels: Record<string, string>;
  commonLabels: Record<string, string>;
}

const { locale, siteTitle, logo, description, navLabels, commonLabels } = Astro.props;

const footerNav = getLocalizedNavItems(locale, 'footer', navLabels);
const socialLinks = getEnabledSocialLinks();
const year = new Date().getFullYear();
const rights = commonLabels.rights ?? 'All rights reserved.';
const homeHref = localizePath(locale, '/');
---

<footer class="relative mt-16 overflow-hidden border-t border-outline-variant/65 bg-surface pb-12">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
  <div class="pointer-events-none absolute -right-20 -top-24 h-56 w-56 rounded-full bg-primary/12 blur-3xl"></div>

  <div class="relative mx-auto grid w-full max-w-[1200px] gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:px-8">
    <div class="space-y-5">
      <a href={homeHref} class="group inline-flex items-center gap-3 text-on-surface transition-colors hover:text-primary">
        <div class="flex h-10 w-10 items-center justify-center rounded-md border border-outline-variant/70 bg-surface-container-low shadow-[0_14px_28px_-22px_rgba(241,201,125,0.35)] transition-transform duration-300 group-hover:scale-105">
          <img src={logo} alt={`${siteTitle} logo`} class="h-5 w-auto" loading="lazy" />
        </div>
        <span class="font-headline text-base font-medium tracking-[-0.02em]">{siteTitle}</span>
      </a>
      <p class="max-w-xl text-sm leading-relaxed text-on-surface-variant text-balance">{description}</p>

      {socialLinks.length > 0 && (
        <div class="flex items-center gap-3 pt-2" aria-label="Social links">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-outline-variant/60 bg-surface-container-low text-on-surface-variant transition-all duration-200 hover:border-primary/35 hover:bg-primary/10 hover:text-primary hover:shadow-[var(--shadow-glow-primary)]"
              rel="noreferrer"
              target="_blank"
              aria-label={item.name}
            >
              <SocialIcon network={item.name as 'facebook' | 'twitter' | 'linkedin' | 'pinterest' | 'instagram' | 'youtube' | 'bluesky'} />
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h3 class="font-label text-xs font-bold uppercase tracking-widest text-on-surface mb-6 opacity-80 decoration-primary/30 decoration-2 underline-offset-8">Sections</h3>
        <nav aria-label="Footer navigation" class="grid gap-4 text-sm">
          {footerNav.map((item) => (
            <a
              href={item.href}
              class="rounded-none text-[11px] uppercase tracking-[0.16em] text-on-surface-variant transition-all duration-200 hover:text-primary hover:translate-x-1 font-label"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <div>
        <h3 class="font-headline text-lg font-bold uppercase tracking-tight text-on-surface mb-6">Languages</h3>
        <div class="grid grid-cols-4 gap-2 sm:gap-3">
          {SUPPORTED_LOCALES.map((l) => (
            <a
              href={localizePath(l, '/')}
              class:list={[
                "flex items-center justify-center rounded-xl border border-outline-variant/80 py-2.5 text-xs font-bold uppercase tracking-widest transition-all",
                l === locale 
                  ? "bg-primary/10 border-primary text-primary shadow-sm" 
                  : "bg-surface-container-low text-on-surface-variant hover:border-primary/40 hover:bg-surface-container-high hover:text-primary"
              ]}
              lang={l}
              title={LOCALE_LABELS[l]}
            >
              {l}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="relative border-t border-outline-variant/50 px-4 py-8 text-center text-xs text-outline sm:px-6 lg:px-8">
    <p>&copy; {year} {siteTitle}. {rights}</p>
  </div>
</footer>
