  data-messages={calculatorMessages}
>
  <h2 class="break-words text-2xl font-semibold leading-tight">{calculatorHeading}</h2>
  <p class="mt-2 text-sm text-on-surface-variant">
    {(() => {
      const text = pick(solver, 'calculatorIntro', `This calculator finds {label} using {expression}.`).replace('{label}', widgetOutputLabel);
      if (text.includes('{expression}')) {
        const parts = text.split('{expression}');
        return (
          <Fragment>
            {parts[0]}
            {plainExpression ? (
              <span class="math-textbook text-tertiary" dir="ltr">{plainExpression}</span>
            ) : (
              <span class="math-textbook text-tertiary" set:html={katex.renderToString(formula.expression, { throwOnError: false })} />
            )}
            {parts[1]}
          </Fragment>
        );
      }
      return text;
    })()}
  </p>

  <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-start">
    <div class="min-w-0 flex-1 w-full space-y-4">
      <form class="grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" data-calc-form>
        {calculator.fields.map((field) => (
          <label class="grid min-w-0 gap-2 text-sm font-medium">
            <span>{widgetFieldLabels[field.key] || field.label}</span>
            <div class="relative flex min-w-0 w-full">
              <input
                class={`input-shell min-w-0 w-0 flex-1 basis-0 ${LENGTH_KEYS.includes(field.key) ? 'rounded-r-none border-r-0' : 'pr-16'}`}
                type="number"
                step="any"
                min={field.min ?? 0}
                max={(field.key === 'A' || field.key === 'B') ? 90 : field.max}
                name={field.key}
                placeholder={field.placeholder}
                required={calculator.kind === 'general_solver' ? undefined : true}
              />
              {LENGTH_KEYS.includes(field.key) ? (
                <select name={`${field.key}_unit`} class="shrink-0 bg-surface-container border border-primary/50 rounded-r-lg px-1.5 sm:px-2 text-[10px] sm:text-[11px] focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary w-20 sm:w-24 text-on-surface-variant truncate">
                  {COMMON_UNIT_LIST.map(u => (
                    <option value={u.val}>({u.val}) {u.label}</option>
                  ))}
                  <optgroup label={moreUnitsLabel}>
                    {ADVANCED_UNIT_LIST.map(u => (
                      <option value={u.val}>({u.val}) {u.label}</option>
                    ))}
                  </optgroup>
                </select>
              ) : field.unit ? (
                <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs text-on-surface-variant">
                  {field.unit}
                </span>
              ) : null}
            </div>
            <p class="hidden text-xs text-error mt-0.5" data-calc-input-error={field.key}></p>
          </label>
        ))}

        <div class="sm:col-span-2 lg:col-span-1 xl:col-span-2 flex flex-wrap gap-3">
          <button type="submit" class="btn-primary">{pick(solver, 'calculate', 'Calculate')} {widgetOutputLabel}</button>
          <button type="reset" class="btn-secondary">{pick(solver, 'reset', 'Reset')}</button>
        </div>
      </form>

      <p class="text-sm text-on-surface-variant" data-calc-status role="status" aria-live="polite">
        {defaultStatus}
      </p>

      <div class="hidden surface-card scroll-mt-24 border-primary/30 bg-surface-container-high" data-calc-result-wrap>
        <div class="flex items-center justify-between">
          <p class="font-label text-xs uppercase tracking-widest text-primary" data-calc-output-label>
            {widgetOutputLabel}
          </p>
          <span class="rounded bg-primary-fixed px-2 py-0.5 text-[10px] uppercase text-on-primary-fixed">{pick(solver, 'resultLabel', 'Result')}</span>
        </div>
        <p class="mt-2 font-mono text-3xl text-tertiary math-textbook" data-calc-output-value>-</p>

        
        <div class="mt-6 border-t border-outline-variant/30 pt-4">
          <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{pick(solver, 'solutionSteps', 'Solution Steps')}</h4>
          <ol class="mt-3 space-y-3" data-calc-steps></ol>
        </div>

        <p class="mt-4 text-xs italic text-on-surface-variant flex items-center gap-2">
          <span>{pick(solver, 'formulaLabel', 'Formula')}:</span>
          {plainExpression ? (
            <span class="math-textbook" dir="ltr">{plainExpression}</span>
          ) : (
            <span class="math-textbook" set:html={katex.renderToString(formula.expression, { throwOnError: false })} />
          )}
        </p>
      </div>
    </div>

    <div class="flex-1 w-full relative z-10 overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-container-lowest/70 p-4 sm:p-6 shadow-sm hidden sm:block">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
      <div class="mb-2">
        <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{pick(solver, 'liveVisualization', 'Live Visualization')}</p>
        <h3 class="mt-1 text-lg text-on-surface">{formulaDiagramHeading}</h3>
      </div>
      <svg class="relative h-auto w-full max-w-sm mx-auto" viewBox="0 0 460 300" aria-label="Dynamic right triangle">
        <defs>
          <linearGradient id="rt-fill-gradient2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f1c97d" stop-opacity="0.3"></stop>
            <stop offset="100%" stop-color="#d4ad65" stop-opacity="0.12"></stop>
          </linearGradient>
        </defs>
        <path d="M 60 240 L 80 240 L 80 260" fill="none" stroke="#99907c" stroke-width="1.5" data-calc-svg-path-stroke></path>
        <path d="M 70 70 L 70 260 L 380 260 Z" fill="url(#rt-fill-gradient2)" stroke="#f1c97d" stroke-width="2.5" stroke-linejoin="round" data-calc-svg-path-fill></path>
        <line x1="70" y1="260" x2="196" y2="184" stroke="#f1c97d" stroke-width="2" stroke-dasharray="5 4" opacity="0.6" data-calc-svg-altitude></line>
        <text x="50" y="170" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="14" text-anchor="end" data-calc-svg-label="a">a = input</text>
        <text x="226" y="284" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="14" text-anchor="middle" data-calc-svg-label="b">b = input</text>
        <text x="246" y="152" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="15" text-anchor="start" data-calc-svg-label="c">c = result</text>
        <text x="316" y="248" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="12" text-anchor="end" data-calc-svg-label="A">A = &#8212;</text>
        <text x="88" y="94" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="12" text-anchor="start" data-calc-svg-label="B">B = &#8212;</text>
        <text x="146" y="210" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="13" text-anchor="end" data-calc-svg-label="h">h = &#8212;</text>
      </svg>
    </div>
  </div>

  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      if (!currentScript) return;

      const section = currentScript.closest('[data-formula-calculator]');
      if (!section) return;

      const translations = JSON.parse(section.getAttribute('data-translations') || '{}');
      const messages = JSON.parse(section.getAttribute('data-messages') || '{}');
      const angleRangeMessage =
        messages.angleRange || 'Angle must be greater than 0\u00B0 and less than 90\u00B0.';
      const form = section.querySelector('[data-calc-form]');
      const statusEl = section.querySelector('[data-calc-status]');
      const resultWrap = section.querySelector('[data-calc-result-wrap]');
      const labelEl = section.querySelector('[data-calc-output-label]');
      const valueEl = section.querySelector('[data-calc-output-value]');
      const stepsEl = section.querySelector('[data-calc-steps]');
      const kind = section.getAttribute('data-kind') ?? '';
      const outputLabel = section.getAttribute('data-output-label') ?? 'Result';
      const outputUnit = section.getAttribute('data-output-unit') ?? '';
      const defaultStatus =
        section.getAttribute('data-default-status') ?? 'Fill values and click calculate.';

      if (!form || !statusEl || !resultWrap || !labelEl || !valueEl || !stepsEl) return;

      const UNIT_SCALE = {
        m: 1, nm: 1e-9, um: 1e-6, mm: 1e-3, cm: 1e-2, km: 1e3,
        in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344, nmi: 1852,
        ang: 1e-10, mil: 0.0000254, pixel: 0.0002645833, pt: 0.0003527778,
        survey_ft: 0.3048006096, fathom: 1.8288, au: 149597870700,
        ls: 299792458, lm: 17987547480, lh: 1079252848800,
        ld: 25902068371200, ly: 9460730472580800, kly: 9460730472580800000,
        pc: 3.085677581e16, mpc: 3.085677581e22
      };
      const LENGTH_KEYS = ['a', 'b', 'c', 'p', 'q', 'h', 'r', 's', 'R'];

      const toNumber = (value) => Number.parseFloat(String(value));
      const deg = (r) => (r * 180) / Math.PI;
      const rad = (d) => (d * Math.PI) / 180;
      const format = (n, digits = 4) => Number(n).toFixed(digits).replace(/\.?0+$/, '');

      const parseInputs = () => {
        const data = new FormData(form);
        const values = {};
        const units = {};
        for (const [key, val] of data.entries()) {
          if (key.endsWith('_unit')) {
            units[key.replace('_unit', '')] = val;
          } else {
            // Empty fields mean "not provided" (the general solver accepts
            // any two values); skip them instead of failing the parse.
            if (String(val).trim() === '') continue;
            const num = toNumber(val);
            if (!Number.isFinite(num)) {
              throw new Error(messages.invalid || translations.unableToCalculate || '');
            }
            values[key] = num;
          }
        }

        let primaryUnit = null;
        for (const k of LENGTH_KEYS) {
          if (units[k]) {
            primaryUnit = units[k];
            break;
          }
        }

        if (primaryUnit) {
          for (const k of LENGTH_KEYS) {
            if (values[k] !== undefined && units[k]) {
              const scale = UNIT_SCALE[units[k]] / UNIT_SCALE[primaryUnit];
              values[k] = values[k] * scale;
            }
          }
        }

        return { values, primaryUnit };
      };

      const requirePositive = (...nums) => {
        if (nums.some((n) => !(n > 0))) {
          throw new Error(messages.positive || translations.unableToCalculate || '');
        }
      };

      const requireAcuteAngle = (angle) => {
        if (!(angle > 0 && angle < 90)) {
          throw new Error(messages.acuteAngle || 'Angle must be between 0 and 90 degrees.');
        }
      };

      const requireRightTriangle = (a, b, c) => {
        const sides = [a, b, c].sort((x, y) => x - y);
        const gap = Math.abs(sides[0] * sides[0] + sides[1] * sides[1] - sides[2] * sides[2]);
        const scale = Math.max(sides[2] * sides[2], 1);
        if (gap > 1e-8 * scale) {
          throw new Error(messages.invalidTriangle || messages.invalid || translations.unableToCalculate || '');
        }
      };

      const buildCalculationStep = (
        stepKey,
        fallbackTitle,
        fallbackDescription,
        formulaLine,
        substitutionLine
      ) => {
        const stepCopy = translations.calculationSteps?.[stepKey] || {};
        const title = stepCopy.title || fallbackTitle;
        const description = stepCopy.description || fallbackDescription;
        return `**${title}**<br/>${description}<br/>${formulaLine}<br/>${substitutionLine}`;
      };

      const buildSpecialTriangleStep = (stepKey, fallbackStep, formulaLine, substitutionLine) => {
        const stepCopy = translations.specialTriangleSteps?.[stepKey];

        if (!stepCopy) {
          return fallbackStep;
        }

        const title = stepCopy.title || outputLabel;
        const formulaLabel = translations.formula || translations.stepLabels?.formula || 'Formula';

        return `**${title}**<br/>${formulaLabel}: ${formulaLine}<br/>${substitutionLine}`;
      };

      const solve = (v) => {
        switch (kind) {
          case 'pythagorean_c': {
            requirePositive(v.a, v.b);
            const r = Math.hypot(v.a, v.b);
            return {
              result: r,
              steps: [
                `**Solve for Hypotenuse c**<br/>The longest side is found by summing the squares of both legs.<br/>Use c = \u221A(a^2 + b^2)<br/>c = \u221A(${v.a}^2 + ${v.b}^2) = \u221A(${format(v.a ** 2)} + ${format(v.b ** 2)}) = ${format(r)}`
              ]
            };
          }
          case 'leg_from_ac': {
            requirePositive(v.a, v.c);
            if (v.c <= v.a) throw new Error(messages.hypotenuseKnownLeg || translations.unableToCalculate || '');
            const r = Math.sqrt(v.c * v.c - v.a * v.a);
            return {
              result: r,
              steps: [
                `**Solve for Leg b**<br/>Subtract the leg's square from the hypotenuse's square.<br/>Use b = \u221A(c^2 - a^2)<br/>b = \u221A(${v.c}^2 - ${v.a}^2) = \u221A(${format(v.c ** 2)} - ${format(v.a ** 2)}) = ${format(r)}`
              ]
            };
          }
          case 'leg_from_bc': {
            requirePositive(v.b, v.c);
            if (v.c <= v.b) throw new Error(messages.hypotenuseKnownLeg || translations.unableToCalculate || '');
            const r = Math.sqrt(v.c * v.c - v.b * v.b);
            return {
              result: r,
              steps: [
                `**Solve for Leg a**<br/>Derive the leg by subtracting squares from the hypotenuse.<br/>Use a = \u221A(c^2 - b^2)<br/>a = \u221A(${v.c}^2 - ${v.b}^2) = \u221A(${format(v.c ** 2)} - ${format(v.b ** 2)}) = ${format(r)}`
              ]
            };
          }
          case 'area_legs': {
            requirePositive(v.a, v.b);
            const r = (v.a * v.b) / 2;
            return {
              result: r,
              steps: [
                `**Calculate Area**<br/>Multiply base and height, then divide by two for the inner space.<br/>Use Area = (a \u00D7 b) / 2<br/>Area = (${v.a} \u00D7 ${v.b}) / 2 = ${format(v.a * v.b)} / 2 = ${format(r)}`
              ]
            };
          }
          case 'general_solver': {
            const toRad = (d) => d * Math.PI / 180;
            const toDeg = (r) => r * 180 / Math.PI;
            const has = (x) => x !== undefined && x !== null && !isNaN(x) && x !== '';
            const a = has(v.a) ? Number(v.a) : null;
            const b = has(v.b) ? Number(v.b) : null;
            const c = has(v.c) ? Number(v.c) : null;
            const A = has(v.A) ? Number(v.A) : null;
            const B = has(v.B) ? Number(v.B) : null;
            const known = [a, b, c, A, B].filter(x => x !== null).length;
            if (known < 2) throw new Error(messages.invalid || 'Enter any two values (at least one side).');
            const sides = [a, b, c].filter(x => x !== null).length;
            if (sides === 0) throw new Error(messages.invalid || 'At least one side length is required.');
            if (a !== null && a <= 0) throw new Error(messages.positive || 'Sides must be positive.');
            if (b !== null && b <= 0) throw new Error(messages.positive || 'Sides must be positive.');
            if (c !== null && c <= 0) throw new Error(messages.positive || 'Sides must be positive.');
            if (A !== null) requireAcuteAngle(A);
            if (B !== null) requireAcuteAngle(B);
            let ra = a, rb = b, rc = c, rA = A, rB = B;
            const steps = [];
            if (ra !== null && rb !== null) {
              rc = Math.sqrt(ra*ra + rb*rb);
              rA = toDeg(Math.atan2(ra, rb));
              rB = 90 - rA;
              steps.push(`c = \u221A(a\u00B2 + b\u00B2) = ${format(rc)}`, `A = atan(a/b) = ${format(rA)}\u00B0`, `B = 90\u00B0 - A = ${format(rB)}\u00B0`);
            } else if (ra !== null && rc !== null) {
              if (ra >= rc) throw new Error(messages.hypotenuseLongest || 'Hypotenuse c must be the longest side.');
              rb = Math.sqrt(rc*rc - ra*ra);
              rA = toDeg(Math.asin(ra/rc));
              rB = 90 - rA;
              steps.push(`b = \u221A(c\u00B2 - a\u00B2) = ${format(rb)}`, `A = asin(a/c) = ${format(rA)}\u00B0`, `B = 90\u00B0 - A = ${format(rB)}\u00B0`);
            } else if (rb !== null && rc !== null) {
              if (rb >= rc) throw new Error(messages.hypotenuseLongest || 'Hypotenuse c must be the longest side.');
              ra = Math.sqrt(rc*rc - rb*rb);
              rB = toDeg(Math.asin(rb/rc));
              rA = 90 - rB;
              steps.push(`a = \u221A(c\u00B2 - b\u00B2) = ${format(ra)}`, `B = asin(b/c) = ${format(rB)}\u00B0`, `A = 90\u00B0 - B = ${format(rA)}\u00B0`);
            } else if (ra !== null && rA !== null) {
              rc = ra / Math.sin(toRad(rA));
              rb = ra / Math.tan(toRad(rA));
              rB = 90 - rA;
              steps.push(`c = a/sin(A) = ${format(rc)}`, `b = a/tan(A) = ${format(rb)}`, `B = 90\u00B0 - A = ${format(rB)}\u00B0`);
            } else if (ra !== null && rB !== null) {
              rc = ra / Math.cos(toRad(rB));
              rb = ra * Math.tan(toRad(rB));
              rA = 90 - rB;
              steps.push(`c = a/cos(B) = ${format(rc)}`, `b = a\u00D7tan(B) = ${format(rb)}`, `A = 90\u00B0 - B = ${format(rA)}\u00B0`);
            } else if (rb !== null && rA !== null) {
              rc = rb / Math.cos(toRad(rA));
              ra = rb * Math.tan(toRad(rA));
              rB = 90 - rA;
              steps.push(`c = b/cos(A) = ${format(rc)}`, `a = b\u00D7tan(A) = ${format(ra)}`, `B = 90\u00B0 - A = ${format(rB)}\u00B0`);
            } else if (rb !== null && rB !== null) {
              rc = rb / Math.sin(toRad(rB));
              ra = rb / Math.tan(toRad(rB));
              rA = 90 - rB;
              steps.push(`c = b/sin(B) = ${format(rc)}`, `a = b/tan(B) = ${format(ra)}`, `A = 90\u00B0 - B = ${format(rA)}\u00B0`);
            } else if (rc !== null && rA !== null) {
              ra = rc * Math.sin(toRad(rA));
              rb = rc * Math.cos(toRad(rA));
              rB = 90 - rA;
              steps.push(`a = c\u00D7sin(A) = ${format(ra)}`, `b = c\u00D7cos(A) = ${format(rb)}`, `B = 90\u00B0 - A = ${format(rB)}\u00B0`);
            } else if (rc !== null && rB !== null) {
              rb = rc * Math.sin(toRad(rB));
              ra = rc * Math.cos(toRad(rB));
              rA = 90 - rB;
              steps.push(`b = c\u00D7sin(B) = ${format(rb)}`, `a = c\u00D7cos(B) = ${format(ra)}`, `A = 90\u00B0 - B = ${format(rA)}\u00B0`);
            }
            if (ra === null || rb === null || rc === null) throw new Error(messages.invalid || 'Could not solve with these inputs.');
            // Any additionally entered values must agree with the solved triangle
            // instead of being silently discarded.
            const relTol = 1e-3;
            const agrees = (entered, computed) => {
              if (entered === null || entered === undefined || computed === null || computed === undefined) return true;
              const denom = Math.max(Math.abs(entered), Math.abs(computed), 1e-12);
              return Math.abs(entered - computed) / denom <= relTol;
            };
            const inconsistentBase = messages.inconsistent || 'Inconsistent values:';
            if (!agrees(a, ra)) throw new Error(`${inconsistentBase} a = ${format(a)} conflicts with the solved triangle (a = ${format(ra)}).`);
            if (!agrees(b, rb)) throw new Error(`${inconsistentBase} b = ${format(b)} conflicts with the solved triangle (b = ${format(rb)}).`);
            if (!agrees(c, rc)) throw new Error(`${inconsistentBase} c = ${format(c)} conflicts with the solved triangle (c = ${format(rc)}).`);
            if (!agrees(A, rA)) throw new Error(`${inconsistentBase} A = ${format(A)}\u00B0 conflicts with the solved triangle (A = ${format(rA)}\u00B0).`);
            if (!agrees(B, rB)) throw new Error(`${inconsistentBase} B = ${format(B)}\u00B0 conflicts with the solved triangle (B = ${format(rB)}\u00B0).`);
            requireRightTriangle(ra, rb, rc);
            return {
              result: rc,
              steps: [`**Solve Right Triangle**<br/>${steps.join('<br/>')}<br/>a = ${format(ra)}, b = ${format(rb)}, c = ${format(rc)}, A = ${format(rA)}\u00B0, B = ${format(rB)}\u00B0`]
            };
          }
          case 'perimeter': {
            requirePositive(v.a, v.b, v.c);
            requireRightTriangle(v.a, v.b, v.c);
            const r = v.a + v.b + v.c;
            const stepCopy = translations.calculationSteps?.perimeter || {};
            const title = stepCopy.title || '';
            const description = stepCopy.description || '';
            return {
              result: r,
              steps: [
                `**${title}**<br/>${description}<br/>P = a + b + c<br/>P = ${v.a} + ${v.b} + ${v.c} = ${format(r)}`
              ]
            };
          }
          case 'semiperimeter': {
            requirePositive(v.a, v.b, v.c);
            requireRightTriangle(v.a, v.b, v.c);
            const r = (v.a + v.b + v.c) / 2;
            const stepCopy = translations.calculationSteps?.semiperimeter || {};
            const title = stepCopy.title || '';
            const description = stepCopy.description || '';
            return {
              result: r,
              steps: [
                `**${title}**<br/>${description}<br/>s = (a + b + c) / 2<br/>s = (${v.a} + ${v.b} + ${v.c}) / 2 = ${format(v.a + v.b + v.c)} / 2 = ${format(r)}`
              ]
            };
          }
          case 'sine': {
            requirePositive(v.a, v.c);
            if (v.a >= v.c) throw new Error(messages.hypotenuseKnownLeg || translations.unableToCalculate || '');
            const r = v.a / v.c;
            return {
              result: r,
              steps: [
                buildCalculationStep(
                  'sine',
                  'sin(A)',
                  '',
                  'sin(A) = a / c',
                  `sin(A) = ${v.a} / ${v.c} = ${format(r)}`
                )
              ]
            };
          }
          case 'cosine': {
            requirePositive(v.b, v.c);
            if (v.b >= v.c) throw new Error(messages.hypotenuseKnownLeg || translations.unableToCalculate || '');
            const r = v.b / v.c;
            return {
              result: r,
              steps: [
                buildCalculationStep(
                  'cosine',
                  'cos(A)',
                  '',
                  'cos(A) = b / c',
                  `cos(A) = ${v.b} / ${v.c} = ${format(r)}`
                )
              ]
            };
          }
          case 'tangent': {
            requirePositive(v.a, v.b);
            const r = v.a / v.b;
            return {
              result: r,
              steps: [
                buildCalculationStep(
                  'tangent',
                  'tan(A)',
                  '',
                  'tan(A) = a / b',
                  `tan(A) = ${v.a} / ${v.b} = ${format(r)}`
                )
              ]
            };
          }
          case 'angle_asin': {
            requirePositive(v.a, v.c);
