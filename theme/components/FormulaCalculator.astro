import type { RightTriangleFormula } from 'src/data/rightTriangleFormulas';
import { DEFAULT_LOCALE, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  formula: RightTriangleFormula;
  locale: Locale;
  heading?: string;
  widgetStrings?: {
    title?: string;
    desc?: string;
    legA?: string;
    legB?: string;
    hypC?: string;
    angA?: string;
    angB?: string;
    output?: string;
  };
  messages?: {
    positive?: string;
    invalid?: string;
    angleRange?: string;
    hypotenuseKnownLeg?: string;
    hypotenuseLongest?: string;
    invalidTriangle?: string;
    projectionLessThanHypotenuse?: string;
    inconsistent?: string;
  };
  runtimeTranslations?: Record<string, unknown>;
}

const { formula, locale, heading, widgetStrings = {}, messages = {}, runtimeTranslations = {} } = Astro.props;

if (!formula.calculator) {
  throw new Error('FormulaCalculator requires a formula with a calculator configuration.');
}

const bundle = getTranslations(locale);
const common = (bundle.common as any) || {};
const formulasBundle = (bundle.formulas as any) || {};
const solver = (common.solver as any) || {};
const units = (common.units as any) || {};

const calculator = formula.calculator!!;

// Localized widget overrides (hub page passes translated strings).
const widgetFieldLabels: Record<string, string> = {
  a: widgetStrings.legA || '',
  b: widgetStrings.legB || '',
  c: widgetStrings.hypC || '',
  A: widgetStrings.angA || '',
  B: widgetStrings.angB || ''
};
const widgetOutputLabel = widgetStrings.output || calculator.outputLabel;
const widgetDesc = widgetStrings.desc || '';

const displayTitle = widgetStrings.title || (formulasBundle?.[formula.slug] as any)?.title || formula.title;
const calculatorHeading = heading || (widgetStrings.title ? displayTitle : `${displayTitle} ${pick(solver, 'calculateSuffix', 'Calculator')}`);
const formulaDiagramHeading =
  locale === DEFAULT_LOCALE
    ? `${displayTitle} Diagram`
    : pick(solver, 'formulaDiagram', 'Formula Diagram');
const defaultStatus = pick(solver, 'statusDefault', `Enter inputs to calculate {label}.`).replace('{label}', widgetOutputLabel);
const plainExpression = formula.plainExpression;

