---
import type { RightTriangleFormula } from 'src/data/rightTriangleFormulas';

interface Props {
  formula: RightTriangleFormula;
}

const { formula } = Astro.props;

if (!formula.calculator) {
  throw new Error('FormulaCalculator requires a formula with a calculator configuration.');
}
const calculator = formula.calculator!!;

const defaultStatus = `Enter inputs to calculate ${calculator.outputLabel}.`;
  const UNIT_SCALE = {
    m: 1, nm: 1e-9, µm: 1e-6, mm: 1e-3, cm: 1e-2, km: 1e3,
    in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344, nmi: 1852,
    Å: 1e-10, mil: 0.0000254, pixel: 0.0002645833, pt: 0.0003527778,
    foot_survey_us: 0.3048006096, fathom: 1.8288, au: 149597870700,
    light_second: 299792458, light_minute: 17987547480, light_hour: 1079252848800,
    light_day: 25902068371200, ly: 9460730472580800, kly: 9460730472580800000,
    pc: 3.085677581e16, Mpc: 3.085677581e22
  };
  const LENGTH_KEYS = ['a', 'b', 'c', 'p', 'q', 'h', 'r', 's', 'R'];
---

<section
  class="section-shell"
  data-formula-calculator
  data-kind={calculator.kind}
  data-output-label={calculator.outputLabel}
  data-output-unit={calculator.outputUnit ?? ''}
  data-default-status={defaultStatus}
>
  <h2 class="text-2xl font-semibold">{formula.title} Calculator</h2>
  <p class="mt-2 text-sm text-on-surface-variant">
    This calculator follows <span class="text-primary math-textbook">{formula.expression}</span> and returns
    <strong class="font-semibold text-on-surface"> {calculator.outputLabel}</strong>.
  </p>

  <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-start">
    <div class="flex-1 w-full relative z-10 overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-container-lowest/70 p-4 sm:p-6 shadow-sm hidden sm:block">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
      <div class="mb-2">
        <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Live Visualization</p>
        <h3 class="mt-1 text-lg text-on-surface">Formula Diagram</h3>
      </div>
      <svg class="relative h-auto w-full max-w-sm mx-auto" viewBox="0 0 460 300" aria-label="Dynamic right triangle">
        <defs>
          <linearGradient id="rt-fill-gradient2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f1c97d" stop-opacity="0.3"></stop>
            <stop offset="100%" stop-color="#d4ad65" stop-opacity="0.12"></stop>
          </linearGradient>
        </defs>
        <path d="M 60 240 L 80 240 L 80 260" fill="none" stroke="#99907c" stroke-width="1.5"></path>
        <path d="M 70 70 L 70 260 L 380 260 Z" fill="url(#rt-fill-gradient2)" stroke="#f1c97d" stroke-width="2.5" stroke-linejoin="round"></path>
        <line x1="70" y1="260" x2="196" y2="184" stroke="#f1c97d" stroke-width="2" stroke-dasharray="5 4" opacity="0.6"></line>
        <text x="50" y="170" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="14" text-anchor="end" data-calc-svg-label="a">a = -</text>
        <text x="226" y="284" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="14" text-anchor="middle" data-calc-svg-label="b">b = -</text>
        <text x="246" y="152" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="15" data-calc-svg-label="c">c = -</text>
        <text x="316" y="248" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="12" data-calc-svg-label="A">A = -</text>
        <text x="88" y="94" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="12" data-calc-svg-label="B">B = -</text>
        <text x="146" y="210" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="13" data-calc-svg-label="h">h = -</text>
      </svg>
    </div>

    <div class="flex-1 w-full space-y-4">
      <form class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" data-calc-form>
        {calculator.fields.map((field) => (
          <label class="grid gap-2 text-sm font-medium">
            <span>{field.label}</span>
            <div class="relative flex">
              <input
                class={`input-shell flex-1 ${LENGTH_KEYS.includes(field.key) ? 'rounded-r-none border-r-0' : 'pr-16'}`}
                type="number"
                step="any"
                min={field.min ?? 0}
                name={field.key}
                required
              />
              {LENGTH_KEYS.includes(field.key) ? (
                <select name={`${field.key}_unit`} class="bg-surface-container border border-outline/30 rounded-r-lg px-2 text-[10px] sm:text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary w-24 sm:w-28 text-on-surface-variant truncate">
                  <option value="m">(m) meter</option>
                  <option value="nm">(nm) nanometer</option>
                  <option value="µm">(µm) micrometer</option>
                  <option value="mm">(mm) millimeter</option>
                  <option value="cm">(cm) centimeter</option>
                  <option value="km">(km) kilometer</option>
                  <option value="in">(in) inch</option>
                  <option value="ft">(ft) foot</option>
                  <option value="yd">(yd) yard</option>
                  <option value="mi">(mi) mile</option>
                  <option value="nmi">(nmi) nautical mile</option>
                  <option value="Å">(Å) angstrom</option>
                  <option value="mil">(mil) mil</option>
                  <option value="pixel">(pixel) pointer</option>
                  <option value="pt">(pt) point</option>
                  <option value="foot_survey_us">(survey ft)</option>
                  <option value="fathom">(fathom)</option>
                  <option value="au">(au) astronomic</option>
                  <option value="light_second">(ls) l-sec</option>
                  <option value="light_minute">(lm) l-min</option>
                  <option value="light_hour">(lh) l-hour</option>
                  <option value="light_day">(ld) l-day</option>
                  <option value="ly">(ly) lightyear</option>
                  <option value="kly">(kly) kilolightyear</option>
                  <option value="pc">(pc) parsec</option>
                  <option value="Mpc">(Mpc) megaparsec</option>
                </select>
              ) : field.unit ? (
                <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs text-on-surface-variant">
                  {field.unit}
                </span>
              ) : null}
            </div>
            <p class="hidden text-xs text-error mt-0.5" data-calc-input-error={field.key}></p>
          </label>
        ))}

        <div class="sm:col-span-2 lg:col-span-1 xl:col-span-2 flex flex-wrap gap-3">
          <button type="submit" class="btn-primary">Calculate {calculator.outputLabel}</button>
          <button type="reset" class="btn-secondary">Reset</button>
        </div>
      </form>

      <p class="text-sm text-on-surface-variant" data-calc-status role="status" aria-live="polite">
        {defaultStatus}
      </p>

      <div class="hidden surface-card border-primary/30 bg-surface-container-high" data-calc-result-wrap>
        <div class="flex items-center justify-between">
          <p class="font-label text-xs uppercase tracking-widest text-primary" data-calc-output-label>
            {calculator.outputLabel}
          </p>
          <span class="rounded bg-primary-fixed px-2 py-0.5 text-[10px] uppercase text-on-primary-fixed">Result</span>
        </div>
        <p class="mt-2 font-mono text-3xl text-tertiary" data-calc-output-value>-</p>

        
        <div class="mt-6 border-t border-outline-variant/30 pt-4">
          <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Solution Steps</h4>
          <ol class="mt-3 space-y-3" data-calc-steps></ol>
        </div>

        <p class="mt-4 text-xs italic text-on-surface-variant" data-calc-output-detail>
          Formula: {formula.expression}
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      if (!currentScript) return;

      const section = currentScript.closest('[data-formula-calculator]');
      if (!section) return;

      const form = section.querySelector('[data-calc-form]');
      const statusEl = section.querySelector('[data-calc-status]');
      const resultWrap = section.querySelector('[data-calc-result-wrap]');
      const labelEl = section.querySelector('[data-calc-output-label]');
      const valueEl = section.querySelector('[data-calc-output-value]');
      const detailEl = section.querySelector('[data-calc-output-detail]');
      const stepsEl = section.querySelector('[data-calc-steps]');
      const kind = section.getAttribute('data-kind') ?? '';
      const outputLabel = section.getAttribute('data-output-label') ?? 'Result';
      const outputUnit = section.getAttribute('data-output-unit') ?? '';
      const defaultStatus =
        section.getAttribute('data-default-status') ?? 'Fill values and click calculate.';

      if (!form || !statusEl || !resultWrap || !labelEl || !valueEl || !detailEl || !stepsEl) return;

      const UNIT_SCALE = {
        m: 1, nm: 1e-9, 'µm': 1e-6, mm: 1e-3, cm: 1e-2, km: 1e3,
        in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344, nmi: 1852,
        'Å': 1e-10, mil: 0.0000254, pixel: 0.0002645833, pt: 0.0003527778,
        foot_survey_us: 0.3048006096, fathom: 1.8288, au: 149597870700,
        light_second: 299792458, light_minute: 17987547480, light_hour: 1079252848800,
        light_day: 25902068371200, ly: 9460730472580800, kly: 9460730472580800000,
        pc: 3.085677581e16, Mpc: 3.085677581e22
      };
      const LENGTH_KEYS = ['a', 'b', 'c', 'p', 'q', 'h', 'r', 's', 'R'];

      const toNumber = (value) => Number.parseFloat(String(value));
      const deg = (r) => (r * 180) / Math.PI;
      const rad = (d) => (d * Math.PI) / 180;
      const format = (n, digits = 4) => Number(n).toFixed(digits).replace(/\.?0+$/, '');

      const parseInputs = () => {
        const data = new FormData(form);
        const values = {};
        const units = {};
        for (const [key, val] of data.entries()) {
          if (key.endsWith('_unit')) {
            units[key.replace('_unit', '')] = val;
          } else {
            const num = toNumber(val);
            if (!Number.isFinite(num)) {
              throw new Error(`Invalid value for ${key}.`);
            }
            values[key] = num;
          }
        }

        let primaryUnit = null;
        for (const k of LENGTH_KEYS) {
          if (units[k]) {
            primaryUnit = units[k];
            break;
          }
        }

        if (primaryUnit) {
          for (const k of LENGTH_KEYS) {
            if (values[k] !== undefined && units[k]) {
              const scale = UNIT_SCALE[units[k]] / UNIT_SCALE[primaryUnit];
              values[k] = values[k] * scale;
            }
          }
        }

        return { values, primaryUnit };
      };

      const requirePositive = (...nums) => {
        if (nums.some((n) => !(n > 0))) {
          throw new Error('All values must be positive.');
        }
      };

      const solve = (v) => {
        switch (kind) {
          case 'pythagorean_c': {
            requirePositive(v.a, v.b);
            const r = Math.hypot(v.a, v.b);
            return {
              result: r,
              steps: [
                `Identify side a = ${v.a} and side b = ${v.b}.`,
                `Use the Pythagorean theorem: c = √(a² + b²)`,
                `Substitute: c = √(${v.a}² + ${v.b}²) = √(${format(v.a ** 2)} + ${format(v.b ** 2)})`,
                `The hypotenuse c is ${format(r)}.`
              ]
            };
          }
          case 'leg_from_ac': {
            requirePositive(v.a, v.c);
            if (v.c <= v.a) throw new Error('Hypotenuse c must be greater than leg a.');
            const r = Math.sqrt(v.c * v.c - v.a * v.a);
            return {
              result: r,
              steps: [
                `Identify side a = ${v.a} and hypotenuse c = ${v.c}.`,
                `Use the formula: b = √(c² - a²)`,
                `Substitute: b = √(${v.c}² - ${v.a}²) = √(${format(v.c ** 2)} - ${format(v.a ** 2)})`,
                `The missing leg b is ${format(r)}.`
              ]
            };
          }
          case 'leg_from_bc': {
            requirePositive(v.b, v.c);
            if (v.c <= v.b) throw new Error('Hypotenuse c must be greater than leg b.');
            const r = Math.sqrt(v.c * v.c - v.b * v.b);
            return {
              result: r,
              steps: [
                `Identify side b = ${v.b} and hypotenuse c = ${v.c}.`,
                `Use the formula: a = √(c² - b²)`,
                `Substitute: a = √(${v.c}² - ${v.b}²) = √(${format(v.c ** 2)} - ${format(v.b ** 2)})`,
                `The missing leg a is ${format(r)}.`
              ]
            };
          }
          case 'area_legs': {
            requirePositive(v.a, v.b);
            const r = (v.a * v.b) / 2;
            return {
              result: r,
              steps: [
                `Identify base (a) = ${v.a} and height (b) = ${v.b}.`,
                `Area = (a * b) / 2`,
                `Calculate: (${v.a} * ${v.b}) / 2 = ${format(v.a * v.b)} / 2`,
                `The total area is ${format(r)}.`
              ]
            };
          }
          case 'perimeter': {
            requirePositive(v.a, v.b, v.c);
            const r = v.a + v.b + v.c;
            return {
              result: r,
              steps: [
                `Identify sides a = ${v.a}, b = ${v.b}, c = ${v.c}.`,
                `Perimeter (P) = a + b + c`,
                `Calculate: ${v.a} + ${v.b} + ${v.c} = ${format(r)}.`
              ]
            };
          }
          case 'semiperimeter': {
            requirePositive(v.a, v.b, v.c);
            const r = (v.a + v.b + v.c) / 2;
            return {
              result: r,
              steps: [
                `Add all sides: P = ${v.a} + ${v.b} + ${v.c} = ${format(v.a + v.b + v.c)}`,
                `Semiperimeter (s) = P / 2 = ${format(v.a + v.b + v.c)} / 2`,
                `The result is ${format(r)}.`
              ]
            };
          }
          case 'sine': {
            requirePositive(v.a, v.c);
            if (v.a >= v.c) throw new Error('Leg a must be smaller than hypotenuse c.');
            const r = v.a / v.c;
            return {
              result: r,
              steps: [
                `Sine of Angle A (sin A) = Opposite / Hypotenuse`,
                `Identify opposite side a = ${v.a} and hypotenuse c = ${v.c}.`,
                `Calculate: ${v.a} / ${v.c} = ${format(r)}.`
              ]
            };
          }
          case 'cosine': {
            requirePositive(v.b, v.c);
            if (v.b >= v.c) throw new Error('Leg b must be smaller than hypotenuse c.');
            const r = v.b / v.c;
            return {
              result: r,
              steps: [
                `Cosine of Angle A (cos A) = Adjacent / Hypotenuse`,
                `Identify adjacent side b = ${v.b} and hypotenuse c = ${v.c}.`,
                `Calculate: ${v.b} / ${v.c} = ${format(r)}.`
              ]
            };
          }
          case 'tangent': {
            requirePositive(v.a, v.b);
            const r = v.a / v.b;
            return {
              result: r,
              steps: [
                `Tangent of Angle A (tan A) = Opposite / Adjacent`,
                `Identify opposite leg a = ${v.a} and adjacent leg b = ${v.b}.`,
                `Calculate: ${v.a} / ${v.b} = ${format(r)}.`
              ]
            };
          }
          case 'angle_asin': {
            requirePositive(v.a, v.c);
            const r = deg(Math.asin(v.a / v.c));
            return {
              result: r,
              steps: [
                `Find Angle A where sin(A) = a / c`,
                `A = arcsin(${v.a} / ${v.c}) = arcsin(${format(v.a / v.c)})`,
                `Angle A is approximately ${format(r)}°.`
              ]
            };
          }
          case 'angle_acos': {
            requirePositive(v.b, v.c);
            const r = deg(Math.acos(v.b / v.c));
            return {
              result: r,
              steps: [
                `Find Angle A where cos(A) = b / c`,
                `A = arccos(${v.b} / ${v.c}) = arccos(${format(v.b / v.c)})`,
                `Angle A is approximately ${format(r)}°.`
              ]
            };
          }
          case 'angle_atan': {
            requirePositive(v.a, v.b);
            const r = deg(Math.atan(v.a / v.b));
            return {
              result: r,
              steps: [
                `Find Angle A where tan(A) = a / b`,
                `A = arctan(${v.a} / ${v.b}) = arctan(${format(v.a / v.b)})`,
                `Angle A is approximately ${format(r)}°.`
              ]
            };
          }
          case 'altitude': {
            let { a, b, c } = v;
            requirePositive(a, b);
            if (!c || c <= a || c <= b) c = Math.hypot(a, b);
            const r = (a * b) / c;
            return {
              result: r,
              steps: [
                `Altitude (h) to the hypotenuse is (a * b) / c.`,
                `Sides: a = ${a}, b = ${b}, c = ${format(c)}.`,
                `Calculate: (${a} * ${b}) / ${format(c)} = ${format(a * b)} / ${format(c)}`,
                `The altitude is ${format(r)}.`
              ]
            };
          }
          case 'projection_p': {
            requirePositive(v.a, v.c);
            const r = (v.a * v.a) / v.c;
            return {
              result: r,
              steps: [
                `The projection p of leg a on the hypotenuse is a² / c.`,
                `a = ${v.a}, c = ${v.c}.`,
                `Substitute: ${v.a}² / ${v.c} = ${format(v.a ** 2)} / ${v.c}`,
                `The length p is ${format(r)}.`
              ]
            };
          }
          case 'projection_q': {
            requirePositive(v.b, v.c);
            const r = (v.b * v.b) / v.c;
            return {
              result: r,
              steps: [
                `The projection q of leg b on the hypotenuse is b² / c.`,
                `b = ${v.b}, c = ${v.c}.`,
                `Substitute: ${v.b}² / ${v.c} = ${format(v.b ** 2)} / ${v.c}`,
                `The length q is ${format(r)}.`
              ]
            };
          }
          case 'inradius': {
            requirePositive(v.a, v.b, v.c);
            const r = (v.a + v.b - v.c) / 2;
            return {
              result: r,
              steps: [
                `The inradius (r) of a right triangle is (a + b - c) / 2.`,
                `Substitute: (${v.a} + ${v.b} - ${v.c}) / 2 = ${format(v.a + v.b - v.c)} / 2`,
                `The inradius is ${format(r)}.`
              ]
            };
          }
          case 'circumradius': {
            requirePositive(v.c);
            const r = v.c / 2;
            return {
              result: r,
              steps: [
                `The circumradius (R) of a right triangle is hypotenuse c / 2.`,
                `c = ${v.c}.`,
                `Substitute: ${v.c} / 2 = ${format(r)}.`
              ]
            };
          }
          case 'cotangent': { requirePositive(v.a, v.b); const r = v.b/v.a; return { result: r, steps: [`cot(A) = b / a = ${format(r)}`] }; }
          case 'secant': { requirePositive(v.b, v.c); const r = v.c/v.b; return { result: r, steps: [`sec(A) = c / b = ${format(r)}`] }; }
          case 'cosecant': { requirePositive(v.a, v.c); const r = v.c/v.a; return { result: r, steps: [`csc(A) = c / a = ${format(r)}`] }; }
          case 'leg_from_hc_sin': { requirePositive(v.c, v.A); const r = v.c * Math.sin(rad(v.A)); return { result: r, steps: [`a = c * sin(A) = ${v.c} * sin(${v.A}°) = ${format(r)}`] }; }
          case 'leg_from_hc_cos': { requirePositive(v.c, v.A); const r = v.c * Math.cos(rad(v.A)); return { result: r, steps: [`b = c * cos(A) = ${v.c} * cos(${v.A}°) = ${format(r)}`] }; }
          case 'leg_from_leg_tan': { requirePositive(v.b, v.A); const r = v.b * Math.tan(rad(v.A)); return { result: r, steps: [`a = b * tan(A) = ${v.b} * tan(${v.A}°) = ${format(r)}`] }; }
          case 'leg_from_leg_tan_div': { requirePositive(v.a, v.A); const r = v.a / Math.tan(rad(v.A)); return { result: r, steps: [`b = a / tan(A) = ${v.a} / tan(${v.A}°) = ${format(r)}`] }; }
          case 'angle_b_from_a': { requirePositive(v.A); const r = 90 - v.A; return { result: r, steps: [`B = 90° - A = 90 - ${v.A} = ${format(r)}`] }; }
          case 'angle_a_from_b': { requirePositive(v.B); const r = 90 - v.B; return { result: r, steps: [`A = 90° - B = 90 - ${v.B} = ${format(r)}`] }; }
          case 'area_sin_a': { requirePositive(v.b, v.c, v.A); const r = 0.5 * v.b * v.c * Math.sin(rad(v.A)); return { result: r, steps: [`Area = 0.5 * b * c * sin(A) = ${format(r)}`] }; }
          case 'area_sin_b': { requirePositive(v.a, v.c, v.B); const r = 0.5 * v.a * v.c * Math.sin(rad(v.B)); return { result: r, steps: [`Area = 0.5 * a * c * sin(B) = ${format(r)}`] }; }
          case 'area_rs': { requirePositive(v.r, v.s); const r = v.r * v.s; return { result: r, steps: [`Area = r * s = ${v.r} * ${v.s} = ${format(r)}`] }; }
          case 'area_ch': { requirePositive(v.c, v.h); const r = 0.5 * v.c * v.h; return { result: r, steps: [`Area = 0.5 * c * h = ${format(r)}`] }; }
          case 'altitude_pq': { requirePositive(v.p, v.q); const r = Math.sqrt(v.p * v.q); return { result: r, steps: [`h = sqrt(p * q) = sqrt(${v.p * v.q}) = ${format(r)}`] }; }
          case 'leg_from_cp': { requirePositive(v.c, v.p); const r = Math.sqrt(v.c * v.p); return { result: r, steps: [`a = sqrt(c * p) = sqrt(${v.c * v.p}) = ${format(r)}`] }; }
          case 'leg_from_cq': { requirePositive(v.c, v.q); const r = Math.sqrt(v.c * v.q); return { result: r, steps: [`b = sqrt(c * q) = sqrt(${v.c * v.q}) = ${format(r)}`] }; }
          case 'hyp_from_pq': { requirePositive(v.p, v.q); const r = v.p + v.q; return { result: r, steps: [`c = p + q = ${v.p} + ${v.q} = ${format(r)}`] }; }
          case 'identity_cos_from_sin': { requirePositive(v.sinA); const r = Math.sqrt(1 - (v.sinA * v.sinA)); return { result: r, steps: [`cos(A) = sqrt(1 - sin²(A)) = ${format(r)}`] }; }
          case 'tan_from_sin_cos': { requirePositive(v.sinA, v.cosA); const r = v.sinA / v.cosA; return { result: r, steps: [`tan(A) = sin(A) / cos(A) = ${format(r)}`] }; }
          case 'c_from_a_45': { requirePositive(v.a); const r = v.a * Math.SQRT2; return { result: r, steps: [`c = a * sqrt(2) = ${format(r)}`] }; }
          case 'a_from_c_45': { requirePositive(v.c); const r = v.c / Math.SQRT2; return { result: r, steps: [`a = c / sqrt(2) = ${format(r)}`] }; }
          case 'long_from_short_30': { requirePositive(v.a); const r = v.a * Math.sqrt(3); return { result: r, steps: [`long leg = a * sqrt(3) = ${format(r)}`] }; }
          case 'c_from_a_30': { requirePositive(v.a); const r = v.a * 2; return { result: r, steps: [`c = 2 * a = ${v.a * 2}`] }; }
          default:
            throw new Error(`Calculator type '${kind}' is not configured.`);
        }
      };

      const updateSvgLabels = (inputs, resultVal, outputUnit) => {
        const svgLabels = section.querySelectorAll('[data-calc-svg-label]');
        const map = { ...inputs };
        
        let outKey = null;
        const lowL = outputLabel.toLowerCase();
        if (lowL.includes('leg a') || outputLabel === 'Leg a' || lowL === 'opposite a') outKey = 'a';
        else if (lowL.includes('leg b') || outputLabel === 'Leg b' || lowL === 'adjacent b') outKey = 'b';
        else if (lowL.includes('hypotenuse c') || outputLabel === 'Hypotenuse c') outKey = 'c';
        else if (lowL.includes('angle a') || lowL.includes('sin(a)') || lowL.includes('cos(a)') || lowL.includes('tan(a)') || lowL.includes('cot(a)') || lowL.includes('sec(a)') || lowL.includes('csc(a)')) outKey = 'A';
        else if (lowL.includes('angle b') || lowL.includes('sin(b)') || lowL.includes('cos(b)') || lowL.includes('tan(b)') || lowL.includes('cot(b)') || lowL.includes('sec(b)') || lowL.includes('csc(b)')) outKey = 'B';
        else if (lowL.includes('altitude h') || outputLabel === 'Altitude h') outKey = 'h';
        else if (lowL.includes('projection p')) outKey = 'p';
        else if (lowL.includes('projection q')) outKey = 'q';

        if (outKey && resultVal !== undefined) map[outKey] = resultVal;

        for (const el of svgLabels) {
          const key = el.getAttribute('data-calc-svg-label');
          if (map[key] !== undefined) {
            let u = outputUnit ? ` ${outputUnit}` : '';
            if (key === 'A' || key === 'B') u = '°';
            if (outKey === key) {
              el.textContent = `${key} = ${format(map[key])}${u}`;
              el.setAttribute('fill', '#f1c97d');
              el.setAttribute('font-weight', '700');
            } else {
              el.textContent = `${key} = ${format(map[key])}${u}`;
              el.setAttribute('fill', '#d0c5af');
              el.setAttribute('font-weight', 'normal');
            }
          } else {
            el.textContent = `${key} = -`;
            el.setAttribute('fill', '#b6b5b4');
            el.setAttribute('font-weight', 'normal');
          }
        }
      };

      const renderSuccess = (resultData, primaryUnit, inputs) => {
        statusEl.textContent = 'Calculation complete.';
        statusEl.classList.remove('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
        statusEl.classList.add('text-on-surface-variant');
        resultWrap.classList.remove('hidden');

        const { result, steps } = resultData;
        const outSuffix = primaryUnit ? ` ${primaryUnit}` : (outputUnit ? ` ${outputUnit}` : '');
        valueEl.textContent = `${format(result)}${outSuffix}`;

        const fragment = document.createDocumentFragment();
        steps.forEach((step, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-3 rounded-lg border border-outline-variant/10 bg-surface-container-low/40 p-3 text-sm transition-colors hover:bg-surface-container-low/60';
          const num = (index + 1).toString().padStart(2, '0');
          li.innerHTML = `<span class="mt-0.5 font-mono text-[10px] text-primary/60 flex-shrink-0">${num}</span><span class="text-on-surface-variant math-textbook">${step}</span>`;
          fragment.append(li);
        });
        stepsEl.replaceChildren(fragment);
        updateSvgLabels(inputs, result, primaryUnit || outputUnit);
      };

      const renderError = (err) => {
        const msg = err instanceof Error ? err.message : 'Unable to calculate.';
        
        // Clear all previous field errors
        const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
        errorBoxes.forEach(el => el.classList.add('hidden'));
        
        let foundField = false;
        const lowMsg = msg.toLowerCase();
        
        let targetKey = null;
        if (lowMsg.includes('c must be greater than leg a') || lowMsg.includes('larger than side a') || lowMsg.includes('hypotenuse c must be')) targetKey = 'c';
        else if (lowMsg.includes('c must be greater than leg b') || lowMsg.includes('larger than side b')) targetKey = 'c';
        else if (lowMsg.includes('side a') && !lowMsg.includes('hypotenuse')) targetKey = 'a';
        else if (lowMsg.includes('side b') && !lowMsg.includes('hypotenuse')) targetKey = 'b';
        else if (lowMsg.includes('angle a')) targetKey = 'A';
        else if (lowMsg.includes('angle b')) targetKey = 'B';

        if (targetKey) {
           const box = section.querySelector(`[data-calc-input-error="${targetKey}"]`);
           if (box) { 
             box.textContent = msg; 
             box.classList.remove('hidden'); 
             foundField = true; 
           }
        }

        if (!foundField) {
          statusEl.textContent = `Error: ${msg}`;
          statusEl.classList.add('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
          statusEl.classList.remove('text-on-surface-variant');
        } else {
          statusEl.textContent = 'Please fix the errors in the fields above.';
          statusEl.classList.add('text-red-500', 'font-semibold');
          statusEl.classList.remove('text-on-surface-variant', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
        }

        resultWrap.classList.add('hidden');
        updateSvgLabels({}, undefined, '');
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        try {
          // Clear errors on fresh submit
          const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
          errorBoxes.forEach(el => el.classList.add('hidden'));

          const { values, primaryUnit } = parseInputs();
          const resultData = solve(values);
          if (Number.isNaN(resultData.result)) {
            throw new Error('Mathematical error. Verify your values accurately represent a right triangle.');
          }
          renderSuccess(resultData, primaryUnit, values);
        } catch (err) {
          renderError(err);
        }
      });

      form.addEventListener('reset', () => {
        setTimeout(() => {
          const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
          errorBoxes.forEach(el => el.classList.add('hidden'));

          statusEl.textContent = defaultStatus;
          statusEl.classList.remove('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
          statusEl.classList.add('text-on-surface-variant');
          resultWrap.classList.add('hidden');
          updateSvgLabels({}, undefined, '');
        }, 0);
      });
    })();
  </script>
</section>
