                  `h = \u221A(${v.p} \u00D7 ${v.q}) = \u221A(${format(v.p * v.q)}) = ${format(r)}`
                )
              ]
            };
          }
          case 'leg_from_cp': { requirePositive(v.c, v.p); const r = Math.sqrt(v.c * v.p); return { result: r, steps: [`**Solve for Leg a**<br/>Calculate leg a from its projection onto the hypotenuse.<br/>Use a = \u221A(c \u00D7 p)<br/>a = \u221A(${v.c} \u00D7 ${v.p}) = \u221A(${format(v.c * v.p)}) = ${format(r)}`] }; }
          case 'leg_from_cp_strict': {
            requirePositive(v.c, v.p);
            if (v.p >= v.c) {
              throw new Error(messages.projectionLessThanHypotenuse || messages.invalidTriangle || translations.unableToCalculate || '');
            }
            const r = Math.sqrt(v.c * v.p);
            return {
              result: r,
              steps: [
                buildCalculationStep(
                  'legAFromProjection',
                  'Solve for Leg a',
                  'Calculate leg a from hypotenuse c and projection p.',
                  'a² = c \u00D7 p<br/>a = \u221A(c \u00D7 p)',
                  `a² = ${v.c} \u00D7 ${v.p} = ${format(v.c * v.p)}<br/>a = \u221A(${v.c} \u00D7 ${v.p}) = \u221A(${format(v.c * v.p)}) = ${format(r)}`
                )
              ]
            };
          }
          case 'leg_from_cq': { requirePositive(v.c, v.q); const r = Math.sqrt(v.c * v.q); return { result: r, steps: [`**Solve for Leg b**<br/>Calculate leg b from its projection onto the hypotenuse.<br/>Use b = \u221A(c \u00D7 q)<br/>b = \u221A(${v.c} \u00D7 ${v.q}) = \u221A(${format(v.c * v.q)}) = ${format(r)}`] }; }
          case 'leg_from_cq_strict': {
            requirePositive(v.c, v.q);
            if (v.q >= v.c) {
              throw new Error(messages.projectionLessThanHypotenuse || messages.invalidTriangle || translations.unableToCalculate || '');
            }
            const r = Math.sqrt(v.c * v.q);
            return {
              result: r,
              steps: [
                buildCalculationStep(
                  'legBFromProjection',
                  'Solve for Leg b',
                  'Calculate leg b from hypotenuse c and projection q.',
                  'b² = c \u00D7 q<br/>b = \u221A(c \u00D7 q)',
                  `b² = ${v.c} \u00D7 ${v.q} = ${format(v.c * v.q)}<br/>b = \u221A(${v.c} \u00D7 ${v.q}) = \u221A(${format(v.c * v.q)}) = ${format(r)}`
                )
              ]
            };
          }
          case 'hyp_from_pq': {
            requirePositive(v.p, v.q);
            const r = v.p + v.q;
            return {
              result: r,
              steps: [
                buildCalculationStep(
                  'hypotenuseFromProjections',
                  'Solve for Hypotenuse c',
                  'Sum the two segments of the hypotenuse.',
                  'c = p + q',
                  `c = ${v.p} + ${v.q} = ${format(r)}`
                )
              ]
            };
          }
          case 'identity_cos_from_sin': { requirePositive(v.sinA); const r = Math.sqrt(1 - (v.sinA * v.sinA)); return { result: r, steps: [`**Calculate cos(A)**<br/>Derive cosine from the sine value using the Pythagorean identity.<br/>Use cos(A) = \u221A(1 - sin^2(A))<br/>cos(A) = \u221A(1 - ${v.sinA}^2) = ${format(r)}`] }; }
          case 'tan_from_sin_cos': { requirePositive(v.sinA, v.cosA); const r = v.sinA / v.cosA; return { result: r, steps: [`**Calculate tan(A)**<br/>Determine tangent using the fundamental sine-cosine ratio.<br/>Use tan(A) = sin(A) / cos(A)<br/>tan(A) = ${v.sinA} / ${v.cosA} = ${format(r)}`] }; }
          case 'c_from_a_45': { requirePositive(v.a); const r = v.a * Math.SQRT2; return { result: r, steps: [buildSpecialTriangleStep('c_from_a_45', `**Solve for Hypotenuse c**<br/>In a special 45-45-90 triangle, multiply leg by \u221A2.<br/>Use c = a \u00D7 \u221A2<br/>c = ${v.a} \u00D7 \u221A2 = ${format(r)}`, 'c = a \u00D7 \u221A2', `c = ${v.a} \u00D7 \u221A2 = ${format(r)}`)] }; }
          case 'a_from_c_45': { requirePositive(v.c); const r = v.c / Math.SQRT2; return { result: r, steps: [buildSpecialTriangleStep('a_from_c_45', `**Solve for Leg a**<br/>In a special 45-45-90 triangle, divide hypotenuse by \u221A2.<br/>Use a = c / \u221A2<br/>a = ${v.c} / \u221A2 = ${format(r)}`, 'a = c / \u221A2', `a = ${v.c} / \u221A2 = ${format(r)}`)] }; }
          case 'area_from_leg_45': { requirePositive(v.a); const r = (v.a * v.a) / 2; return { result: r, steps: [buildSpecialTriangleStep('area_from_leg_45', `**Calculate Area**<br/>In a 45-45-90 triangle, both legs are equal, so area is a\u00B2 / 2.<br/>Use Area = a\u00B2 / 2<br/>Area = ${v.a}\u00B2 / 2 = ${format(v.a * v.a)} / 2 = ${format(r)}`, 'Area = a\u00B2 / 2', `Area = ${v.a}\u00B2 / 2 = ${format(v.a * v.a)} / 2 = ${format(r)}`)] }; }
          case 'perimeter_from_leg_45': { requirePositive(v.a); const r = (2 * v.a) + (v.a * Math.SQRT2); return { result: r, steps: [buildSpecialTriangleStep('perimeter_from_leg_45', `**Calculate Perimeter P**<br/>Add both equal legs and the hypotenuse a\u221A2.<br/>Use P = 2a + a\u221A2<br/>P = 2(${v.a}) + ${v.a}\u221A2 = ${format(r)}`, 'P = 2a + a\u221A2', `P = 2(${v.a}) + ${v.a}\u221A2 = ${format(r)}`)] }; }
          case 'long_from_short_30': { requirePositive(v.a); const r = v.a * Math.sqrt(3); return { result: r, steps: [buildSpecialTriangleStep('long_from_short_30', `**Solve for Long Leg b**<br/>In a 30-60-90 triangle, the long leg is short leg \u00D7 \u221A3.<br/>Use b = a \u00D7 \u221A3<br/>b = ${v.a} \u00D7 \u221A3 = ${format(r)}`, 'b = a \u00D7 \u221A3', `b = ${v.a} \u00D7 \u221A3 = ${format(r)}`)] }; }
          case 'c_from_a_30': { requirePositive(v.a); const r = v.a * 2; return { result: r, steps: [buildSpecialTriangleStep('c_from_a_30', `**Solve for Hypotenuse c**<br/>In a 30-60-90 triangle, the hypotenuse is double the short leg.<br/>Use c = 2 \u00D7 a<br/>c = 2 \u00D7 ${v.a} = ${format(r)}`, 'c = 2 \u00D7 a', `c = 2 \u00D7 ${v.a} = ${format(r)}`)] }; }
          case 'short_from_c_30': { requirePositive(v.c); const r = v.c / 2; return { result: r, steps: [buildSpecialTriangleStep('short_from_c_30', `**Solve for Short Leg a**<br/>In a 30-60-90 triangle, the short leg is half of the hypotenuse.<br/>Use a = c / 2<br/>a = ${v.c} / 2 = ${format(r)}`, 'a = c / 2', `a = ${v.c} / 2 = ${format(r)}`)] }; }
          case 'short_from_long_30': { requirePositive(v.b); const r = v.b / Math.sqrt(3); return { result: r, steps: [buildSpecialTriangleStep('short_from_long_30', `**Solve for Short Leg a**<br/>Divide the long leg by \u221A3.<br/>Use a = long leg / \u221A3<br/>a = ${v.b} / \u221A3 = ${format(r)}`, 'a = long leg / \u221A3', `a = ${v.b} / \u221A3 = ${format(r)}`)] }; }
          case 'long_from_c_30': { requirePositive(v.c); const r = (v.c * Math.sqrt(3)) / 2; return { result: r, steps: [buildSpecialTriangleStep('long_from_c_30', `**Solve for Long Leg**<br/>The long leg is the hypotenuse scaled by \u221A3 / 2.<br/>Use long leg = (c \u00D7 \u221A3) / 2<br/>long leg = (${v.c} \u00D7 \u221A3) / 2 = ${format(r)}`, 'long leg = (c \u00D7 \u221A3) / 2', `long leg = (${v.c} \u00D7 \u221A3) / 2 = ${format(r)}`)] }; }
          case 'area_from_short_30': { requirePositive(v.a); const longLeg = v.a * Math.sqrt(3); const r = (v.a * longLeg) / 2; return { result: r, steps: [buildSpecialTriangleStep('area_from_short_30', `**Calculate Area**<br/>Use the short leg and long leg relationship for a 30-60-90 triangle.<br/>Use Area = (short leg \u00D7 long leg) / 2<br/>Area = (${v.a} \u00D7 ${format(longLeg)}) / 2 = ${format(r)}`, 'Area = (short leg \u00D7 long leg) / 2', `Area = (${v.a} \u00D7 ${format(longLeg)}) / 2 = ${format(r)}`)] }; }
          case 'perimeter_from_short_30': { requirePositive(v.a); const longLeg = v.a * Math.sqrt(3); const hypotenuse = 2 * v.a; const r = v.a + longLeg + hypotenuse; return { result: r, steps: [buildSpecialTriangleStep('perimeter_from_short_30', `**Calculate Perimeter P**<br/>Add the short leg, long leg, and hypotenuse.<br/>Use P = short leg + long leg + c<br/>P = ${v.a} + ${format(longLeg)} + ${format(hypotenuse)} = ${format(r)}`, 'P = short leg + long leg + c', `P = ${v.a} + ${format(longLeg)} + ${format(hypotenuse)} = ${format(r)}`)] }; }
          default:
            throw new Error(`Calculator type '${kind}' is not configured.`);
        }
      };

      const updateSvgLabels = (inputs, resultVal, outputUnit) => {
        const svgLabels = section.querySelectorAll('[data-calc-svg-label]');
        const strokeEl = section.querySelector('[data-calc-svg-path-stroke]');
        const fillEl = section.querySelector('[data-calc-svg-path-fill]');
        const altitudeLine = section.querySelector('[data-calc-svg-altitude]');
        const map = { ...inputs };
        
        let outKey = null;
        const lowL = outputLabel.toLowerCase();
        if (kind.toLowerCase().includes('altitude')) outKey = 'h';
        else if (lowL.includes('leg a') || outputLabel === 'Leg a' || lowL === 'opposite a' || lowL === 'long leg') outKey = 'a';
        else if (lowL.includes('leg b') || outputLabel === 'Leg b' || lowL === 'adjacent b') outKey = 'b';
        else if (lowL.includes('hypotenuse c') || outputLabel === 'Hypotenuse c') outKey = 'c';
        else if (lowL.includes('angle a') || lowL.includes('sin(a)') || lowL.includes('cos(a)') || lowL.includes('tan(a)') || lowL.includes('cot(a)') || lowL.includes('sec(a)') || lowL.includes('csc(a)')) outKey = 'A';
        else if (lowL.includes('angle b') || lowL.includes('sin(b)') || lowL.includes('cos(b)') || lowL.includes('tan(b)') || lowL.includes('cot(b)') || lowL.includes('sec(b)') || lowL.includes('csc(b)')) outKey = 'B';
        else if (/\bA\b/.test(outputLabel)) outKey = 'A';
        else if (/\bB\b/.test(outputLabel)) outKey = 'B';
        else if (lowL.includes('altitude h') || outputLabel === 'Altitude h') outKey = 'h';
        else if (lowL.includes('projection p')) outKey = 'p';
        else if (lowL.includes('projection q')) outKey = 'q';
        else if (lowL.includes('inradius')) outKey = 'r';
        else if (lowL.includes('circumradius')) outKey = 'R';

        if (outKey && resultVal !== undefined) map[outKey] = resultVal;

        // --- Derive A and B for visual shape scaling ---
        let drawA = map.a;
        let drawB = map.b;
        let drawC = map.c;
        const A_ang = map.A;
        const B_ang = map.B;

        if (!drawA || !drawB) {
            if (drawA && drawC && drawC > drawA) drawB = Math.sqrt(drawC*drawC - drawA*drawA);
            else if (drawB && drawC && drawC > drawB) drawA = Math.sqrt(drawC*drawC - drawB*drawB);
            else if (drawC && A_ang) { drawA = drawC * Math.sin(rad(A_ang)); drawB = drawC * Math.cos(rad(A_ang)); }
            else if (drawC && B_ang) { drawA = drawC * Math.cos(rad(B_ang)); drawB = drawC * Math.sin(rad(B_ang)); }
            else if (drawA && A_ang) drawB = drawA / Math.tan(rad(A_ang));
            else if (drawB && B_ang) drawA = drawB / Math.tan(rad(B_ang));
            else if (map.p && map.q) { drawC = map.p + map.q; drawA = Math.sqrt(drawC*map.p); drawB = Math.sqrt(drawC*map.q); }
            else if (map.h && drawC) { drawA = Math.sqrt(0.5*(drawC*drawC + drawC*Math.sqrt(Math.max(0, drawC*drawC - 4*map.h*map.h)))); drawB = Math.sqrt(Math.max(0, drawC*drawC - drawA*drawA)); }
        }

        const setPath = (aVal, bVal) => {
          const DEFAULT_STROKE = 'M 60 240 L 80 240 L 80 260';
          const DEFAULT_FILL = 'M 70 70 L 70 260 L 380 260 Z';
          if (!aVal || !bVal || !isFinite(aVal) || !isFinite(bVal) || aVal <= 0 || bVal <= 0) {
            if (fillEl) fillEl.setAttribute('d', DEFAULT_FILL);
            if (strokeEl) strokeEl.setAttribute('d', DEFAULT_STROKE);
            if (altitudeLine) altitudeLine.setAttribute('opacity', '0');
            // reset text positions
             for (const el of svgLabels) {
               const k = el.getAttribute('data-calc-svg-label');
               if (k === 'a') { el.setAttribute('x', '50'); el.setAttribute('y', '170'); el.setAttribute('text-anchor', 'end'); }
               if (k === 'b') { el.setAttribute('x', '226'); el.setAttribute('y', '284'); el.setAttribute('text-anchor', 'middle'); }
               if (k === 'c') { el.setAttribute('x', '246'); el.setAttribute('y', '152'); el.setAttribute('text-anchor', 'start'); }
               if (k === 'A') { el.setAttribute('x', '316'); el.setAttribute('y', '248'); el.setAttribute('text-anchor', 'end'); }
               if (k === 'B') { el.setAttribute('x', '88'); el.setAttribute('y', '94'); el.setAttribute('text-anchor', 'start'); }
               if (k === 'h') { el.setAttribute('x', '146'); el.setAttribute('y', '210'); el.setAttribute('text-anchor', 'end'); }
             }
            return;
          }

          const W = 460, H = 300, maxW = W - 100, maxH = H - 80;
          const aspectTri = bVal / aVal;
          const aspectBox = maxW / maxH;
          let dW = maxW, dH = dW / aspectTri;
          if (aspectTri <= aspectBox) { dH = maxH; dW = dH * aspectTri; }
          const lX = W/2 - dW/2, tY = H/2 - dH/2, rX = lX + dW, bY = tY + dH;

          if (fillEl) fillEl.setAttribute('d', `M ${lX} ${tY} L ${lX} ${bY} L ${rX} ${bY} Z`);
          
          const bSize = Math.min(20, dW * 0.15, dH * 0.15);
          if (strokeEl) strokeEl.setAttribute('d', `M ${lX} ${bY - bSize} L ${lX + bSize} ${bY - bSize} L ${lX + bSize} ${bY}`);

          const hX = lX + (dW * dH * dH) / (dW*dW + dH*dH);
          const hY = bY - (dW * dW * dH) / (dW*dW + dH*dH);
          if (altitudeLine) {
            altitudeLine.setAttribute('x1', lX);
            altitudeLine.setAttribute('y1', bY);
            altitudeLine.setAttribute('x2', hX);
            altitudeLine.setAttribute('y2', hY);
            altitudeLine.setAttribute('opacity', '0.6');
          }

          for (const el of svgLabels) {
             const key = el.getAttribute('data-calc-svg-label');
             if (key === 'a') { el.setAttribute('x', lX - 10); el.setAttribute('y', bY - dH/2 + 5); el.setAttribute('text-anchor', 'end'); }
             if (key === 'b') { el.setAttribute('x', lX + dW/2); el.setAttribute('y', bY + 20); el.setAttribute('text-anchor', 'middle'); }
             if (key === 'c') { el.setAttribute('x', lX + dW/2 + 15); el.setAttribute('y', bY - dH/2 - 10); el.setAttribute('text-anchor', 'start'); }
             if (key === 'A') { el.setAttribute('x', rX - Math.min(40, dW*0.1)); el.setAttribute('y', bY - 8); el.setAttribute('text-anchor', 'end'); }
             if (key === 'B') { el.setAttribute('x', lX + 12); el.setAttribute('y', tY + Math.min(40, dH*0.1) + 10); el.setAttribute('text-anchor', 'start'); }
             if (key === 'h') { el.setAttribute('x', lX + (hX - lX)*0.5 + 5); el.setAttribute('y', bY - (bY - hY)*0.5 + 5); el.setAttribute('text-anchor', 'end'); }
          }
        };

        setPath(drawA, drawB);
        // ---

        const emptyLabel = {
          a: 'a = input',
          b: 'b = input',
          c: 'c = result',
          A: 'A = \u2014',
          B: 'B = \u2014',
          h: 'h = \u2014'
        };

        for (const el of svgLabels) {
          const key = el.getAttribute('data-calc-svg-label');
          if (map[key] !== undefined) {
            let u = outputUnit ? ` ${outputUnit}` : '';
            if (key === 'A' || key === 'B') u = '\u00B0';
            if (outKey === key) {
              el.textContent = `${key} = ${format(map[key])}${u}`;
              el.setAttribute('fill', '#f1c97d');
              el.setAttribute('font-weight', '700');
            } else {
              el.textContent = `${key} = ${format(map[key])}${u}`;
              el.setAttribute('fill', '#d0c5af');
              el.setAttribute('font-weight', 'normal');
            }
          } else {
            el.textContent = emptyLabel[key] || `${key} = \u2014`;
            el.setAttribute('fill', '#b6b5b4');
            el.setAttribute('font-weight', 'normal');
          }
        }
      };

      const renderSuccess = (resultData, primaryUnit, inputs) => {
        statusEl.textContent = translations.calculationComplete || '';
        statusEl.classList.remove('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
        statusEl.classList.add('text-on-surface-variant');
        resultWrap.classList.remove('hidden');

        const { result, steps } = resultData;
        const applyRootBars = (value) => {
          let output = '';
          let cursor = 0;

          while (cursor < value.length) {
            if (value[cursor] === '\u221A' && value[cursor + 1] === '(') {
              let depth = 0;
              let end = cursor + 1;

              for (; end < value.length; end++) {
                const char = value[end];
                if (char === '(') depth += 1;
                if (char === ')') {
                  depth -= 1;
                  if (depth === 0) break;
                }
              }

              if (depth === 0 && end < value.length) {
                const inner = applyRootBars(value.slice(cursor + 2, end));
                output += '&#8730;<span class="math-radical-content">' + inner + '</span>';
                cursor = end + 1;
                continue;
              }
            }

            output += value[cursor];
            cursor += 1;
          }

          return output;
        };

        const formatStepText = (raw) =>
          applyRootBars(
            String(raw)
              .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
              .replace(/([a-zA-Z])(\d+)/g, '<i>$1</i><sup>$2</sup>')
              .replace(/\^(\d+)/g, '<sup>$1</sup>')
              .replace(/²/g, '<sup>2</sup>')
              .replace(/³/g, '<sup>3</sup>')
              .replace(/(^|[^a-zA-Z<>])([a-zA-Z])(?![a-zA-Z<>])/g, '$1<i>$2</i>')
          );

        const splitSubstitutionAndAnswer = (line) => {
          const normalized = String(line).trim();
          const parts = normalized.split('=').map((part) => part.trim()).filter(Boolean);
          if (parts.length >= 3) {
            return {
              substitution: parts.slice(0, -1).join(' = '),
              answer: parts[parts.length - 1]
            };
          }
          if (parts.length === 2) {
            return {
              substitution: normalized,
              answer: parts[1]
            };
          }
          return { substitution: normalized, answer: null };
        };

        const buildStepFlow = (lines) => {
          const cleanedLines = lines.map((line) => String(line).trim()).filter(Boolean);
          if (!cleanedLines.length) return [];
          const stepLabels = translations.stepLabels || {};

          const explanationParts = [];
          const equationLines = [];
          let formula = '';
          let substitution = '';
          let answer = '';

          for (const line of cleanedLines) {
            const normalizedLine = line.replace(/^use\s+/i, '').trim();
            if (normalizedLine.includes('=')) {
              equationLines.push(normalizedLine);
            } else {
              explanationParts.push(normalizedLine);
            }
          }

          if (equationLines.length > 0) {
            formula = equationLines[0];
            substitution = equationLines[equationLines.length - 1];
          }

          if (substitution) {
            const split = splitSubstitutionAndAnswer(substitution);
            if (split.answer) answer = split.answer;
          } else if (formula) {
            const split = splitSubstitutionAndAnswer(formula);
            if (split.answer) answer = split.answer;
          }

          const flow = [];
          if (formula) flow.push({ type: 'formula', label: stepLabels.formula || translations.formula || '', value: formula });
          if (substitution && substitution !== formula) {
            flow.push({ type: 'substitution', label: stepLabels.substitution || '', value: substitution });
          }
          if (answer) flow.push({ type: 'answer', label: stepLabels.answer || '', value: answer });

          const explanation = explanationParts.join(' ').trim();
          if (explanation) flow.push({ type: 'explanation', label: stepLabels.explanation || '', value: explanation });

          return flow.length
            ? flow
            : cleanedLines.map((line) => ({ type: 'detail', label: stepLabels.detail || '', value: line }));
        };

        const stepBlocks = steps
          .map((step) => {
            const lines = String(step)
              .split(/<br\s*\/?>/gi)
              .map((line) => line.trim())
              .filter(Boolean);
            if (!lines.length) return null;
            const title = lines[0].replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*/g, '').trim();
            return {
              title: title || lines[0],
              lines: lines.slice(1)
            };
          })
          .filter(Boolean);
        
        const getUnitSuffix = () => {
          const k = kind.toLowerCase();
          const isRatio = ['sine', 'cosine', 'tangent', 'cotangent', 'secant', 'cosecant', 'identity', 'ratio', 'tan_from'].some(r => k.includes(r));
          if (isRatio) return '';

          if (k.includes('angle')) {
            return outputUnit ? ` ${outputUnit}` : (translations.angleSuffix || '\u00B0');
          }

          if (k.includes('area')) {
            return translations.sqUnits || '';
          }

          if (primaryUnit) return ` ${primaryUnit}`;
          return outputUnit ? ` ${outputUnit}` : '';
        };

        const outSuffix = getUnitSuffix();
        valueEl.innerHTML = `${format(result)}${outSuffix.replace(/²/g, '<sup>2</sup>')}`;

        const fragment = document.createDocumentFragment();
        stepBlocks.forEach((block, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-3 rounded-lg border border-outline-variant/10 bg-surface-container-low/40 p-3 text-sm transition-colors hover:bg-surface-container-low/60';
          const num = (index + 1).toString().padStart(2, '0');
          const flowItems = buildStepFlow(block.lines);
          const detailItems = flowItems.length
            ? `<ul class="mt-2 space-y-1 border-l border-outline-variant/20 pl-3">${flowItems
                .map((detail) => {
                  const valueClass = detail.type === 'answer'
                    ? 'math-textbook font-semibold text-primary'
                    : 'math-textbook text-on-surface-variant';
                  const valueDir = ['formula', 'substitution', 'answer'].includes(detail.type)
                    ? ' dir="ltr"'
                    : '';
                  return `<li><span class="font-semibold text-on-surface">${detail.label}:</span> <span class="${valueClass}"${valueDir}>${formatStepText(detail.value)}</span></li>`;
                })
                .join('')}</ul>`
            : '';
          li.innerHTML = `<span class="mt-0.5 font-mono text-[10px] text-primary flex-shrink-0 rounded-md bg-primary/10 px-2 py-1">${num}</span><div class="min-w-0"><p class="text-on-surface math-textbook font-semibold">${formatStepText(block.title)}</p>${detailItems}</div>`;
          fragment.append(li);
        });
        stepsEl.replaceChildren(fragment);
        updateSvgLabels(inputs, result, primaryUnit || outputUnit);
      };

      const renderError = (err) => {
        const msg = err instanceof Error ? err.message : (translations.unableToCalculate || '');
        
        const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
        errorBoxes.forEach(el => el.classList.add('hidden'));
        
        let foundField = false;
        const lowMsg = msg.toLowerCase();
        
        let targetKey = null;
        if (lowMsg.includes('c must be greater than leg a') || lowMsg.includes('larger than side a') || lowMsg.includes('hypotenuse c must be') || lowMsg.includes('hypotenuse c should')) targetKey = 'c';
        else if (lowMsg.includes('c must be greater than leg b') || lowMsg.includes('larger than side b')) targetKey = 'c';
        else if (lowMsg.includes('side a') && !lowMsg.includes('hypotenuse')) targetKey = 'a';
        else if (lowMsg.includes('side b') && !lowMsg.includes('hypotenuse')) targetKey = 'b';
        else if (lowMsg.includes('angle a')) targetKey = 'A';
        else if (lowMsg.includes('angle b')) targetKey = 'B';

        if (targetKey) {
           const box = section.querySelector(`[data-calc-input-error="${targetKey}"]`);
           if (box) { 
             box.textContent = msg; 
             box.classList.remove('hidden'); 
             foundField = true; 
           }
        }

        if (!foundField) {
          const directStatusMessages = [
            messages.positive,
            messages.invalid,
            angleRangeMessage,
            messages.hypotenuseKnownLeg,
            messages.hypotenuseLongest,
            messages.invalidTriangle,
            messages.projectionLessThanHypotenuse
          ].filter(Boolean);
          const errorPrefix = translations.errorPrefix || '';
          statusEl.textContent = directStatusMessages.includes(msg) ? msg : (errorPrefix ? `${errorPrefix}: ${msg}` : msg);
          statusEl.classList.add('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
          statusEl.classList.remove('text-on-surface-variant');
        } else {
          statusEl.textContent = translations.fixErrors || '';
          statusEl.classList.add('text-red-500', 'font-semibold');
          statusEl.classList.remove('text-on-surface-variant', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
        }

        resultWrap.classList.add('hidden');
        updateSvgLabels({}, undefined, '');
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        try {
          // Clear errors on fresh submit
          const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
          errorBoxes.forEach(el => el.classList.add('hidden'));

          const { values, primaryUnit } = parseInputs();
          const resultData = solve(values);
          if (Number.isNaN(resultData.result)) {
            throw new Error('Mathematical error. Verify your values accurately represent a right triangle.');
          }
          renderSuccess(resultData, primaryUnit, values);
          resultWrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (err) {
          renderError(err);
        }
      });

      form.addEventListener('reset', () => {
        setTimeout(() => {
          const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
          errorBoxes.forEach(el => el.classList.add('hidden'));

          statusEl.textContent = defaultStatus;
          statusEl.classList.remove('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
          statusEl.classList.add('text-on-surface-variant');
          resultWrap.classList.add('hidden');
          updateSvgLabels({}, undefined, '');
        }, 0);
      });

      // Live diagram updates as the user types (tolerant: skips empty/invalid, never throws).
      const liveUpdateDiagram = () => {
        try {
          const data = new FormData(form);
          const values = {};
          const units = {};
          for (const [key, val] of data.entries()) {
            if (key.endsWith('_unit')) {
              units[key.replace('_unit', '')] = val;
            } else {
              const str = String(val).trim();
              if (str === '') continue;
              const num = Number.parseFloat(str);
              if (!Number.isFinite(num) || num <= 0) continue;
              if ((key === 'A' || key === 'B') && num >= 90) continue;
              values[key] = num;
            }
          }
          let primaryUnit = null;
          for (const k of LENGTH_KEYS) {
            if (units[k]) { primaryUnit = units[k]; break; }
          }
          if (primaryUnit) {
            for (const k of LENGTH_KEYS) {
              if (values[k] !== undefined && units[k]) {
                const scale = UNIT_SCALE[units[k]] / UNIT_SCALE[primaryUnit];
                values[k] = values[k] * scale;
              }
            }
          }
          updateSvgLabels(values, undefined, primaryUnit || outputUnit);
        } catch (e) {
          // Never break the calculator on live updates.
        }
      };

      form.addEventListener('input', liveUpdateDiagram);
      form.addEventListener('change', liveUpdateDiagram);
    })();
  </script>
</section>



