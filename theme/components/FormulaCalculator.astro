---
import type { RightTriangleFormula } from 'src/data/rightTriangleFormulas';
import { getTranslations, pick } from 'theme/i18n/translations';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  formula: RightTriangleFormula;
  locale: string;
}

const { formula, locale } = Astro.props;

if (!formula.calculator) {
  throw new Error('FormulaCalculator requires a formula with a calculator configuration.');
}

const bundle = getTranslations(locale);
const solver = (bundle.solver as any) || {};
const units = (bundle.units as any) || {};

const calculator = formula.calculator!!;

const displayTitle = (bundle.formulas?.[formula.slug] as any)?.title || formula.title;
const defaultStatus = pick(solver, 'statusDefault', `Enter inputs to calculate {label}.`).replace('{label}', calculator.outputLabel);

const UNIT_LIST = [
  { val: 'm', label: units.m || 'meter' },
  { val: 'nm', label: units.nm || 'nanometer' },
  { val: 'um', label: units.um || 'micrometer' },
  { val: 'mm', label: units.mm || 'millimeter' },
  { val: 'cm', label: units.cm || 'centimeter' },
  { val: 'km', label: units.km || 'kilometer' },
  { val: 'in', label: units.in || 'inch' },
  { val: 'ft', label: units.ft || 'foot' },
  { val: 'yd', label: units.yd || 'yard' },
  { val: 'mi', label: units.mi || 'mile' },
  { val: 'nmi', label: units.nmi || 'nautical mile' },
  { val: 'ang', label: units.ang || 'angstrom' },
  { val: 'mil', label: units.mil || 'mil' },
  { val: 'pixel', label: units.pixel || 'pixel' },
  { val: 'pt', label: units.pt || 'point' },
  { val: 'survey_ft', label: units.survey_ft || 'survey ft' },
  { val: 'fathom', label: units.fathom || 'fathom' },
  { val: 'au', label: units.au || 'astronomic' },
  { val: 'ls', label: units.ls || 'l-sec' },
  { val: 'lm', label: units.lm || 'l-min' },
  { val: 'lh', label: units.lh || 'l-hour' },
  { val: 'ld', label: units.ld || 'l-day' },
  { val: 'ly', label: units.ly || 'lightyear' },
  { val: 'kly', label: units.kly || 'kilolightyear' },
  { val: 'pc', label: units.pc || 'parsec' },
  { val: 'mpc', label: units.mpc || 'megaparsec' }
];

const UNIT_SCALE = {
  m: 1, nm: 1e-9, um: 1e-6, mm: 1e-3, cm: 1e-2, km: 1e3,
  in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344, nmi: 1852,
  ang: 1e-10, mil: 0.0000254, pixel: 0.0002645833, pt: 0.0003527778,
  survey_ft: 0.3048006096, fathom: 1.8288, au: 149597870700,
  ls: 299792458, lm: 17987547480, lh: 1079252848800,
  ld: 25902068371200, ly: 9460730472580800, kly: 9460730472580800000,
  pc: 3.085677581e16, mpc: 3.085677581e22
};

const LENGTH_KEYS = ['a', 'b', 'c', 'p', 'q', 'h', 'r', 's', 'R'];

const scriptTranslations = {
  calculationComplete: "Calculation complete.", // I should add these to the bundle too
  unableToCalculate: "Unable to calculate.",
  fixErrors: "Please fix the errors in the fields above.",
  angleSuffix: "Ã‚Â°",
  sqUnits: (units.m ? ` ${units.m}<sup>2</sup>` : ' sq units'),
  resultLabel: pick(solver, 'resultLabel', 'Result'),
  solutionSteps: pick(solver, 'solutionSteps', 'Solution Steps'),
  formula: pick(solver, 'formulaLabel', 'Formula')
};
---

<section
  class="section-shell"
  data-formula-calculator
  data-kind={calculator.kind}
  data-output-label={calculator.outputLabel}
  data-output-unit={calculator.outputUnit ?? ''}
  data-default-status={defaultStatus}
  data-translations={JSON.stringify(scriptTranslations)}
>
  <h2 class="text-2xl font-semibold">{displayTitle} {pick(solver, 'calculateSuffix', 'Calculator')}</h2>
  <p class="mt-2 text-sm text-on-surface-variant">
    {(() => {
      const text = pick(solver, 'calculatorIntro', `This calculator follows {expression} and returns {label}.`).replace('{label}', calculator.outputLabel);
      if (text.includes('{expression}')) {
        const parts = text.split('{expression}');
        return (
          <Fragment>
            {parts[0]}
            <span class="math-textbook text-tertiary" set:html={katex.renderToString(formula.expression, { throwOnError: false })} />
            {parts[1]}
          </Fragment>
        );
      }
      return text;
    })()}
  </p>

  <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-start">
    <div class="flex-1 w-full space-y-4">
      <form class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" data-calc-form>
        {calculator.fields.map((field) => (
          <label class="grid gap-2 text-sm font-medium">
            <span>{field.label}</span>
            <div class="relative flex">
              <input
                class={`input-shell flex-1 ${LENGTH_KEYS.includes(field.key) ? 'rounded-r-none border-r-0' : 'pr-16'}`}
                type="number"
                step="any"
                min={field.min ?? 0}
                name={field.key}
                required
              />
              {LENGTH_KEYS.includes(field.key) ? (
                <select name={`${field.key}_unit`} class="bg-surface-container border border-outline/30 rounded-r-lg px-2 text-[10px] sm:text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary w-24 sm:w-28 text-on-surface-variant truncate">
                  {UNIT_LIST.map(u => (
                    <option value={u.val}>({u.val}) {u.label}</option>
                  ))}
                </select>
              ) : field.unit ? (
                <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs text-on-surface-variant">
                  {field.unit}
                </span>
              ) : null}
            </div>
            <p class="hidden text-xs text-error mt-0.5" data-calc-input-error={field.key}></p>
          </label>
        ))}

        <div class="sm:col-span-2 lg:col-span-1 xl:col-span-2 flex flex-wrap gap-3">
          <button type="submit" class="btn-primary">{pick(solver, 'calculate', 'Calculate')} {calculator.outputLabel}</button>
          <button type="reset" class="btn-secondary">{pick(solver, 'reset', 'Reset')}</button>
        </div>
      </form>

      <p class="text-sm text-on-surface-variant" data-calc-status role="status" aria-live="polite">
        {defaultStatus}
      </p>

      <div class="hidden surface-card border-primary/30 bg-surface-container-high" data-calc-result-wrap>
        <div class="flex items-center justify-between">
          <p class="font-label text-xs uppercase tracking-widest text-primary" data-calc-output-label>
            {calculator.outputLabel}
          </p>
          <span class="rounded bg-primary-fixed px-2 py-0.5 text-[10px] uppercase text-on-primary-fixed">{pick(solver, 'resultLabel', 'Result')}</span>
        </div>
        <p class="mt-2 font-mono text-3xl text-tertiary math-textbook" data-calc-output-value>-</p>

        
        <div class="mt-6 border-t border-outline-variant/30 pt-4">
          <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{pick(solver, 'solutionSteps', 'Solution Steps')}</h4>
          <ol class="mt-3 space-y-3" data-calc-steps></ol>
        </div>

        <p class="mt-4 text-xs italic text-on-surface-variant flex items-center gap-2">
          <span>{pick(solver, 'formulaLabel', 'Formula')}:</span>
          <span class="math-textbook" set:html={katex.renderToString(formula.expression, { throwOnError: false })} />
        </p>
      </div>
    </div>

    <div class="flex-1 w-full relative z-10 overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-container-lowest/70 p-4 sm:p-6 shadow-sm hidden sm:block">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
      <div class="mb-2">
        <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{pick(solver, 'liveVisualization', 'Live Visualization')}</p>
        <h3 class="mt-1 text-lg text-on-surface">{pick(solver, 'formulaDiagram', 'Formula Diagram')}</h3>
      </div>
      <svg class="relative h-auto w-full max-w-sm mx-auto" viewBox="0 0 460 300" aria-label="Dynamic right triangle">
        <defs>
          <linearGradient id="rt-fill-gradient2" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f1c97d" stop-opacity="0.3"></stop>
            <stop offset="100%" stop-color="#d4ad65" stop-opacity="0.12"></stop>
          </linearGradient>
        </defs>
        <path d="M 60 240 L 80 240 L 80 260" fill="none" stroke="#99907c" stroke-width="1.5" data-calc-svg-path-stroke></path>
        <path d="M 70 70 L 70 260 L 380 260 Z" fill="url(#rt-fill-gradient2)" stroke="#f1c97d" stroke-width="2.5" stroke-linejoin="round" data-calc-svg-path-fill></path>
        <line x1="70" y1="260" x2="196" y2="184" stroke="#f1c97d" stroke-width="2" stroke-dasharray="5 4" opacity="0.6" data-calc-svg-altitude></line>
        <text x="50" y="170" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="14" text-anchor="end" data-calc-svg-label="a">a = -</text>
        <text x="226" y="284" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="14" text-anchor="middle" data-calc-svg-label="b">b = -</text>
        <text x="246" y="152" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="15" text-anchor="start" data-calc-svg-label="c">c = -</text>
        <text x="316" y="248" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="12" text-anchor="end" data-calc-svg-label="A">A = -</text>
        <text x="88" y="94" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="12" text-anchor="start" data-calc-svg-label="B">B = -</text>
        <text x="146" y="210" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="13" text-anchor="end" data-calc-svg-label="h">h = -</text>
      </svg>
    </div>
  </div>

  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      if (!currentScript) return;

      const section = currentScript.closest('[data-formula-calculator]');
      if (!section) return;

      const translations = JSON.parse(section.getAttribute('data-translations') || '{}');
      const form = section.querySelector('[data-calc-form]');
      const statusEl = section.querySelector('[data-calc-status]');
      const resultWrap = section.querySelector('[data-calc-result-wrap]');
      const labelEl = section.querySelector('[data-calc-output-label]');
      const valueEl = section.querySelector('[data-calc-output-value]');
      const stepsEl = section.querySelector('[data-calc-steps]');
      const kind = section.getAttribute('data-kind') ?? '';
      const outputLabel = section.getAttribute('data-output-label') ?? 'Result';
      const outputUnit = section.getAttribute('data-output-unit') ?? '';
      const defaultStatus =
        section.getAttribute('data-default-status') ?? 'Fill values and click calculate.';

      if (!form || !statusEl || !resultWrap || !labelEl || !valueEl || !stepsEl) return;

      const UNIT_SCALE = {
        m: 1, nm: 1e-9, um: 1e-6, mm: 1e-3, cm: 1e-2, km: 1e3,
        in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344, nmi: 1852,
        ang: 1e-10, mil: 0.0000254, pixel: 0.0002645833, pt: 0.0003527778,
        survey_ft: 0.3048006096, fathom: 1.8288, au: 149597870700,
        ls: 299792458, lm: 17987547480, lh: 1079252848800,
        ld: 25902068371200, ly: 9460730472580800, kly: 9460730472580800000,
        pc: 3.085677581e16, mpc: 3.085677581e22
      };
      const LENGTH_KEYS = ['a', 'b', 'c', 'p', 'q', 'h', 'r', 's', 'R'];

      const toNumber = (value) => Number.parseFloat(String(value));
      const deg = (r) => (r * 180) / Math.PI;
      const rad = (d) => (d * Math.PI) / 180;
      const format = (n, digits = 4) => Number(n).toFixed(digits).replace(/\.?0+$/, '');

      const parseInputs = () => {
        const data = new FormData(form);
        const values = {};
        const units = {};
        for (const [key, val] of data.entries()) {
          if (key.endsWith('_unit')) {
            units[key.replace('_unit', '')] = val;
          } else {
            const num = toNumber(val);
            if (!Number.isFinite(num)) {
              throw new Error(`Invalid value for ${key}.`);
            }
            values[key] = num;
          }
        }

        let primaryUnit = null;
        for (const k of LENGTH_KEYS) {
          if (units[k]) {
            primaryUnit = units[k];
            break;
          }
        }

        if (primaryUnit) {
          for (const k of LENGTH_KEYS) {
            if (values[k] !== undefined && units[k]) {
              const scale = UNIT_SCALE[units[k]] / UNIT_SCALE[primaryUnit];
              values[k] = values[k] * scale;
            }
          }
        }

        return { values, primaryUnit };
      };

      const requirePositive = (...nums) => {
        if (nums.some((n) => !(n > 0))) {
          throw new Error('All values must be positive.');
        }
      };

      const solve = (v) => {
        switch (kind) {
          case 'pythagorean_c': {
            requirePositive(v.a, v.b);
            const r = Math.hypot(v.a, v.b);
            return {
              result: r,
              steps: [
                `**Solve for Hypotenuse c**<br/>The longest side is found by summing the squares of both legs.<br/>Use c = Ã¢Ë†Å¡(aÃ‚Â² + bÃ‚Â²)<br/>c = Ã¢Ë†Å¡(${v.a}Ã‚Â² + ${v.b}Ã‚Â²) = Ã¢Ë†Å¡(${format(v.a ** 2)} + ${format(v.b ** 2)}) = ${format(r)}`
              ]
            };
          }
          case 'leg_from_ac': {
            requirePositive(v.a, v.c);
            if (v.c <= v.a) throw new Error('Hypotenuse c must be greater than leg a.');
            const r = Math.sqrt(v.c * v.c - v.a * v.a);
            return {
              result: r,
              steps: [
                `**Solve for Leg b**<br/>Subtract the leg's square from the hypotenuse's square.<br/>Use b = Ã¢Ë†Å¡(cÃ‚Â² - aÃ‚Â²)<br/>b = Ã¢Ë†Å¡(${v.c}Ã‚Â² - ${v.a}Ã‚Â²) = Ã¢Ë†Å¡(${format(v.c ** 2)} - ${format(v.a ** 2)}) = ${format(r)}`
              ]
            };
          }
          case 'leg_from_bc': {
            requirePositive(v.b, v.c);
            if (v.c <= v.b) throw new Error('Hypotenuse c must be greater than leg b.');
            const r = Math.sqrt(v.c * v.c - v.b * v.b);
            return {
              result: r,
              steps: [
                `**Solve for Leg a**<br/>Derive the leg by subtracting squares from the hypotenuse.<br/>Use a = Ã¢Ë†Å¡(cÃ‚Â² - bÃ‚Â²)<br/>a = Ã¢Ë†Å¡(${v.c}Ã‚Â² - ${v.b}Ã‚Â²) = Ã¢Ë†Å¡(${format(v.c ** 2)} - ${format(v.b ** 2)}) = ${format(r)}`
              ]
            };
          }
          case 'area_legs': {
            requirePositive(v.a, v.b);
            const r = (v.a * v.b) / 2;
            return {
              result: r,
              steps: [
                `**Calculate Area**<br/>Multiply base and height, then divide by two for the inner space.<br/>Use Area = (a Ãƒâ€” b) / 2<br/>Area = (${v.a} Ãƒâ€” ${v.b}) / 2 = ${format(v.a * v.b)} / 2 = ${format(r)}`
              ]
            };
          }
          case 'perimeter': {
            requirePositive(v.a, v.b, v.c);
            const r = v.a + v.b + v.c;
            return {
              result: r,
              steps: [
                `**Calculate Perimeter**<br/>Find the total length of the triangle's boundaries.<br/>Use P = a + b + c<br/>P = ${v.a} + ${v.b} + ${v.c} = ${format(r)}`
              ]
            };
          }
          case 'semiperimeter': {
            requirePositive(v.a, v.b, v.c);
            const r = (v.a + v.b + v.c) / 2;
            return {
              result: r,
              steps: [
                `**Determine Semiperimeter**<br/>Calculate half of the perimeter for further area derivations.<br/>Use s = (a + b + c) / 2<br/>s = (${v.a} + ${v.b} + ${v.c}) / 2 = ${format(v.a + v.b + v.c)} / 2 = ${format(r)}`
              ]
            };
          }
          case 'sine': {
            requirePositive(v.a, v.c);
            if (v.a >= v.c) throw new Error('Leg a must be smaller than hypotenuse c.');
            const r = v.a / v.c;
            return {
              result: r,
              steps: [
                `**Solve for sin(A)**<br/>The sine ratio compares the opposite side to the hypotenuse.<br/>Use sin(A) = a / c<br/>sin(A) = ${v.a} / ${v.c} = ${format(r)}`
              ]
            };
          }
          case 'cosine': {
            requirePositive(v.b, v.c);
            if (v.b >= v.c) throw new Error('Leg b must be smaller than hypotenuse c.');
            const r = v.b / v.c;
            return {
              result: r,
              steps: [
                `**Solve for cos(A)**<br/>The cosine ratio compares the adjacent side to the hypotenuse.<br/>Use cos(A) = b / c<br/>cos(A) = ${v.b} / ${v.c} = ${format(r)}`
              ]
            };
          }
          case 'tangent': {
            requirePositive(v.a, v.b);
            const r = v.a / v.b;
            return {
              result: r,
              steps: [
                `**Solve for tan(A)**<br/>The tangent ratio compares the opposite leg to the adjacent leg.<br/>Use tan(A) = a / b<br/>tan(A) = ${v.a} / ${v.b} = ${format(r)}`
              ]
            };
          }
          case 'angle_asin': {
            requirePositive(v.a, v.c);
            const r = deg(Math.asin(v.a / v.c));
            return {
              result: r,
              steps: [
                `**Find Angle A from Sine**<br/>Apply the inverse sine to find the angle in degrees.<br/>Use A = sinÃ¢ÂÂ»Ã‚Â¹(a / c)<br/>A = sinÃ¢ÂÂ»Ã‚Â¹(${v.a} / ${v.c}) = sinÃ¢ÂÂ»Ã‚Â¹(${format(v.a / v.c)}) = ${format(r)}Ã‚Â°`
              ]
            };
          }
          case 'angle_acos': {
            requirePositive(v.b, v.c);
            const r = deg(Math.acos(v.b / v.c));
            return {
              result: r,
              steps: [
                `**Find Angle A from Cosine**<br/>Apply the inverse cosine to find the angle in degrees.<br/>Use A = cosÃ¢ÂÂ»Ã‚Â¹(b / c)<br/>A = cosÃ¢ÂÂ»Ã‚Â¹(${v.b} / ${v.c}) = cosÃ¢ÂÂ»Ã‚Â¹(${format(v.b / v.c)}) = ${format(r)}Ã‚Â°`
              ]
            };
          }
          case 'angle_atan': {
            requirePositive(v.a, v.b);
            const r = deg(Math.atan(v.a / v.b));
            return {
              result: r,
              steps: [
                `**Find Angle A from Tangent**<br/>Apply the inverse tangent to find the angle in degrees.<br/>Use A = tanÃ¢ÂÂ»Ã‚Â¹(a / b)<br/>A = tanÃ¢ÂÂ»Ã‚Â¹(${v.a} / ${v.b}) = tanÃ¢ÂÂ»Ã‚Â¹(${format(v.a / v.b)}) = ${format(r)}Ã‚Â°`
              ]
            };
          }
          case 'altitude': {
            let { a, b, c } = v;
            requirePositive(a, b);
            if (!c || c <= a || c <= b) c = Math.hypot(a, b);
            const r = (a * b) / c;
            return {
              result: r,
              steps: [
                `**Find Altitude h**<br/>Calculate the height to the hypotenuse using the leg product ratio.<br/>Use h = (a Ãƒâ€” b) / c<br/>h = (${a} Ãƒâ€” ${b}) / ${format(c)} = ${format(a * b)} / ${format(c)} = ${format(r)}`
              ]
            };
          }
          case 'projection_p': {
            requirePositive(v.a, v.c);
            const r = (v.a * v.a) / v.c;
            return {
              result: r,
              steps: [
                `**Find Projection p**<br/>Calculate the segment of the hypotenuse adjacent to leg a.<br/>Use p = aÃ‚Â² / c<br/>p = ${v.a}Ã‚Â² / ${v.c} = ${format(v.a ** 2)} / ${v.c} = ${format(r)}`
              ]
            };
          }
          case 'projection_q': {
            requirePositive(v.b, v.c);
            const r = (v.b * v.b) / v.c;
            return {
              result: r,
              steps: [
                `**Find Projection q**<br/>Calculate the segment of the hypotenuse adjacent to leg b.<br/>Use q = bÃ‚Â² / c<br/>q = ${v.b}Ã‚Â² / ${v.c} = ${format(v.b ** 2)} / ${v.c} = ${format(r)}`
              ]
            };
          }
          case 'inradius': {
            requirePositive(v.a, v.b, v.c);
            const r = (v.a + v.b - v.c) / 2;
            return {
              result: r,
              steps: [
                `**Calculate Inradius r**<br/>Find the radius of the largest circle that fits inside the triangle.<br/>Use r = (a + b - c) / 2<br/>r = (${v.a} + ${v.b} - ${v.c}) / 2 = ${format(v.a + v.b - v.c)} / 2 = ${format(r)}`
              ]
            };
          }
          case 'circumradius': {
            requirePositive(v.c);
            const r = v.c / 2;
            return {
              result: r,
              steps: [
                `**Calculate Circumradius R**<br/>The circumradius is simply half of the hypotenuse.<br/>Use R = c / 2<br/>R = ${v.c} / 2 = ${format(r)}`
              ]
            };
          }
          case 'cotangent': { requirePositive(v.a, v.b); const r = v.b/v.a; return { result: r, steps: [`**Calculate cot(A)**<br/>The ratio of adjacent side to opposite side.<br/>Use cot(A) = b / a<br/>cot(A) = ${v.b} / ${v.a} = ${format(r)}`] }; }
          case 'secant': { requirePositive(v.b, v.c); const r = v.c/v.b; return { result: r, steps: [`**Calculate sec(A)**<br/>The ratio of hypotenuse to adjacent side.<br/>Use sec(A) = c / b<br/>sec(A) = ${v.c} / ${v.b} = ${format(r)}`] }; }
          case 'cosecant': { requirePositive(v.a, v.c); const r = v.c/v.a; return { result: r, steps: [`**Calculate csc(A)**<br/>The ratio of hypotenuse to opposite side.<br/>Use csc(A) = c / a<br/>csc(A) = ${v.c} / ${v.a} = ${format(r)}`] }; }
          case 'leg_from_hc_sin': { requirePositive(v.c, v.A); const r = v.c * Math.sin(rad(v.A)); return { result: r, steps: [`**Solve for Leg a**<br/>Multiply hypotenuse by sine of the opposite angle.<br/>Use a = c Ãƒâ€” sin(A)<br/>a = ${v.c} Ãƒâ€” sin(${v.A}Ã‚Â°) = ${format(r)}`] }; }
          case 'leg_from_hc_cos': { requirePositive(v.c, v.A); const r = v.c * Math.cos(rad(v.A)); return { result: r, steps: [`**Solve for Leg b**<br/>Multiply hypotenuse by cosine of the adjacent angle.<br/>Use b = c Ãƒâ€” cos(A)<br/>b = ${v.c} Ãƒâ€” cos(${v.A}Ã‚Â°) = ${format(r)}`] }; }
          case 'leg_from_leg_tan': { requirePositive(v.b, v.A); const r = v.b * Math.tan(rad(v.A)); return { result: r, steps: [`**Solve for Leg a**<br/>Scale the adjacent leg by the tangent of angle A.<br/>Use a = b Ãƒâ€” tan(A)<br/>a = ${v.b} Ãƒâ€” tan(${v.A}Ã‚Â°) = ${format(r)}`] }; }
          case 'leg_from_leg_tan_div': { requirePositive(v.a, v.A); const r = v.a / Math.tan(rad(v.A)); return { result: r, steps: [`**Solve for Leg b**<br/>Divide the opposite leg by the tangent of angle A.<br/>Use b = a / tan(A)<br/>b = ${v.a} / tan(${v.A}Ã‚Â°) = ${format(r)}`] }; }
          case 'angle_b_from_a': { requirePositive(v.A); const r = 90 - v.A; return { result: r, steps: [`**Find Angle B**<br/>Subtract angle A from the triangle's 90-degree constant.<br/>Use B = 90Ã‚Â° - A<br/>B = 90Ã‚Â° - ${v.A}Ã‚Â° = ${format(r)}Ã‚Â°`] }; }
          case 'angle_a_from_b': { requirePositive(v.B); const r = 90 - v.B; return { result: r, steps: [`**Find Angle A**<br/>Subtract angle B from the triangle's 90-degree constant.<br/>Use A = 90Ã‚Â° - B<br/>A = 90Ã‚Â° - ${v.B}Ã‚Â° = ${format(r)}Ã‚Â°`] }; }
          case 'area_sin_a': { requirePositive(v.b, v.c, v.A); const r = 0.5 * v.b * v.c * Math.sin(rad(v.A)); return { result: r, steps: [`**Calculate Area**<br/>Find the area using two sides and the included angle.<br/>Use Area = 0.5 Ãƒâ€” b Ãƒâ€” c Ãƒâ€” sin(A)<br/>Area = 0.5 Ãƒâ€” ${v.b} Ãƒâ€” ${v.c} Ãƒâ€” sin(${v.A}Ã‚Â°) = ${format(r)}`] }; }
          case 'area_sin_b': { requirePositive(v.a, v.c, v.B); const r = 0.5 * v.a * v.c * Math.sin(rad(v.B)); return { result: r, steps: [`**Calculate Area**<br/>Find the area using two sides and the included angle.<br/>Use Area = 0.5 Ãƒâ€” a Ãƒâ€” c Ãƒâ€” sin(B)<br/>Area = 0.5 Ãƒâ€” ${v.a} Ãƒâ€” ${v.c} Ãƒâ€” sin(${v.B}Ã‚Â°) = ${format(r)}`] }; }
          case 'area_rs': { requirePositive(v.r, v.s); const r = v.r * v.s; return { result: r, steps: [`**Calculate Area**<br/>Derive the area from inradius and semiperimeter.<br/>Use Area = r Ãƒâ€” s<br/>Area = ${v.r} Ãƒâ€” ${v.s} = ${format(r)}`] }; }
          case 'area_ch': { requirePositive(v.c, v.h); const r = 0.5 * v.c * v.h; return { result: r, steps: [`**Calculate Area**<br/>Standard base-height formula applied to the hypotenuse.<br/>Use Area = 0.5 Ãƒâ€” c Ãƒâ€” h<br/>Area = 0.5 Ãƒâ€” ${v.c} Ãƒâ€” ${v.h} = ${format(r)}`] }; }
          case 'altitude_pq': { requirePositive(v.p, v.q); const r = Math.sqrt(v.p * v.q); return { result: r, steps: [`**Find Altitude h**<br/>The geometric mean of the hypotenuse segments.<br/>Use h = Ã¢Ë†Å¡(p Ãƒâ€” q)<br/>h = Ã¢Ë†Å¡(${v.p} Ãƒâ€” ${v.q}) = Ã¢Ë†Å¡(${format(v.p * v.q)}) = ${format(r)}`] }; }
          case 'leg_from_cp': { requirePositive(v.c, v.p); const r = Math.sqrt(v.c * v.p); return { result: r, steps: [`**Solve for Leg a**<br/>Calculate leg a from its projection onto the hypotenuse.<br/>Use a = Ã¢Ë†Å¡(c Ãƒâ€” p)<br/>a = Ã¢Ë†Å¡(${v.c} Ãƒâ€” ${v.p}) = Ã¢Ë†Å¡(${format(v.c * v.p)}) = ${format(r)}`] }; }
          case 'leg_from_cq': { requirePositive(v.c, v.q); const r = Math.sqrt(v.c * v.q); return { result: r, steps: [`**Solve for Leg b**<br/>Calculate leg b from its projection onto the hypotenuse.<br/>Use b = Ã¢Ë†Å¡(c Ãƒâ€” q)<br/>b = Ã¢Ë†Å¡(${v.c} Ãƒâ€” ${v.q}) = Ã¢Ë†Å¡(${format(v.c * v.q)}) = ${format(r)}`] }; }
          case 'hyp_from_pq': { requirePositive(v.p, v.q); const r = v.p + v.q; return { result: r, steps: [`**Solve for Hypotenuse c**<br/>Sum the two segments of the hypotenuse.<br/>Use c = p + q<br/>c = ${v.p} + ${v.q} = ${format(r)}`] }; }
          case 'identity_cos_from_sin': { requirePositive(v.sinA); const r = Math.sqrt(1 - (v.sinA * v.sinA)); return { result: r, steps: [`**Calculate cos(A)**<br/>Derive cosine from the sine value using the Pythagorean identity.<br/>Use cos(A) = Ã¢Ë†Å¡(1 - sinÃ‚Â²(A))<br/>cos(A) = Ã¢Ë†Å¡(1 - ${v.sinA}Ã‚Â²) = ${format(r)}`] }; }
          case 'tan_from_sin_cos': { requirePositive(v.sinA, v.cosA); const r = v.sinA / v.cosA; return { result: r, steps: [`**Calculate tan(A)**<br/>Determine tangent using the fundamental sine-cosine ratio.<br/>Use tan(A) = sin(A) / cos(A)<br/>tan(A) = ${v.sinA} / ${v.cosA} = ${format(r)}`] }; }
          case 'c_from_a_45': { requirePositive(v.a); const r = v.a * Math.SQRT2; return { result: r, steps: [`**Solve for Hypotenuse c**<br/>In a special 45-45-90 triangle, multiply leg by Ã¢Ë†Å¡2.<br/>Use c = a Ãƒâ€” Ã¢Ë†Å¡2<br/>c = ${v.a} Ãƒâ€” Ã¢Ë†Å¡2 = ${format(r)}`] }; }
          case 'a_from_c_45': { requirePositive(v.c); const r = v.c / Math.SQRT2; return { result: r, steps: [`**Solve for Leg a**<br/>In a special 45-45-90 triangle, divide hypotenuse by Ã¢Ë†Å¡2.<br/>Use a = c / Ã¢Ë†Å¡2<br/>a = ${v.c} / Ã¢Ë†Å¡2 = ${format(r)}`] }; }
          case 'long_from_short_30': { requirePositive(v.a); const r = v.a * Math.sqrt(3); return { result: r, steps: [`**Solve for Long Leg b**<br/>In a 30-60-90 triangle, the long leg is short leg Ãƒâ€” Ã¢Ë†Å¡3.<br/>Use b = a Ãƒâ€” Ã¢Ë†Å¡3<br/>b = ${v.a} Ãƒâ€” Ã¢Ë†Å¡3 = ${format(r)}`] }; }
          case 'c_from_a_30': { requirePositive(v.a); const r = v.a * 2; return { result: r, steps: [`**Solve for Hypotenuse c**<br/>In a 30-60-90 triangle, the hypotenuse is double the short leg.<br/>Use c = 2 Ãƒâ€” a<br/>c = 2 Ãƒâ€” ${v.a} = ${v.a * 2}`] }; }
          default:
            throw new Error(`Calculator type '${kind}' is not configured.`);
        }
      };

      const updateSvgLabels = (inputs, resultVal, outputUnit) => {
        const svgLabels = section.querySelectorAll('[data-calc-svg-label]');
        const strokeEl = section.querySelector('[data-calc-svg-path-stroke]');
        const fillEl = section.querySelector('[data-calc-svg-path-fill]');
        const altitudeLine = section.querySelector('[data-calc-svg-altitude]');
        const map = { ...inputs };
        
        let outKey = null;
        const lowL = outputLabel.toLowerCase();
        if (lowL.includes('leg a') || outputLabel === 'Leg a' || lowL === 'opposite a' || lowL === 'long leg') outKey = 'a';
        else if (lowL.includes('leg b') || outputLabel === 'Leg b' || lowL === 'adjacent b') outKey = 'b';
        else if (lowL.includes('hypotenuse c') || outputLabel === 'Hypotenuse c') outKey = 'c';
        else if (lowL.includes('angle a') || lowL.includes('sin(a)') || lowL.includes('cos(a)') || lowL.includes('tan(a)') || lowL.includes('cot(a)') || lowL.includes('sec(a)') || lowL.includes('csc(a)')) outKey = 'A';
        else if (lowL.includes('angle b') || lowL.includes('sin(b)') || lowL.includes('cos(b)') || lowL.includes('tan(b)') || lowL.includes('cot(b)') || lowL.includes('sec(b)') || lowL.includes('csc(b)')) outKey = 'B';
        else if (lowL.includes('altitude h') || outputLabel === 'Altitude h') outKey = 'h';
        else if (lowL.includes('projection p')) outKey = 'p';
        else if (lowL.includes('projection q')) outKey = 'q';

        if (outKey && resultVal !== undefined) map[outKey] = resultVal;

        // --- Derive A and B for visual shape scaling ---
        let drawA = map.a;
        let drawB = map.b;
        const drawC = map.c;
        const A_ang = map.A;
        const B_ang = map.B;

        if (!drawA || !drawB) {
            if (drawA && drawC && drawC > drawA) drawB = Math.sqrt(drawC*drawC - drawA*drawA);
            else if (drawB && drawC && drawC > drawB) drawA = Math.sqrt(drawC*drawC - drawB*drawB);
            else if (drawC && A_ang) { drawA = drawC * Math.sin(rad(A_ang)); drawB = drawC * Math.cos(rad(A_ang)); }
            else if (drawC && B_ang) { drawA = drawC * Math.cos(rad(B_ang)); drawB = drawC * Math.sin(rad(B_ang)); }
            else if (drawA && A_ang) drawB = drawA / Math.tan(rad(A_ang));
            else if (drawB && B_ang) drawA = drawB / Math.tan(rad(B_ang));
            else if (map.p && map.q) { drawC = map.p + map.q; drawA = Math.sqrt(drawC*map.p); drawB = Math.sqrt(drawC*map.q); }
            else if (map.h && drawC) { drawA = Math.sqrt(0.5*(drawC*drawC + drawC*Math.sqrt(Math.max(0, drawC*drawC - 4*map.h*map.h)))); drawB = Math.sqrt(Math.max(0, drawC*drawC - drawA*drawA)); }
        }

        const setPath = (aVal, bVal) => {
          const DEFAULT_STROKE = 'M 60 240 L 80 240 L 80 260';
          const DEFAULT_FILL = 'M 70 70 L 70 260 L 380 260 Z';
          if (!aVal || !bVal || !isFinite(aVal) || !isFinite(bVal) || aVal <= 0 || bVal <= 0) {
            if (fillEl) fillEl.setAttribute('d', DEFAULT_FILL);
            if (strokeEl) strokeEl.setAttribute('d', DEFAULT_STROKE);
            if (altitudeLine) altitudeLine.setAttribute('opacity', '0');
            // reset text positions
             for (const el of svgLabels) {
               const k = el.getAttribute('data-calc-svg-label');
               if (k === 'a') { el.setAttribute('x', '50'); el.setAttribute('y', '170'); el.setAttribute('text-anchor', 'end'); }
               if (k === 'b') { el.setAttribute('x', '226'); el.setAttribute('y', '284'); el.setAttribute('text-anchor', 'middle'); }
               if (k === 'c') { el.setAttribute('x', '246'); el.setAttribute('y', '152'); el.setAttribute('text-anchor', 'start'); }
               if (k === 'A') { el.setAttribute('x', '316'); el.setAttribute('y', '248'); el.setAttribute('text-anchor', 'end'); }
               if (k === 'B') { el.setAttribute('x', '88'); el.setAttribute('y', '94'); el.setAttribute('text-anchor', 'start'); }
               if (k === 'h') { el.setAttribute('x', '146'); el.setAttribute('y', '210'); el.setAttribute('text-anchor', 'end'); }
             }
            return;
          }

          const W = 460, H = 300, maxW = W - 100, maxH = H - 80;
          const aspectTri = bVal / aVal;
          const aspectBox = maxW / maxH;
          let dW = maxW, dH = dW / aspectTri;
          if (aspectTri <= aspectBox) { dH = maxH; dW = dH * aspectTri; }
          const lX = W/2 - dW/2, tY = H/2 - dH/2, rX = lX + dW, bY = tY + dH;

          if (fillEl) fillEl.setAttribute('d', `M ${lX} ${tY} L ${lX} ${bY} L ${rX} ${bY} Z`);
          
          const bSize = Math.min(20, dW * 0.15, dH * 0.15);
          if (strokeEl) strokeEl.setAttribute('d', `M ${lX} ${bY - bSize} L ${lX + bSize} ${bY - bSize} L ${lX + bSize} ${bY}`);

          const hX = lX + (dW * dH * dH) / (dW*dW + dH*dH);
          const hY = bY - (dW * dW * dH) / (dW*dW + dH*dH);
          if (altitudeLine) {
            altitudeLine.setAttribute('x1', lX);
            altitudeLine.setAttribute('y1', bY);
            altitudeLine.setAttribute('x2', hX);
            altitudeLine.setAttribute('y2', hY);
            altitudeLine.setAttribute('opacity', '0.6');
          }

          for (const el of svgLabels) {
             const key = el.getAttribute('data-calc-svg-label');
             if (key === 'a') { el.setAttribute('x', lX - 10); el.setAttribute('y', bY - dH/2 + 5); el.setAttribute('text-anchor', 'end'); }
             if (key === 'b') { el.setAttribute('x', lX + dW/2); el.setAttribute('y', bY + 20); el.setAttribute('text-anchor', 'middle'); }
             if (key === 'c') { el.setAttribute('x', lX + dW/2 + 15); el.setAttribute('y', bY - dH/2 - 10); el.setAttribute('text-anchor', 'start'); }
             if (key === 'A') { el.setAttribute('x', rX - Math.min(40, dW*0.1)); el.setAttribute('y', bY - 8); el.setAttribute('text-anchor', 'end'); }
             if (key === 'B') { el.setAttribute('x', lX + 12); el.setAttribute('y', tY + Math.min(40, dH*0.1) + 10); el.setAttribute('text-anchor', 'start'); }
             if (key === 'h') { el.setAttribute('x', lX + (hX - lX)*0.5 + 5); el.setAttribute('y', bY - (bY - hY)*0.5 + 5); el.setAttribute('text-anchor', 'end'); }
          }
        };

        setPath(drawA, drawB);
        // ---

        for (const el of svgLabels) {
          const key = el.getAttribute('data-calc-svg-label');
          if (map[key] !== undefined) {
            let u = outputUnit ? ` ${outputUnit}` : '';
            if (key === 'A' || key === 'B') u = 'Ã‚Â°';
            if (outKey === key) {
              el.textContent = `${key} = ${format(map[key])}${u}`;
              el.setAttribute('fill', '#f1c97d');
              el.setAttribute('font-weight', '700');
            } else {
              el.textContent = `${key} = ${format(map[key])}${u}`;
              el.setAttribute('fill', '#d0c5af');
              el.setAttribute('font-weight', 'normal');
            }
          } else {
            el.textContent = `${key} = -`;
            el.setAttribute('fill', '#b6b5b4');
            el.setAttribute('font-weight', 'normal');
          }
        }
      };

      const renderSuccess = (resultData, primaryUnit, inputs) => {
        statusEl.textContent = translations.calculationComplete || 'Calculation complete.';
        statusEl.classList.remove('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
        statusEl.classList.add('text-on-surface-variant');
        resultWrap.classList.remove('hidden');

        const { result, steps } = resultData;
        const formatStepText = (raw) =>
          String(raw)
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/([a-zA-Z])(\d+)/g, '<i>$1</i><sup>$2</sup>')
            .replace(/\^(\d+)/g, '<sup>$1</sup>')
            .replace(/²|Â²/g, '<sup>2</sup>')
            .replace(/³|Â³/g, '<sup>3</sup>')
            .replace(/(^|[^a-zA-Z<>])([a-zA-Z])(?![a-zA-Z<>])/g, '$1<i>$2</i>');

        const splitSubstitutionAndAnswer = (line) => {
          const normalized = String(line).trim();
          const parts = normalized.split('=').map((part) => part.trim()).filter(Boolean);
          if (parts.length >= 3) {
            return {
              substitution: parts.slice(0, -1).join(' = '),
              answer: parts[parts.length - 1]
            };
          }
          if (parts.length === 2) {
            return {
              substitution: normalized,
              answer: parts[1]
            };
          }
          return { substitution: normalized, answer: null };
        };

        const buildStepFlow = (lines) => {
          const cleanedLines = lines.map((line) => String(line).trim()).filter(Boolean);
          if (!cleanedLines.length) return [];

          const explanationParts = [];
          const equationLines = [];
          let formula = '';
          let substitution = '';
          let answer = '';

          for (const line of cleanedLines) {
            const normalizedLine = line.replace(/^use\s+/i, '').trim();
            if (normalizedLine.includes('=')) {
              equationLines.push(normalizedLine);
            } else {
              explanationParts.push(normalizedLine);
            }
          }

          if (equationLines.length > 0) {
            formula = equationLines[0];
            substitution = equationLines[equationLines.length - 1];
          }

          if (substitution) {
            const split = splitSubstitutionAndAnswer(substitution);
            if (split.answer) answer = split.answer;
          } else if (formula) {
            const split = splitSubstitutionAndAnswer(formula);
            if (split.answer) answer = split.answer;
          }

          const flow = [];
          if (formula) flow.push({ label: 'Formula', value: formula });
          if (substitution && substitution !== formula) {
            flow.push({ label: 'Substitution', value: substitution });
          }
          if (answer) flow.push({ label: 'Answer', value: answer });

          const explanation = explanationParts.join(' ').trim();
          if (explanation) flow.push({ label: 'Explanation', value: explanation });

          return flow.length ? flow : cleanedLines.map((line) => ({ label: 'Detail', value: line }));
        };

        const stepBlocks = steps
          .map((step) => {
            const lines = String(step)
              .split(/<br\s*\/?>/gi)
              .map((line) => line.trim())
              .filter(Boolean);
            if (!lines.length) return null;
            const title = lines[0].replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*/g, '').trim();
            return {
              title: title || lines[0],
              lines: lines.slice(1)
            };
          })
          .filter(Boolean);
        
        const getUnitSuffix = () => {
          const k = kind.toLowerCase();
          const isRatio = ['sine', 'cosine', 'tangent', 'cotangent', 'secant', 'cosecant', 'identity', 'ratio', 'tan_from'].some(r => k.includes(r));
          if (isRatio) return '';

          if (k.includes('angle')) {
            return outputUnit ? ` ${outputUnit}` : (translations.angleSuffix || 'Ã‚Â°');
          }

          if (k.includes('area')) {
            return (translations.sqUnits || ' sq units');
          }

          if (primaryUnit) return ` ${primaryUnit}`;
          return outputUnit ? ` ${outputUnit}` : '';
        };

        const outSuffix = getUnitSuffix();
        valueEl.innerHTML = `${format(result)}${outSuffix.replace(/²|Â²/g, '<sup>2</sup>')}`;

        const fragment = document.createDocumentFragment();
        stepBlocks.forEach((block, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-3 rounded-lg border border-outline-variant/10 bg-surface-container-low/40 p-3 text-sm transition-colors hover:bg-surface-container-low/60';
          const num = (index + 1).toString().padStart(2, '0');
          const flowItems = buildStepFlow(block.lines);
          const detailItems = flowItems.length
            ? `<ul class="mt-2 space-y-1 border-l border-outline-variant/20 pl-3">${flowItems
                .map((detail) => {
                  const valueClass = detail.label === 'Answer'
                    ? 'math-textbook font-semibold text-primary'
                    : 'math-textbook text-on-surface-variant';
                  return `<li><span class="font-semibold text-on-surface">${detail.label}:</span> <span class="${valueClass}">${formatStepText(detail.value)}</span></li>`;
                })
                .join('')}</ul>`
            : '';
          li.innerHTML = `<span class="mt-0.5 font-mono text-[10px] text-primary flex-shrink-0 rounded-md bg-primary/10 px-2 py-1">${num}</span><div class="min-w-0"><p class="text-on-surface math-textbook font-semibold">${formatStepText(block.title)}</p>${detailItems}</div>`;
          fragment.append(li);
        });
        stepsEl.replaceChildren(fragment);
        updateSvgLabels(inputs, result, primaryUnit || outputUnit);
      };

      const renderError = (err) => {
        const msg = err instanceof Error ? err.message : (translations.unableToCalculate || 'Unable to calculate.');
        
        const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
        errorBoxes.forEach(el => el.classList.add('hidden'));
        
        let foundField = false;
        const lowMsg = msg.toLowerCase();
        
        let targetKey = null;
        if (lowMsg.includes('c must be greater than leg a') || lowMsg.includes('larger than side a') || lowMsg.includes('hypotenuse c must be')) targetKey = 'c';
        else if (lowMsg.includes('c must be greater than leg b') || lowMsg.includes('larger than side b')) targetKey = 'c';
        else if (lowMsg.includes('side a') && !lowMsg.includes('hypotenuse')) targetKey = 'a';
        else if (lowMsg.includes('side b') && !lowMsg.includes('hypotenuse')) targetKey = 'b';
        else if (lowMsg.includes('angle a')) targetKey = 'A';
        else if (lowMsg.includes('angle b')) targetKey = 'B';

        if (targetKey) {
           const box = section.querySelector(`[data-calc-input-error="${targetKey}"]`);
           if (box) { 
             box.textContent = msg; 
             box.classList.remove('hidden'); 
             foundField = true; 
           }
        }

        if (!foundField) {
          statusEl.textContent = `Error: ${msg}`;
          statusEl.classList.add('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
          statusEl.classList.remove('text-on-surface-variant');
        } else {
          statusEl.textContent = translations.fixErrors || 'Please fix the errors in the fields above.';
          statusEl.classList.add('text-red-500', 'font-semibold');
          statusEl.classList.remove('text-on-surface-variant', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
        }

        resultWrap.classList.add('hidden');
        updateSvgLabels({}, undefined, '');
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        try {
          // Clear errors on fresh submit
          const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
          errorBoxes.forEach(el => el.classList.add('hidden'));

          const { values, primaryUnit } = parseInputs();
          const resultData = solve(values);
          if (Number.isNaN(resultData.result)) {
            throw new Error('Mathematical error. Verify your values accurately represent a right triangle.');
          }
          renderSuccess(resultData, primaryUnit, values);
        } catch (err) {
          renderError(err);
        }
      });

      form.addEventListener('reset', () => {
        setTimeout(() => {
          const errorBoxes = section.querySelectorAll('[data-calc-input-error]');
          errorBoxes.forEach(el => el.classList.add('hidden'));

          statusEl.textContent = defaultStatus;
          statusEl.classList.remove('text-red-500', 'font-semibold', 'bg-red-500/10', 'px-3', 'py-2', 'rounded-lg', 'border', 'border-red-500/20');
          statusEl.classList.add('text-on-surface-variant');
          resultWrap.classList.add('hidden');
          updateSvgLabels({}, undefined, '');
        }, 0);
      });
    })();
  </script>
</section>
