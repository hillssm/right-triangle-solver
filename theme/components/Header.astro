---
import LanguageSwitcher from 'theme/components/LanguageSwitcher.astro';
import { localizePath, type Locale } from 'theme/i18n/locales';

import { getLocalizedNavItems } from 'theme/utils/site';

interface Props {
  locale: Locale;
  siteTitle: string;
  logo: string;
  navLabels: Record<string, string>;
}

const { locale, siteTitle, logo, navLabels } = Astro.props;

const navItems = getLocalizedNavItems(locale, 'header', navLabels);
const homeHref = localizePath(locale, '/');
const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => {
  if (path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
};
---

<header class="sticky top-0 z-40 border-b border-outline-variant/30 bg-white/25 shadow-sm md:backdrop-blur-xl">
  <div class="pointer-events-none absolute inset-x-0 -bottom-px h-px bg-gradient-to-r from-transparent via-primary/35 to-transparent"></div>
  <div class="mx-auto flex w-full max-w-[1200px] items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <a
      href={homeHref}
      class="group inline-flex min-w-0 items-center gap-2 text-on-surface transition-colors hover:text-primary sm:gap-3"
      data-mobile-link
    >
      <div class="flex h-9 w-9 items-center justify-center rounded-md border border-outline-variant/70 bg-surface-container-low shadow-[0_12px_28px_-20px_rgba(241,201,125,0.35)] transition-transform duration-300 group-hover:scale-105">
        <img src={logo} alt={`${siteTitle} logo`} width="240" height="240" class="h-5 w-auto" loading="lazy" />
      </div>
      <span class="max-w-[12rem] truncate font-headline text-sm font-medium tracking-[-0.02em] text-on-surface sm:max-w-none sm:text-base">{siteTitle}</span>
    </a>

    <div class="hidden items-center gap-4 md:flex">
      <nav aria-label="Primary" class="flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'btn-primary px-4 py-2 text-[11px] uppercase tracking-[0.16em] font-label',
              normalizePath(item.href) === normalizePath(currentPath)
                ? ''
                : 'opacity-90 hover:opacity-100'
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="h-6 w-px bg-outline-variant/30"></div>
      <LanguageSwitcher currentLocale={locale} />
    </div>

    <button
      type="button"
      data-menu-toggle
      class="inline-flex items-center justify-center rounded-md border border-outline-variant/60 bg-surface-container-low p-2 text-on-surface-variant transition-all duration-200 hover:border-primary/35 hover:text-primary md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span data-icon-open aria-hidden="true" class="material-symbols-outlined text-xl">menu</span>
      <span data-icon-close class="material-symbols-outlined text-xl hidden" aria-hidden="true">close</span>
    </button>
  </div>

  <div
    data-mobile-overlay
    class="fixed inset-0 z-40 hidden bg-black/70 backdrop-blur-[2px] md:hidden"
    aria-hidden="true"
  ></div>

  <aside
    id="mobile-menu"
    data-mobile-panel
    aria-hidden="true"
    inert
    class="fixed inset-y-0 right-0 z-50 h-dvh w-full translate-x-full border-l border-outline-variant/70 bg-surface-container-low px-5 pb-6 pt-[max(1.25rem,env(safe-area-inset-top))] shadow-[var(--shadow-luxury)] transition-transform duration-300 sm:w-[85%] sm:max-w-sm md:hidden"
  >
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-md border border-outline-variant/70 bg-surface-container-high">
          <img src={logo} alt="" width="240" height="240" class="h-4 w-auto" loading="lazy" />
        </div>
        <span class="max-w-[11rem] truncate text-sm font-semibold text-on-surface">{siteTitle}</span>
      </div>
      <div class="flex items-center">
        <button
          type="button"
          data-menu-close
          class="rounded-md border border-outline-variant/60 p-2 text-on-surface-variant transition-colors hover:text-primary"
          aria-label="Close menu"
        >
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    </div>

    <div class="mb-4">
      <LanguageSwitcher currentLocale={locale} />
    </div>

    <nav class="grid gap-2 pb-6" aria-label="Mobile">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md border px-4 py-3 text-sm font-medium transition-all duration-200',
            normalizePath(item.href) === normalizePath(currentPath)
              ? 'border-primary/45 bg-primary/10 text-primary'
              : 'border-outline-variant/55 text-on-surface-variant hover:border-primary/25 hover:bg-surface-container-high hover:text-primary'
          ]}
          data-mobile-link
        >
          {item.label}
        </a>
      ))}
    </nav>
  </aside>

  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      if (!currentScript) return;

      const header = currentScript.closest('header');
      if (!header) return;

      const initMobileMenu = () => {
        const toggleButton = header.querySelector('[data-menu-toggle]');
        const closeButton = header.querySelector('[data-menu-close]');
        const panel = header.querySelector('[data-mobile-panel]');
        const overlay = header.querySelector('[data-mobile-overlay]');
        const openIcon = header.querySelector('[data-icon-open]');
        const closeIcon = header.querySelector('[data-icon-close]');
        const mobileLinks = header.querySelectorAll('[data-mobile-link]');

        if (!toggleButton || !panel || !overlay || !openIcon || !closeIcon) {
          return;
        }

        const setMenuState = (isOpen) => {
          toggleButton.setAttribute('aria-expanded', String(isOpen));
          panel.setAttribute('aria-hidden', String(!isOpen));
          overlay.setAttribute('aria-hidden', String(!isOpen));
          if (isOpen) {
            panel.removeAttribute('inert');
          } else {
            panel.setAttribute('inert', '');
          }

          panel.classList.toggle('translate-x-full', !isOpen);
          overlay.classList.toggle('hidden', !isOpen);
          openIcon.classList.toggle('hidden', isOpen);
          closeIcon.classList.toggle('hidden', !isOpen);

          document.body.style.overflow = isOpen ? 'hidden' : '';
        };

        toggleButton.addEventListener('click', () => {
          const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
          setMenuState(!expanded);
        });

        closeButton?.addEventListener('click', () => setMenuState(false));
        overlay.addEventListener('click', () => setMenuState(false));

        mobileLinks.forEach((link) => {
          link.addEventListener('click', () => setMenuState(false));
        });
      };

      const deferredInit = () => {
        window.setTimeout(initMobileMenu, 0);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', deferredInit, { once: true });
      } else {
        deferredInit();
      }
    })();
  </script>
</header>
