---
import { localizePath, type Locale } from 'theme/i18n/locales';
import { getLocalizedNavItems } from 'theme/utils/site';

interface Props {
  locale: Locale;
  siteTitle: string;
  logo: string;
  navLabels: Record<string, string>;
}

const { locale, siteTitle, logo, navLabels } = Astro.props;

const navItems = getLocalizedNavItems(locale, 'header', navLabels);
const homeHref = localizePath(locale, '/');
---

<header class="sticky top-0 z-40 border-b border-primary/15" style="background: linear-gradient(180deg, rgba(24,17,12,0.95) 0%, rgba(14,10,7,0.86) 100%); backdrop-filter: blur(16px) saturate(1.2);">
  <div class="mx-auto flex w-full max-w-[1200px] items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <a href={homeHref} class="group inline-flex items-center gap-3 text-on-surface transition-colors hover:text-primary" data-mobile-link>
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-primary-container shadow-[0_0_16px_-4px_rgba(212,175,116,0.4)] transition-transform duration-300 group-hover:scale-105">
        <img src={logo} alt={`${siteTitle} logo`} class="h-5 w-auto" loading="lazy" />
      </div>
      <span class="text-sm font-bold tracking-tight sm:text-base">{siteTitle}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-2 text-on-surface-variant transition-all duration-200 hover:bg-primary/8 hover:text-primary"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      data-menu-toggle
      class="inline-flex items-center justify-center rounded-lg border border-outline-variant/30 p-2 text-on-surface-variant transition-all duration-200 hover:border-primary/35 hover:text-primary md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span data-icon-open aria-hidden="true" class="material-symbols-outlined text-xl">menu</span>
      <span data-icon-close class="material-symbols-outlined text-xl hidden" aria-hidden="true">close</span>
    </button>
  </div>

  <div
    data-mobile-overlay
    class="fixed inset-0 hidden bg-black/60 backdrop-blur-sm md:hidden"
    aria-hidden="true"
  ></div>

  <aside
    id="mobile-menu"
    data-mobile-panel
    aria-hidden="true"
    class="fixed right-0 top-0 h-full w-[85%] max-w-sm translate-x-full border-l border-primary/15 bg-[linear-gradient(180deg,#19120c_0%,#0f0a06_100%)] p-6 shadow-[var(--shadow-luxury)] transition-transform duration-300 md:hidden"
  >
    <div class="mb-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-primary-container">
          <img src={logo} alt="" class="h-4 w-auto" loading="lazy" />
        </div>
        <span class="text-sm font-semibold text-on-surface">{siteTitle}</span>
      </div>
      <button
        type="button"
        data-menu-close
        class="rounded-lg border border-outline-variant/20 p-2 text-on-surface-variant transition-colors hover:text-primary"
        aria-label="Close menu"
      >
        <span class="material-symbols-outlined text-lg">close</span>
      </button>
    </div>

    <nav class="grid gap-2" aria-label="Mobile">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-xl border border-outline-variant/15 px-4 py-3 text-sm font-medium text-on-surface-variant transition-all duration-200 hover:border-primary/25 hover:bg-primary/8 hover:text-primary"
          data-mobile-link
        >
          {item.label}
        </a>
      ))}
    </nav>
  </aside>

  <script is:inline>
    (() => {
      const currentScript = document.currentScript;
      if (!currentScript) return;

      const header = currentScript.closest('header');
      if (!header) return;

      const toggleButton = header.querySelector('[data-menu-toggle]');
      const closeButton = header.querySelector('[data-menu-close]');
      const panel = header.querySelector('[data-mobile-panel]');
      const overlay = header.querySelector('[data-mobile-overlay]');
      const openIcon = header.querySelector('[data-icon-open]');
      const closeIcon = header.querySelector('[data-icon-close]');
      const mobileLinks = header.querySelectorAll('[data-mobile-link]');

      if (!toggleButton || !panel || !overlay || !openIcon || !closeIcon) {
        return;
      }

      const setMenuState = (isOpen) => {
        toggleButton.setAttribute('aria-expanded', String(isOpen));
        panel.setAttribute('aria-hidden', String(!isOpen));
        overlay.setAttribute('aria-hidden', String(!isOpen));

        panel.classList.toggle('translate-x-full', !isOpen);
        overlay.classList.toggle('hidden', !isOpen);
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);

        document.body.style.overflow = isOpen ? 'hidden' : '';
      };

      toggleButton.addEventListener('click', () => {
        const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
        setMenuState(!expanded);
      });

      closeButton?.addEventListener('click', () => setMenuState(false));
      overlay.addEventListener('click', () => setMenuState(false));

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => setMenuState(false));
      });
    })();
  </script>
</header>
