---
interface Props {
  heading: string;
}

const { heading } = Astro.props;

const defaultSteps = [
  {
    icon: 'input',
    title: '1. Enter known values',
    desc: 'Provide any valid right-triangle inputs and keep units consistent.'
  },
  {
    icon: 'bolt',
    title: '2. Solve instantly',
    desc: 'The solver applies Pythagorean and trigonometric relations in real time.'
  },
  {
    icon: 'insights',
    title: '3. Validate the geometry',
    desc: 'Use live visualization, ratios, and derived metrics to verify your answer.'
  }
];
---

<section id="how-it-works" class="section-shell" aria-labelledby="how-it-works-heading">
  <div class="flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/12 text-primary">
      <span class="material-symbols-outlined text-xl">rocket_launch</span>
    </div>
    <h2 id="how-it-works-heading" class="text-2xl sm:text-3xl">{heading}</h2>
  </div>
  <p class="mt-3 max-w-2xl text-sm text-on-surface-variant">
    From input to proof-ready output in three clean steps.
  </p>

  <div class="mt-6 grid gap-5 sm:grid-cols-3 anim-stagger">
    <slot>
      {
        defaultSteps.map((step) => (
          <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
              <span class="material-symbols-outlined text-xl">{step.icon}</span>
            </div>
            <h3 class="text-base font-semibold text-on-surface">{step.title}</h3>
            <p class="text-sm leading-relaxed text-on-surface-variant">{step.desc}</p>
          </article>
        ))
      }
    </slot>
  </div>
</section>
