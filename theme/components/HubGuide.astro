    <img src={imgSrc('hub-parts.svg')} alt={rich(G.sDiagram.alt)} class="mx-auto h-auto w-full max-w-xl" loading="lazy" />
    <figcaption class="mt-2 text-center text-sm text-on-surface-variant" set:html={rich(G.sDiagram.caption)} />
  </figure>
  <h3 set:html={rich(G.sDiagram.h3)} />
  <div class="not-prose overflow-x-auto">
    <table class="w-full min-w-[420px] border-collapse text-sm">
      <thead>
        <tr class="border-b border-outline-variant/30 text-left">
          <th class="py-2 pr-4 font-semibold" set:html={rich(G.sDiagram.thSymbol)} />
          <th class="py-2 font-semibold" set:html={rich(G.sDiagram.thMeaning)} />
        </tr>
      </thead>
      <tbody>
        {(G.sDiagram.rows ?? []).map((row: string[]) => (
          <tr class="border-b border-outline-variant/15 last:border-0">
            <td class="py-2 pr-4 font-mono" set:html={rich(row[0])} />
            <td class="py-2" set:html={rich(row[1])} />
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p set:html={rich(G.sDiagram.outro)} />
</section>

