---
import katex from 'katex';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Faq from 'theme/components/Faq.astro';
import { HUB_GUIDE_FAQS } from 'src/data/rightTriangleHubGuide';

const tex = (latex: string) =>
  katex.renderToString(latex, { throwOnError: false, displayMode: false });
const texBlock = (latex: string) =>
  katex.renderToString(latex, { throwOnError: false, displayMode: true });

// Inline the two interactive diagrams so the toggle scripts can reach their <g> groups.
const inlineHubSvg = (name: string) =>
  readFileSync(join(process.cwd(), 'public', 'images', 'hub', name), 'utf8');
