<section id="hub-related" class="mx-auto mt-12 w-full max-w-4xl section-shell scroll-mt-24">
  <h2 class="font-headline text-2xl font-bold text-on-surface" set:html={rich(G.sRelated.h2)} />
  <p class="mt-2 max-w-2xl text-sm text-on-surface-variant" set:html={rich(G.sRelated.intro)} />
  {(() => {
    let n = 0;
    return (G.sRelated.groups ?? []).map((gr: any) => (
      <div class="mt-10 border-t border-primary/25 pt-8">
        <h3 class="font-headline text-xl font-bold text-on-surface" set:html={rich(gr.title)} />
        <ul class="mt-5 grid gap-x-12 sm:grid-cols-2">
          {(gr.links ?? []).map((ph: string) => {
            n++;
            const num = String(n).padStart(2, '0');
            return (
              <li class="border-b border-primary/10">
                <a href={relLink(ph).href} class="group flex items-baseline gap-4 py-3.5">
                  <span class="font-headline text-sm text-primary/70 transition-colors group-hover:text-primary">{num}</span>
                  <span class="text-[15px] leading-snug text-on-surface transition-colors group-hover:text-primary" set:html={rich(relLink(ph).label)} />
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ));
  })()}
</section>

