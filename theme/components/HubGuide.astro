---
import katex from 'katex';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Faq from 'theme/components/Faq.astro';
import { localizePath, type Locale } from 'theme/i18n/locales';

interface Props {
  guide: any;
  names: Record<string, string>;
  locale: Locale;
}

const { guide: G, names, locale } = Astro.props;

const HUB_IMG_DIR = join(process.cwd(), 'public', 'images', 'hub');

const rich = (s: string): string => {
  if (!s || typeof s !== 'string') return '';
  let out = s;
  for (const [k, v] of Object.entries(names)) {
    out = out.split(k).join(v);
  }
  if (locale !== 'en') {
    out = out.split('href="/').join(`href="/${locale}/`);
  }
  out = out.replace(
    /\[\[\[(.+?)\]\]\]/g,
    (_, l) =>
      `<div dir="ltr" class="katex-block">${katex.renderToString(l, { throwOnError: false, displayMode: true })}</div>`
  );
  out = out.replace(
    /\[\[(.+?)\]\]/g,
    (_, l) =>
      `<span dir="ltr" class="math-textbook">${katex.renderToString(l, { throwOnError: false, displayMode: false })}</span>`
  );
  return out;
};

const locFile = (name: string): string => {
  const localized = join(HUB_IMG_DIR, name.replace('.svg', `-${locale}.svg`));
  return existsSync(localized) ? localized : join(HUB_IMG_DIR, name);
};

const inlineHubSvg = (name: string): string => {
  try {
    return readFileSync(locFile(name), 'utf8');
  } catch {
    return '';
  }
};

const imgSrc = (name: string): string => {
  const localized = `/images/hub/${name.replace('.svg', `-${locale}.svg`)}`;
  return existsSync(join(HUB_IMG_DIR, name.replace('.svg', `-${locale}.svg`)))
    ? localized
    : `/images/hub/${name}`;
};

const HREFS: Record<string, string> = {
  __SIDE_CALC__: '/right-triangle-side-calculator/',
  __SIDEANGLE_CALC__: '/right-triangle-side-from-angle-calculator/',
  __ANGLE_CALC__: '/right-triangle-angle-calculator/',
  __TRIG_CALC__: '/right-triangle-trig-ratios-calculator/',
  __AREA_CALC__: '/right-triangle-area-calculator/',
  __MEAS_CALC__: '/right-triangle-measurements-calculator/',
  __ALT_CALC__: '/right-triangle-altitude-calculator/',
  __PROJ_CALC__: '/right-triangle-projection-calculator/',
  __RAD_CALC__: '/right-triangle-radius-calculator/',
  __SPECIAL_CALC__: '/special-right-triangle-calculator/',
  __TRIPLES_CALC__: '/pythagorean-triples-calculator/'
};

const relLink = (ph: string) => ({
  href: localizePath(locale, HREFS[ph] ?? '/'),
  label: names[ph] ?? ph
});

const inputAttrs = (inputs: Record<string, string> | null) => {
  if (!inputs) return {};
  const attrs: Record<string, string> = {};
  // Use case-safe attribute names: HTML lowercases data-* names, so
  // data-A would collide with data-a. Angles get their own prefix.
  for (const [k, v] of Object.entries(inputs)) {
    const name = k === 'A' ? 'angle-a' : k === 'B' ? 'angle-b' : `leg-${k.toLowerCase()}`;
    attrs[`data-${name}`] = v;
  }
  return attrs;
};

const faqItems = (G.faqs ?? []).map((f: any) => ({
  question: rich(f.q),
  answer: rich(f.a)
}));

const tocAnchors = ['#hub-diagram','#hub-how-to','#hub-fundamentals','#hub-formulas','#hub-visualizations','#hub-examples','#hub-real-world','#hub-special','#hub-triples','#hub-mistakes','#hub-verify','#faq'];
const tocEntries = [
  ...((G.toc ?? []).map((label: string, i: number) => ({ label, href: tocAnchors[i] || '' }))),
  { label: G.sRelated?.h2 || '', href: '#hub-related' }
].filter((e) => e.label && e.href);
---

<nav class="mx-auto mt-12 w-full max-w-4xl section-shell" aria-label={rich(G.tocTitle)}>
  <h2 class="text-2xl font-semibold" set:html={rich(G.tocTitle)} />
  <ol class="mt-4 grid gap-2 sm:grid-cols-2">
    {tocEntries.map((entry) => (
      <li>
        <a class="hover:text-primary hover:underline" href={entry.href} set:html={rich(entry.label)} />
      </li>
    ))}
  </ol>
</nav>

