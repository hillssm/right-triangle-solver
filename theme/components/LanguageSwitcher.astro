---
import {
  LOCALE_LABELS,
  SUPPORTED_LOCALES,
  localizePath,
  type Locale
} from 'theme/i18n/locales';

interface Props {
  currentLocale: Locale;
  switchLabel: string;
}

const { currentLocale, switchLabel } = Astro.props;
---

<nav aria-label={switchLabel} class="flex flex-wrap items-center gap-2">
  <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{switchLabel}</span>
  <ul class="flex flex-wrap items-center gap-1 text-xs">
    {SUPPORTED_LOCALES.map((locale) => {
      const active = locale === currentLocale;
      return (
        <li>
          <a
            href={localizePath(locale, '/')}
            class:list={[
              'inline-flex rounded-md border px-2 py-1 transition-colors',
              active
                ? 'border-primary/60 bg-primary/16 text-primary'
                : 'border-outline-variant/40 text-on-surface-variant hover:border-primary/40 hover:text-primary'
            ]}
            aria-current={active ? 'page' : undefined}
            lang={locale}
          >
            {locale.toUpperCase()} <span class="sr-only">{LOCALE_LABELS[locale]}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
