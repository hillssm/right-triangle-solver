---
interface Props {
  locale?: string;
  calculatorHref?: string;
  libraryHref?: string;
  practiceHref?: string;
  formulasHref?: string;
}

import { getTranslations } from '../i18n/translations';

const {
  locale = 'en',
  calculatorHref = '/',
  libraryHref = '/library/',
  practiceHref = '/practice/',
  formulasHref = '/formulas/'
} = Astro.props;

const bundle = getTranslations(locale as any);
const lib = bundle.library || {};
const siteName = bundle.content?.site?.title || 'Right Triangle Solver';
---

<div class="bg-surface text-on-surface font-body flex flex-col md:flex-row rounded-3xl overflow-hidden border border-outline-variant/30 shadow-luxury relative">
  <!-- Ambient glow -->
  <div class="ambient-glow" style="width: 500px; height: 500px; top: -150px; left: 30%; background: rgba(181, 140, 69, 0.15);"></div>
  <div class="ambient-glow" style="width: 400px; height: 400px; bottom: -100px; right: -50px; background: rgba(91, 64, 0, 0.1);"></div>

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="hidden w-[280px] shrink-0 flex-col border-r border-outline-variant/20 bg-gradient-to-b from-surface-container-low to-surface-container py-6 md:flex">
    <div class="mb-10 px-8">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-primary-container shadow-md">
          <span class="material-symbols-outlined text-lg text-on-primary" style="font-variation-settings: 'FILL' 1;">architecture</span>
        </div>
        <div>
          <div class="text-sm font-headline font-bold text-on-primary-container">{siteName}</div>
          <p class="font-label text-[9px] uppercase tracking-[0.25em] text-on-surface-variant">{lib.precisionSolver || 'Precision Solver'}</p>
        </div>
      </div>
    </div>

    <nav class="flex-1 space-y-1 px-4" aria-label="Workspace navigation">
      <a class="group flex items-center gap-4 rounded-xl px-5 py-3.5 text-on-surface-variant transition-all duration-300 hover:bg-primary/5 hover:text-primary" href={calculatorHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">calculate</span>
        <span class="text-sm tracking-wide">{lib.nav_calculator || 'Calculator'}</span>
      </a>
      <a class="group flex items-center gap-4 rounded-xl border-l-[3px] border-primary bg-primary/10 px-5 py-3.5 text-primary transition-all duration-300" href={libraryHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110" style="font-variation-settings: 'FILL' 1;">menu_book</span>
        <span class="text-sm font-medium tracking-wide">{lib.nav_library || 'Library'}</span>
        <span class="ml-auto h-1.5 w-1.5 rounded-full bg-primary shadow-sm"></span>
      </a>
      <a class="group flex items-center gap-4 rounded-xl px-5 py-3.5 text-on-surface-variant transition-all duration-300 hover:bg-primary/5 hover:text-primary" href={practiceHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">edit_note</span>
        <span class="text-sm tracking-wide">{lib.nav_practice || 'Practice'}</span>
      </a>
    </nav>

    <div class="mb-6 px-6">
      <button class="btn-primary w-full justify-center gap-2 py-3 text-sm" type="button">
        <span class="material-symbols-outlined text-base">add_circle</span>
        {lib.newProof || 'New Proof'}
      </button>
    </div>

    <div class="space-y-1 border-t border-outline-variant/8 px-4 pt-5">
      <a class="flex items-center gap-4 rounded-lg px-5 py-2.5 text-on-surface-variant transition-colors hover:text-primary" href="#">
        <span class="material-symbols-outlined text-lg">settings</span>
        <span class="text-xs font-label tracking-wide">{lib.settings || 'Settings'}</span>
      </a>
      <a class="flex items-center gap-4 rounded-lg px-5 py-2.5 text-on-surface-variant transition-colors hover:text-primary" href="#">
        <span class="material-symbols-outlined text-lg">help</span>
        <span class="text-xs font-label tracking-wide">{lib.support || 'Support'}</span>
      </a>
    </div>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <div class="flex flex-1 flex-col overflow-hidden">
    <header class="relative z-10 flex h-16 w-full shrink-0 items-center justify-between px-6 md:px-8 border-b border-outline-variant/10 bg-white/40 backdrop-blur-md">
      <div class="flex items-center gap-4">
        <button type="button" class="inline-flex items-center justify-center rounded-lg border border-outline-variant/20 p-2 text-slate-400 transition-colors hover:border-primary/30 hover:text-primary md:hidden" data-lib-mobile-toggle aria-label="Toggle sidebar">
          <span class="material-symbols-outlined text-xl">menu</span>
        </button>
        <span class="text-xl font-headline tracking-tight md:text-2xl">
          <span class="text-gradient-primary">{siteName}</span>
        </span>
      </div>

      <div class="flex items-center gap-4">
        <div class="hidden items-center rounded-xl border border-outline-variant/10 bg-surface-container-low/50 px-4 py-2 lg:flex">
          <span class="material-symbols-outlined mr-2 text-sm text-primary/60">search</span>
          <input
            class="w-52 border-none bg-transparent text-sm text-slate-200 placeholder-slate-500 outline-none focus:ring-0"
            placeholder={lib.searchTheorems || 'Search theorems...'}
            type="text"
          />
        </div>
        <button class="hidden items-center gap-2 rounded-xl border border-primary/15 bg-primary/5 px-4 py-2 text-sm font-medium text-primary transition-all hover:bg-primary/10 md:inline-flex" type="button">
          <span class="material-symbols-outlined text-base">workspace_premium</span>
          {lib.goPremium || 'Go Premium'}
        </button>
        <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border border-outline-variant/15 bg-surface-container-high/50 text-slate-400 transition-all hover:border-primary/30 hover:text-primary" aria-label="Profile">
          <span class="material-symbols-outlined text-xl">account_circle</span>
        </button>
      </div>
    </header>

    <main class="flex-1 overflow-y-auto custom-scrollbar bg-background p-6 pb-24 scroll-smooth md:p-8 md:pb-8">
      <div class="mx-auto max-w-7xl">
        <!-- Hero intro -->
        <div class="mb-14 max-w-3xl" style="animation: fade-in-up 0.6s cubic-bezier(0.22,1,0.36,1) both;">
          <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-4 py-1.5 font-label text-[10px] font-bold uppercase tracking-[0.25em] text-primary">
            <span class="material-symbols-outlined text-sm">auto_awesome</span>
            {lib.knowledgeBase || 'Knowledge Base'}
          </span>
          <h2 class="mb-6 text-4xl leading-tight font-headline text-on-surface md:text-5xl">
            {lib.formulaTheoryLibrary || 'Formula & Theory Library'}
          </h2>
          <p class="text-lg leading-relaxed text-on-surface-variant font-body">
            {lib.libraryIntro || 'A curated collection of geometric principles and algebraic identities.'}
          </p>
        </div>

        <!-- ═══ BENTO GRID ═══ -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          <!-- Pythagorean Theorem (Hero card) -->
          <div class="group flex flex-col overflow-hidden rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest transition-all duration-500 hover:border-primary/20 hover:shadow-[var(--shadow-glow-primary)] md:col-span-8 md:flex-row" style="animation: fade-in-up 0.6s cubic-bezier(0.22,1,0.36,1) 0.1s both;">
            <div class="flex flex-col justify-between p-8 md:w-1/2">
              <div>
                <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 transition-transform duration-300 group-hover:scale-110">
                  <span class="material-symbols-outlined text-2xl text-primary">architecture</span>
                </div>
                <h3 class="mb-4 text-3xl font-headline text-on-surface">{lib.pythagoreanTheorem || 'Pythagorean Theorem'}</h3>
                <p class="mb-6 text-sm leading-relaxed text-slate-400 font-body">
                  {lib.pythDesc || 'A fundamental relation in Euclidean geometry among the three sides of a right triangle.'}
                </p>
              </div>
              <div class="rounded-xl border-l-4 border-primary bg-surface-container-lowest/80 p-5 backdrop-blur-sm">
                <code class="font-label text-2xl tracking-tighter text-primary text-glow-primary">a<sup>2</sup> + b<sup>2</sup> = c<sup>2</sup></code>
              </div>
            </div>
            <div class="relative flex min-h-[280px] items-center justify-center overflow-hidden bg-surface-container-highest/20 md:w-1/2">
              <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
              <!-- Interactive animated triangle -->
              <svg class="relative h-48 w-48 drop-shadow-[0_0_20px_rgba(212,175,116,0.2)]" viewBox="0 0 200 200" data-interactive-pyth>
                <defs>
                  <linearGradient id="pythGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#d4af74" stop-opacity="0.2"/>
                    <stop offset="100%" stop-color="#b88946" stop-opacity="0.05"/>
                  </linearGradient>
                </defs>
                <rect x="10" y="10" width="60" height="60" fill="url(#pythGrad)" stroke="#d4af74" stroke-width="1.5" rx="4" opacity="0.6">
                  <animate attributeName="opacity" values="0.4;0.7;0.4" dur="4s" repeatCount="indefinite"/>
                </rect>
                <text x="40" y="45" text-anchor="middle" fill="#d4af74" font-family="Space Grotesk" font-size="14" font-weight="700">a²</text>
                <rect x="80" y="80" width="80" height="80" fill="url(#pythGrad)" stroke="#d4af74" stroke-width="1.5" rx="4" opacity="0.6">
                  <animate attributeName="opacity" values="0.4;0.7;0.4" dur="4s" repeatCount="indefinite" begin="1.3s"/>
                </rect>
                <text x="120" y="125" text-anchor="middle" fill="#d4af74" font-family="Space Grotesk" font-size="14" font-weight="700">b²</text>
                <path d="M 10 70 L 80 70 L 80 160 Z" fill="none" stroke="#f1d4a4" stroke-width="2" stroke-linejoin="round" style="filter: drop-shadow(0 0 4px rgba(126,209,247,0.4));"/>
                <text x="35" y="130" text-anchor="middle" fill="#d8b177" font-family="Space Grotesk" font-size="12" font-weight="700" opacity="0.8">=c²</text>
                <text x="60" y="82" text-anchor="middle" fill="#f1d4a4" font-family="Space Grotesk" font-size="18" font-weight="700">+</text>
              </svg>
            </div>
          </div>

          <!-- SOH CAH TOA -->
          <div class="group rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-8 transition-all duration-500 hover:border-primary/15 hover:shadow-[var(--shadow-glow-primary)] md:col-span-4" style="animation: fade-in-up 0.6s cubic-bezier(0.22,1,0.36,1) 0.2s both;">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-secondary-container/10 transition-transform duration-300 group-hover:scale-110">
              <span class="material-symbols-outlined text-2xl text-secondary-container">change_history</span>
            </div>
            <h3 class="mb-4 text-2xl font-headline text-on-surface">SOH CAH TOA</h3>
            <p class="mb-8 text-sm leading-relaxed text-slate-400 font-body">
              {lib.trigMnemonicDesc || 'A mnemonic for the three trigonometric ratios.'}
            </p>
            <div class="space-y-3" data-trig-ratios>
              <div class="group/item flex items-center justify-between rounded-xl border border-outline-variant/10 px-4 py-3 transition-all duration-300 hover:border-primary/20 hover:bg-surface-container-high/30 cursor-pointer">
                <span class="font-label text-xs uppercase tracking-widest text-slate-500 group-hover/item:text-primary transition-colors">{lib.sine || 'Sine'}</span>
                <span class="italic font-headline text-on-surface">O / H</span>
              </div>
              <div class="group/item flex items-center justify-between rounded-xl border border-outline-variant/10 px-4 py-3 transition-all duration-300 hover:border-primary/20 hover:bg-surface-container-high/30 cursor-pointer">
                <span class="font-label text-xs uppercase tracking-widest text-slate-500 group-hover/item:text-primary transition-colors">{lib.cosine || 'Cosine'}</span>
                <span class="italic font-headline text-on-surface">A / H</span>
              </div>
              <div class="group/item flex items-center justify-between rounded-xl border border-outline-variant/10 px-4 py-3 transition-all duration-300 hover:border-primary/20 hover:bg-surface-container-high/30 cursor-pointer">
                <span class="font-label text-xs uppercase tracking-widest text-slate-500 group-hover/item:text-primary transition-colors">{lib.tangent || 'Tangent'}</span>
                <span class="italic font-headline text-on-surface">O / A</span>
              </div>
            </div>
          </div>

          <!-- 45-45-90 Triangle -->
          <div class="group flex flex-col rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-8 transition-all duration-500 hover:border-primary/15 hover:shadow-[var(--shadow-glow-primary)] md:col-span-6" style="animation: fade-in-up 0.6s cubic-bezier(0.22,1,0.36,1) 0.3s both;">
            <div class="mb-6 flex items-start justify-between gap-4">
              <div>
                <h3 class="mb-2 text-2xl font-headline text-on-surface">{lib.isoscelesRight || '45-45-90 Triangle'}</h3>
                <p class="max-w-xs text-sm text-slate-400 font-body">
                  {lib.isoscelesDesc || 'The isosceles right triangle, with ratio 1 : 1 : √2.'}
                </p>
              </div>
            </div>
            <div class="flex flex-1 items-center justify-center py-6">
              <svg class="h-48 w-48 drop-shadow-[0_0_20px_rgba(212,175,116,0.15)]" viewBox="0 0 200 200" data-interactive-4545>
                <path d="M 30 170 L 170 170 L 30 30 Z" fill="none" stroke="#d4af74" stroke-width="2.5" stroke-linejoin="round" style="filter: drop-shadow(0 0 6px rgba(212,175,116,0.3));"/>
                <path d="M 30 170 L 170 170 L 30 30 Z" fill="#d4af74" opacity="0.06"/>
                <rect x="30" y="150" width="20" height="20" fill="none" stroke="#3c494c" stroke-width="1.5"/>
                <text x="20" y="105" text-anchor="end" fill="#bbc9cc" font-family="Space Grotesk" font-size="13">x</text>
                <text x="100" y="190" text-anchor="middle" fill="#bbc9cc" font-family="Space Grotesk" font-size="13">x</text>
                <text x="115" y="90" text-anchor="middle" fill="#d4af74" font-family="Space Grotesk" font-size="13" font-weight="700" transform="rotate(-45, 115, 90)">x√2</text>
                <text x="82" y="155" fill="#f1d4a4" font-family="Space Grotesk" font-size="10">45°</text>
                <text x="38" y="50" fill="#f1d4a4" font-family="Space Grotesk" font-size="10">45°</text>
              </svg>
            </div>
          </div>

          <!-- Area Formulas -->
          <div class="group rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-8 transition-all duration-500 hover:border-primary/15 hover:shadow-[var(--shadow-glow-primary)] md:col-span-6" style="animation: fade-in-up 0.6s cubic-bezier(0.22,1,0.36,1) 0.4s both;">
            <h3 class="mb-6 text-2xl font-headline text-on-surface flex items-center gap-3">
              <span class="material-symbols-outlined text-primary">calculate</span>
              {lib.areaFormulas || 'Area Formulas'}
            </h3>
            <div class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
              <div class="space-y-2 group/formula">
                <p class="font-label text-xs uppercase tracking-widest text-primary flex items-center gap-2">{lib.circle || 'Circle'}</p>
                <div class="rounded-xl bg-surface-container-lowest/70 p-4 border border-outline-variant/10 transition-all hover:border-primary/15 hover:shadow-sm">
                  <span class="text-2xl font-headline text-on-surface">A = &pi;r<sup>2</sup></span>
                </div>
              </div>
              <div class="space-y-2 group/formula">
                <p class="font-label text-xs uppercase tracking-widest text-primary flex items-center gap-2">{lib.triangle || 'Triangle'}</p>
                <div class="rounded-xl bg-surface-container-lowest/70 p-4 border border-outline-variant/10 transition-all hover:border-primary/15 hover:shadow-sm">
                  <span class="text-2xl font-headline text-on-surface">A = &frac12;bh</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ═══ SPOTLIGHT SECTION: Golden Ratio ═══ -->
        <section class="mt-16 flex flex-col items-center gap-12 rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low/50 to-transparent p-8 lg:flex-row lg:p-12" style="animation: fade-in-up 0.6s cubic-bezier(0.22,1,0.36,1) 0.5s both;">
          <div class="order-2 lg:order-1 lg:w-2/5">
            <div class="relative overflow-hidden rounded-2xl border border-outline-variant/10 bg-surface-container-lowest p-8">
              <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.04]"></div>
              <svg class="relative w-full h-auto drop-shadow-[0_0_20px_rgba(212,175,116,0.1)]" viewBox="0 0 300 200" data-golden-spiral>
                <rect x="10" y="10" width="180" height="180" fill="none" stroke="#d4af74" stroke-width="1" opacity="0.3" rx="2"/>
                <path d="M 190 190 Q 190 10, 10 10 Q 10 10, 10 122 Q 10 122, 78 122 Q 78 122, 78 190" fill="none" stroke="#d4af74" stroke-width="2.5" stroke-linecap="round"/>
                <text x="250" y="105" text-anchor="middle" fill="#d4af74" font-family="Noto Serif" font-size="48" font-weight="700" opacity="0.6">φ</text>
                <text x="250" y="130" text-anchor="middle" fill="#bbc9cc" font-family="Space Grotesk" font-size="11">≈ 1.618</text>
              </svg>
            </div>
          </div>

          <div class="order-1 lg:order-2 lg:w-3/5">
            <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-secondary-container/20 bg-secondary-container/5 px-4 py-1.5 font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-container">
              <span class="material-symbols-outlined text-sm">star</span>
              {lib.spotlightTheorem || 'Spotlight Theorem'}
            </span>
            <h2 class="mb-8 text-3xl font-headline text-on-surface md:text-4xl">{lib.divineProportion || 'The Divine Proportion (φ)'}</h2>
            <p class="mb-8 text-base leading-relaxed text-slate-400 font-body md:text-lg">
              {lib.goldenRatioDescription || 'In mathematics, two quantities are in the golden ratio if their ratio is the same as the ratio of their sum to the larger of the two quantities.'}
            </p>
            <button class="group mt-10 flex items-center gap-2 font-label text-sm uppercase tracking-widest text-primary transition-all duration-300 hover:gap-4" type="button">
              {lib.detailedProof || 'Explore Detailed Proof'}
              <span class="material-symbols-outlined transition-transform duration-300 group-hover:translate-x-2">arrow_forward</span>
            </button>
          </div>
        </section>
      </div>
    </main>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="fixed right-0 bottom-0 left-0 z-20 flex h-16 items-center justify-around border-t border-outline-variant/8 md:hidden" style="background: linear-gradient(180deg, rgba(25,18,13,0.95) 0%, rgba(12,9,7,1) 100%); backdrop-filter: blur(16px);">
    <a class="flex flex-col items-center gap-1 text-slate-500 transition-colors hover:text-slate-300" href={calculatorHref}>
      <span class="material-symbols-outlined">calculate</span>
      <span class="text-[9px] font-label tracking-wide">{lib.nav_calculator || 'Calculator'}</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-primary" href={libraryHref}>
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">menu_book</span>
      <span class="text-[9px] font-label font-medium tracking-wide">{lib.nav_library || 'Library'}</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-slate-500 transition-colors hover:text-slate-300" href={practiceHref}>
      <span class="material-symbols-outlined">edit_note</span>
      <span class="text-[9px] font-label tracking-wide">{lib.nav_practice || 'Practice'}</span>
    </a>
  </nav>
</div>

