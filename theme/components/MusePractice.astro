---
import { getTranslations, pick } from 'theme/i18n/translations';

interface Props {
  calculatorHref?: string;
  libraryHref?: string;
  practiceHref?: string;
  formulasHref?: string;
  locale: string;
}

const {
  calculatorHref = '/',
  libraryHref = '/library/',
  practiceHref = '/practice/',
  formulasHref = '/',
  locale
} = Astro.props;

const bundle = getTranslations(locale);
const practice = (bundle.practice as any) || {};
const solver = (bundle.solver as any) || {};

const diffMap = {
  1: practice.easy || 'Easy',
  2: practice.moderate || 'Moderate',
  3: practice.hard || 'Hard'
};

const scriptTranslations = {
  streakSuffix: practice.streak || "DAY STREAK",
  rank: practice.rank || "Rank",
  time: practice.time || "Time",
  accuracy: practice.accuracy || "Accuracy",
  score: practice.score || "Score",
  correctTitle: practice.correct || "Correct!",
  incorrectTitle: practice.incorrect || "Not quite!",
  feedbackCorrect: "The answer is {ans}. Solved in {sec}s. +{pts} points!", // template
  feedbackIncorrect: "The correct answer is {ans}. Keep practicing!", // template
  difficultyLabels: [practice.easy || 'Easy', practice.moderate || 'Moderate', practice.hard || 'Hard'],
  challengeSubtitle: "Find the hypotenuse c given a = {a} and b = {b}.", // template
  recall: "Recall:",
  showHint: practice.showHint || "Show Hint",
  ranks: {
    gm: "Grand Master",
    expert: "Expert",
    scholar: "Scholar",
    adept: "Adept",
    initiate: "Initiate"
  }
};
---

<div class="bg-background text-on-background font-body selection:bg-primary-container selection:text-on-primary-container">
  <div class="flex flex-col md:flex-row rounded-3xl overflow-hidden border border-outline-variant/30 shadow-luxury relative" data-practice-translations={JSON.stringify(scriptTranslations)}>
    <!-- Ambient glow -->
    <div class="ambient-glow" style="width: 500px; height: 500px; top: -100px; right: 10%; background: rgba(181, 140, 69, 0.12);"></div>
    <div class="ambient-glow" style="width: 300px; height: 300px; bottom: 0; left: 0; background: rgba(91, 64, 0, 0.05);"></div>

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="hidden w-[280px] shrink-0 flex-col border-r border-outline-variant/20 bg-gradient-to-b from-surface-container-low to-surface-container py-6 md:flex">
      <div class="mb-10 px-6">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-primary-container shadow-[var(--shadow-glow-primary)]">
            <span class="material-symbols-outlined text-lg text-on-primary" style="font-variation-settings: 'FILL' 1;">architecture</span>
          </div>
        <div>
          <div class="text-sm font-headline font-bold text-on-primary-container">Right Triangle Solver</div>
          <p class="font-label text-[9px] uppercase tracking-[0.25em] text-on-surface-variant">{practice.precisionSolver || 'Precision Solver'}</p>
        </div>
        </div>
      </div>

      <nav class="flex-1 space-y-1 px-4" aria-label="Workspace navigation">
      <a class="group flex items-center gap-4 rounded-xl px-5 py-3.5 text-on-surface-variant transition-all duration-300 hover:bg-primary/5 hover:text-primary" href={calculatorHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">calculate</span>
        <span class="text-sm tracking-wide">{practice.solver || 'Solver'}</span>
      </a>
      <a class="group flex items-center gap-4 rounded-xl px-5 py-3.5 text-on-surface-variant transition-all duration-300 hover:bg-primary/5 hover:text-primary" href={libraryHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">menu_book</span>
        <span class="text-sm tracking-wide">{practice.library || 'Library'}</span>
      </a>
      <a class="group flex items-center gap-4 rounded-xl border-l-[3px] border-primary bg-primary/10 px-5 py-3.5 text-primary transition-all duration-300" href={practiceHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110" style="font-variation-settings: 'FILL' 1;">edit_note</span>
        <span class="text-sm font-medium tracking-wide">{practice.practice || 'Practice'}</span>
        <span class="ml-auto h-1.5 w-1.5 rounded-full bg-primary shadow-sm"></span>
      </a>
      </nav>

      <div class="mt-auto space-y-2 border-t border-outline-variant/8 px-4 pt-5">
        <button class="btn-primary mb-4 w-full justify-center gap-2 py-3 text-sm" type="button" data-new-challenge>
          <span class="material-symbols-outlined text-base">add_circle</span>
          {practice.newChallenge || 'New Challenge'}
        </button>
        <a class="flex items-center gap-4 rounded-lg px-5 py-2.5 text-on-surface-variant transition-colors hover:text-primary" href="#">
          <span class="material-symbols-outlined text-lg">settings</span>
          <span class="text-xs font-label tracking-wide">{practice.settings || 'Settings'}</span>
        </a>
        <a class="flex items-center gap-4 rounded-lg px-5 py-2.5 text-on-surface-variant transition-colors hover:text-primary" href="#">
          <span class="material-symbols-outlined text-lg">help</span>
          <span class="text-xs font-label tracking-wide">{practice.support || 'Support'}</span>
        </a>
      </div>
    </aside>

    <!-- ═══ MAIN ═══ -->
    <main class="flex-1 bg-surface">
      <header class="sticky top-0 z-30 flex h-16 w-full items-center justify-between px-6 md:px-8 border-b border-outline-variant/10 bg-white/40 backdrop-blur-md">
        <div class="flex items-center gap-3">
          <span class="text-xl font-headline tracking-tight md:text-2xl">
            <span class="text-primary drop-shadow-sm">Right Triangle Solver</span>
          </span>
        </div>
        <div class="flex items-center gap-4">
          <!-- Streak badge -->
          <div class="hidden items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-4 py-1.5 md:flex">
            <span class="material-symbols-outlined text-sm text-primary" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
            <span class="font-label text-xs text-primary" data-streak-count>0 {practice.streak || 'DAY STREAK'}</span>
          </div>
          <button class="hidden items-center gap-2 rounded-xl border border-primary/15 bg-primary/5 px-4 py-2 text-sm font-medium text-primary transition-all hover:bg-primary/10 md:inline-flex" type="button">
            <span class="material-symbols-outlined text-base">workspace_premium</span>
            {practice.premium || 'Go Premium'}
          </button>
          <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border border-outline-variant/15 bg-surface-container-high/50 text-slate-400 transition-all hover:border-primary/30 hover:text-primary" aria-label="Profile">
            <span class="material-symbols-outlined text-xl">account_circle</span>
          </button>
        </div>
      </header>

      <div class="mx-auto max-w-6xl p-6 pb-24 md:p-8 md:pb-8">
        <!-- Challenge Header -->
        <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between" style="animation: fade-in-up 0.5s cubic-bezier(0.22,1,0.36,1) both;">
          <div>
            <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-4 py-1.5 font-label text-[10px] font-bold uppercase tracking-[0.25em] text-primary">
              <span class="material-symbols-outlined text-sm">bolt</span>
              {practice.dailyChallenge || 'Daily Challenge'}
            </span>
            <h2 class="text-3xl leading-tight font-headline md:text-4xl">
              <span class="text-gradient-secondary" data-challenge-title>The Pythagorean Shadow</span>
            </h2>
            <p class="mt-2 max-w-md text-sm font-body text-slate-400" data-challenge-subtitle>
              Calculate the unknown side given the adjacent and opposite lengths.
            </p>
          </div>

          <!-- Progress panel -->
          <div class="flex items-center gap-6 rounded-2xl border-l-4 border-primary/40 bg-gradient-to-r from-surface-container-low to-surface-container-lowest p-6 hover-lift">
            <div class="flex flex-col">
              <span class="font-label text-[9px] uppercase tracking-widest text-slate-500">{practice.progress || 'Progress'}</span>
              <div class="mt-2 flex items-center gap-3">
                <div class="h-1.5 w-32 overflow-hidden rounded-full bg-surface-container-highest">
                  <div class="h-full rounded-full bg-gradient-to-r from-primary to-primary-container transition-all duration-1000" style="width: 0%;" data-progress-bar></div>
                </div>
                <span class="font-label text-xs text-primary font-medium" data-progress-text>0%</span>
              </div>
            </div>
            <div class="h-8 w-px bg-outline-variant/15"></div>
            <div class="flex flex-col">
              <span class="font-label text-[9px] uppercase tracking-widest text-slate-500">{practice.rank || 'Rank'}</span>
              <span class="text-lg font-headline text-gradient-secondary" data-rank-text>Initiate</span>
            </div>
          </div>
        </div>

        <!-- ═══ CHALLENGE AREA ═══ -->
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12" style="animation: fade-in-up 0.5s cubic-bezier(0.22,1,0.36,1) 0.15s both;">
          <!-- Visualization -->
          <div class="group relative overflow-hidden rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-8 lg:col-span-7 lg:p-12 hover-lift">
            <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.03]"></div>

            <div class="relative flex aspect-video w-full items-center justify-center">
              <svg class="w-full max-w-md drop-shadow-[0_0_30px_rgba(212,175,116,0.1)]" viewBox="0 0 400 300" data-challenge-svg>
                <path d="M 50 250 L 350 250 L 350 50 Z" fill="none" stroke="#d4af74" stroke-width="3" stroke-linejoin="round" style="filter: drop-shadow(0 0 8px rgba(212,175,116,0.3));"></path>
                <path d="M 50 250 L 350 250 L 350 50 Z" fill="#d4af74" opacity="0.04"></path>
                <rect x="330" y="230" width="20" height="20" fill="none" stroke="#3c494c" stroke-width="1.5"></rect>
                <text x="200" y="275" font-family="Space Grotesk" font-size="16" fill="#d8b177" font-weight="700" text-anchor="middle" data-label-leg-a>a = 12</text>
                <text x="370" y="155" font-family="Space Grotesk" font-size="16" fill="#d8b177" font-weight="700" data-label-leg-b>b = 9</text>
                <text x="180" y="140" font-family="Space Grotesk" font-size="20" fill="#d4af74" font-weight="700" font-style="italic" transform="rotate(-33, 180, 140)" data-label-hyp>c = ?</text>
                <!-- Animated vertex dots -->
                <circle cx="50" cy="250" r="4" fill="#d4af74" opacity="0.7">
                  <animate attributeName="r" values="3;6;3" dur="3s" repeatCount="indefinite" />
                </circle>
                <circle cx="350" cy="250" r="4" fill="#d4af74" opacity="0.7">
                  <animate attributeName="r" values="3;6;3" dur="3s" repeatCount="indefinite" begin="1s" />
                </circle>
                <circle cx="350" cy="50" r="4" fill="#d4af74" opacity="0.7">
                  <animate attributeName="r" values="3;6;3" dur="3s" repeatCount="indefinite" begin="2s" />
                </circle>
              </svg>
            </div>

            <!-- Hint bar -->
            <div class="glass-panel absolute right-4 bottom-4 left-4 flex items-center justify-between rounded-xl border border-outline-variant/10 p-4 md:right-6 md:bottom-6 md:left-6">
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-tertiary">lightbulb</span>
                <p class="text-xs text-slate-300 font-body">
                  {scriptTranslations.recall} <span class="ml-1 text-sm italic font-headline text-primary">a² + b² = c²</span>
                </p>
              </div>
              <button class="font-label text-[10px] uppercase tracking-widest text-primary transition-colors hover:text-primary-container" type="button" data-show-hint>
                {practice.showHint || 'Show Hint'}
              </button>
            </div>
          </div>

          <!-- Input panel -->
          <div class="flex flex-col gap-5 lg:col-span-5" style="animation: slide-in-right 0.5s cubic-bezier(0.22,1,0.36,1) 0.25s both;">
            <!-- Answer input -->
            <div class="rounded-2xl border border-outline-variant/15 bg-gradient-to-br from-surface-container-highest/80 to-surface-container-high p-7 border-glow">
              <label class="mb-4 flex items-center gap-2 font-label text-xs uppercase tracking-widest text-slate-400">
                <span class="material-symbols-outlined text-sm text-primary">edit</span>
                {practice.yourSolution || 'Your Solution'}
              </label>
              <div class="group relative">
                <input
                  class="w-full border-none border-b-2 border-outline-variant bg-transparent pb-4 text-4xl font-headline text-primary placeholder:text-slate-700 transition-all focus:border-primary focus:ring-0 md:text-5xl"
                  type="text"
                  placeholder={practice.enterValue || 'Enter value...'}
                  data-answer-input
                  inputmode="decimal"
                />
                <div class="absolute right-0 bottom-5 flex items-center gap-2">
                  <span class="font-label text-[10px] uppercase tracking-widest text-slate-500">{practice.units || 'Units'}:</span>
                  <span class="text-base font-headline text-secondary-fixed">cm</span>
                </div>
              </div>
            </div>

            <!-- Keypad -->
            <div class="rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-5">
              <div class="grid grid-cols-3 gap-2.5" data-keypad>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="7">7</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="8">8</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="9">9</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="4">4</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="5">5</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="6">6</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="1">1</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="2">2</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="3">3</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key=".">.</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl font-headline text-secondary transition-all duration-200 border border-transparent hover:border-primary/20 hover:bg-primary/15 hover:text-primary active:scale-95" type="button" data-key="0">0</button>
                <button class="h-14 rounded-xl bg-surface-container-highest/70 text-xl text-error transition-all duration-200 border border-transparent hover:border-error/20 hover:bg-error-container/20 active:scale-95" type="button" data-key="backspace">
                  <span class="material-symbols-outlined">backspace</span>
                </button>
                <button class="btn-primary col-span-3 mt-3 h-14 gap-3 text-base font-label font-bold uppercase tracking-widest" type="button" data-check-answer>
                  <span>{practice.checkAnswer || 'Check Answer'}</span>
                  <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ═══ STATS ROW ═══ -->
        <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4 anim-stagger" style="animation-delay: 0.3s;">
          <div class="group rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-5 hover-lift">
            <span class="mb-2 flex items-center gap-2 font-label text-[9px] uppercase tracking-widest text-slate-500">
              <span class="material-symbols-outlined text-sm text-primary/50">speed</span>
              {practice.difficulty || 'Difficulty'}
            </span>
            <div class="mt-2 flex gap-1.5" data-difficulty-bars>
              <div class="h-1.5 w-8 rounded-full bg-secondary-container transition-all"></div>
              <div class="h-1.5 w-8 rounded-full bg-secondary-container transition-all"></div>
              <div class="h-1.5 w-8 rounded-full bg-outline-variant/15 transition-all"></div>
            </div>
            <span class="mt-3 block text-xs text-secondary font-body font-medium" data-difficulty-text>Moderate</span>
          </div>

          <div class="group rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-5 hover-lift">
            <span class="mb-2 flex items-center gap-2 font-label text-[9px] uppercase tracking-widest text-slate-500">
              <span class="material-symbols-outlined text-sm text-primary/50">timer</span>
              {practice.time || 'Time'}
            </span>
            <span class="mt-1 block text-2xl font-headline text-secondary stat-value" data-timer>00:00</span>
          </div>

          <div class="group rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-5 hover-lift">
            <span class="mb-2 flex items-center gap-2 font-label text-[9px] uppercase tracking-widest text-slate-500">
              <span class="material-symbols-outlined text-sm text-primary/50">target</span>
              {practice.accuracy || 'Accuracy'}
            </span>
            <span class="mt-1 block text-2xl font-headline text-secondary stat-value" data-accuracy>0%</span>
          </div>

          <div class="group relative overflow-hidden rounded-2xl border border-outline-variant/10 bg-gradient-to-br from-surface-container-low to-surface-container-lowest p-5 hover-lift">
            <span class="mb-2 flex items-center gap-2 font-label text-[9px] uppercase tracking-widest text-slate-500">
              <span class="material-symbols-outlined text-sm text-primary/50">token</span>
            </span>
            <div class="mt-1 flex items-center gap-2">
              <span class="text-2xl font-headline text-primary-container stat-value" data-score>0</span>
              <span class="material-symbols-outlined text-lg text-primary-container">emoji_events</span>
            </div>
          </div>
        </div>

        <!-- Feedback overlay (hidden by default) -->
        <div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm" data-feedback-overlay>
          <div class="mx-4 max-w-md rounded-2xl border border-outline-variant/15 bg-surface-container-low p-8 text-center shadow-[var(--shadow-luxury)]" data-feedback-panel>
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl" data-feedback-icon-wrap>
              <span class="material-symbols-outlined text-4xl" data-feedback-icon></span>
            </div>
            <h3 class="text-2xl font-headline" data-feedback-title></h3>
            <p class="mt-2 text-sm text-slate-400" data-feedback-message></p>
            <button class="btn-primary mt-6 w-full justify-center py-3" type="button" data-feedback-next>
              {practice.nextChallenge || 'Next Challenge'}
              <span class="material-symbols-outlined ml-2 text-base">arrow_forward</span>
            </button>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="fixed right-0 bottom-0 left-0 z-20 flex h-16 items-center justify-around border-t border-outline-variant/8 md:hidden" style="background: linear-gradient(180deg, rgba(25,18,13,0.95) 0%, rgba(12,9,7,1) 100%); backdrop-filter: blur(16px);">
    <a class="flex flex-col items-center gap-1 text-slate-500 transition-colors hover:text-slate-300" href={calculatorHref}>
      <span class="material-symbols-outlined">calculate</span>
      <span class="text-[9px] font-label tracking-wide">{practice.solver || 'Solver'}</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-slate-500 transition-colors hover:text-slate-300" href={libraryHref}>
      <span class="material-symbols-outlined">menu_book</span>
      <span class="text-[9px] font-label tracking-wide">{practice.library || 'Library'}</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-primary" href={practiceHref}>
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">edit_note</span>
      <span class="text-[9px] font-label font-medium tracking-wide">{practice.practice || 'Practice'}</span>
    </a>
  </nav>
</div>

<script is:inline>
(() => {
  const CHALLENGES = [
    { a: 3, b: 4, unknown: 'c', title: 'Classic 3-4-5', difficulty: 1 },
    { a: 5, b: 12, unknown: 'c', title: 'Perfect Triple 5-12-13', difficulty: 1 },
    { a: 8, b: 15, unknown: 'c', title: 'The 8-15-17 Standard', difficulty: 2 },
    { a: 7, b: 24, unknown: 'c', title: 'Extended Triple', difficulty: 2 },
    { a: 9, b: 12, unknown: 'c', title: 'The Pythagorean Shadow', difficulty: 2 },
    { a: 6, b: 8, unknown: 'c', title: 'Scaled Classic', difficulty: 1 },
    { a: 20, b: 21, unknown: 'c', title: 'Near-Equal Legs', difficulty: 3 },
    { a: 11, b: 60, unknown: 'c', title: 'Wide Triangle', difficulty: 3 },
    { a: 9, b: 40, unknown: 'c', title: 'Steep Slope', difficulty: 2 },
    { a: 14, b: 48, unknown: 'c', title: 'Double Seven Challenge', difficulty: 3 }
  ];

  let currentChallenge = null;
  let score = 0;
  let correct = 0;
  let total = 0;
  let timerInterval = null;
  let seconds = 0;
  let streak = 0;

  const STORAGE_KEY = 'muse_practice_stats';

  const loadStats = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      score = data.score || 0;
      correct = data.correct || 0;
      total = data.total || 0;
      streak = data.streak || 0;
    } catch { /* ignore */ }
  };

  const saveStats = () => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ score, correct, total, streak }));
    } catch { /* ignore */ }
  };

  const $ = (sel) => document.querySelector(sel);
  const answerInput = $('[data-answer-input]');
  const challengeTitle = $('[data-challenge-title]');
  const challengeSubtitle = $('[data-challenge-subtitle]');
  const labelA = $('[data-label-leg-a]');
  const labelB = $('[data-label-leg-b]');
  const labelHyp = $('[data-label-hyp]');
  const progressBar = $('[data-progress-bar]');
  const progressText = $('[data-progress-text]');
  const timerEl = $('[data-timer]');
  const accuracyEl = $('[data-accuracy]');
  const scoreEl = $('[data-score]');
  const streakEl = $('[data-streak-count]');
  const diffBars = $('[data-difficulty-bars]');
  const diffText = $('[data-difficulty-text]');
  const feedbackOverlay = $('[data-feedback-overlay]');
  const feedbackIconWrap = $('[data-feedback-icon-wrap]');
  const feedbackIcon = $('[data-feedback-icon]');
  const feedbackTitle = $('[data-feedback-title]');
  const feedbackMessage = $('[data-feedback-message]');
  const rankEl = $('[data-rank-text]');
  
  const translations = JSON.parse(document.querySelector('[data-practice-translations]')?.getAttribute('data-practice-translations') || '{}');

  if (!answerInput) return;

  const getRank = () => {
    const r = translations.ranks || {};
    if (score >= 500) return r.gm || 'Grand Master';
    if (score >= 300) return r.expert || 'Expert';
    if (score >= 150) return r.scholar || 'Scholar';
    if (score >= 50) return r.adept || 'Adept';
    return r.initiate || 'Initiate';
  };

  const updateUI = () => {
    if (scoreEl) scoreEl.textContent = score;
    if (accuracyEl) accuracyEl.textContent = total > 0 ? Math.round((correct / total) * 100) + '%' : '0%';
    if (streakEl) streakEl.textContent = (streak || 0) + ' ' + (translations.streakSuffix || 'DAY STREAK');
    if (rankEl) rankEl.textContent = getRank();
    const progress = Math.min((score / 500) * 100, 100);
    if (progressBar) progressBar.style.width = progress + '%';
    if (progressText) progressText.textContent = Math.round(progress) + '%';
  };

  const startTimer = () => {
    seconds = 0;
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      seconds++;
      const m = String(Math.floor(seconds / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      if (timerEl) timerEl.textContent = m + ':' + s;
    }, 1000);
  };

  const stopTimer = () => {
    if (timerInterval) clearInterval(timerInterval);
  };

  const setDifficulty = (level) => {
    if (!diffBars) return;
    const bars = diffBars.querySelectorAll('div');
    bars.forEach((bar, i) => {
      if (i < level) {
        bar.className = 'h-1.5 w-8 rounded-full bg-secondary-container transition-all';
      } else {
        bar.className = 'h-1.5 w-8 rounded-full bg-outline-variant/15 transition-all';
      }
    });
    if (diffText) {
      diffText.textContent = (translations.difficultyLabels || [])[level - 1] || 'Moderate';
    }
  };

  const loadChallenge = () => {
    const idx = Math.floor(Math.random() * CHALLENGES.length);
    currentChallenge = CHALLENGES[idx];
    const answer = Math.sqrt(currentChallenge.a ** 2 + currentChallenge.b ** 2);
    currentChallenge.answer = answer;

    if (challengeTitle) challengeTitle.textContent = currentChallenge.title;
    if (challengeSubtitle) {
      challengeSubtitle.textContent = (translations.challengeSubtitle || "Find the hypotenuse c given a = {a} and b = {b}.")
        .replace('{a}', currentChallenge.a)
        .replace('{b}', currentChallenge.b);
    }
    if (labelA) labelA.textContent = `a = ${currentChallenge.a}`;
    if (labelB) labelB.textContent = `b = ${currentChallenge.b}`;
    if (labelHyp) labelHyp.textContent = 'c = ?';
    if (answerInput) answerInput.value = '';

    setDifficulty(currentChallenge.difficulty);
    startTimer();
  };

  const showFeedback = (isCorrect, correctAnswer) => {
    if (!feedbackOverlay) return;
    feedbackOverlay.classList.remove('hidden');
    feedbackOverlay.classList.add('flex');

    if (isCorrect) {
      feedbackIconWrap.className = 'mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary-container/20';
      feedbackIcon.textContent = 'check_circle';
      feedbackIcon.className = 'material-symbols-outlined text-4xl text-secondary-container';
      feedbackIcon.style.fontVariationSettings = "'FILL' 1";
      feedbackTitle.textContent = translations.correctTitle || 'Correct!';
      feedbackTitle.className = 'text-2xl font-headline text-secondary-container';
      
      const pts = Math.max(50 - seconds, 10);
      feedbackMessage.textContent = (translations.feedbackCorrect || "The answer is {ans}. Solved in {sec}s. +{pts} points!")
        .replace('{ans}', correctAnswer.toFixed(2))
        .replace('{sec}', seconds)
        .replace('{pts}', pts);
    } else {
      feedbackIconWrap.className = 'mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-error/20';
      feedbackIcon.textContent = 'cancel';
      feedbackIcon.className = 'material-symbols-outlined text-4xl text-error';
      feedbackIcon.style.fontVariationSettings = "'FILL' 1";
      feedbackTitle.textContent = translations.incorrectTitle || 'Not quite!';
      feedbackTitle.className = 'text-2xl font-headline text-error';
      feedbackMessage.textContent = (translations.feedbackIncorrect || "The correct answer is {ans}. Keep practicing!")
        .replace('{ans}', correctAnswer.toFixed(2));
    }
  };

  const checkAnswer = () => {
    if (!currentChallenge) return;
    const userValue = parseFloat(answerInput.value);
    if (isNaN(userValue)) return;

    stopTimer();
    total++;
    const tolerance = 0.5;
    const isCorrect = Math.abs(userValue - currentChallenge.answer) < tolerance;

    if (isCorrect) {
      correct++;
      const points = Math.max(50 - seconds, 10);
      score += points;
    }

    saveStats();
    updateUI();
    showFeedback(isCorrect, currentChallenge.answer);
  };

  const keypad = document.querySelector('[data-keypad]');
  if (keypad) {
    keypad.querySelectorAll('[data-key]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key');
        if (key === 'backspace') {
          answerInput.value = answerInput.value.slice(0, -1);
        } else {
          answerInput.value += key;
        }
        answerInput.focus();
      });
    });
  }

  const checkBtn = $('[data-check-answer]');
  if (checkBtn) checkBtn.addEventListener('click', checkAnswer);

  if (answerInput) {
    answerInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') checkAnswer();
    });
  }

  const nextBtn = $('[data-feedback-next]');
  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      feedbackOverlay.classList.add('hidden');
      feedbackOverlay.classList.remove('flex');
      loadChallenge();
    });
  }

  const newBtn = $('[data-new-challenge]');
  if (newBtn) newBtn.addEventListener('click', loadChallenge);

  const hintBtn = $('[data-show-hint]');
  if (hintBtn) {
    hintBtn.addEventListener('click', () => {
      if (!currentChallenge) return;
      const hint = `√(${currentChallenge.a}² + ${currentChallenge.b}²) = √(${currentChallenge.a ** 2} + ${currentChallenge.b ** 2}) = √${currentChallenge.a ** 2 + currentChallenge.b ** 2}`;
      hintBtn.textContent = hint;
      hintBtn.classList.add('text-tertiary');
    });
  };

  // Initialize
  loadStats();
  updateUI();
  loadChallenge();
})();
</script>
