---
interface Props {
  title?: string;
  calculatorHref?: string;
  libraryHref?: string;
  practiceHref?: string;
  formulasHref?: string;
}

const {
  title = 'Right Triangle Solver',
  calculatorHref = '/',
  libraryHref = '/library/',
  practiceHref = '/practice/',
  formulasHref = '/formulas/'
} = Astro.props;

const modeSummaries = [
  {
    id: 'legs_ab',
    title: 'Leg a + Leg b',
    description: 'Compute every triangle property from the two legs.',
    icon: 'straighten'
  },
  {
    id: 'legA_c',
    title: 'Leg a + Hypotenuse c',
    description: 'Recover leg b and all derived values with one constraint.',
    icon: 'timeline'
  },
  {
    id: 'legB_c',
    title: 'Leg b + Hypotenuse c',
    description: 'Recover leg a and all derived values with one constraint.',
    icon: 'timeline'
  },
  {
    id: 'angleA_legA',
    title: 'Angle A + Leg a',
    description: 'Use sine and tangent identities to solve the full shape.',
    icon: 'rotate_right'
  },
  {
    id: 'angleA_legB',
    title: 'Angle A + Leg b',
    description: 'Use cosine and tangent identities to solve the full shape.',
    icon: 'rotate_right'
  },
  {
    id: 'angleA_c',
    title: 'Angle A + Hypotenuse c',
    description: 'Project the hypotenuse into both legs with trig relations.',
    icon: 'rotate_right'
  },
  {
    id: 'angleB_legA',
    title: 'Angle B + Leg a',
    description: 'Mirror-angle solve flow anchored to leg a.',
    icon: 'rotate_left'
  },
  {
    id: 'angleB_legB',
    title: 'Angle B + Leg b',
    description: 'Mirror-angle solve flow anchored to leg b.',
    icon: 'rotate_left'
  },
  {
    id: 'angleB_c',
    title: 'Angle B + Hypotenuse c',
    description: 'Directly derive both legs from the angle and hypotenuse.',
    icon: 'rotate_left'
  }
];
---

<div class="relative flex min-h-[100dvh] w-full overflow-hidden bg-background text-on-surface font-body" data-muse-root>
  <div class="pointer-events-none absolute inset-0 z-0">
    <div class="absolute -left-40 top-[-12rem] h-[28rem] w-[28rem] rounded-full bg-primary/20 blur-[120px]"></div>
    <div class="absolute right-[-10rem] top-[-10rem] h-[24rem] w-[24rem] rounded-full bg-secondary-fixed/16 blur-[120px]"></div>
    <div class="absolute bottom-[-12rem] left-1/2 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-tertiary/10 blur-[140px]"></div>
    <div class="absolute inset-0 opacity-[0.08] dot-grid"></div>
  </div>

  <aside class="relative z-10 hidden h-[100dvh] w-[300px] shrink-0 flex-col border-r border-primary/15 bg-[linear-gradient(180deg,rgba(25,17,12,0.95)_0%,rgba(11,8,6,0.96)_100%)] px-5 py-6 md:flex">
    <div class="mb-8 rounded-2xl border border-primary/20 bg-primary/5 p-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-primary-container shadow-[var(--shadow-glow-primary)]">
          <span class="material-symbols-outlined text-lg text-on-primary" style="font-variation-settings: 'FILL' 1;">diamond</span>
        </div>
        <div>
          <p class="font-label text-[10px] uppercase tracking-[0.22em] text-primary/70">Premium Studio</p>
          <h1 class="text-lg font-headline text-primary text-glow-primary">Right Triangle Solver</h1>
        </div>
      </div>
    </div>

    <nav class="space-y-2" aria-label="Workspace navigation">
      <a class="group flex items-center gap-3 rounded-xl border border-primary/25 bg-primary/12 px-4 py-3 text-primary transition-all hover:shadow-[var(--shadow-glow-primary)]" href={calculatorHref}>
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calculate</span>
        <span class="text-sm font-medium tracking-wide">Solver</span>
        <span class="ml-auto h-2 w-2 rounded-full bg-primary shadow-[0_0_10px_rgba(212,175,116,0.7)]"></span>
      </a>
      <a class="group flex items-center gap-3 rounded-xl px-4 py-3 text-on-surface-variant transition-all hover:bg-primary/8 hover:text-on-surface" href={libraryHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">menu_book</span>
        <span class="text-sm tracking-wide">Library</span>
      </a>
      <a class="group flex items-center gap-3 rounded-xl px-4 py-3 text-on-surface-variant transition-all hover:bg-primary/8 hover:text-on-surface" href={practiceHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">edit_note</span>
        <span class="text-sm tracking-wide">Practice</span>
      </a>
      <a class="group flex items-center gap-3 rounded-xl px-4 py-3 text-on-surface-variant transition-all hover:bg-primary/8 hover:text-on-surface" href={formulasHref}>
        <span class="material-symbols-outlined transition-transform duration-300 group-hover:scale-110">functions</span>
        <span class="text-sm tracking-wide">Formulas</span>
      </a>
    </nav>

    <div class="mt-8 rounded-2xl border border-outline-variant/25 bg-surface-container-low/70 p-4">
      <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">What You Get</p>
      <ul class="mt-3 space-y-2 text-sm text-on-surface-variant">
        <li class="flex items-start gap-2">
          <span class="material-symbols-outlined mt-0.5 text-sm text-primary">check_circle</span>
          Nine complete solve modes
        </li>
        <li class="flex items-start gap-2">
          <span class="material-symbols-outlined mt-0.5 text-sm text-primary">check_circle</span>
          Live diagram and geometry steps
        </li>
        <li class="flex items-start gap-2">
          <span class="material-symbols-outlined mt-0.5 text-sm text-primary">check_circle</span>
          Session history in local storage
        </li>
      </ul>
    </div>

    <div class="mt-auto space-y-2 border-t border-outline-variant/20 pt-5">
      <a class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-outline transition-colors hover:text-on-surface" href={formulasHref}>
        <span class="material-symbols-outlined text-base">auto_awesome</span>
        Study Formula Sheet
      </a>
    </div>
  </aside>

  <main class="relative z-10 flex min-w-0 flex-1 flex-col">
    <header class="h-16 shrink-0 border-b border-primary/12 bg-[linear-gradient(180deg,rgba(30,21,14,0.92)_0%,rgba(20,14,10,0.84)_100%)] px-4 backdrop-blur-xl sm:px-6 lg:px-8">
      <div class="mx-auto flex h-full w-full max-w-[1500px] items-center justify-between">
        <div class="flex items-center gap-3">
          <button type="button" class="inline-flex items-center justify-center rounded-lg border border-outline-variant/30 p-2 text-on-surface-variant transition-colors hover:border-primary/40 hover:text-primary md:hidden" data-mobile-sidebar-toggle aria-label="Toggle sidebar">
            <span class="material-symbols-outlined text-xl">menu</span>
          </button>
          <div>
            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Right Triangle Workspace</p>
            <h2 class="text-lg font-headline text-on-surface sm:text-xl">
              <span class="text-gradient-primary">{title}</span>
            </h2>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <a class="hidden items-center gap-2 rounded-xl border border-primary/20 bg-primary/8 px-3 py-2 text-xs font-label uppercase tracking-widest text-primary transition-all hover:bg-primary/14 sm:inline-flex" href={formulasHref}>
            <span class="material-symbols-outlined text-sm">library_books</span>
            Formula Notes
          </a>
          <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border border-outline-variant/25 bg-surface-container-high/50 text-on-surface-variant transition-all hover:border-primary/35 hover:text-primary" aria-label="Profile">
            <span class="material-symbols-outlined text-xl">account_circle</span>
          </button>
        </div>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto custom-scrollbar px-4 pb-24 pt-5 sm:px-6 sm:pt-6 lg:px-8 lg:pb-10">
      <div class="mx-auto grid w-full max-w-[1500px] gap-6 xl:grid-cols-[360px_minmax(0,1fr)]">
        <section class="section-shell border-primary/25 bg-[linear-gradient(165deg,rgba(39,29,21,0.94)_0%,rgba(21,15,11,0.95)_100%)] p-5 sm:p-6 xl:sticky xl:top-6 xl:h-fit">
          <div class="mb-6 flex items-start justify-between gap-4">
            <div>
              <p class="font-label text-[10px] uppercase tracking-[0.2em] text-primary/80">Command Panel</p>
              <h3 class="mt-2 text-2xl font-headline">Universal Solver</h3>
              <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
                Pick any valid pair of inputs and generate the complete triangle instantly.
              </p>
            </div>
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/25 bg-primary/10 text-primary">
              <span class="material-symbols-outlined">precision_manufacturing</span>
            </div>
          </div>

          <form class="space-y-4" data-calculator-form>
            <label class="grid gap-2 text-sm">
              <span class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant">Input Mode</span>
              <select class="input-shell cursor-pointer" data-mode-select>
                {modeSummaries.map((mode) => (
                  <option value={mode.id}>{mode.title}</option>
                ))}
              </select>
            </label>

            <label class="grid gap-2 text-sm">
              <span class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant" data-input1-label>Input 1</span>
              <div class="relative">
                <input class="input-shell pr-20 text-lg font-headline text-primary" data-input1 type="number" step="any" min="0" placeholder="0" />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded-md border border-primary/18 bg-primary/8 px-2 py-1 text-[10px] font-label uppercase tracking-wider text-primary" data-input1-unit>
                  units
                </span>
              </div>
            </label>

            <label class="grid gap-2 text-sm">
              <span class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant" data-input2-label>Input 2</span>
              <div class="relative">
                <input class="input-shell pr-20 text-lg font-headline text-primary" data-input2 type="number" step="any" min="0" placeholder="0" />
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded-md border border-primary/18 bg-primary/8 px-2 py-1 text-[10px] font-label uppercase tracking-wider text-primary" data-input2-unit>
                  units
                </span>
              </div>
            </label>

            <div class="rounded-xl border border-outline-variant/25 bg-surface-container-low/70 px-4 py-3 text-sm text-on-surface-variant" data-mode-description>
              Pick a mode and enter your known values.
            </div>

            <div class="grid grid-cols-2 gap-3 pt-1">
              <button class="btn-primary gap-2 py-3" type="submit">
                <span class="material-symbols-outlined text-base">play_arrow</span>
                Solve
              </button>
              <button class="btn-secondary gap-2 py-3" type="button" data-reset-btn>
                <span class="material-symbols-outlined text-base">refresh</span>
                Reset
              </button>
            </div>
          </form>

          <p class="mt-4 flex items-center gap-2 text-sm text-on-surface-variant" data-status role="status" aria-live="polite">
            <span class="material-symbols-outlined text-base text-primary/60">info</span>
            Enter inputs and click solve.
          </p>

          <details class="mt-5 rounded-xl border border-outline-variant/20 bg-surface-container-lowest/70">
            <summary class="cursor-pointer px-4 py-3 font-label text-[10px] uppercase tracking-[0.2em] text-outline transition-colors hover:text-on-surface">
              Supported Cases
            </summary>
            <ul class="space-y-2 px-4 pb-4 text-sm text-on-surface-variant">
              {modeSummaries.map((mode) => (
                <li class="rounded-lg border border-transparent bg-surface-container-low/45 px-3 py-2 transition-colors hover:border-primary/20 hover:bg-surface-container-high/30">
                  <div class="flex items-start gap-2">
                    <span class="material-symbols-outlined mt-0.5 text-sm text-primary/70">{mode.icon}</span>
                    <div>
                      <p class="text-primary">{mode.title}</p>
                      <p class="text-xs text-outline">{mode.description}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </details>
        </section>

        <section class="space-y-6">
          <div class="grid gap-4 md:grid-cols-3">
            <article class="lux-stat">
              <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Area</p>
              <p class="mt-2 text-3xl font-headline text-primary text-glow-primary" data-out-area>6.0000</p>
              <p class="mt-1 text-xs text-on-surface-variant">square units (units²)</p>
            </article>
            <article class="lux-stat">
              <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Perimeter</p>
              <p class="mt-2 text-3xl font-headline text-on-surface" data-out-perimeter>12.0000</p>
              <p class="mt-1 text-xs text-on-surface-variant">linear units</p>
            </article>
            <article class="lux-stat">
              <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Hypotenuse</p>
              <p class="mt-2 text-3xl font-headline text-secondary-fixed text-glow-secondary" data-out-c>5.0000</p>
              <p class="mt-1 text-xs text-on-surface-variant">longest side</p>
            </article>
          </div>

          <article class="section-shell p-5 sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Visual Output</p>
                <h3 class="mt-2 text-2xl font-headline">Triangle Visualization</h3>
              </div>
              <a class="btn-secondary gap-2 px-4 py-2 text-xs" href={formulasHref}>
                <span class="material-symbols-outlined text-sm">functions</span>
                Formula Deck
              </a>
            </div>

            <div class="relative mt-5 overflow-hidden rounded-2xl border border-primary/20 bg-surface-container-lowest/75 p-4 sm:p-6">
              <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.06]"></div>
              <svg class="relative h-auto w-full drop-shadow-[0_0_28px_rgba(212,175,116,0.2)]" viewBox="0 0 420 290" aria-label="Right triangle solved geometry">
                <path d="M 60 220 L 80 220 L 80 240" fill="none" stroke="#6f5b47" stroke-width="1.5"></path>
                <path
                  d="M 60 80 L 60 240 L 340 240 Z"
                  fill="none"
                  stroke="#d4af74"
                  stroke-width="3"
                  stroke-linejoin="round"
                  data-triangle-path
                  style="filter: drop-shadow(0 0 10px rgba(212,175,116,0.34));"
                ></path>
                <path d="M 60 80 L 60 240 L 340 240 Z" fill="url(#triangleFillGradient)" opacity="0.12" data-triangle-fill></path>

                <text fill="#c4b7a5" font-family="Sora" font-size="13" text-anchor="end" x="47" y="160" data-label-a>a = 3.000</text>
                <text fill="#c4b7a5" font-family="Sora" font-size="13" text-anchor="middle" x="200" y="262" data-label-b>b = 4.000</text>
                <text fill="#d4af74" font-family="Sora" font-size="14" font-weight="700" text-anchor="start" x="226" y="146" data-label-c style="filter: drop-shadow(0 0 6px rgba(212,175,116,0.4));">c = 5.000</text>
                <text fill="#d9c3a0" font-family="Sora" font-size="11" x="282" y="226" data-label-alpha>A = 36.870 deg</text>
                <text fill="#d9c3a0" font-family="Sora" font-size="11" x="78" y="96" data-label-beta>B = 53.130 deg</text>

                <circle cx="60" cy="240" r="4" fill="#d4af74" opacity="0.7">
                  <animate attributeName="r" values="3;5;3" dur="3s" repeatCount="indefinite" />
                </circle>
                <circle cx="340" cy="240" r="4" fill="#d4af74" opacity="0.7">
                  <animate attributeName="r" values="3;5;3" dur="3s" repeatCount="indefinite" begin="1s" />
                </circle>
                <circle cx="60" cy="80" r="4" fill="#d4af74" opacity="0.7">
                  <animate attributeName="r" values="3;5;3" dur="3s" repeatCount="indefinite" begin="2s" />
                </circle>

                <defs>
                  <linearGradient id="triangleFillGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#d4af74" stop-opacity="1"></stop>
                    <stop offset="100%" stop-color="#8b6228" stop-opacity="0.15"></stop>
                  </linearGradient>
                </defs>
              </svg>
            </div>
          </article>

          <div class="grid gap-6 lg:grid-cols-2">
            <article class="section-shell p-5 sm:p-6">
              <h3 class="text-xl font-headline">Computed Values</h3>
              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div class="lux-data-cell"><span>Leg a</span><strong data-out-a>3.0000</strong></div>
                <div class="lux-data-cell"><span>Leg b</span><strong data-out-b>4.0000</strong></div>
                <div class="lux-data-cell"><span>Hypotenuse c</span><strong data-out-c-2>5.0000</strong></div>
                <div class="lux-data-cell"><span>Angle A</span><strong data-out-a-angle>36.8700 deg</strong></div>
                <div class="lux-data-cell"><span>Angle B</span><strong data-out-b-angle>53.1300 deg</strong></div>
                <div class="lux-data-cell"><span>Semiperimeter</span><strong data-out-s>6.0000</strong></div>
                <div class="lux-data-cell"><span>Altitude h</span><strong data-out-h>2.4000</strong></div>
                <div class="lux-data-cell"><span>Inradius r</span><strong data-out-r>1.0000</strong></div>
                <div class="lux-data-cell"><span>Circumradius R</span><strong data-out-R>2.5000</strong></div>
                <div class="lux-data-cell"><span>Projection p</span><strong data-out-p>1.8000</strong></div>
                <div class="lux-data-cell"><span>Projection q</span><strong data-out-q>3.2000</strong></div>
                <div class="lux-data-cell"><span>sin(A)</span><strong data-out-sinA>0.6000</strong></div>
                <div class="lux-data-cell"><span>cos(A)</span><strong data-out-cosA>0.8000</strong></div>
                <div class="lux-data-cell"><span>tan(A)</span><strong data-out-tanA>0.7500</strong></div>
              </div>
            </article>

            <article class="section-shell p-5 sm:p-6">
              <h3 class="text-xl font-headline">Reasoning and History</h3>
              <p class="mt-1 text-sm text-on-surface-variant">Every solve includes a readable method trace and recent entries.</p>

              <ol class="mt-4 grid gap-3" data-steps-list>
                <!-- Steps will be injected here by muse-calculator.js -->
              </ol>

              <div class="mt-6 border-t border-outline-variant/20 pt-4">
                <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Recent Solves</h4>
                <ul class="mt-3 max-h-60 space-y-2 overflow-y-auto custom-scrollbar text-xs text-on-surface-variant" data-history-list>
                  <li class="text-outline italic">No history yet. Solve to save entries.</li>
                </ul>
              </div>
            </article>
          </div>
        </section>
      </div>
    </div>
  </main>

  <nav class="fixed bottom-0 left-0 right-0 z-20 flex h-16 items-center justify-around border-t border-primary/15 bg-[linear-gradient(180deg,rgba(24,17,12,0.95)_0%,rgba(13,10,7,1)_100%)] backdrop-blur-xl md:hidden">
    <a class="flex flex-col items-center gap-1 text-primary" href={calculatorHref}>
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calculate</span>
      <span class="text-[9px] font-label tracking-wide">Solver</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-outline transition-colors hover:text-on-surface" href={libraryHref}>
      <span class="material-symbols-outlined">menu_book</span>
      <span class="text-[9px] font-label tracking-wide">Library</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-outline transition-colors hover:text-on-surface" href={practiceHref}>
      <span class="material-symbols-outlined">edit_note</span>
      <span class="text-[9px] font-label tracking-wide">Practice</span>
    </a>
    <a class="flex flex-col items-center gap-1 text-outline transition-colors hover:text-on-surface" href={formulasHref}>
      <span class="material-symbols-outlined">functions</span>
      <span class="text-[9px] font-label tracking-wide">Formulas</span>
    </a>
  </nav>

  <div class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm md:hidden" data-mobile-sidebar-overlay></div>
  <aside class="fixed left-0 top-0 z-50 h-full w-[290px] -translate-x-full border-r border-primary/15 bg-[linear-gradient(180deg,#1b140f_0%,#0f0b08_100%)] p-5 transition-transform duration-300 md:hidden" data-mobile-sidebar-panel>
    <div class="mb-6 flex items-center justify-between border-b border-outline-variant/20 pb-4">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-primary-container">
          <span class="material-symbols-outlined text-base text-on-primary" style="font-variation-settings: 'FILL' 1;">diamond</span>
        </div>
        <span class="font-headline text-lg text-primary">Right Triangle Solver</span>
      </div>
      <button type="button" class="rounded-lg border border-outline-variant/20 p-1.5 text-on-surface-variant hover:text-primary" data-mobile-sidebar-close aria-label="Close sidebar">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <nav class="space-y-2" aria-label="Mobile navigation">
      <a class="flex items-center gap-3 rounded-xl border border-primary/20 bg-primary/10 px-4 py-3 text-primary" href={calculatorHref}>
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calculate</span>
        <span class="text-sm font-medium tracking-wide">Solver</span>
      </a>
      <a class="flex items-center gap-3 rounded-xl px-4 py-3 text-on-surface-variant transition-all hover:bg-primary/8 hover:text-on-surface" href={libraryHref}>
        <span class="material-symbols-outlined">menu_book</span>
        <span class="text-sm tracking-wide">Library</span>
      </a>
      <a class="flex items-center gap-3 rounded-xl px-4 py-3 text-on-surface-variant transition-all hover:bg-primary/8 hover:text-on-surface" href={practiceHref}>
        <span class="material-symbols-outlined">edit_note</span>
        <span class="text-sm tracking-wide">Practice</span>
      </a>
      <a class="flex items-center gap-3 rounded-xl px-4 py-3 text-on-surface-variant transition-all hover:bg-primary/8 hover:text-on-surface" href={formulasHref}>
        <span class="material-symbols-outlined">functions</span>
        <span class="text-sm tracking-wide">Formulas</span>
      </a>
    </nav>
  </aside>

  <script is:inline src="/js/muse-calculator.js"></script>
  <script is:inline>
    (() => {
      const toggle = document.querySelector('[data-mobile-sidebar-toggle]');
      const panel = document.querySelector('[data-mobile-sidebar-panel]');
      const overlay = document.querySelector('[data-mobile-sidebar-overlay]');
      const close = document.querySelector('[data-mobile-sidebar-close]');
      if (!toggle || !panel || !overlay) return;

      const open = () => {
        panel.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      const shut = () => {
        panel.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      };

      toggle.addEventListener('click', open);
      overlay.addEventListener('click', shut);
      close?.addEventListener('click', shut);
      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', shut));
    })();
  </script>
</div>
