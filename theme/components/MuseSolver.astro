---
interface Props {
  title?: string;
  solverHref?: string;
  libraryHref?: string;
  practiceHref?: string;
  formulasHref?: string;
}

const {
  title = 'Mathematical Muse',
  solverHref = '/',
  libraryHref = '/library/',
  practiceHref = '/practice/',
  formulasHref = '/formulas/'
} = Astro.props;

const modeSummaries = [
  { id: 'legs_ab', title: 'Leg a + Leg b', description: 'Compute everything from the two legs.' },
  { id: 'legA_c', title: 'Leg a + Hypotenuse c', description: 'Find missing leg b, angles, and all metrics.' },
  { id: 'legB_c', title: 'Leg b + Hypotenuse c', description: 'Find missing leg a, angles, and all metrics.' },
  { id: 'angleA_legA', title: 'Angle A + Leg a', description: 'Use sine and tangent to recover full triangle.' },
  { id: 'angleA_legB', title: 'Angle A + Leg b', description: 'Use cosine and tangent to recover full triangle.' },
  { id: 'angleA_c', title: 'Angle A + Hypotenuse c', description: 'Use sine/cosine for direct side reconstruction.' },
  { id: 'angleB_legA', title: 'Angle B + Leg a', description: 'Mirror case using complementary angle B.' },
  { id: 'angleB_legB', title: 'Angle B + Leg b', description: 'Recover all sides from angle B and adjacent leg.' },
  { id: 'angleB_c', title: 'Angle B + Hypotenuse c', description: 'Direct recovery from angle B and hypotenuse.' }
];
---

<div class="dark flex h-[100dvh] w-full overflow-hidden bg-background text-on-surface font-body" data-muse-root>
  <aside class="hidden h-screen w-64 shrink-0 flex-col border-r border-outline-variant/15 bg-[#0d1c32] py-6 md:flex">
    <div class="mb-10 px-8">
      <h1 class="text-xl font-headline text-primary">The Muse</h1>
      <p class="font-label text-xs uppercase tracking-widest text-slate-400 opacity-70">Precision Solver</p>
    </div>

    <nav class="flex-1 space-y-2 px-4" aria-label="Workspace navigation">
      <a class="flex items-center gap-4 rounded-lg border-l-2 border-primary bg-surface-container-high px-4 py-3 text-primary transition-all duration-300" href={solverHref}>
        <span class="material-symbols-outlined">calculate</span>
        <span class="text-sm tracking-wide">Solver</span>
      </a>
      <a class="flex items-center gap-4 rounded-lg px-4 py-3 text-slate-400 transition-all duration-300 hover:bg-surface-container-high hover:text-slate-100" href={libraryHref}>
        <span class="material-symbols-outlined">menu_book</span>
        <span class="text-sm tracking-wide">Library</span>
      </a>
      <a class="flex items-center gap-4 rounded-lg px-4 py-3 text-slate-400 transition-all duration-300 hover:bg-surface-container-high hover:text-slate-100" href={practiceHref}>
        <span class="material-symbols-outlined">edit_note</span>
        <span class="text-sm tracking-wide">Practice</span>
      </a>
      <a class="flex items-center gap-4 rounded-lg px-4 py-3 text-slate-400 transition-all duration-300 hover:bg-surface-container-high hover:text-slate-100" href={formulasHref}>
        <span class="material-symbols-outlined">functions</span>
        <span class="text-sm tracking-wide">Formulas</span>
      </a>
    </nav>

    <div class="mb-6 px-8">
      <a class="inline-flex w-full items-center justify-center rounded-lg bg-gradient-to-br from-primary to-primary-container py-3 text-center font-medium text-on-primary shadow-lg shadow-primary/10 transition-all hover:brightness-110" href={`${formulasHref}pythagorean-theorem/`}>
        Study Core Formula
      </a>
    </div>

    <div class="space-y-2 border-t border-outline-variant/10 px-4 pt-6">
      <a class="flex items-center gap-4 px-4 py-2 text-slate-400 transition-colors hover:text-slate-100" href="#">
        <span class="material-symbols-outlined">settings</span>
        <span class="text-sm">Settings</span>
      </a>
      <a class="flex items-center gap-4 px-4 py-2 text-slate-400 transition-colors hover:text-slate-100" href="#">
        <span class="material-symbols-outlined">help</span>
        <span class="text-sm">Support</span>
      </a>
    </div>
  </aside>

  <main class="min-w-0 flex flex-1 flex-col overflow-hidden bg-background">
    <header class="h-16 w-full shrink-0 bg-[#041329] px-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-2xl font-headline tracking-tight text-primary">{title}</span>
        <span class="rounded border border-primary/30 bg-primary/5 px-2 py-0.5 text-[10px] uppercase tracking-tighter text-primary font-label">Full Solver</span>
      </div>

      <div class="flex items-center gap-4">
        <a class="hidden rounded-lg border border-primary/20 bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary transition-all hover:bg-primary/20 md:inline-flex" href={formulasHref}>
          Browse All Formulas
        </a>
        <span class="material-symbols-outlined cursor-pointer text-slate-400 transition-colors hover:text-primary">account_circle</span>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto p-6 md:p-8">
      <div class="mx-auto grid max-w-[1400px] gap-6 xl:grid-cols-[360px_minmax(0,1fr)]">
        <section class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-6">
          <h2 class="text-xl font-headline text-on-surface">Universal Right Triangle Solver</h2>
          <p class="mt-2 text-sm text-slate-300">
            Choose any valid input pair. The solver computes every side, angle, and derived metric.
          </p>

          <form class="mt-6 space-y-4" data-solver-form>
            <label class="grid gap-2 text-sm">
              <span class="font-label uppercase tracking-widest text-slate-400">Input Mode</span>
              <select class="input-shell" data-mode-select>
                {modeSummaries.map((mode) => (
                  <option value={mode.id}>{mode.title}</option>
                ))}
              </select>
            </label>

            <label class="grid gap-2 text-sm">
              <span class="font-label uppercase tracking-widest text-slate-400" data-input1-label>Input 1</span>
              <div class="relative">
                <input class="input-shell pr-16 text-lg font-headline text-primary" data-input1 type="number" step="any" min="0" />
                <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs text-slate-400 font-label" data-input1-unit>units</span>
              </div>
            </label>

            <label class="grid gap-2 text-sm">
              <span class="font-label uppercase tracking-widest text-slate-400" data-input2-label>Input 2</span>
              <div class="relative">
                <input class="input-shell pr-16 text-lg font-headline text-primary" data-input2 type="number" step="any" min="0" />
                <span class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-xs text-slate-400 font-label" data-input2-unit>units</span>
              </div>
            </label>

            <p class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest px-3 py-2 text-xs text-slate-400" data-mode-description>
              Pick a mode and enter your known values.
            </p>

            <div class="flex gap-3 pt-1">
              <button class="flex-1 rounded-lg border border-primary/20 bg-primary/10 py-2 text-sm uppercase text-primary font-label transition-colors hover:bg-primary/20" type="submit">
                Solve
              </button>
              <button class="flex-1 rounded-lg border border-outline-variant/20 bg-surface-container-high py-2 text-sm uppercase text-primary font-label transition-colors hover:bg-surface-container-highest" type="button" data-reset-btn>
                Reset
              </button>
            </div>
          </form>

          <p class="mt-4 text-sm text-slate-300" data-status role="status" aria-live="polite">
            Enter inputs and click solve.
          </p>

          <div class="mt-6 rounded-xl border border-outline-variant/15 bg-surface-container-lowest p-4">
            <h3 class="text-sm font-label uppercase tracking-widest text-slate-400">All Supported Cases</h3>
            <ul class="mt-3 space-y-2 text-sm text-slate-300">
              {modeSummaries.map((mode) => (
                <li>
                  <span class="text-primary">{mode.title}</span>
                  <span class="text-slate-400"> - {mode.description}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="space-y-6">
          <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
            <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-6">
              <div
                class="pointer-events-none absolute inset-0 opacity-10"
                style="background-image: radial-gradient(circle at 2px 2px, #3c494c 1px, transparent 0); background-size: 38px 38px;"
              ></div>

              <div class="relative flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-headline">Triangle Visualization</h2>
                  <p class="text-xs uppercase tracking-widest text-slate-400 font-label mt-1">Scaled from solved values</p>
                </div>
                <a class="rounded-lg border border-primary/20 bg-primary/10 px-3 py-1.5 text-xs uppercase tracking-widest text-primary font-label" href={formulasHref}>
                  Formula Pages
                </a>
              </div>

              <div class="relative mt-4 flex items-center justify-center">
                <svg class="h-auto w-full max-w-2xl" viewBox="0 0 420 290" aria-label="Right triangle solved geometry">
                  <path d="M 60 220 L 80 220 L 80 240" fill="none" stroke="#3c494c" stroke-width="1.5"></path>
                  <path
                    d="M 60 80 L 60 240 L 340 240 Z"
                    fill="none"
                    stroke="#00daf3"
                    stroke-width="3.5"
                    stroke-linejoin="round"
                    data-triangle-path
                  ></path>
                  <path d="M 60 80 L 60 240 L 340 240 Z" fill="url(#triangleFillGradient)" opacity="0.16" data-triangle-fill></path>

                  <text fill="#bbc9cc" font-family="Space Grotesk" font-size="13" text-anchor="end" x="47" y="160" data-label-a>a = 3.000</text>
                  <text fill="#bbc9cc" font-family="Space Grotesk" font-size="13" text-anchor="middle" x="200" y="262" data-label-b>b = 4.000</text>
                  <text fill="#00daf3" font-family="Space Grotesk" font-size="14" font-weight="700" text-anchor="start" x="226" y="146" data-label-c>c = 5.000</text>
                  <text fill="#7ed1f7" font-family="Space Grotesk" font-size="11" x="282" y="226" data-label-alpha>A = 36.870 deg</text>
                  <text fill="#7ed1f7" font-family="Space Grotesk" font-size="11" x="78" y="96" data-label-beta>B = 53.130 deg</text>

                  <defs>
                    <linearGradient id="triangleFillGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#00daf3" stop-opacity="1"></stop>
                      <stop offset="100%" stop-color="#00bcd2" stop-opacity="0.2"></stop>
                    </linearGradient>
                  </defs>
                </svg>
              </div>
            </div>

            <div class="space-y-4">
              <div class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-5">
                <p class="font-label text-[10px] uppercase tracking-widest text-slate-500">Area</p>
                <p class="mt-2 text-3xl font-headline text-primary text-glow-primary" data-out-area>6.0000</p>
              </div>
              <div class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-5">
                <p class="font-label text-[10px] uppercase tracking-widest text-slate-500">Perimeter</p>
                <p class="mt-2 text-3xl font-headline text-on-surface" data-out-perimeter>12.0000</p>
              </div>
              <div class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-5">
                <p class="font-label text-[10px] uppercase tracking-widest text-slate-500">Hypotenuse</p>
                <p class="mt-2 text-3xl font-headline text-secondary-fixed" data-out-c>5.0000</p>
              </div>
            </div>
          </div>

          <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-6">
              <h3 class="text-lg font-headline">Solved Values</h3>
              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">a</span><div class="font-mono text-primary" data-out-a>3.0000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">b</span><div class="font-mono text-primary" data-out-b>4.0000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">c</span><div class="font-mono text-primary" data-out-c-2>5.0000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">A (deg)</span><div class="font-mono text-tertiary" data-out-a-angle>36.8700</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">B (deg)</span><div class="font-mono text-tertiary" data-out-b-angle>53.1300</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">Semiperimeter s</span><div class="font-mono text-on-surface" data-out-s>6.0000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">Altitude h</span><div class="font-mono text-on-surface" data-out-h>2.4000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">Inradius r</span><div class="font-mono text-on-surface" data-out-r>1.0000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">Circumradius R</span><div class="font-mono text-on-surface" data-out-R>2.5000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">Projection p</span><div class="font-mono text-on-surface" data-out-p>1.8000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">Projection q</span><div class="font-mono text-on-surface" data-out-q>3.2000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">sin(A)</span><div class="font-mono text-on-surface" data-out-sinA>0.6000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">cos(A)</span><div class="font-mono text-on-surface" data-out-cosA>0.8000</div></div>
                <div class="rounded-lg bg-surface-container-lowest p-3"><span class="text-slate-400">tan(A)</span><div class="font-mono text-on-surface" data-out-tanA>0.7500</div></div>
              </div>
            </section>

            <section class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-6">
              <h3 class="text-lg font-headline">How This Was Solved</h3>
              <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-300" data-steps-list>
                <li>Used Pythagorean theorem: c = sqrt(a^2 + b^2).</li>
                <li>Computed angle A with atan(a / b), then B = 90 - A.</li>
                <li>Derived area, perimeter, and circle radii from solved sides.</li>
              </ol>

              <div class="mt-6 border-t border-outline-variant/10 pt-4">
                <h4 class="text-sm font-label uppercase tracking-widest text-slate-400">Recent Solves</h4>
                <ul class="mt-3 space-y-2 text-xs text-slate-300" data-history-list>
                  <li class="text-slate-500">No history yet. Solve to save entries.</li>
                </ul>
              </div>
            </section>
          </div>
        </section>
      </div>
    </div>
  </main>

  <nav class="fixed right-0 bottom-0 left-0 z-20 flex h-16 items-center justify-around border-t border-outline-variant/10 bg-[#0d1c32] md:hidden">
    <a class="flex flex-col items-center text-primary" href={solverHref}>
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calculate</span>
      <span class="text-[10px] font-label">Solver</span>
    </a>
    <a class="flex flex-col items-center text-slate-400" href={libraryHref}>
      <span class="material-symbols-outlined">menu_book</span>
      <span class="text-[10px] font-label">Library</span>
    </a>
    <a class="flex flex-col items-center text-slate-400" href={practiceHref}>
      <span class="material-symbols-outlined">edit_note</span>
      <span class="text-[10px] font-label">Practice</span>
    </a>
    <a class="flex flex-col items-center text-slate-400" href={formulasHref}>
      <span class="material-symbols-outlined">functions</span>
      <span class="text-[10px] font-label">Formulas</span>
    </a>
  </nav>

  <script is:inline src="/js/muse-solver.js"></script>
</div>
