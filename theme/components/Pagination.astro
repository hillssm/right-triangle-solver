---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  previousLabel: string;
  nextLabel: string;
}

const {
  currentPage,
  totalPages,
  basePath,
  previousLabel,
  nextLabel
} = Astro.props;

const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);

function pageHref(page: number): string {
  if (page <= 1) {
    return basePath;
  }
  return `${basePath}${page}/`;
}
---

<nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
  <a
    href={currentPage > 1 ? pageHref(currentPage - 1) : undefined}
    class:list={[
      'rounded-lg border px-3 py-2 text-sm transition-colors',
      currentPage > 1
        ? 'border-outline-variant/45 text-on-surface-variant hover:border-primary/55 hover:text-primary'
        : 'pointer-events-none border-outline-variant/20 text-outline'
    ]}
    aria-disabled={currentPage > 1 ? 'false' : 'true'}
  >
    {previousLabel}
  </a>

  {pageNumbers.map((page) => (
    <a
      href={pageHref(page)}
      class:list={[
        'rounded-lg border px-3 py-2 text-sm transition-colors',
        page === currentPage
          ? 'border-primary/60 bg-primary/14 text-primary'
          : 'border-outline-variant/45 text-on-surface-variant hover:border-primary/55 hover:text-primary'
      ]}
      aria-current={page === currentPage ? 'page' : undefined}
    >
      {page}
    </a>
  ))}

  <a
    href={currentPage < totalPages ? pageHref(currentPage + 1) : undefined}
    class:list={[
      'rounded-lg border px-3 py-2 text-sm transition-colors',
      currentPage < totalPages
        ? 'border-outline-variant/45 text-on-surface-variant hover:border-primary/55 hover:text-primary'
        : 'pointer-events-none border-outline-variant/20 text-outline'
    ]}
    aria-disabled={currentPage < totalPages ? 'false' : 'true'}
  >
    {nextLabel}
  </a>
</nav>
