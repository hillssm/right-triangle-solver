---
interface Props {
  heading: string;
  description: string;
}

const { heading, description } = Astro.props;
---

<section class="section-shell" aria-labelledby="tool-heading" data-right-triangle-tool>
  <div class="grid gap-8 xl:grid-cols-[0.95fr_1.05fr]">
    <div>
      <h2 id="tool-heading" class="text-2xl sm:text-3xl">{heading}</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-on-surface-variant">{description}</p>

      <form class="mt-6 grid gap-4" data-triangle-form novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Side a</span>
            <input
              class="input-shell"
              type="text"
              inputmode="decimal"
              name="a"
              placeholder="3"
            />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="a"></span>
          </label>

          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Side b</span>
            <input
              class="input-shell"
              type="text"
              inputmode="decimal"
              name="b"
              placeholder="4"
            />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="b"></span>
          </label>

          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Hypotenuse c</span>
            <input class="input-shell" type="text" inputmode="decimal" name="c" placeholder="5" />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="c"></span>
          </label>

          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Angle α</span>
            <input class="input-shell" type="text" inputmode="text" name="alpha" placeholder="30" />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="alpha"></span>
          </label>

          <label class="grid gap-2 text-sm sm:col-span-2">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Angle β</span>
            <input class="input-shell" type="text" inputmode="text" name="beta" placeholder="pi/6" />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="beta"></span>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">Angle mode</span>
          <button class="interactive-chip is-active" type="button" data-angle-mode-option="deg">Degree</button>
          <button class="interactive-chip" type="button" data-angle-mode-option="rad">Radian</button>
          <span class="text-xs text-on-surface-variant">Angles accept entries like 30 or pi/6.</span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">Quick presets</span>
          <button class="interactive-chip" type="button" data-preset="a:3,b:4">3-4-5</button>
          <button class="interactive-chip" type="button" data-preset="a:5,b:12">5-12-13</button>
          <button class="interactive-chip" type="button" data-preset="a:8,b:15">8-15-17</button>
          <button class="interactive-chip" type="button" data-preset="a:9,b:12">9-12-15</button>
        </div>

        <div class="flex flex-wrap gap-3">
          <button class="btn-primary gap-2" type="submit">
            <span class="material-symbols-outlined text-base">play_arrow</span>
            Solve Triangle
          </button>
          <button class="btn-secondary gap-2" type="button" data-reset-btn>
            <span class="material-symbols-outlined text-base">refresh</span>
            Reset
          </button>
        </div>

        <p class="text-sm text-on-surface-variant" role="status" aria-live="polite" data-tool-status>
          Enter exactly two known values from a, b, c, α, β.
        </p>

        <details class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest/70">
          <summary class="cursor-pointer px-4 py-3 font-label text-[10px] uppercase tracking-[0.2em] text-outline transition-colors hover:text-on-surface">
            Formulas Used
          </summary>
          <ul class="space-y-2 px-4 pb-4 text-sm text-on-surface-variant" data-formula-list>
            <li class="pl-1">c = sqrt(a^2 + b^2)</li>
            <li class="pl-1">α = atan(a / b)</li>
            <li class="pl-1">β = 90° - α</li>
          </ul>
        </details>

        <details class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest/70">
          <summary class="cursor-pointer px-4 py-3 font-label text-[10px] uppercase tracking-[0.2em] text-outline transition-colors hover:text-on-surface">
            Step-By-Step
          </summary>
          <ol class="list-decimal space-y-2 px-4 pb-4 pl-8 text-sm text-on-surface-variant" data-step-list>
            <li class="pl-1">Provide exactly two known values.</li>
            <li class="pl-1">Apply right-triangle identities to recover missing values.</li>
            <li class="pl-1">Validate that c is largest and α + β = 90°.</li>
          </ol>
        </details>
      </form>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <div class="lux-data-cell">
          <span>Side a</span>
          <strong data-result-a>3.0000</strong>
        </div>
        <div class="lux-data-cell">
          <span>Side b</span>
          <strong data-result-b>4.0000</strong>
        </div>
        <div class="lux-data-cell">
          <span>Hypotenuse c</span>
          <strong data-result-hypotenuse>5.0000</strong>
        </div>
        <div class="lux-data-cell">
          <span>Angle α</span>
          <strong data-result-angle-alpha>36.8699 deg</strong>
        </div>
        <div class="lux-data-cell">
          <span>Angle β</span>
          <strong data-result-angle-beta>53.1301 deg</strong>
        </div>
        <div class="lux-data-cell">
          <span>Altitude h</span>
          <strong data-result-altitude>2.4000</strong>
        </div>
        <div class="lux-data-cell">
          <span>Area A</span>
          <strong data-result-area>6.0000</strong>
        </div>
        <div class="lux-data-cell">
          <span>Perimeter P</span>
          <strong data-result-perimeter>12.0000</strong>
        </div>
      </div>
    </div>

    <article class="surface-card border-outline-variant/65 bg-surface-container-low p-4 sm:p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">Live Visualization</p>
          <h3 class="mt-2 text-xl text-on-surface">Right Triangle Diagram</h3>
        </div>
        <div class="rounded-lg border border-primary/30 bg-primary-fixed px-3 py-1 text-[10px] font-label uppercase tracking-[0.2em] text-primary">
          Scaled
        </div>
      </div>

      <div class="relative mt-5 overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-container-lowest/70 p-4 sm:p-6">
        <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
        <svg class="relative h-auto w-full" viewBox="0 0 460 300" aria-label="Dynamic right triangle">
          <defs>
            <linearGradient id="rt-fill-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#f1c97d" stop-opacity="0.3"></stop>
              <stop offset="100%" stop-color="#d4ad65" stop-opacity="0.12"></stop>
            </linearGradient>
          </defs>

          <path d="M 60 240 L 80 240 L 80 260" fill="none" stroke="#99907c" stroke-width="1.5"></path>

          <path
            d="M 70 70 L 70 260 L 380 260 Z"
            fill="none"
            stroke="#f1c97d"
            stroke-width="3.2"
            stroke-linejoin="round"
            data-triangle-path
          ></path>
          <path d="M 70 70 L 70 260 L 380 260 Z" fill="url(#rt-fill-gradient)" data-triangle-fill></path>

          <text x="54" y="170" fill="#d0c5af" font-size="13" text-anchor="end" data-label-a>a = 3.000</text>
          <text x="226" y="284" fill="#d0c5af" font-size="13" text-anchor="middle" data-label-b>b = 4.000</text>
          <text x="250" y="152" fill="#f1c97d" font-size="14" font-weight="700" data-label-c>c = 5.000</text>
          <text x="316" y="248" fill="#b6b5b4" font-size="11" data-label-angle-alpha>α = 36.870 deg</text>
          <text x="84" y="88" fill="#b6b5b4" font-size="11" data-label-angle-beta>β = 53.130 deg</text>
        </svg>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest/70 p-3">
          <p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">a:c ratio</p>
          <p class="mt-2 font-mono text-sm text-on-surface" data-result-ratio-a>0.6000</p>
        </div>
        <div class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest/70 p-3">
          <p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">b:c ratio</p>
          <p class="mt-2 font-mono text-sm text-on-surface" data-result-ratio-b>0.8000</p>
        </div>
        <div class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest/70 p-3">
          <p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">tan(α)</p>
          <p class="mt-2 font-mono text-sm text-on-surface" data-result-tangent>0.7500</p>
        </div>
      </div>
    </article>
  </div>

  <script>
    import {
      parseMathExpression,
      solveRightTriangle,
      formatAngleForMode,
      SOLVER_INPUT_KEYS,
      type AngleMode,
      type RightTriangleSolution,
      type SolverInputKey
    } from 'src/utils/rightTriangleSolver';

    const formatNumber = (value: number, digits = 4): string => Number(value).toFixed(digits);

    const renderListItems = (listEl: HTMLElement, items: string[]) => {
      const fragment = document.createDocumentFragment();
      for (const item of items) {
        const li = document.createElement('li');
        li.className = 'pl-1';
        li.textContent = item;
        fragment.append(li);
      }
      listEl.replaceChildren(fragment);
    };

    const parsePreset = (rawPreset: string): Partial<Record<SolverInputKey, string>> => {
      const values: Partial<Record<SolverInputKey, string>> = {};
      for (const chunk of rawPreset.split(',')) {
        const [rawKey, rawValue] = chunk.split(':');
        const key = rawKey?.trim() as SolverInputKey | undefined;
        const value = rawValue?.trim();
        if (key && value && SOLVER_INPUT_KEYS.includes(key)) {
          values[key] = value;
        }
      }
      return values;
    };

    const initTriangleTool = (section: HTMLElement) => {
      const form = section.querySelector('[data-triangle-form]') as HTMLFormElement | null;
      const statusEl = section.querySelector('[data-tool-status]') as HTMLElement | null;
      const pathEl = section.querySelector('[data-triangle-path]') as SVGPathElement | null;
      const fillEl = section.querySelector('[data-triangle-fill]') as SVGPathElement | null;
      const labelA = section.querySelector('[data-label-a]') as SVGTextElement | null;
      const labelB = section.querySelector('[data-label-b]') as SVGTextElement | null;
      const labelC = section.querySelector('[data-label-c]') as SVGTextElement | null;
      const labelAngleAlpha = section.querySelector('[data-label-angle-alpha]') as SVGTextElement | null;
      const labelAngleBeta = section.querySelector('[data-label-angle-beta]') as SVGTextElement | null;
      const resultAEl = section.querySelector('[data-result-a]') as HTMLElement | null;
      const resultBEl = section.querySelector('[data-result-b]') as HTMLElement | null;
      const hypotenuseEl = section.querySelector('[data-result-hypotenuse]') as HTMLElement | null;
      const areaEl = section.querySelector('[data-result-area]') as HTMLElement | null;
      const perimeterEl = section.querySelector('[data-result-perimeter]') as HTMLElement | null;
      const angleAlphaEl = section.querySelector('[data-result-angle-alpha]') as HTMLElement | null;
      const angleBetaEl = section.querySelector('[data-result-angle-beta]') as HTMLElement | null;
      const altitudeEl = section.querySelector('[data-result-altitude]') as HTMLElement | null;
      const ratioAEl = section.querySelector('[data-result-ratio-a]') as HTMLElement | null;
      const ratioBEl = section.querySelector('[data-result-ratio-b]') as HTMLElement | null;
      const tangentEl = section.querySelector('[data-result-tangent]') as HTMLElement | null;
      const formulaListEl = section.querySelector('[data-formula-list]') as HTMLElement | null;
      const stepListEl = section.querySelector('[data-step-list]') as HTMLElement | null;
      const presetButtons = Array.from(section.querySelectorAll('[data-preset]')) as HTMLButtonElement[];
      const modeButtons = Array.from(section.querySelectorAll('[data-angle-mode-option]')) as HTMLButtonElement[];
      const resetButton = section.querySelector('[data-reset-btn]') as HTMLButtonElement | null;

      if (
        !form ||
        !statusEl ||
        !pathEl ||
        !fillEl ||
        !labelA ||
        !labelB ||
        !labelC ||
        !labelAngleAlpha ||
        !labelAngleBeta ||
        !resultAEl ||
        !resultBEl ||
        !hypotenuseEl ||
        !areaEl ||
        !perimeterEl ||
        !angleAlphaEl ||
        !angleBetaEl ||
        !altitudeEl ||
        !ratioAEl ||
        !ratioBEl ||
        !tangentEl ||
        !formulaListEl ||
        !stepListEl ||
        !resetButton
      ) {
        return;
      }

      const inputRefs = {
        a: form.querySelector('input[name="a"]'),
        b: form.querySelector('input[name="b"]'),
        c: form.querySelector('input[name="c"]'),
        alpha: form.querySelector('input[name="alpha"]'),
        beta: form.querySelector('input[name="beta"]')
      } satisfies Record<SolverInputKey, HTMLInputElement | null>;

      const errorRefs = {
        a: form.querySelector('[data-error-for="a"]'),
        b: form.querySelector('[data-error-for="b"]'),
        c: form.querySelector('[data-error-for="c"]'),
        alpha: form.querySelector('[data-error-for="alpha"]'),
        beta: form.querySelector('[data-error-for="beta"]')
      } satisfies Record<SolverInputKey, HTMLElement | null>;

      if (
        Object.values(inputRefs).some((el) => !el) ||
        Object.values(errorRefs).some((el) => !el)
      ) {
        return;
      }

      const inputs = inputRefs as Record<SolverInputKey, HTMLInputElement>;
      const errors = errorRefs as Record<SolverInputKey, HTMLElement>;

      let angleMode: AngleMode = 'deg';

      const setStatus = (message: string, isError = false) => {
        statusEl.textContent = message;
        statusEl.classList.toggle('text-error', isError);
      };

      const setFieldError = (key: SolverInputKey, message = '') => {
        errors[key].textContent = message;
        inputs[key].setAttribute('aria-invalid', message ? 'true' : 'false');
      };

      const clearFieldErrors = () => {
        for (const key of SOLVER_INPUT_KEYS) {
          setFieldError(key, '');
        }
      };

      const drawTriangle = (solution: RightTriangleSolution) => {
        const originX = 70;
        const originY = 260;
        const maxLeg = Math.max(solution.a, solution.b, 1);
        const scale = 190 / maxLeg;
        const topX = originX;
        const topY = originY - solution.a * scale;
        const rightX = originX + solution.b * scale;
        const path = `M ${topX} ${topY} L ${originX} ${originY} L ${rightX} ${originY} Z`;
        const angleUnit = angleMode === 'deg' ? 'deg' : 'rad';

        pathEl.setAttribute('d', path);
        fillEl.setAttribute('d', path);

        labelA.setAttribute('y', String((topY + originY) / 2));
        labelA.textContent = `a = ${formatNumber(solution.a, 3)}`;

        labelB.setAttribute('x', String((originX + rightX) / 2));
        labelB.textContent = `b = ${formatNumber(solution.b, 3)}`;

        labelC.setAttribute('x', String((originX + rightX) / 2 + 18));
        labelC.setAttribute('y', String((topY + originY) / 2));
        labelC.textContent = `c = ${formatNumber(solution.c, 3)}`;

        labelAngleAlpha.setAttribute('x', String(rightX - 76));
        labelAngleAlpha.setAttribute('y', String(originY - 12));
        labelAngleAlpha.textContent = `α = ${formatAngleForMode(solution.alphaRad, angleMode, 3)} ${angleUnit}`;

        labelAngleBeta.setAttribute('x', String(originX + 14));
        labelAngleBeta.setAttribute('y', String(topY + 16));
        labelAngleBeta.textContent = `β = ${formatAngleForMode(solution.betaRad, angleMode, 3)} ${angleUnit}`;
      };

      const renderSolution = (solution: RightTriangleSolution) => {
        const angleUnit = angleMode === 'deg' ? 'deg' : 'rad';

        resultAEl.textContent = formatNumber(solution.a);
        resultBEl.textContent = formatNumber(solution.b);
        hypotenuseEl.textContent = formatNumber(solution.c);
        angleAlphaEl.textContent = `${formatAngleForMode(solution.alphaRad, angleMode)} ${angleUnit}`;
        angleBetaEl.textContent = `${formatAngleForMode(solution.betaRad, angleMode)} ${angleUnit}`;
        altitudeEl.textContent = formatNumber(solution.h);
        areaEl.textContent = formatNumber(solution.area);
        perimeterEl.textContent = formatNumber(solution.perimeter);
        ratioAEl.textContent = formatNumber(solution.ratioA);
        ratioBEl.textContent = formatNumber(solution.ratioB);
        tangentEl.textContent = formatNumber(solution.tangentAlpha);

        drawTriangle(solution);
        renderListItems(formulaListEl, solution.formulas);
        renderListItems(stepListEl, solution.steps);
      };

      const activePresetForInputs = (preset: Partial<Record<SolverInputKey, string>>) => {
        for (const key of SOLVER_INPUT_KEYS) {
          const presetValue = preset[key] ?? '';
          const currentValue = inputs[key].value.trim();
          if (!presetValue && currentValue) return false;
          if (!presetValue) continue;

          try {
            const presetNumber = parseMathExpression(presetValue);
            const currentNumber = parseMathExpression(currentValue || '');
            if (Math.abs(presetNumber - currentNumber) > 1e-9) {
              return false;
            }
          } catch {
            return false;
          }
        }

        return true;
      };

      const updatePresetState = () => {
        for (const button of presetButtons) {
          const preset = parsePreset(button.getAttribute('data-preset') || '');
          button.classList.toggle('is-active', activePresetForInputs(preset));
        }
      };

      const readValues = () => {
        const values: Partial<Record<SolverInputKey, number>> = {};
        let hasAnyError = false;

        for (const key of SOLVER_INPUT_KEYS) {
          const raw = inputs[key].value.trim();
          if (!raw) {
            setFieldError(key, '');
            continue;
          }

          try {
            let parsed = parseMathExpression(raw);
            if ((key === 'alpha' || key === 'beta') && angleMode === 'deg' && /pi|π/i.test(raw)) {
              parsed = (parsed * 180) / Math.PI;
            }
            values[key] = parsed;
            setFieldError(key, '');
          } catch (error) {
            const fallback =
              key === 'alpha' || key === 'beta'
                ? 'Enter a valid angle (example: 30 or pi/6).'
                : `Enter a valid value for ${key}.`;
            const message = error instanceof Error ? error.message : fallback;
            setFieldError(key, message);
            hasAnyError = true;
          }
        }

        return { values, hasAnyError };
      };

      const solveFromInputs = () => {
        clearFieldErrors();
        const { values, hasAnyError } = readValues();
        if (hasAnyError) {
          setStatus('Fix highlighted inputs before solving.', true);
          updatePresetState();
          return;
        }

        try {
          const solution = solveRightTriangle(values, angleMode);
          renderSolution(solution);
          const readableCase = solution.combination.replace('+', ' + ');
          setStatus(`Solved from ${readableCase}.`, false);
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Unable to solve with these inputs.';
          setStatus(message, true);
        }

        updatePresetState();
      };

      const applyPreset = (button: HTMLButtonElement) => {
        const preset = parsePreset(button.getAttribute('data-preset') || '');
        for (const key of SOLVER_INPUT_KEYS) {
          inputs[key].value = preset[key] ?? '';
        }
        solveFromInputs();
      };

      const syncModeButtons = () => {
        for (const button of modeButtons) {
          const isActive = button.dataset.angleModeOption === angleMode;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      };

      const resetTool = () => {
        angleMode = 'deg';
        syncModeButtons();
        for (const key of SOLVER_INPUT_KEYS) {
          inputs[key].value = '';
        }
        inputs.a.value = '3';
        inputs.b.value = '4';
        solveFromInputs();
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        solveFromInputs();
      });

      for (const key of SOLVER_INPUT_KEYS) {
        inputs[key].addEventListener('input', () => {
          updatePresetState();
          const filled = SOLVER_INPUT_KEYS.filter((inputKey) => inputs[inputKey].value.trim().length > 0).length;
          if (filled === 2) {
            solveFromInputs();
            return;
          }
          if (filled === 0) {
            clearFieldErrors();
            setStatus('Enter exactly two known values from a, b, c, α, β.', false);
            return;
          }
          clearFieldErrors();
          setStatus('Provide exactly two known values to solve.', false);
        });
      }

      for (const button of presetButtons) {
        button.addEventListener('click', () => applyPreset(button));
      }

      for (const button of modeButtons) {
        button.addEventListener('click', () => {
          const nextMode = button.dataset.angleModeOption as AngleMode | undefined;
          if (!nextMode || nextMode === angleMode) return;
          angleMode = nextMode;
          syncModeButtons();
          solveFromInputs();
        });
      }

      resetButton.addEventListener('click', () => resetTool());

      syncModeButtons();
      resetTool();
    };

    const sections = Array.from(document.querySelectorAll('[data-right-triangle-tool]')) as HTMLElement[];
    for (const section of sections) {
      initTriangleTool(section);
    }
  </script>
</section>
