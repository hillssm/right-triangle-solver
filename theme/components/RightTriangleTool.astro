---
interface Props {
  heading: string;
  locale?: string;
  labels?: {
    sideA?: string;
    sideB?: string;
    hypotenuseC?: string;
    angleA?: string;
    angleB?: string;
    angleMode?: string;
    degree?: string;
    radian?: string;
    radianNote?: string;
    solve?: string;
    reset?: string;
    copy?: string;
    statusDefault?: string;
    statusDescription?: string;
    showFormulas?: string;
    area?: string;
    perimeter?: string;
    altitude?: string;
    semiperimeter?: string;
    inradius?: string;
    circumradius?: string;
    segmentP?: string;
    segmentQ?: string;
    visualizationTitle?: string;
    visualizationSub?: string;
    visualizationBadge?: string;
    ratioAC?: string;
    ratioBC?: string;
    tanA?: string;
    solutionSteps?: string;
    solutionStepsDefault?: string;
    entered?: string;
    computed?: string;
    solvedFrom?: string;
    resultsTitle?: string;
    copySuccess?: string;
    solveFirst?: string;
    fixErrors?: string;
  }
}

import { getTranslations } from '../i18n/translations';

const { heading, locale = 'en', labels = {} } = Astro.props;
const bundle = getTranslations(locale as any);
const units = bundle.units || {};

// Default labels in English for fallback
const l = {
  sideA: labels.sideA ?? 'Side a',
  sideB: labels.sideB ?? 'Side b',
  hypotenuseC: labels.hypotenuseC ?? 'Hypotenuse c',
  angleA: labels.angleA ?? 'Angle A',
  angleB: labels.angleB ?? 'Angle B',
  angleMode: labels.angleMode ?? 'Angle mode',
  degree: labels.degree ?? 'Degree',
  radian: labels.radian ?? 'Radian',
  radianNote: labels.radianNote ?? 'Radian entries like pi/6 are supported.',
  solve: labels.solve ?? 'Solve Triangle',
  reset: labels.reset ?? 'Reset',
  copy: labels.copy ?? 'Copy Results',
  statusDefault: labels.statusDefault ?? 'Enter any 2 valid right-triangle values.',
  statusDescription: labels.statusDescription ?? 'Solve sides, angles, and derived measures. View formulas and steps.',
  showFormulas: labels.showFormulas ?? 'Show Formulas Used',
  area: labels.area ?? 'Area',
  perimeter: labels.perimeter ?? 'Perimeter',
  altitude: labels.altitude ?? 'Altitude h',
  semiperimeter: labels.semiperimeter ?? 'Semiperimeter s',
  inradius: labels.inradius ?? 'Inradius r',
  circumradius: labels.circumradius ?? 'Circumradius R',
  segmentP: labels.segmentP ?? 'Segment p',
  segmentQ: labels.segmentQ ?? 'Segment q',
  visualizationTitle: labels.visualizationTitle ?? 'Live Visualization',
  visualizationSub: labels.visualizationSub ?? 'Right Triangle Diagram',
  visualizationBadge: labels.visualizationBadge ?? 'Scaled',
  ratioAC: labels.ratioAC ?? 'a:c ratio',
  ratioBC: labels.ratioBC ?? 'b:c ratio',
  tanA: labels.tanA ?? 'tan(A)',
  solutionSteps: labels.solutionSteps ?? 'Solution Steps',
  solutionStepsDefault: labels.solutionStepsDefault ?? 'Enter exactly 2 values with at least one side.',
  entered: labels.entered ?? 'entered',
  computed: labels.computed ?? 'computed',
  solvedFrom: labels.solvedFrom ?? 'Solved from',
  resultsTitle: labels.resultsTitle ?? 'Right Triangle Solver Results',
  copySuccess: labels.copySuccess ?? 'Results copied to clipboard.',
  solveFirst: labels.solveFirst ?? 'Solve a triangle before copying results.',
  fixErrors: labels.fixErrors ?? 'Please fix the errors in the highlighted fields.'
};

const UNIT_LIST = [
  { val: 'm', label: units.m || 'meter' },
  { val: 'nm', label: units.nm || 'nanometer' },
  { val: 'um', label: units.um || 'micrometer' },
  { val: 'mm', label: units.mm || 'millimeter' },
  { val: 'cm', label: units.cm || 'centimeter' },
  { val: 'km', label: units.km || 'kilometer' },
  { val: 'in', label: units.in || 'inch' },
  { val: 'ft', label: units.ft || 'foot' },
  { val: 'yd', label: units.yd || 'yard' },
  { val: 'mi', label: units.mi || 'mile' },
  { val: 'nmi', label: units.nmi || 'nautical mile' },
  { val: 'ang', label: units.ang || 'angstrom' },
  { val: 'mil', label: units.mil || 'mil' },
  { val: 'pixel', label: units.pixel || 'pixel' },
  { val: 'pt', label: units.pt || 'point' },
  { val: 'survey_ft', label: units.survey_ft || 'survey ft' },
  { val: 'fathom', label: units.fathom || 'fathom' },
  { val: 'au', label: units.au || 'astronomic' },
  { val: 'ls', label: units.ls || 'l-sec' },
  { val: 'lm', label: units.lm || 'l-min' },
  { val: 'lh', label: units.lh || 'l-hour' },
  { val: 'ld', label: units.ld || 'l-day' },
  { val: 'ly', label: units.ly || 'lightyear' },
  { val: 'kly', label: units.kly || 'kilolightyear' },
  { val: 'pc', label: units.pc || 'parsec' },
  { val: 'mpc', label: units.mpc || 'megaparsec' }
];

const labelsJson = JSON.stringify(l);
---

<section 
  class="section-shell h-full w-full min-w-0 justify-self-stretch" 
  aria-labelledby="tool-heading" 
  data-right-triangle-tool
  data-labels={labelsJson}
>
  <div class="grid gap-6 sm:grid-cols-[1.1fr_0.9fr] lg:gap-8">
    <div>
      <h2 id="tool-heading" class="text-2xl sm:text-3xl">{heading}</h2>
      <p class="mt-4 font-label text-[11px] font-semibold uppercase tracking-[0.15em] text-primary/90">{l.statusDefault}</p>

      <form class="mt-6 grid gap-4" data-triangle-form novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.sideA}</span>
            <div class="relative flex">
              <input class="input-shell flex-1 rounded-r-none border-r-0" type="text" inputmode="decimal" name="a" />
              <select name="a_unit" class="bg-surface-container border border-outline/30 rounded-r-lg px-2 text-[10px] sm:text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary w-24 sm:w-28 text-on-surface-variant truncate">
                {UNIT_LIST.map(u => <option value={u.val}>({u.val}) {u.label}</option>)}
              </select>
            </div>
            <span class="min-h-[1rem] text-xs text-error" data-error-for="a"></span>
          </label>

          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.sideB}</span>
            <div class="relative flex">
              <input class="input-shell flex-1 rounded-r-none border-r-0" type="text" inputmode="decimal" name="b" />
              <select name="b_unit" class="bg-surface-container border border-outline/30 rounded-r-lg px-2 text-[10px] sm:text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary w-24 sm:w-28 text-on-surface-variant truncate">
                {UNIT_LIST.map(u => <option value={u.val}>({u.val}) {u.label}</option>)}
              </select>
            </div>
            <span class="min-h-[1rem] text-xs text-error" data-error-for="b"></span>
          </label>

          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.hypotenuseC}</span>
            <div class="relative flex">
              <input class="input-shell flex-1 rounded-r-none border-r-0" type="text" inputmode="decimal" name="c" />
              <select name="c_unit" class="bg-surface-container border border-outline/30 rounded-r-lg px-2 text-[10px] sm:text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary w-24 sm:w-28 text-on-surface-variant truncate">
                {UNIT_LIST.map(u => <option value={u.val}>({u.val}) {u.label}</option>)}
              </select>
            </div>
            <span class="min-h-[1rem] text-xs text-error" data-error-for="c"></span>
          </label>

          <label class="grid gap-2 text-sm">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.angleA}</span>
            <input class="input-shell" type="text" inputmode="text" name="alpha" placeholder="" />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="alpha"></span>
          </label>

          <label class="grid gap-2 text-sm sm:col-span-2">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.angleB}</span>
            <input class="input-shell" type="text" inputmode="text" name="beta" placeholder="" />
            <span class="min-h-[1rem] text-xs text-error" data-error-for="beta"></span>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">{l.angleMode}</span>
          <button class="interactive-chip is-active" type="button" data-angle-mode-option="deg">{l.degree}</button>
          <button class="interactive-chip" type="button" data-angle-mode-option="rad">{l.radian}</button>
          <span class="text-xs text-on-surface-variant">{l.radianNote}</span>
        </div>


        <div class="flex flex-wrap gap-3">
          <button class="btn-primary gap-2" type="submit">
            <span class="material-symbols-outlined text-base">play_arrow</span>
            {l.solve}
          </button>
          <button class="btn-secondary gap-2" type="button" data-reset-btn>
            <span class="material-symbols-outlined text-base">refresh</span>
            {l.reset}
          </button>
          <button class="btn-secondary gap-2" type="button" data-copy-btn>
            <span class="material-symbols-outlined text-base">content_copy</span>
            {l.copy}
          </button>
        </div>

        <p class="text-sm text-on-surface-variant" role="status" aria-live="polite" data-tool-status>
        </p>
        <p class="text-xs text-on-surface-variant">{l.statusDescription}</p>

        <details class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest/70">
          <summary class="cursor-pointer px-4 py-3 font-label text-[10px] uppercase tracking-[0.2em] text-outline transition-colors hover:text-on-surface">
            {l.showFormulas}
          </summary>
          <ul class="space-y-2 px-4 pb-4 text-sm text-on-surface-variant" data-formula-list>
            <li class="pl-1"></li>
          </ul>
        </details>


      </form>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <div class="lux-data-cell"><div class="flex items-center justify-between gap-2"><span>{l.sideA}</span><span class="font-label text-[9px] uppercase tracking-[0.16em] text-outline" data-origin-a>-</span></div><strong data-result-a>-</strong></div>
        <div class="lux-data-cell"><div class="flex items-center justify-between gap-2"><span>{l.sideB}</span><span class="font-label text-[9px] uppercase tracking-[0.16em] text-outline" data-origin-b>-</span></div><strong data-result-b>-</strong></div>
        <div class="lux-data-cell"><div class="flex items-center justify-between gap-2"><span>{l.hypotenuseC}</span><span class="font-label text-[9px] uppercase tracking-[0.16em] text-outline" data-origin-c>-</span></div><strong data-result-hypotenuse>-</strong></div>
        <div class="lux-data-cell"><div class="flex items-center justify-between gap-2"><span>{l.angleA}</span><span class="font-label text-[9px] uppercase tracking-[0.16em] text-outline" data-origin-alpha>-</span></div><strong data-result-angle-alpha>-</strong></div>
        <div class="lux-data-cell"><div class="flex items-center justify-between gap-2"><span>{l.angleB}</span><span class="font-label text-[9px] uppercase tracking-[0.16em] text-outline" data-origin-beta>-</span></div><strong data-result-angle-beta>-</strong></div>
        <div class="lux-data-cell"><span>{l.area}</span><strong data-result-area>-</strong></div>
        <div class="lux-data-cell"><span>{l.perimeter}</span><strong data-result-perimeter>-</strong></div>
        <div class="lux-data-cell"><span>{l.altitude}</span><strong data-result-altitude>-</strong></div>
        <div class="lux-data-cell"><span>{l.semiperimeter}</span><strong data-result-semiperimeter>-</strong></div>
        <div class="lux-data-cell"><span>{l.inradius}</span><strong data-result-inradius>-</strong></div>
        <div class="lux-data-cell"><span>{l.circumradius}</span><strong data-result-circumradius>-</strong></div>
        <div class="lux-data-cell"><span>{l.segmentP}</span><strong data-result-segment-p>-</strong></div>
        <div class="lux-data-cell"><span>{l.segmentQ}</span><strong data-result-segment-q>-</strong></div>
      </div>
    </div>

    <article class="surface-card border-outline-variant/65 bg-surface-container-low p-4 sm:p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.visualizationTitle}</p>
          <h3 class="mt-2 text-xl text-on-surface">{l.visualizationSub}</h3>
        </div>
        <div class="rounded-lg border border-primary/30 bg-primary-fixed px-3 py-1 text-[10px] font-label uppercase tracking-[0.2em] text-[#261900]">{l.visualizationBadge}</div>
      </div>

      <div class="relative mt-5 overflow-hidden rounded-2xl border border-outline-variant/20 bg-surface-container-lowest/70 p-4 sm:p-6">
        <div class="dot-grid pointer-events-none absolute inset-0 opacity-[0.08]"></div>
        <svg class="relative h-auto w-full" viewBox="0 0 460 300" aria-label="Dynamic right triangle">
          <defs>
            <linearGradient id="rt-fill-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#f1c97d" stop-opacity="0.3"></stop>
              <stop offset="100%" stop-color="#d4ad65" stop-opacity="0.12"></stop>
            </linearGradient>
          </defs>

          <path d="M 60 240 L 80 240 L 80 260" fill="none" stroke="#99907c" stroke-width="1.5"></path>
          <path d="M 70 70 L 70 260 L 380 260 Z" fill="none" stroke="#f1c97d" stroke-width="3.2" stroke-linejoin="round" data-triangle-path></path>
          <path d="M 70 70 L 70 260 L 380 260 Z" fill="url(#rt-fill-gradient)" data-triangle-fill></path>
          <line x1="70" y1="260" x2="196" y2="184" stroke="#f1c97d" stroke-width="2" stroke-dasharray="5 4" opacity="0" data-altitude-line></line>

          <text x="54" y="170" fill="#d0c5af" font-family="'Noto Serif', serif" font-style="italic" font-size="13" text-anchor="end" data-label-a>a = -</text>
          <text x="226" y="284" fill="#d0c5af" font-family="'Noto Serif', serif" font-style="italic" font-size="13" text-anchor="middle" data-label-b>b = -</text>
          <text x="250" y="145" fill="#f1c97d" font-family="'Noto Serif', serif" font-style="italic" font-size="14" font-weight="700" data-label-c>c = -</text>
          <text x="310" y="252" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="11" data-label-angle-alpha>A = -</text>
          <text x="90" y="105" fill="#b6b5b4" font-family="'Noto Serif', serif" font-style="italic" font-size="11" data-label-angle-beta>B = -</text>
          <text x="208" y="196" fill="#f1c97d" font-family="'Noto Serif', serif" font-style="italic" font-size="11" opacity="0" data-label-h>h = -</text>
        </svg>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest/70 p-3"><p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">{l.ratioAC}</p><p class="mt-2 font-mono text-sm text-on-surface" data-result-ratio-a>-</p></div>
        <div class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest/70 p-3"><p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">{l.ratioBC}</p><p class="mt-2 font-mono text-sm text-on-surface" data-result-ratio-b>-</p></div>
        <div class="rounded-lg border border-outline-variant/20 bg-surface-container-lowest/70 p-3"><p class="font-label text-[10px] uppercase tracking-[0.18em] text-outline">{l.tanA}</p><p class="mt-2 font-mono text-sm text-on-surface" data-result-tangent>-</p></div>
      </div>

      <div class="mt-8 border-t border-outline-variant/30 pt-6">
        <div class="flex items-center gap-3">
          <div class="h-1.5 w-1.5 rounded-full bg-primary/70"></div>
          <h3 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{l.solutionSteps}</h3>
        </div>
        <div class="mt-4 space-y-4">
          <ol class="grid gap-3" data-step-list>
            <li class="rounded-xl border border-outline-variant/10 bg-surface-container-lowest/40 p-3 text-sm text-on-surface-variant transition-colors hover:border-primary/20 hover:bg-surface-container-lowest/60">
              <span class="mr-2 font-mono text-[10px] text-primary/60">01</span>
              {l.solutionStepsDefault}
            </li>
          </ol>
        </div>
      </div>
    </article>
  </div>

  <script>
    import {
      parseMathExpression,
      calculateRightTriangle,
      formatAngleForMode,
      CALCULATOR_INPUT_KEYS,
      type AngleMode,
      type RightTriangleSolution,
      type CalculatorInputKey
    } from '../../src/utils/rightTriangleCalculator';

    type UnitOption = string;

    const UNIT_SCALE: Record<string, number> = {
      m: 1, nm: 1e-9, '\u00B5m': 1e-6, mm: 1e-3, cm: 1e-2, km: 1e3,
      in: 0.0254, ft: 0.3048, yd: 0.9144, mi: 1609.344, nmi: 1852,
      '\u00C5': 1e-10, mil: 0.0000254, pixel: 0.0002645833, pt: 0.0003527778,
      foot_survey_us: 0.3048006096, fathom: 1.8288, au: 149597870700,
      light_second: 299792458, light_minute: 17987547480, light_hour: 1079252848800,
      light_day: 25902068371200, ly: 9460730472580800, kly: 9460730472580800000,
      pc: 3.085677581e16, Mpc: 3.085677581e22
    };
    const formatNumber = (value: number, digits = 4): string => Number(value).toFixed(digits);
    const formatEditableNumber = (value: number, digits = 10): string => String(Number(value.toFixed(digits)));
    const formatWithUnitRaw = (value: number, unit: UnitOption, digits = 4, squared = false): string => {
      const base = formatNumber(value, digits);
      if (!unit) return base;
      return squared ? `${base} ${unit}\u00B2` : `${base} ${unit}`;
    };
    const formatWithUnit = (value: number, unit: UnitOption, digits = 4, squared = false): string => {
      const base = formatNumber(value, digits);
      if (!unit) return base;
      return squared ? `${base} ${unit}<sup>2</sup>` : `${base} ${unit}`;
    };
    const formatAngle = (rad: number, mode: AngleMode): string => `${formatAngleForMode(rad, mode, 4)} ${mode === 'deg' ? 'deg' : 'rad'}`;
    const parseAngleInput = (raw: string, mode: AngleMode): number => {
      let parsed = parseMathExpression(raw);
      if (mode === 'deg' && /pi|\u03C0/i.test(raw)) {
        parsed = (parsed * 180) / Math.PI;
      }
      return parsed;
    };
    const formatMathText = (raw: string): string => {
      const applyRootBars = (value: string): string => {
        let output = '';
        let cursor = 0;

        while (cursor < value.length) {
          if (value[cursor] === '\u221A' && value[cursor + 1] === '(') {
            let depth = 0;
            let end = cursor + 1;

            for (; end < value.length; end++) {
              const char = value[end];
              if (char === '(') depth += 1;
              if (char === ')') {
                depth -= 1;
                if (depth === 0) break;
              }
            }

            if (depth === 0 && end < value.length) {
              const inner = applyRootBars(value.slice(cursor + 2, end));
              output += '&#8730;<span class="math-radical-content">' + inner + '</span>';
              cursor = end + 1;
              continue;
            }
          }

          output += value[cursor];
          cursor += 1;
        }

        return output;
      };

      let text = String(raw)
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/alpha|\u03B1/g, 'A')
        .replace(/beta|\u03B2/g, 'B')
        // Textbook power: variable followed by digit (e.g. x2 -> x^2)
        .replace(/([a-zA-Z])(\d+)/g, '<i>$1</i><sup>$2</sup>')
        // Caret power: ^2 -> <sup>2</sup>
        .replace(/\^(\d+)/g, '<sup>$1</sup>')
        // Unicode power conversion
        .replace(/\u00B9/g, '<sup>1</sup>')
        .replace(/\u00B2/g, '<sup>2</sup>')
        .replace(/\u00B3/g, '<sup>3</sup>')
        .replace(/\u2074/g, '<sup>4</sup>');

      // Italicize single letters representing variables if not already wrapped
      text = text.replace(/(^|[^a-zA-Z<>])([a-zA-Z])(?![a-zA-Z<>])/g, '$1<i>$2</i>');
      return applyRootBars(text);
    };

    const parseStepBlock = (rawStep: string): { title: string; lines: string[] } => {
      const lines = String(rawStep)
        .split(/<br\s*\/?>/gi)
        .map((line) => line.trim())
        .filter(Boolean);

      if (!lines.length) {
        return { title: '', lines: [] };
      }

      const title = lines[0].replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*/g, '').trim();
      return { title: title || lines[0], lines: lines.slice(1) };
    };

    const splitSubstitutionAndAnswer = (line: string): { substitution: string; answer: string | null } => {
      const normalized = line.trim();
      const parts = normalized.split('=').map((part) => part.trim()).filter(Boolean);
      if (parts.length >= 3) {
        return {
          substitution: parts.slice(0, -1).join(' = '),
          answer: parts[parts.length - 1]
        };
      }
      if (parts.length === 2) {
        return {
          substitution: normalized,
          answer: parts[1]
        };
      }
      return { substitution: normalized, answer: null };
    };

    const buildStepFlow = (lines: string[]): Array<{ label: string; value: string }> => {
      const cleanedLines = lines.map((line) => line.trim()).filter(Boolean);
      if (!cleanedLines.length) return [];

      const explanationParts: string[] = [];
      const equationLines: string[] = [];
      let formula = '';
      let substitution = '';
      let answer = '';

      for (const line of cleanedLines) {
        const normalizedLine = line.replace(/^use\s+/i, '').trim();
        if (normalizedLine.includes('=')) {
          equationLines.push(normalizedLine);
        } else {
          explanationParts.push(normalizedLine);
        }
      }

      if (equationLines.length > 0) {
        formula = equationLines[0];
        substitution = equationLines[equationLines.length - 1];
      }

      if (substitution) {
        const split = splitSubstitutionAndAnswer(substitution);
        if (split.answer) answer = split.answer;
      } else if (formula) {
        const split = splitSubstitutionAndAnswer(formula);
        if (split.answer) answer = split.answer;
      }

      const flow: Array<{ label: string; value: string }> = [];
      if (formula) flow.push({ label: 'Formula', value: formula });
      if (substitution && substitution !== formula) {
        flow.push({ label: 'Substitution', value: substitution });
      }
      if (answer) flow.push({ label: 'Answer', value: answer });

      const explanation = explanationParts.join(' ').trim();
      if (explanation) flow.push({ label: 'Explanation', value: explanation });

      return flow.length ? flow : cleanedLines.map((line) => ({ label: 'Detail', value: line }));
    };

    const renderListItems = (listEl: HTMLElement, items: string[], isStep = false) => {
      const fragment = document.createDocumentFragment();

      if (isStep) {
        items.forEach((item, index) => {
          const block = parseStepBlock(item);
          if (!block.title && !block.lines.length) return;

          const li = document.createElement('li');
          li.className = 'rounded-xl border border-outline-variant/10 bg-surface-container-lowest/40 p-3 text-sm text-on-surface-variant transition-colors hover:border-primary/20 hover:bg-surface-container-lowest/60 flex items-start gap-3';
          const num = (index + 1).toString().padStart(2, '0');
          const flowItems = buildStepFlow(block.lines);
          const detailItems = flowItems.length
            ? `<ul class="mt-2 space-y-1 border-l border-outline-variant/20 pl-3">${flowItems
                .map((detail) => {
                  const valueClass = detail.label === 'Answer'
                    ? 'math-textbook font-semibold text-primary'
                    : 'math-textbook text-on-surface-variant';
                  return `<li><span class="font-semibold text-on-surface">${detail.label}:</span> <span class="${valueClass}">${formatMathText(detail.value)}</span></li>`;
                })
                .join('')}</ul>`
            : '';

          li.innerHTML = `<span class="mt-0.5 font-mono text-[10px] text-primary flex-shrink-0 rounded-md bg-primary/10 px-2 py-1">${num}</span><div class="min-w-0"><p class="math-textbook font-semibold text-on-surface">${formatMathText(block.title)}</p>${detailItems}</div>`;
          fragment.append(li);
        });

        listEl.replaceChildren(fragment);
        return;
      }

      items.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'pl-1 math-textbook';
        li.innerHTML = formatMathText(item);
        fragment.append(li);
      });

      listEl.replaceChildren(fragment);
    };

      const parsePreset = (rawPreset: string): Partial<Record<CalculatorInputKey, string>> => {
        const values: Partial<Record<CalculatorInputKey, string>> = {};
        for (const chunk of rawPreset.split(',')) {
          const [rawKey, rawValue] = chunk.split(':');
          const key = rawKey?.trim() as CalculatorInputKey | undefined;
          const value = rawValue?.trim();
          if (key && value && CALCULATOR_INPUT_KEYS.includes(key)) values[key] = value;
        }
      return values;
    };

    const initTriangleTool = (section: HTMLElement) => {
      const l = JSON.parse(section.getAttribute('data-labels') || '{}');
      const form = section.querySelector('[data-triangle-form]') as HTMLFormElement | null;
      const statusEl = section.querySelector('[data-tool-status]') as HTMLElement | null;
      const formulaListEl = section.querySelector('[data-formula-list]') as HTMLElement | null;
      const stepListEl = section.querySelector('[data-step-list]') as HTMLElement | null;
      const resetButton = section.querySelector('[data-reset-btn]') as HTMLButtonElement | null;
      const copyButton = section.querySelector('[data-copy-btn]') as HTMLButtonElement | null;
      const pathEl = section.querySelector('[data-triangle-path]') as SVGPathElement | null;
      const fillEl = section.querySelector('[data-triangle-fill]') as SVGPathElement | null;
      const altitudeLineEl = section.querySelector('[data-altitude-line]') as SVGLineElement | null;
      const labelA = section.querySelector('[data-label-a]') as SVGTextElement | null;
      const labelB = section.querySelector('[data-label-b]') as SVGTextElement | null;
      const labelC = section.querySelector('[data-label-c]') as SVGTextElement | null;
      const labelAngleAlpha = section.querySelector('[data-label-angle-alpha]') as SVGTextElement | null;
      const labelAngleBeta = section.querySelector('[data-label-angle-beta]') as SVGTextElement | null;
      const labelH = section.querySelector('[data-label-h]') as SVGTextElement | null;
      const modeButtons = Array.from(section.querySelectorAll('[data-angle-mode-option]')) as HTMLButtonElement[];

      const resultEls = {
        a: section.querySelector('[data-result-a]'),
        b: section.querySelector('[data-result-b]'),
        c: section.querySelector('[data-result-hypotenuse]'),
        A: section.querySelector('[data-result-angle-alpha]'),
        B: section.querySelector('[data-result-angle-beta]'),
        area: section.querySelector('[data-result-area]'),
        perimeter: section.querySelector('[data-result-perimeter]'),
        h: section.querySelector('[data-result-altitude]'),
        s: section.querySelector('[data-result-semiperimeter]'),
        r: section.querySelector('[data-result-inradius]'),
        R: section.querySelector('[data-result-circumradius]'),
        p: section.querySelector('[data-result-segment-p]'),
        q: section.querySelector('[data-result-segment-q]'),
        ratioA: section.querySelector('[data-result-ratio-a]'),
        ratioB: section.querySelector('[data-result-ratio-b]'),
        tanA: section.querySelector('[data-result-tangent]')
      };

      if (!form || !statusEl || !formulaListEl || !stepListEl || !resetButton || !copyButton || !pathEl || !fillEl || !altitudeLineEl || !labelA || !labelB || !labelC || !labelAngleAlpha || !labelAngleBeta || !labelH || Object.values(resultEls).some((el) => !el)) return;

        const inputRefs = {
          a: form.querySelector('input[name="a"]'),
          b: form.querySelector('input[name="b"]'),
          c: form.querySelector('input[name="c"]'),
          alpha: form.querySelector('input[name="alpha"]'),
          beta: form.querySelector('input[name="beta"]')
        } satisfies Record<CalculatorInputKey, HTMLInputElement | null>;

        const errorRefs = {
          a: form.querySelector('[data-error-for="a"]'),
          b: form.querySelector('[data-error-for="b"]'),
          c: form.querySelector('[data-error-for="c"]'),
          alpha: form.querySelector('[data-error-for="alpha"]'),
          beta: form.querySelector('[data-error-for="beta"]')
        } satisfies Record<CalculatorInputKey, HTMLElement | null>;

        const originRefs = {
          a: section.querySelector('[data-origin-a]'),
          b: section.querySelector('[data-origin-b]'),
          c: section.querySelector('[data-origin-c]'),
          alpha: section.querySelector('[data-origin-alpha]'),
          beta: section.querySelector('[data-origin-beta]')
        } satisfies Record<CalculatorInputKey, HTMLElement | null>;

        if (Object.values(inputRefs).some((el) => !el) || Object.values(errorRefs).some((el) => !el) || Object.values(originRefs).some((el) => !el)) return;

        const inputs = inputRefs as Record<CalculatorInputKey, HTMLInputElement>;
        const errors = errorRefs as Record<CalculatorInputKey, HTMLElement>;
        const origins = originRefs as Record<CalculatorInputKey, HTMLElement>;
        const r = resultEls as Record<string, HTMLElement>;

        let angleMode: AngleMode = 'deg';
        let unit: UnitOption = '';
        let lastSolution: RightTriangleSolution | null = null;

        const getFilledCount = () => CALCULATOR_INPUT_KEYS.filter((key) => inputs[key].value.trim().length > 0).length;

        const setStatus = (message: string, isError = false) => {
          statusEl.textContent = message;
          statusEl.classList.toggle('text-error', isError);
        };

        const setFieldError = (key: CalculatorInputKey, message = '') => {
          errors[key].textContent = message;
          inputs[key].setAttribute('aria-invalid', message ? 'true' : 'false');
        };

        const clearFieldErrors = () => {
          for (const key of CALCULATOR_INPUT_KEYS) setFieldError(key, '');
        };

        const labelEntered = l.entered || 'entered';
        const labelComputed = l.computed || 'computed';
        const labelSolvedFrom = l.solvedFrom || 'Solved from';
        const labelStatusDefault = l.statusDefault || '';
        const labelSolutionStepsDefault = l.solutionStepsDefault || '';
        const DEFAULT_PATH = 'M 70 70 L 70 260 L 380 260 Z';

        const setOriginState = (provided: CalculatorInputKey[] | null) => {
          for (const key of CALCULATOR_INPUT_KEYS) {
            const entered = provided ? provided.includes(key) : false;
            origins[key].textContent = provided ? (entered ? labelEntered : labelComputed) : '-';
            origins[key].classList.toggle('text-primary', entered);
            origins[key].classList.toggle('text-outline', !entered);
          }
        };

      const setEmptyResults = () => {
        for (const key of ['a', 'b', 'c', 'A', 'B', 'area', 'perimeter', 'h', 's', 'r', 'R', 'p', 'q', 'ratioA', 'ratioB', 'tanA']) r[key].textContent = '-';
        setOriginState(null);
        renderListItems(formulaListEl, []);
        renderListItems(stepListEl, [labelSolutionStepsDefault], true);
        pathEl.setAttribute('d', DEFAULT_PATH);
        fillEl.setAttribute('d', DEFAULT_PATH);
        altitudeLineEl.setAttribute('opacity', '0');
        labelH.setAttribute('opacity', '0');
        labelA.textContent = 'a = -';
        labelB.textContent = 'b = -';
        labelC.textContent = 'c = -';
        labelAngleAlpha.textContent = 'A = -';
        labelAngleBeta.textContent = 'B = -';
        labelH.textContent = 'h = -';
        labelA.setAttribute('fill', '#d0c5af');
        labelB.setAttribute('fill', '#d0c5af');
        labelC.setAttribute('fill', '#f1c97d');
        labelAngleAlpha.setAttribute('fill', '#b6b5b4');
        labelAngleBeta.setAttribute('fill', '#b6b5b4');
        lastSolution = null;
      };

      const drawTriangle = (solution: RightTriangleSolution) => {
        const ox = 70;
        const oy = 260;
        const scale = 190 / Math.max(solution.a, solution.b, 1);
        const tx = ox;
        const ty = oy - solution.a * scale;
        const rx = ox + solution.b * scale;
        const ry = oy;
        const path = `M ${tx} ${ty} L ${ox} ${oy} L ${rx} ${ry} Z`;
        pathEl.setAttribute('d', path);
        fillEl.setAttribute('d', path);

        const dx = rx - tx;
        const dy = ry - ty;
        const den = dx * dx + dy * dy;
        const t = den > 0 ? ((ox - tx) * dx + (oy - ty) * dy) / den : 0;
        const fx = tx + t * dx;
        const fy = ty + t * dy;

        altitudeLineEl.setAttribute('x1', String(ox));
        altitudeLineEl.setAttribute('y1', String(oy));
        altitudeLineEl.setAttribute('x2', String(fx));
        altitudeLineEl.setAttribute('y2', String(fy));
        altitudeLineEl.setAttribute('opacity', '1');

        labelH.setAttribute('x', String((ox + fx) / 2 + 8));
        labelH.setAttribute('y', String((oy + fy) / 2 - 8));
        labelH.setAttribute('opacity', '1');
        labelH.textContent = `h = ${formatWithUnit(solution.h, unit, 3)}`;

        labelA.setAttribute('y', String((ty + oy) / 2));
        labelA.textContent = `a = ${formatWithUnit(solution.a, unit, 3)}`;
        labelB.setAttribute('x', String((ox + rx) / 2));
        labelB.textContent = `b = ${formatWithUnit(solution.b, unit, 3)}`;
        labelC.setAttribute('x', String((ox + rx) / 2 + 18));
        labelC.setAttribute('y', String((ty + oy) / 2));
        labelC.textContent = `c = ${formatWithUnit(solution.c, unit, 3)}`;
        labelAngleAlpha.setAttribute('x', String(rx - 80));
        labelAngleAlpha.setAttribute('y', String(oy - 8));
        labelAngleAlpha.textContent = `A = ${formatAngleForMode(solution.alphaRad, angleMode, 3)} ${angleMode === 'deg' ? 'deg' : 'rad'}`;
        labelAngleBeta.setAttribute('x', String(ox + 20));
        labelAngleBeta.setAttribute('y', String(ty + 35));
        labelAngleBeta.textContent = `B = ${formatAngleForMode(solution.betaRad, angleMode, 3)} ${angleMode === 'deg' ? 'deg' : 'rad'}`;

        const entered = new Set(solution.providedKeys);
        labelA.setAttribute('fill', entered.has('a') ? '#f1c97d' : '#d0c5af');
        labelB.setAttribute('fill', entered.has('b') ? '#f1c97d' : '#d0c5af');
        labelC.setAttribute('fill', entered.has('c') ? '#f1c97d' : '#d0c5af');
        labelAngleAlpha.setAttribute('fill', entered.has('alpha') ? '#f1c97d' : '#b6b5b4');
        labelAngleBeta.setAttribute('fill', entered.has('beta') ? '#f1c97d' : '#b6b5b4');
      };

      const renderSolution = (solution: RightTriangleSolution) => {
        r.a.innerHTML = formatWithUnit(solution.a, unit);
        r.b.innerHTML = formatWithUnit(solution.b, unit);
        r.c.innerHTML = formatWithUnit(solution.c, unit);
        r.A.innerHTML = formatAngle(solution.alphaRad, angleMode);
        r.B.innerHTML = formatAngle(solution.betaRad, angleMode);
        r.area.innerHTML = formatWithUnit(solution.area, unit, 4, true);
        r.perimeter.innerHTML = formatWithUnit(solution.perimeter, unit);
        r.h.innerHTML = formatWithUnit(solution.h, unit);
        r.s.innerHTML = formatWithUnit(solution.semiperimeter, unit);
        r.r.innerHTML = formatWithUnit(solution.inradius, unit);
        r.R.innerHTML = formatWithUnit(solution.circumradius, unit);
        r.p.innerHTML = formatWithUnit(solution.segmentP, unit);
        r.q.innerHTML = formatWithUnit(solution.segmentQ, unit);
        r.ratioA.innerHTML = formatNumber(solution.ratioA);
        r.ratioB.innerHTML = formatNumber(solution.ratioB);
        r.tanA.innerHTML = formatNumber(solution.tangentAlpha);

        setOriginState(solution.providedKeys);
        drawTriangle(solution);
        renderListItems(formulaListEl, solution.formulas);
        renderListItems(stepListEl, solution.steps, true);

        lastSolution = solution;
      };

        const updateUrlState = () => {
          const params = new URLSearchParams(window.location.search);
          const map: Record<CalculatorInputKey, string> = { a: 'a', b: 'b', c: 'c', alpha: 'A', beta: 'B' };
          for (const key of CALCULATOR_INPUT_KEYS) {
            const value = inputs[key].value.trim();
            if (value) params.set(map[key], value);
            else params.delete(map[key]);
          }
        if (angleMode === 'deg') params.delete('mode');
        else params.set('mode', angleMode);
        if (unit) params.set('unit', unit);
        else params.delete('unit');
        const query = params.toString();
        window.history.replaceState({}, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
      };

        const readValues = () => {
          const values: Partial<Record<CalculatorInputKey, number>> = {};
          let hasAnyError = false;

          const formData = new FormData(form);
          const units: Record<string, string> = {};
          for (const key of ['a', 'b', 'c']) {
            units[key] = String(formData.get(`${key}_unit`) || 'm');
          }

          for (const key of CALCULATOR_INPUT_KEYS) {
            const raw = inputs[key].value.trim();
          if (!raw) {
            setFieldError(key, '');
            continue;
          }

          try {
            const parsed = key === 'alpha' || key === 'beta' ? parseAngleInput(raw, angleMode) : parseMathExpression(raw);
            values[key] = parsed;
            setFieldError(key, '');
          } catch (error) {
            const fallback =
              key === 'alpha' || key === 'beta'
                ? 'Enter a valid angle.'
                : `Enter a valid value for ${key}.`;
            setFieldError(key, error instanceof Error ? error.message : fallback);
            hasAnyError = true;
          }
        }

        let primaryUnit = '';
        for (const k of ['a', 'b', 'c'] as const) {
          if (values[k] !== undefined) {
            primaryUnit = units[k];
            break;
          }
        }
        if (primaryUnit) {
          unit = primaryUnit;
          for (const k of ['a', 'b', 'c'] as const) {
            if (values[k] !== undefined) {
              const scale = UNIT_SCALE[units[k]] / UNIT_SCALE[primaryUnit];
              values[k] = values[k]! * scale;
            }
          }
        }

        return { values, hasAnyError };
      };

      const solveFromInputs = () => {
        clearFieldErrors();
        const { values, hasAnyError } = readValues();
        if (hasAnyError) {
          setStatus(l.fixErrors || 'Fix highlighted inputs before solving.', true);
          setEmptyResults();
          return;
        }

        try {
            const solution = calculateRightTriangle(values, angleMode);
            renderSolution(solution);
            const readableCase = solution.combination.replace('+', ' + ').replace('alpha', 'A').replace('beta', 'B');
            setStatus(`${labelSolvedFrom} ${readableCase}.`, false);
          } catch (error) {
            const msg = error instanceof Error ? error.message : 'Unable to solve.';
            const lowMsg = msg.toLowerCase();
            let targetKey = null;

            if (lowMsg.includes('c must be larger than side a') || lowMsg.includes('c must be greater than leg a') || lowMsg.includes('hypotenuse c must be')) targetKey = 'c';
            else if (lowMsg.includes('c must be larger than side b') || lowMsg.includes('c must be greater than leg b')) targetKey = 'c';
            else if (lowMsg.includes('side a must be a positive') || (!lowMsg.includes('hypotenuse') && lowMsg.includes('side a'))) targetKey = 'a';
            else if (lowMsg.includes('side b must be a positive') || (!lowMsg.includes('hypotenuse') && lowMsg.includes('side b'))) targetKey = 'b';
            else if (lowMsg.includes('angle a')) targetKey = 'alpha';
            else if (lowMsg.includes('angle b')) targetKey = 'beta';

            if (targetKey) {
              setFieldError(targetKey, msg);
              setStatus(l.fixErrors || 'Please fix errors.', true);
            } else {
              setStatus(msg, true);
            }
          setEmptyResults();
        }

        updateUrlState();
      };

      const syncModeButtons = () => {
        for (const button of modeButtons) {
          const active = button.dataset.angleModeOption === angleMode;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        }
      };

      const resetTool = () => {
        angleMode = 'deg';
        unit = '';
        for (const key of CALCULATOR_INPUT_KEYS) {
          inputs[key].value = '';
          setFieldError(key, '');
        }
        syncModeButtons();
        setEmptyResults();
        setStatus(l.statusDefault, false);
        updateUrlState();
      };

      const copyResults = async () => {
        if (!lastSolution) {
          setStatus(l.solveFirst || 'Solve before copying.', true);
          return;
        }

        const text = [
          l.resultsTitle || 'Right Triangle Solver Results',
          `a = ${formatWithUnitRaw(lastSolution.a, unit)}`,
          `b = ${formatWithUnitRaw(lastSolution.b, unit)}`,
          `c = ${formatWithUnitRaw(lastSolution.c, unit)}`,
          `A = ${formatAngle(lastSolution.alphaRad, angleMode)}`,
          `B = ${formatAngle(lastSolution.betaRad, angleMode)}`,
          `Area = ${formatWithUnitRaw(lastSolution.area, unit, 4, true)}`,
          `Perimeter = ${formatWithUnitRaw(lastSolution.perimeter, unit)}`,
          `Altitude h = ${formatWithUnitRaw(lastSolution.h, unit)}`,
          `Semiperimeter s = ${formatWithUnitRaw(lastSolution.semiperimeter, unit)}`,
          `Inradius r = ${formatWithUnitRaw(lastSolution.inradius, unit)}`,
          `Circumradius R = ${formatWithUnitRaw(lastSolution.circumradius, unit)}`,
          `Segment p = ${formatWithUnitRaw(lastSolution.segmentP, unit)}`,
          `Segment q = ${formatWithUnitRaw(lastSolution.segmentQ, unit)}`
        ].join('\n');

        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else {
            const area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', 'true');
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.append(area);
            area.select();
            document.execCommand('copy');
            area.remove();
          }
          setStatus(l.copySuccess || 'Copied.', false);
        } catch {
          setStatus('Error copying results.', true);
        }
      };

      const hydrateFromUrl = () => {
        const params = new URLSearchParams(window.location.search);
        const mode = params.get('mode');
        const urlUnit = params.get('unit');
        if (mode === 'deg' || mode === 'rad') angleMode = mode;
        if (urlUnit && UNIT_SCALE[urlUnit]) unit = urlUnit;

        const map: Array<[string, CalculatorInputKey]> = [['a', 'a'], ['b', 'b'], ['c', 'c'], ['A', 'alpha'], ['B', 'beta']];
        let hasAny = false;
        for (const [param, key] of map) {
          const value = params.get(param)?.trim() ?? '';
          if (value) hasAny = true;
          inputs[key].value = value;
        }

        syncModeButtons();

        const filled = getFilledCount();
        if (hasAny && filled >= 2) solveFromInputs();
        else {
          setEmptyResults();
          setStatus(l.statusDefault, false);
        }
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        solveFromInputs();
      });

      for (const key of CALCULATOR_INPUT_KEYS) {
        inputs[key].addEventListener('input', () => {
          setFieldError(key, '');
          const filled = getFilledCount();
          if (filled >= 2) {
            solveFromInputs();
            return;
          }
          if (filled === 0) {
            setEmptyResults();
            setStatus(l.statusDefault, false);
          }
          updateUrlState();
        });

        inputs[key].addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            solveFromInputs();
          }
        });
      }

      for (const button of modeButtons) {
        button.addEventListener('click', () => {
          const next = button.dataset.angleModeOption as AngleMode | undefined;
          if (!next || next === angleMode) return;
          const previousMode = angleMode;
          for (const key of ['alpha', 'beta'] as const) {
            const raw = inputs[key].value.trim();
            if (!raw) continue;
            try {
              const parsedInPreviousMode = parseAngleInput(raw, previousMode);
              const converted = next === 'deg' ? (parsedInPreviousMode * 180) / Math.PI : (parsedInPreviousMode * Math.PI) / 180;
              inputs[key].value = formatEditableNumber(converted);
              setFieldError(key, '');
            } catch {
            }
          }
          angleMode = next;
          syncModeButtons();
          if (getFilledCount() >= 2) solveFromInputs();
          else if (lastSolution) renderSolution(lastSolution);
          updateUrlState();
        });
      }

      for (const uk of ['a_unit', 'b_unit', 'c_unit']) {
        const sel = form.querySelector(`[name="${uk}"]`);
        if (sel) {
          sel.addEventListener('change', () => {
            const filled = getFilledCount();
            if (filled >= 2) solveFromInputs();
            updateUrlState();
          });
        }
      }

      resetButton.addEventListener('click', resetTool);
      copyButton.addEventListener('click', copyResults);

      setEmptyResults();
      hydrateFromUrl();
    };

    for (const section of Array.from(document.querySelectorAll('[data-right-triangle-tool]')) as HTMLElement[]) {
      initTriangleTool(section);
    }
  </script>
</section>
