 * SideFromAngleGuide.astro - Educational guide for the Right Triangle Side From Angle Calculator page.
 * En-only (following SideGuide pattern). 15 sections, 4 SVG diagrams, 4 tables, 12 FAQs.
 */
import katex from 'katex';
import Faq from 'theme/components/Faq.astro';

const rich = (s: string): string => {
  if (!s || typeof s !== 'string') return '';
  let out = s;
  out = out.replace(
    /\[\[\[(.+?)\]\]\]/g,
    (_, l) =>
      `<div dir="ltr" class="katex-block">${katex.renderToString(l, { throwOnError: false, displayMode: true })}</div>`
  );
  out = out.replace(
    /\[\[(.+?)\]\]/g,
    (_, l) =>
      `<span dir="ltr" class="math-textbook">${katex.renderToString(l, { throwOnError: false, displayMode: false })}</span>`
  );
  return out;
};

const imgSrc = (name: string): string => `/images/hub/${name}`;
