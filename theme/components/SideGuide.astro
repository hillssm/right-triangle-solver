        <tr class="border-b border-outline-variant/15">
          <td class="py-2 pr-4">c = 13, a = 5</td>
          <td class="py-2 pr-4">b</td>
          <td class="py-2 pr-4 font-mono">b = √(c² − a²)</td>
          <td class="py-2">Missing Leg From c and a</td>
        </tr>
        <tr class="border-b border-outline-variant/15 last:border-0">
          <td class="py-2 pr-4">c = 17, b = 15</td>
          <td class="py-2 pr-4">a</td>
