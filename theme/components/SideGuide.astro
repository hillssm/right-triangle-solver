/**
 * SideGuide.astro - Educational guide for the Right Triangle Side Calculator hub page.
 * En-only (following HubGuide pattern). 17 sections, 4 SVG diagrams, 4 tables, 12 FAQs.
 */
import katex from 'katex';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Faq from 'theme/components/Faq.astro';

const SIDE_IMG_DIR = join(process.cwd(), 'public', 'images', 'hub');

const rich = (s: string): string => {
  if (!s || typeof s !== 'string') return '';
  let out = s;
  out = out.replace(
    /\[\[\[(.+?)\]\]\]/g,
    (_, l) =>
      `<div dir="ltr" class="katex-block">${katex.renderToString(l, { throwOnError: false, displayMode: true })}</div>`
  );
  out = out.replace(
    /\[\[(.+?)\]\]/g,
    (_, l) =>
      `<span dir="ltr" class="math-textbook">${katex.renderToString(l, { throwOnError: false, displayMode: false })}</span>`
  );
  return out;
};

const inlineSideSvg = (name: string): string => {
  try {
    return readFileSync(join(SIDE_IMG_DIR, name), 'utf8');
  } catch {
    return '';
  }
};

const imgSrc = (name: string): string => `/images/hub/${name}`;
