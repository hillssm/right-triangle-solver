        <tr><td class="border-gray-600 px-4 py-2">Corresponding angles</td><td class="border-gray-600 px-4 py-2">Equal</td><td class="border-gray-600 px-4 py-2">Equal</td></tr>
        <tr><td class="border-gray-600 px-4 py-2">Corresponding sides</td><td class="border-gray-600 px-4 py-2">Proportional</td><td class="border-gray-600 px-4 py-2">Equal</td></tr>
        <tr><td class="border-gray-600 px-4 py-2">Size</td><td class="border-gray-600 px-4 py-2">May differ</td><td class="border-gray-600 px-4 py-2">Same</td></tr>
        <tr><td class="border-gray-600 px-4 py-2">Scale factor</td><td class="border-gray-600 px-4 py-2">Any positive value</td><td class="border-gray-600 px-4 py-2"><span set:html={rich('[[1]]')} /></td></tr>
        <tr><td class="border-gray-600 px-4 py-2">Example</td><td class="border-gray-600 px-4 py-2">3-4-5 and 6-8-10</td><td class="border-gray-600 px-4 py-2">Two 3-4-5 triangles</td></tr>
