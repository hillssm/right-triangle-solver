        <tr><td class="border-gray-600 px-4 py-2">45-45-90: Leg</td><td class="border-gray-600 px-4 py-2">Hypotenuse c</td><td class="border-gray-600 px-4 py-2">Leg a</td></tr>
        <tr><td class="border-gray-600 px-4 py-2">30-60-90: Long leg</td><td class="border-gray-600 px-4 py-2">Short leg a</td><td class="border-gray-600 px-4 py-2">Long leg b</td></tr>
