        <tr><td class="border-gray-600 px-4 py-2">Long leg b</td><td class="border-gray-600 px-4 py-2">60°</td><td class="border-gray-600 px-4 py-2">Middle</td></tr>
        <tr><td class="border-gray-600 px-4 py-2">Hypotenuse c</td><td class="border-gray-600 px-4 py-2">90°</td><td class="border-gray-600 px-4 py-2">Longest</td></tr>
