---
import type { Locale } from 'theme/i18n/locales';
import { localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, any>;
const about = (content.about as Record<string, any>) ?? {};

const highlightIcons = ['bolt', 'target', 'menu_book', 'shield'];
const defaultHighlights = [
  {
    title: 'Fast by Design',
    description: 'Get right-triangle answers instantly, without unnecessary steps.'
  },
  {
    title: 'Accuracy Focused',
    description: 'Built to support precise calculations and clear geometric reasoning.'
  },
  {
    title: 'Learning Friendly',
    description: 'Step-by-step explanations help students understand, not just copy answers.'
  },
  {
    title: 'Privacy Respectful',
    description: 'We keep the experience practical and lightweight with minimal friction.'
  }
];

const audienceIcons = ['school', 'co_present', 'engineering'];
const defaultAudiences = [
  {
    title: 'Students',
    description:
      'Practice homework, double-check solutions, and build confidence with clear triangle logic.'
  },
  {
    title: 'Teachers',
    description:
      'Use quick demonstrations in class and provide visual references for right-triangle methods.'
  },
  {
    title: 'Professionals',
    description:
      'Validate geometry quickly during drafting, estimation, and day-to-day technical tasks.'
  }
];

const defaultPrinciples = [
  'Clarity over complexity: the interface should be simple enough for beginners and efficient for experts.',
  'Useful defaults: common right-triangle workflows should work immediately with minimal setup.',
  'Transparent math: formulas and steps should be visible, not hidden behind a black box.',
  'Continuous improvement: we evolve the product based on real feedback from learners and practitioners.'
];

const highlights = defaultHighlights.map((fallback, index) => {
  const raw = Array.isArray(about.highlights) ? about.highlights[index] : null;
  return {
    title: pick((raw as Record<string, unknown>) ?? {}, 'title', fallback.title),
    description: pick((raw as Record<string, unknown>) ?? {}, 'description', fallback.description)
  };
});

const audiences = defaultAudiences.map((fallback, index) => {
  const raw = Array.isArray(about.audiences) ? about.audiences[index] : null;
  return {
    title: pick((raw as Record<string, unknown>) ?? {}, 'title', fallback.title),
    description: pick((raw as Record<string, unknown>) ?? {}, 'description', fallback.description)
  };
});

const principles = Array.isArray(about.principles) ? about.principles : defaultPrinciples;
const pageTitle = pick(about, 'title', 'About Us');
const pageDescription = pick(about, 'description', 'About this project');
const canonicalPath = localizePath(locale, '/about-us/');
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  schemaPage="about"
>
  <header class="mx-auto mb-10 w-full max-w-4xl text-center">
    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10">
      <span class="material-symbols-outlined text-3xl text-primary">groups</span>
    </div>
    <p class="font-label text-xs uppercase tracking-widest text-outline">
      {pick(about, 'subHeading', 'Who we are')}
    </p>
    <h1 class="mt-3 text-3xl font-headline text-on-surface sm:text-4xl lg:text-5xl">
      {pick(about, 'heading', 'About Us')}
    </h1>
    <p class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-on-surface-variant">
      {pick(
        about,
        'intro',
        'Right Triangle Solver is built to make geometry easier to understand, faster to solve, and more practical in real learning and work scenarios.'
      )}
    </p>
  </header>

  <section class="mx-auto mb-8 w-full max-w-4xl section-shell">
    <div class="mb-3 flex items-center gap-3">
      <span class="material-symbols-outlined text-lg text-primary">auto_awesome</span>
      <h2 class="text-xl font-headline text-on-surface">
        {pick(about, 'missionTitle', 'Our Mission')}
      </h2>
    </div>
    <p class="leading-relaxed text-on-surface-variant">
      {pick(
        about,
        'missionBody',
        'We built Right Triangle Solver to simplify geometry for students, teachers, and professionals.'
      )}
    </p>

    <div class="anim-stagger mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {highlights.map((item, index) => (
        <article class="surface-card text-center">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10">
            <span class="material-symbols-outlined text-lg text-primary">
              {highlightIcons[index] ?? 'bolt'}
            </span>
          </div>
          <h3 class="text-sm font-semibold text-on-surface" set:html={item.title} />
          <p class="mt-2 text-xs leading-relaxed text-on-surface-variant" set:html={item.description} />
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto mb-8 w-full max-w-4xl section-shell">
    <h2 class="text-xl font-headline text-on-surface">
      {pick(about, 'whoHelpsTitle', 'Who This Helps')}
    </h2>
    <div class="anim-stagger mt-5 grid gap-4 md:grid-cols-3">
      {audiences.map((audience, index) => (
        <article class="surface-card">
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
            <span class="material-symbols-outlined text-lg text-primary">
              {audienceIcons[index] ?? 'school'}
            </span>
          </div>
          <h3 class="text-base font-semibold text-on-surface" set:html={audience.title} />
          <p class="mt-2 text-sm leading-relaxed text-on-surface-variant" set:html={audience.description} />
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto mb-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{pick(about, 'qualityTitle', 'How We Think About Product Quality')}</h2>
    <ul>
      {principles.map((principle: string) => (
        <li set:html={principle} />
      ))}
    </ul>
  </section>

  <section class="mx-auto w-full max-w-4xl section-shell">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-headline text-on-surface">
          {pick(about, 'promiseTitle', 'Our Promise')}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
          {pick(
            about,
            'promiseBody',
            'The tool is free, practical, and designed with care. We continuously improve based on real user needs.'
          )}
        </p>
      </div>
      <div class="flex gap-3">
        <a href={localizePath(locale, '/contact-us/')} class="btn-primary">
          {pick(about, 'contactUsCta', 'Contact Us')}
        </a>
        <a href={localizePath(locale, '/')} class="btn-secondary">
          {pick(about, 'openSolverCta', 'Open Solver')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
