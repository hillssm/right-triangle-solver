---
import type { FocusedAngleCalculatorPage as PageData } from 'src/data/focusedAngleCalculatorPages';
import {
  getFocusedAngleCalculatorRuntimeTranslations,
  getFocusedAngleCalculatorUi
} from 'src/data/focusedAngleCalculatorTranslations';
import ArccosGuide from 'theme/components/ArccosGuide.astro';
import ArcsinGuide from 'theme/components/ArcsinGuide.astro';
import ArctanGuide from 'theme/components/ArctanGuide.astro';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import { formatListItem, formatRootBars } from 'src/utils/formatList';
import Faq from 'theme/components/Faq.astro';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { replaceGenericSeoHeading, seoSectionHeading } from 'theme/utils/seoHeadings';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: PageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;
const formula = getFormulaBySlug(page.formulaSlug);
const isArccosPage = page.slug === 'right-triangle-angle-from-cosine-calculator' && locale === 'en';
const isArcsinPage = page.slug === 'right-triangle-angle-from-sine-calculator' && locale === 'en';
const isArctanPage = page.slug === 'right-triangle-angle-from-tangent-calculator' && locale === 'en';

if (!formula || !formula.calculator) {
  throw new Error(`Focused angle calculator formula is missing: ${page.formulaSlug}`);
}

const calculatorFormula = {
  ...formula,
  calculator: {
    ...formula.calculator,
    outputLabel: page.calculator.outputLabel,
    fields: page.calculator.fields
  }
};

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const content = (bundle.content as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const groupedPages = ((content.grouped as Record<string, any>)?.pages as Record<string, any>) || {};

const homeLabel = pick(nav, 'home', 'Home');
const parentLabel = pick(
  groupedPages['right-triangle-angle-calculator'] || {},
  'h1',
  'Right Triangle Angle Calculator'
);
const canonicalPath = localizePath(locale, page.url);
const parentPath = localizePath(locale, '/right-triangle-angle-calculator/');
const angleUi = getFocusedAngleCalculatorUi(locale);
const runtimeTranslations = getFocusedAngleCalculatorRuntimeTranslations(page, locale);

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  { label: parentLabel, href: parentPath },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: angleUi.messages.positive,
  invalid: angleUi.messages.angleRange,
  hypotenuseKnownLeg: angleUi.messages.hypotenuseKnownSide
};

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

type SideKey = 'a' | 'b' | 'c';
type AngleKey = 'A' | 'B';

const activeSides = new Set<SideKey>(page.diagram.activeSides);
const activeAngles = new Set<AngleKey>(page.diagram.activeAngles);

const sideVisual = (side: SideKey) => {
  const active = activeSides.has(side);
  return {
    stroke: active ? 'var(--color-primary)' : 'var(--color-outline)',
    labelFill: active ? 'var(--color-primary)' : 'var(--color-on-surface-variant)',
    strokeWidth: active ? 7 : 4,
    opacity: active ? 1 : 0.45
  };
};

const angleVisual = (angle: AngleKey) => {
  const active = activeAngles.has(angle);
  return {
    stroke: active ? 'var(--color-tertiary)' : 'var(--color-outline)',
    fill: active ? 'var(--color-tertiary)' : 'var(--color-on-surface-variant)',
    strokeWidth: active ? 3 : 2,
    opacity: active ? 1 : 0.5
  };
};

const sideA = sideVisual('a');
const sideB = sideVisual('b');
const sideC = sideVisual('c');
const angleA = angleVisual('A');
const angleB = angleVisual('B');

const sideKeyItems = [
  {
    key: 'a',
    label: angleUi.sideKey.a.label,
    description: angleUi.sideKey.a.description
  },
  {
    key: 'b',
    label: angleUi.sideKey.b.label,
    description: angleUi.sideKey.b.description
  },
  {
    key: 'c',
    label: angleUi.sideKey.c.label,
    description: angleUi.sideKey.c.description
  }
] as const;

const angleKeyItems = [
  {
    key: 'A',
    label: angleUi.angleKey.A.label,
    description: angleUi.angleKey.A.description
  },
  {
    key: 'B',
    label: angleUi.angleKey.B.label,
    description: angleUi.angleKey.B.description
  }
] as const;

const sectionHeading = (
  heading: string,
  intent?: Parameters<typeof seoSectionHeading>[1]
) =>
  locale === DEFAULT_LOCALE
    ? replaceGenericSeoHeading(heading, page, intent)
    : heading;
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {angleUi.badge}
    </p>
    <h1 class="mx-auto mt-3 max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{page.h1}</span>
    </h1>
    <p class="mx-auto mt-4 hidden max-w-2xl px-4 text-sm leading-relaxed text-on-surface sm:block sm:text-base lg:text-lg opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={page.headerSummary} />
    <p class="mx-auto mt-3 max-w-xs text-xs tracking-[0.01em] text-on-surface sm:hidden opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={page.headerSummary} />
  </header>

  <FormulaCalculator
    formula={calculatorFormula}
    locale={locale}
    heading={page.calculator.heading}
    messages={calculatorMessages}
    runtimeTranslations={runtimeTranslations}
  />

  {!isArccosPage && !isArcsinPage && !isArctanPage && (
  <>
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.howItWorks.h2)}</h2>
    {page.howItWorks.paragraphs.map((paragraph) => (
      <p set:html={formatRootBars(paragraph)} />
    ))}
    <div class="not-prose mt-5 grid gap-3 sm:grid-cols-2">
      {page.howItWorks.cards.map((card) => (
        <div class="min-w-0 rounded-lg border border-outline-variant/25 bg-surface-container-lowest/55 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {card.label}
          </p>
          <p
            class="mt-2 break-words text-sm leading-relaxed text-on-surface-variant"
            dir={card.value.includes('=') ? 'ltr' : undefined}
            set:html={formatRootBars(card.value)}
          />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.formula.h2)}</h2>
    <div class="not-prose mt-4 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
      <div
        class="math-textbook min-w-max text-2xl text-tertiary"
        dir="ltr"
        set:html={renderMath(page.formula.display)}
      />
    </div>
    {page.formula.paragraphs.map((paragraph) => (
      <p set:html={formatRootBars(paragraph)} />
    ))}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="break-words text-2xl font-semibold">{sectionHeading(page.diagram.h2)}</h2>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-on-surface-variant" set:html={formatRootBars(page.diagram.intro)} />

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
      <div class="min-w-0">
        <div class="rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
          <svg
            class="mx-auto block h-auto w-full max-w-md"
            viewBox="0 0 560 390"
            role="img"
            aria-label={`${page.diagram.h2}: ${page.diagram.focusLabel}`}
          >
            <rect
              x="10"
              y="10"
              width="540"
              height="370"
              rx="14"
              fill="var(--color-surface-container-low)"
              stroke="var(--color-outline-variant)"
              stroke-opacity="0.3"
            />
            <path
              d="M120 310 L120 92 L430 310 Z"
              fill="rgba(241, 201, 125, 0.06)"
              stroke="var(--color-outline-variant)"
              stroke-width="1.5"
              stroke-opacity="0.4"
            />
            <path
              d="M120 280 L150 280 L150 310"
              fill="none"
              stroke="var(--color-on-surface-variant)"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <line
              x1="120"
              y1="310"
              x2="120"
              y2="92"
              stroke={sideA.stroke}
              stroke-width={sideA.strokeWidth}
              stroke-linecap="round"
              opacity={sideA.opacity}
            />
            <line
              x1="120"
              y1="310"
              x2="430"
              y2="310"
              stroke={sideB.stroke}
              stroke-width={sideB.strokeWidth}
              stroke-linecap="round"
              opacity={sideB.opacity}
            />
            <line
              x1="120"
              y1="92"
              x2="430"
              y2="310"
              stroke={sideC.stroke}
              stroke-width={sideC.strokeWidth}
              stroke-linecap="round"
              opacity={sideC.opacity}
            />

            <path
              d="M390 310 A 42 42 0 0 0 405 284"
              fill="none"
              stroke={angleA.stroke}
              stroke-width={angleA.strokeWidth}
              stroke-linecap="round"
              opacity={angleA.opacity}
            />
            <path
              d="M120 136 A 44 44 0 0 1 154 121"
              fill="none"
              stroke={angleB.stroke}
              stroke-width={angleB.strokeWidth}
              stroke-linecap="round"
              opacity={angleB.opacity}
            />

            <text
              x="454"
              y="302"
              fill={angleA.fill}
              font-family="'Noto Serif', serif"
              font-size="17"
              font-weight="700"
              text-anchor="start"
            >A</text>
            <text
              x="104"
              y="82"
              fill={angleB.fill}
              font-family="'Noto Serif', serif"
              font-size="17"
              font-weight="700"
              text-anchor="end"
            >B</text>
            <text
              x="104"
              y="332"
              fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif"
              font-size="14"
              text-anchor="end"
            >{angleUi.svg.rightAngle}</text>

            <text
              x="70"
              y="205"
              fill={sideA.labelFill}
              font-family="'Noto Serif', serif"
              font-size="17"
              font-weight="700"
              text-anchor="middle"
            >a</text>
            <text
              x="70"
              y="226"
              fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif"
              font-size="10"
              text-anchor="middle"
            >{angleUi.svg.opposite}</text>
            <text
              x="275"
              y="350"
              fill={sideB.labelFill}
              font-family="'Noto Serif', serif"
              font-size="17"
              font-weight="700"
              text-anchor="middle"
            >b</text>
            <text
              x="275"
              y="367"
              fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif"
              font-size="10"
              text-anchor="middle"
            >{angleUi.svg.adjacent}</text>
            <text
              x="300"
              y="174"
              fill={sideC.labelFill}
              font-family="'Noto Serif', serif"
              font-size="17"
              font-weight="700"
              text-anchor="start"
            >c</text>
            <text
              x="300"
              y="194"
              fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif"
              font-size="10"
              text-anchor="start"
            >{angleUi.svg.hypotenuse}</text>
          </svg>
        </div>
      </div>

      <div class="min-w-0 space-y-4">
        <div class="rounded-lg border border-primary/25 bg-primary/10 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {angleUi.highlightedRelationship}
          </p>
          <p class="mt-2 break-words text-lg font-semibold text-on-surface" dir="ltr">
            {page.diagram.focusLabel}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.focusDetail}
          </p>
        </div>

        <div class="rounded-lg border border-outline-variant/25 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {angleUi.diagramKey}
          </p>
          <ul class="mt-3 grid gap-2 text-sm text-on-surface-variant">
            {sideKeyItems.map((item) => (
              <li class={`rounded-md border px-3 py-2 ${activeSides.has(item.key) ? 'border-primary/30 bg-primary/10' : 'border-outline-variant/20 bg-surface-container-low/50'}`}>
                <strong class="text-on-surface">{item.label}</strong>
                <span class="mt-1 block" set:html={formatRootBars(item.description)} />
              </li>
            ))}
            {angleKeyItems.map((item) => (
              <li class={`rounded-md border px-3 py-2 ${activeAngles.has(item.key) ? 'border-tertiary/40 bg-tertiary/10' : 'border-outline-variant/20 bg-surface-container-low/50'}`}>
                <strong class="text-on-surface">{item.label}</strong>
                <span class="mt-1 block" set:html={formatRootBars(item.description)} />
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-lg border border-outline-variant/25 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {angleUi.quickChecks}
          </p>
          <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.notes.map((note) => (
              <li set:html={formatRootBars(note)} />
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(angleUi.howToUse, 'howTo')}</h2>
    <ol>
      {page.howToSteps.map((step) => (
        <li set:html={step} />
      ))}
    </ol>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.example.h2)}</h2>
    <p set:html={formatRootBars(page.example.intro)} />
    <div class="not-prose mt-5 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
      <div class="grid gap-2">
        {page.example.steps.map((line) => (
          <div class="min-w-max text-lg font-mono text-on-surface" dir="ltr">
            {line}
          </div>
        ))}
      </div>
    </div>
    <p class="mt-4" set:html={formatRootBars(page.example.answer)} />
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(angleUi.whatResultMeans, 'result')}</h2>
    {page.resultMeaning.map((paragraph) => (
      <p set:html={formatRootBars(paragraph)} />
    ))}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(angleUi.whenToUse, 'useCases')}</h2>
    <p set:html={page.whenToUse.intro} />
    <ul>
      {page.whenToUse.items.map((item) => (
        <li set:html={formatListItem(item)} />
      ))}
    </ul>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(angleUi.commonMistakes, 'commonMistakes')}</h2>
    <p set:html={page.commonMistakes.intro} />
    <ul>
      {page.commonMistakes.items.map((item) => (
        <li set:html={formatListItem(item)} />
      ))}
    </ul>
  </section>

  <div class="mx-auto mt-8 w-full max-w-4xl">
    <Faq heading={sectionHeading(angleUi.faqHeading, 'faqs')} items={page.faqs} />
  </div>
  </>
  )}

  {page.slug === 'right-triangle-angle-from-cosine-calculator' && locale === 'en' ? <ArccosGuide /> : null}
  {page.slug === 'right-triangle-angle-from-sine-calculator' && locale === 'en' ? <ArcsinGuide /> : null}
  {page.slug === 'right-triangle-angle-from-tangent-calculator' && locale === 'en' ? <ArctanGuide /> : null}

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="break-words text-2xl font-semibold">{sectionHeading(angleUi.relatedAngleCalculators, 'related')}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="break-words text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {angleUi.openTool}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
