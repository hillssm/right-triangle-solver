---
import type { FocusedMeasurementCalculatorPage as FocusedMeasurementCalculatorPageData } from 'src/data/focusedMeasurementCalculatorPages';
import { getFormulaBySlug, type FormulaCalculatorField } from 'src/data/rightTriangleFormulas';
import Faq from 'theme/components/Faq.astro';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { formatListItem } from 'src/utils/formatList';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: FocusedMeasurementCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;

const buildCalculatorFormula = ({
  formulaSlug,
  outputLabel,
  fields
}: {
  formulaSlug: string;
  outputLabel: string;
  fields: FormulaCalculatorField[];
}) => {
  const formula = getFormulaBySlug(formulaSlug);

  if (!formula || !formula.calculator) {
    throw new Error(`Focused measurement calculator formula is missing: ${formulaSlug}`);
  }

  return {
    ...formula,
    calculator: {
      ...formula.calculator,
      outputLabel,
      fields
    }
  };
};

const calculatorFormula = buildCalculatorFormula({
  formulaSlug: page.formulaSlug,
  outputLabel: page.calculator.outputLabel,
  fields: page.calculator.fields
});

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const content = (bundle.content as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};
const groupedPages = ((content.grouped as Record<string, any>)?.pages as Record<string, any>) || {};
const groupedUi = ((content.grouped as Record<string, any>)?.ui as Record<string, string>) || {};
const faqHub = (content.faqHub as Record<string, string>) || {};

const measurementUiDefaults = {
  home: 'Home',
  badge: 'Measurement Calculator',
  relatedCalculators: 'Related Calculators',
  openTool: 'Open Tool',
  faqHeading: 'Frequently Asked Questions',
  faqDescription: 'Answers to the most common right-triangle solving questions.',
  positiveError: 'Please enter positive values.',
  invalidError: 'Please enter positive values.',
  angleRangeError: 'Angle must be greater than 0\u00B0 and less than 90\u00B0.',
  hypotenuseKnownLegError: 'The hypotenuse c must be greater than the known leg.'
};

const measurementUiByLocale: Partial<Record<Locale, Partial<typeof measurementUiDefaults>>> = {
  hi: {
    home: 'à¤¹à¥‹à¤®',
    badge: 'à¤®à¤¾à¤ª à¤•à¥ˆà¤²à¤•à¥à¤²à¥‡à¤Ÿà¤°',
    faqDescription: 'à¤‡à¤¸ à¤•à¥ˆà¤²à¤•à¥à¤²à¥‡à¤Ÿà¤° à¤”à¤° à¤¸à¤®à¤•à¥‹à¤£ à¤¤à¥à¤°à¤¿à¤­à¥à¤œ à¤®à¤¾à¤ª à¤¸à¥‡ à¤œà¥à¤¡à¤¼à¥‡ à¤¸à¤¾à¤®à¤¾à¤¨à¥à¤¯ à¤ªà¥à¤°à¤¶à¥à¤¨à¥‹à¤‚ à¤•à¥‡ à¤¸à¤°à¤² à¤‰à¤¤à¥à¤¤à¤°à¥¤',
    positiveError: 'à¤•à¥ƒà¤ªà¤¯à¤¾ à¤§à¤¨à¤¾à¤¤à¥à¤®à¤• à¤®à¤¾à¤¨ à¤¦à¤°à¥à¤œ à¤•à¤°à¥‡à¤‚à¥¤',
    invalidError: 'à¤•à¥ƒà¤ªà¤¯à¤¾ à¤®à¤¾à¤¨ à¤¸à¤¹à¥€ à¤¦à¤°à¥à¤œ à¤•à¤°à¥‡à¤‚à¥¤',
    hypotenuseKnownLegError: 'à¤•à¤°à¥à¤£ c à¤¸à¤¬à¤¸à¥‡ à¤²à¤‚à¤¬à¥€ à¤­à¥à¤œà¤¾ à¤¹à¥‹à¤¨à¤¾ à¤šà¤¾à¤¹à¤¿à¤à¥¤'
  },
  ko: {
    home: 'í™ˆ',
    badge: 'ì¸¡ì • ê³„ì‚°ê¸°',
    faqDescription: 'ì´ ê³„ì‚°ê¸°ì™€ ì§ê°ì‚¼ê°í˜• ì¸¡ì •ì— ëŒ€í•´ ìžì£¼ ë¬»ëŠ” ì§ˆë¬¸ì„ ê°„ë‹¨ížˆ ì •ë¦¬í–ˆìŠµë‹ˆë‹¤.',
    positiveError: 'ì–‘ìˆ˜ ê°’ì„ ìž…ë ¥í•˜ì„¸ìš”.',
    invalidError: 'ì˜¬ë°”ë¥¸ ê°’ì„ ìž…ë ¥í•˜ì„¸ìš”.',
    hypotenuseKnownLegError: 'ë¹—ë³€ cëŠ” ê°€ìž¥ ê¸´ ë³€ì´ì–´ì•¼ í•©ë‹ˆë‹¤.'
  }
};

const measurementUi = {
  ...measurementUiDefaults,
  ...(measurementUiByLocale[locale] || {})
};

const homeLabel = pick(nav, 'home', measurementUi.home);
const measurementCalculatorLabel = pick(
  groupedPages['right-triangle-measurements-calculator'] || {},
  'h1',
  'Right Triangle Measurements Calculator'
);
const areaCalculatorLabel = pick(
  groupedPages['right-triangle-area-calculator'] || {},
  'h1',
  'Right Triangle Area Calculator'
);
const canonicalPath = localizePath(locale, page.url);
const areaChildCalculatorSlugs = new Set([
  'right-triangle-area-from-legs-calculator',
  'right-triangle-area-from-angle-calculator',
  'right-triangle-area-from-semiperimeter-calculator',
  'right-triangle-area-from-altitude-calculator'
]);
const isAreaChildCalculator = areaChildCalculatorSlugs.has(page.slug);
const parentCalculatorLabel = isAreaChildCalculator
  ? areaCalculatorLabel
  : measurementCalculatorLabel;
const parentCalculatorPath = isAreaChildCalculator
  ? '/right-triangle-area-calculator/'
  : '/right-triangle-measurements-calculator/';

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  {
    label: parentCalculatorLabel,
    href: localizePath(locale, parentCalculatorPath)
  },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: measurementUi.positiveError,
  invalid: measurementUi.invalidError,
  angleRange: measurementUi.angleRangeError,
  hypotenuseKnownLeg: measurementUi.hypotenuseKnownLegError
};

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

const calculatorName = page.h1.replace(/\s+Calculator$/, '');
const calculatorHeading =
  locale === DEFAULT_LOCALE ? `Calculate ${calculatorName}` : undefined;
const calculatorModes = page.calculatorModes?.length
  ? page.calculatorModes.map((mode) => ({
      ...mode,
      formula: buildCalculatorFormula({
        formulaSlug: mode.formulaSlug,
        outputLabel: mode.outputLabel,
        fields: mode.fields
      })
    }))
  : [
      {
        formulaSlug: page.formulaSlug,
        label: page.h1,
        heading: calculatorHeading,
        outputLabel: page.calculator.outputLabel,
        fields: page.calculator.fields,
        formula: calculatorFormula
      }
    ];
const hasMultipleCalculatorModes = calculatorModes.length > 1;
const howItWorksHeading =
  locale === DEFAULT_LOCALE
    ? `How This ${calculatorName} Calculator Works`
    : page.quickSummary?.h2 || page.h1;

const relatedHeading = pick(groupedUi, 'relatedCalculatorsTitle', measurementUi.relatedCalculators);
const modeTitle = pick(groupedUi, 'calculatorModeTitle', 'Calculator Mode');
const modeSelectLabel = pick(groupedUi, 'chooseCalculatorMode', 'Choose calculator mode');
const openToolLabel = pick(solver, 'openTool', measurementUi.openTool);
const faqHeading = pick(faqHub, 'heading', measurementUi.faqHeading);
const badge = measurementUi.badge;

const measurementSideEntries = page.diagram
  ? [
      page.diagram.sides.a,
      page.diagram.sides.b,
      page.diagram.sides.c,
      page.diagram.result
    ]
  : [];


---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface">{item.label}</span>
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {badge}
    </p>
    <h1 class="mt-3 break-words text-3xl font-bold leading-tight sm:text-4xl">{page.h1}</h1>
    <p class="mt-4 max-w-3xl break-words text-on-surface-variant">{page.intro}</p>
  </header>

  {hasMultipleCalculatorModes ? (
    <section class="mx-auto w-full max-w-4xl section-shell" data-focused-measurement-modes>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h2 class="text-2xl font-semibold">{modeTitle}</h2>
      </div>

      <label class="mt-6 block text-sm font-medium text-on-surface-variant sm:hidden">
        {modeSelectLabel}
        <select
          class="input-shell mt-2 rounded-lg border border-outline-variant/40"
          data-focused-measurement-mode-select
        >
          {calculatorModes.map((mode) => (
            <option value={mode.formulaSlug}>{mode.label}</option>
          ))}
        </select>
      </label>

      <div class="mt-6 hidden flex-wrap gap-2 sm:flex" role="tablist" aria-label={modeSelectLabel}>
        {calculatorModes.map((mode, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-focused-measurement-mode-button
            data-mode={mode.formulaSlug}
            class={`interactive-chip ${index === 0 ? 'is-active' : ''}`}
          >
            {mode.label}
          </button>
        ))}
      </div>

      <div class="mt-8 space-y-8">
        {calculatorModes.map((mode, index) => (
          <div
            data-focused-measurement-mode-panel
            data-mode={mode.formulaSlug}
            class={index === 0 ? '' : 'hidden'}
            role="tabpanel"
          >
            <FormulaCalculator
              formula={mode.formula}
              locale={locale}
              heading={mode.heading}
              messages={calculatorMessages}
            />
          </div>
        ))}
      </div>

      <script is:inline>
        (() => {
          const currentScript = document.currentScript;
          if (!currentScript) return;

          const root = currentScript.closest('[data-focused-measurement-modes]');
          if (!root) return;

          const buttons = Array.from(
            root.querySelectorAll('[data-focused-measurement-mode-button]')
          );
          const panels = Array.from(
            root.querySelectorAll('[data-focused-measurement-mode-panel]')
          );
          const select = root.querySelector('[data-focused-measurement-mode-select]');

          if (!panels.length) return;

          const setMode = (mode) => {
            panels.forEach((panel) => {
              const isActive = panel.getAttribute('data-mode') === mode;
              panel.classList.toggle('hidden', !isActive);
            });

            buttons.forEach((button) => {
              const isActive = button.getAttribute('data-mode') === mode;
              button.classList.toggle('is-active', isActive);
              button.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            if (select && select.value !== mode) {
              select.value = mode;
            }
          };

          const defaultMode = panels[0].getAttribute('data-mode');
          if (defaultMode) setMode(defaultMode);

          buttons.forEach((button) => {
            button.addEventListener('click', () => {
              const mode = button.getAttribute('data-mode');
              if (mode) setMode(mode);
            });
          });

          if (select) {
            select.addEventListener('change', (event) => {
              const target = event.target;
              if (!(target instanceof HTMLSelectElement)) return;
              setMode(target.value);
            });
          }
        })();
      </script>
    </section>
  ) : (
    <FormulaCalculator
      formula={calculatorModes[0].formula}
      locale={locale}
      heading={calculatorModes[0].heading}
      messages={calculatorMessages}
    />
  )}

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{howItWorksHeading}</h2>
    <p>{page.toolPurpose}</p>
    {page.quickSummary?.intro && <p>{page.quickSummary.intro}</p>}
    {page.quickSummary?.cards && (
      <div class="not-prose mt-5 grid gap-3 sm:grid-cols-2">
        {page.quickSummary.cards.map((card) => (
          <div class="min-w-0 rounded-lg border border-outline-variant/25 bg-surface-container-lowest/55 p-4">
            <p class="font-label text-[11px] uppercase tracking-widest text-primary">
              {card.label}
            </p>
            <p class="mt-2 break-words text-sm leading-relaxed text-on-surface-variant">
              {card.value}
            </p>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{page.formulaSection.h2}</h2>
    <div class="not-prose mt-4 grid gap-3">
      {page.formulaSection.formulas.map((expression) => (
        <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
          <div
            class="math-textbook min-w-max text-2xl text-tertiary"
            set:html={renderMath(expression)}
          />
        </div>
      ))}
    </div>
    {page.formulaSection.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </section>

  {page.diagram && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
      <h2 class="text-2xl font-semibold">{page.diagram.h2}</h2>
      <p class="mt-3 leading-relaxed text-on-surface-variant">{page.diagram.intro}</p>
      <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
        <div class="min-w-0">
          <div class="rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
            <svg
              class="measurement-diagram-svg"
              viewBox="0 0 560 380"
              role="img"
              aria-labelledby={`${page.slug}-measurement-diagram-title ${page.slug}-measurement-diagram-desc`}
            >
              <title id={`${page.slug}-measurement-diagram-title`}>{page.diagram.h2}</title>
              <desc id={`${page.slug}-measurement-diagram-desc`}>{page.diagram.caption}</desc>
              <rect
                x="14"
                y="14"
                width="532"
                height="352"
                rx="18"
                fill="var(--color-surface-container-low)"
                stroke="var(--color-outline-variant)"
                stroke-opacity="0.35"
              />
              <path
                d="M100 274 L100 82 L430 274 Z"
                fill="rgba(241, 201, 125, 0.06)"
                stroke="var(--color-outline-variant)"
                stroke-width="1.5"
                stroke-opacity="0.45"
              />
              <path
                d="M100 242 H132 V274"
                fill="none"
                stroke="var(--color-on-surface-variant)"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M100 274 L100 82 L430 274 L100 274"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <line
                x1="100"
                y1="274"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />
              <line
                x1="100"
                y1="82"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />

              <g class="measurement-diagram-label" transform="translate(224 293)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">a</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(54 158)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">b</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(332 136)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">c</text>
              </g>
              <g class="measurement-diagram-formula" transform="translate(164 188)">
                <rect width="230" height="42" rx="10" />
                <text x="115" y="27" text-anchor="middle">{page.diagram.formulaLabel}</text>
              </g>
            </svg>
          </div>
        </div>

        <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {page.diagram.keyLabel}
          </p>
          <div class="mt-4 grid gap-3">
            {measurementSideEntries.map((item) => (
              <div class="min-w-0 rounded-md border border-outline-variant/25 bg-surface-container-low/70 p-3">
                <p class="break-words font-semibold text-on-surface">{item.label}</p>
                <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.notes.map((note) => (
              <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2">
                {note}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{page.howTo.h2}</h2>
    <ol>
      {page.howTo.steps.map((step) => (
        <li set:html={formatListItem(step)} />
      ))}
    </ol>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{page.example.h2}</h2>
    <p>{page.example.intro}</p>
    <div class="not-prose mt-5 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
      <div class="grid gap-2">
        {page.example.lines.map((line) => (
          <div
            class="math-textbook min-w-max text-lg text-on-surface"
            set:html={renderMath(line, false)}
          />
        ))}
      </div>
    </div>
    {page.example.answer && <p class="mt-4">{page.example.answer}</p>}
  </section>

  {page.extraSections.map((section) => (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2>{section.h2}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      {section.listItems && section.listItems.length > 0 && (
        <>
          {section.listTitle && <h3>{section.listTitle}</h3>}
          <ul>
            {section.listItems.map((item) => (
              <li set:html={formatListItem(item)} />
            ))}
          </ul>
        </>
      )}
    </section>
  ))}

  <div class="mx-auto mt-8 w-full max-w-4xl">
    <Faq heading={faqHeading} description={measurementUi.faqDescription} items={page.faqs} />
  </div>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{relatedHeading}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .measurement-diagram-svg {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin-inline: auto;
  }

  .measurement-diagram-label rect,
  .measurement-diagram-formula rect {
    fill: var(--color-surface-container-high);
    stroke: var(--color-outline-variant);
    stroke-opacity: 0.65;
  }

  .measurement-diagram-label text,
  .measurement-diagram-formula text {
    fill: var(--color-on-surface);
    font-family: var(--font-label);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .measurement-diagram-formula text {
    fill: var(--color-primary);
  }

  @media (max-width: 28rem) {
    .measurement-diagram-label text,
    .measurement-diagram-formula text {
      font-size: 0.8125rem;
    }
  }
</style>
