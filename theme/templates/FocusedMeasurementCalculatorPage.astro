          </p>
        </a>
      ))}
    </div>
  </section>
  </>
  )}

  {isAreaFromAltitudePage && locale === 'en' ? <AreaFromAltitudeGuide /> : null}
  {isAreaFromAltitudePage && locale !== 'en' && AREA_FROM_ALTITUDE_GUIDE_TRANSLATIONS[locale] ? <AreaFromAltitudeGuideLocalized guide={AREA_FROM_ALTITUDE_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isAreaFromAnglePage && locale === 'en' ? <AreaFromAngleGuide /> : null}
  {isAreaFromAnglePage && locale !== 'en' && AREA_FROM_ANGLE_GUIDE_TRANSLATIONS[locale] ? <AreaFromAngleGuideLocalized guide={AREA_FROM_ANGLE_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isAreaFromHypotenuseAltitudePage && locale === 'en' ? <AreaFromHypotenuseAltitudeGuide /> : null}
  {isAreaFromHypotenuseAltitudePage && locale !== 'en' && AREA_FROM_HYPOTENUSE_ALTITUDE_GUIDE_TRANSLATIONS[locale] ? <AreaFromHypotenuseAltitudeGuideLocalized guide={AREA_FROM_HYPOTENUSE_ALTITUDE_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isAreaFromInradiusSemiperimeterPage && locale === 'en' ? <AreaFromInradiusSemiperimeterGuide /> : null}
  {isAreaFromInradiusSemiperimeterPage && locale !== 'en' && AREA_FROM_INRADIUS_SEMIPERIMETER_GUIDE_TRANSLATIONS[locale] ? <AreaFromInradiusSemiperimeterGuideLocalized guide={AREA_FROM_INRADIUS_SEMIPERIMETER_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isAreaFromLegAnglePage && locale === 'en' ? <AreaFromLegAngleGuide /> : null}
  {isAreaFromLegAnglePage && locale !== 'en' && AREA_FROM_LEG_ANGLE_GUIDE_TRANSLATIONS[locale] ? <AreaFromLegAngleGuideLocalized guide={AREA_FROM_LEG_ANGLE_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isAreaFromLegsPage && locale === 'en' ? <AreaFromLegsGuide /> : null}
  {isAreaFromLegsPage && locale !== 'en' && AREA_FROM_LEGS_GUIDE_TRANSLATIONS[locale] ? <AreaFromLegsGuideLocalized guide={AREA_FROM_LEGS_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
</BaseLayout>

