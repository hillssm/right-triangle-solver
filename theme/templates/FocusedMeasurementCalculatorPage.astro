---
import type { FocusedMeasurementCalculatorPage as FocusedMeasurementCalculatorPageData } from 'src/data/focusedMeasurementCalculatorPages';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import Faq from 'theme/components/Faq.astro';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: FocusedMeasurementCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;
const formula = getFormulaBySlug(page.formulaSlug);

if (!formula || !formula.calculator) {
  throw new Error(`Focused measurement calculator formula is missing: ${page.formulaSlug}`);
}

const calculatorFormula = {
  ...formula,
  calculator: {
    ...formula.calculator,
    outputLabel: page.calculator.outputLabel,
    fields: page.calculator.fields
  }
};

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const content = (bundle.content as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};
const groupedPages = ((content.grouped as Record<string, any>)?.pages as Record<string, any>) || {};
const groupedUi = ((content.grouped as Record<string, any>)?.ui as Record<string, string>) || {};
const faqHub = (content.faqHub as Record<string, string>) || {};

const homeLabel = pick(nav, 'home', 'Home');
const measurementCalculatorLabel = pick(
  groupedPages['right-triangle-measurements-calculator'] || {},
  'h1',
  'Right Triangle Measurements Calculator'
);
const canonicalPath = localizePath(locale, page.url);

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  {
    label: measurementCalculatorLabel,
    href: localizePath(locale, '/right-triangle-measurements-calculator/')
  },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: 'Please enter positive values.',
  invalid: 'Please enter positive values.',
  hypotenuseKnownLeg: 'The hypotenuse c should be the longest side.'
};

const measurementSideEntries = page.diagram
  ? [
      page.diagram.sides.a,
      page.diagram.sides.b,
      page.diagram.sides.c,
      page.diagram.result
    ]
  : [];

const relatedHeading = pick(groupedUi, 'relatedCalculatorsTitle', 'Related Calculators');
const openToolLabel = pick(solver, 'openTool', 'Open Tool');
const faqHeading = pick(faqHub, 'heading', 'Frequently Asked Questions');
const badge = 'Measurement Calculator';

const makeSectionId = (heading: string, index: number) =>
  `${page.slug}-section-${index}-${heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 42)}`;

const contentSections = page.extraSections.map((section, index) => ({
  ...section,
  id: makeSectionId(section.h2, index)
}));

const guideLinks = [
  { href: '#formula', label: 'Formula' },
  { href: '#steps', label: 'Steps' },
  { href: '#example', label: 'Example' },
  ...contentSections.slice(0, 6).map((section) => ({
    href: `#${section.id}`,
    label: section.h2
  }))
];
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface">{item.label}</span>
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {badge}
    </p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{page.h1}</h1>
    <p class="mt-4 max-w-3xl text-on-surface-variant">{page.intro}</p>
  </header>

  <FormulaCalculator
    formula={calculatorFormula}
    locale={locale}
    messages={calculatorMessages}
  />

  {page.quickSummary && (
    <section class="mx-auto mt-8 w-full max-w-5xl section-shell">
      <h2 class="text-2xl font-semibold">{page.quickSummary.h2}</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-on-surface-variant">
        {page.quickSummary.intro}
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {page.quickSummary.cards.map((card) => (
          <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-4">
            <p class="font-label text-[11px] uppercase tracking-widest text-primary">
              {card.label}
            </p>
            <p class="mt-2 break-words text-sm leading-relaxed text-on-surface">
              {card.value}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  {page.diagram && (
    <section class="mx-auto mt-8 w-full max-w-5xl section-shell">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.12fr)_minmax(17rem,0.88fr)] lg:items-center">
        <div class="min-w-0">
          <h2 class="text-2xl font-semibold">{page.diagram.h2}</h2>
          <p class="mt-3 leading-relaxed text-on-surface-variant">{page.diagram.intro}</p>

          <div class="measurement-diagram-canvas mt-5 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
            <svg
              class="measurement-diagram-svg"
              viewBox="0 0 560 380"
              role="img"
              aria-labelledby={`${page.slug}-measurement-diagram-title ${page.slug}-measurement-diagram-desc`}
            >
              <title id={`${page.slug}-measurement-diagram-title`}>{page.diagram.h2}</title>
              <desc id={`${page.slug}-measurement-diagram-desc`}>{page.diagram.caption}</desc>
              <rect
                x="14"
                y="14"
                width="532"
                height="352"
                rx="18"
                fill="var(--color-surface-container-low)"
                stroke="var(--color-outline-variant)"
                stroke-opacity="0.35"
              />
              <path
                d="M100 274 L100 82 L430 274 Z"
                fill="rgba(241, 201, 125, 0.06)"
                stroke="var(--color-outline-variant)"
                stroke-width="1.5"
                stroke-opacity="0.45"
              />
              <path
                d="M100 242 H132 V274"
                fill="none"
                stroke="var(--color-on-surface-variant)"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M100 274 L100 82 L430 274 L100 274"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <line
                x1="100"
                y1="274"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />
              <line
                x1="100"
                y1="82"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />

              <g class="measurement-diagram-label" transform="translate(224 293)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">a</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(54 158)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">b</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(332 136)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">c</text>
              </g>
              <g class="measurement-diagram-formula" transform="translate(174 188)">
                <rect width="210" height="42" rx="10" />
                <text x="105" y="27" text-anchor="middle">{page.diagram.formulaLabel}</text>
              </g>
            </svg>
          </div>
        </div>

        <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {page.diagram.keyLabel}
          </p>
          <div class="mt-4 grid gap-3">
            {measurementSideEntries.map((item) => (
              <div class="min-w-0 rounded-md border border-outline-variant/25 bg-surface-container-low/70 p-3">
                <p class="break-words font-semibold text-on-surface">{item.label}</p>
                <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.notes.map((note) => (
              <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2">
                {note}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="measurement-index mx-auto mt-8 w-full max-w-5xl section-shell">
    <div class="grid gap-4 lg:grid-cols-[minmax(0,0.34fr)_minmax(0,0.66fr)] lg:items-center">
      <div>
        <p class="font-label text-[11px] uppercase tracking-widest text-primary">Structured Guide</p>
        <h2 class="mt-2 text-2xl font-semibold">Jump to the main parts</h2>
      </div>
      <nav aria-label="Page sections" class="flex flex-wrap gap-2">
        {guideLinks.map((link) => (
          <a
            href={link.href}
            class="max-w-full rounded-md border border-outline-variant/30 bg-surface-container-lowest/65 px-3 py-2 text-sm text-on-surface-variant transition-colors hover:border-primary/45 hover:text-primary"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section id="formula" class="measurement-guide-section mx-auto mt-10 w-full max-w-5xl">
    <div class="measurement-section-header">
      <span>01</span>
      <div>
        <p>Formula</p>
        <h2>{page.formulaSection.h2}</h2>
      </div>
    </div>
    <div class="measurement-section-body grid gap-5 lg:grid-cols-[minmax(0,0.58fr)_minmax(18rem,0.42fr)]">
      <div class="measurement-copy">
        {page.formulaSection.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="grid gap-3">
        {page.formulaSection.formulas.map((expression) => (
          <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
            <div
              class="math-textbook min-w-max text-xl text-tertiary"
              set:html={renderMath(expression)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="steps" class="measurement-guide-section mx-auto mt-10 w-full max-w-5xl">
    <div class="measurement-section-header">
      <span>02</span>
      <div>
        <p>Steps</p>
        <h2>{page.howTo.h2}</h2>
      </div>
    </div>
    <ol class="measurement-step-grid">
      {page.howTo.steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="example" class="measurement-guide-section mx-auto mt-10 w-full max-w-5xl">
    <div class="measurement-section-header">
      <span>03</span>
      <div>
        <p>Example</p>
        <h2>{page.example.h2}</h2>
      </div>
    </div>
    <div class="measurement-section-body grid gap-5 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)]">
      <div class="measurement-copy">
        <p>{page.example.intro}</p>
        {page.example.answer && (
          <p class="rounded-lg border border-primary/20 bg-primary/10 p-4 font-semibold text-on-surface">
            {page.example.answer}
          </p>
        )}
      </div>
      <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
        <div class="grid gap-2">
        {page.example.lines.map((line) => (
          <div
            class="math-textbook min-w-max text-lg text-on-surface"
            set:html={renderMath(line, false)}
          />
        ))}
        </div>
      </div>
    </div>
  </section>

  {contentSections.map((section, index) => (
    <section id={section.id} class="measurement-guide-section mx-auto mt-10 w-full max-w-5xl">
      <div class="measurement-section-header">
        <span>{String(index + 4).padStart(2, '0')}</span>
        <div>
          <p>Guide</p>
          <h2>{section.h2}</h2>
        </div>
      </div>
      <div class={`measurement-section-body grid gap-5 ${section.listItems && section.listItems.length > 0 ? 'lg:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)]' : ''}`}>
        <div class="measurement-copy">
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {section.listItems && section.listItems.length > 0 && (
          <div class="measurement-list-panel">
            {section.listTitle && <h3>{section.listTitle}</h3>}
            <ul>
              {section.listItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="mx-auto mt-10 w-full max-w-5xl section-shell">
    <h2 class="text-2xl font-semibold">{relatedHeading}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>

  <div class="mx-auto mt-8 w-full max-w-4xl">
    <Faq heading={faqHeading} items={page.faqs} />
  </div>
</BaseLayout>

<style>
  .measurement-index a {
    overflow-wrap: anywhere;
  }

  .measurement-guide-section {
    scroll-margin-top: 6rem;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 34%, transparent);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 34%),
      color-mix(in srgb, var(--color-surface-container-low) 82%, transparent);
    padding: clamp(1.15rem, 2.6vw, 2rem);
  }

  .measurement-section-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin-bottom: clamp(1.15rem, 2.4vw, 1.7rem);
  }

  .measurement-section-header > span {
    display: inline-flex;
    width: 2.5rem;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 36%, transparent);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .measurement-section-header p {
    margin: 0 0 0.35rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .measurement-section-header h2 {
    margin: 0;
    color: var(--color-on-surface);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    line-height: 1.12;
  }

  .measurement-section-body {
    min-width: 0;
    align-items: start;
  }

  .measurement-copy {
    display: grid;
    min-width: 0;
    gap: 1rem;
    color: var(--color-on-surface-variant);
    line-height: 1.75;
  }

  .measurement-copy p {
    margin: 0;
    max-width: 72ch;
    overflow-wrap: anywhere;
  }

  .measurement-step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .measurement-step-grid li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 24%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-surface-container-lowest) 72%, transparent);
    padding: 1rem;
  }

  .measurement-step-grid span {
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .measurement-step-grid p {
    margin: 0;
    min-width: 0;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .measurement-list-panel {
    min-width: 0;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 26%, transparent);
    background: color-mix(in srgb, var(--color-surface-container-lowest) 68%, transparent);
    padding: 1rem;
  }

  .measurement-list-panel h3 {
    margin: 0 0 0.8rem;
    color: var(--color-primary);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .measurement-list-panel ul {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .measurement-list-panel li {
    min-width: 0;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 20%, transparent);
    background: color-mix(in srgb, var(--color-surface-container-low) 55%, transparent);
    padding: 0.85rem;
    color: var(--color-on-surface-variant);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .measurement-diagram-canvas {
    min-width: 0;
  }

  .measurement-diagram-svg {
    display: block;
    width: 100%;
    min-height: 15rem;
    height: auto;
  }

  .measurement-diagram-label rect,
  .measurement-diagram-formula rect {
    fill: var(--color-surface-container-high);
    stroke: var(--color-outline-variant);
    stroke-opacity: 0.65;
  }

  .measurement-diagram-label text,
  .measurement-diagram-formula text {
    fill: var(--color-on-surface);
    font-family: var(--font-label);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .measurement-diagram-formula text {
    fill: var(--color-primary);
  }

  @media (max-width: 28rem) {
    .measurement-guide-section {
      padding: 1rem;
    }

    .measurement-section-header {
      gap: 0.8rem;
    }

    .measurement-section-header > span {
      width: 2.15rem;
    }

    .measurement-diagram-svg {
      min-height: 13rem;
    }

    .measurement-diagram-label text,
    .measurement-diagram-formula text {
      font-size: 0.8125rem;
    }
  }
</style>
