---
import type { FocusedMeasurementCalculatorPage as FocusedMeasurementCalculatorPageData } from 'src/data/focusedMeasurementCalculatorPages';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import Faq from 'theme/components/Faq.astro';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: FocusedMeasurementCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;
const formula = getFormulaBySlug(page.formulaSlug);

if (!formula || !formula.calculator) {
  throw new Error(`Focused measurement calculator formula is missing: ${page.formulaSlug}`);
}

const calculatorFormula = {
  ...formula,
  calculator: {
    ...formula.calculator,
    outputLabel: page.calculator.outputLabel,
    fields: page.calculator.fields
  }
};

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const content = (bundle.content as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};
const groupedPages = ((content.grouped as Record<string, any>)?.pages as Record<string, any>) || {};
const groupedUi = ((content.grouped as Record<string, any>)?.ui as Record<string, string>) || {};
const faqHub = (content.faqHub as Record<string, string>) || {};

const measurementUiDefaults = {
  home: 'Home',
  badge: 'Measurement Calculator',
  quickAnswer: 'Quick Answer',
  structuredGuide: 'Structured Guide',
  chooseSection: 'Choose the section you need',
  pageSections: 'Page sections',
  formula: 'Formula',
  steps: 'Steps',
  example: 'Example',
  coreConcepts: 'Core Concepts',
  learn: 'Learn',
  conceptsHeading: 'Understand {name}',
  conceptsIntro: 'Start here for the meaning, side labels, and setup behind the calculator result.',
  examples: 'Examples',
  practice: 'Practice',
  examplesHeading: 'Worked Examples and Quick References',
  examplesIntro: 'Use these examples to compare your inputs, verify common triples, and follow the arithmetic.',
  uses: 'Uses',
  apply: 'Apply',
  usesHeading: 'Where This Result Is Used',
  usesIntro: 'These sections explain when the result matters and how it connects to nearby right-triangle formulas.',
  checks: 'Checks',
  verify: 'Verify',
  checksHeading: 'Accuracy Checks Before You Use the Answer',
  checksIntro: 'Review units, common mistakes, and validation rules before copying the result into another calculation.',
  faqDescription: 'Answers to the most common right-triangle solving questions.',
  positiveError: 'Please enter positive values.',
  invalidError: 'Please enter positive values.',
  hypotenuseKnownLegError: 'The hypotenuse c should be the longest side.'
};

const measurementUiByLocale: Partial<Record<Locale, Partial<typeof measurementUiDefaults>>> = {
  hi: {
    home: 'होम',
    badge: 'माप कैलकुलेटर',
    quickAnswer: 'त्वरित उत्तर',
    structuredGuide: 'संरचित मार्गदर्शिका',
    chooseSection: 'अपना अनुभाग चुनें',
    pageSections: 'पृष्ठ अनुभाग',
    formula: 'सूत्र',
    steps: 'चरण',
    example: 'उदाहरण',
    coreConcepts: 'मुख्य बातें',
    learn: 'सीखें',
    conceptsHeading: 'समझें: {name}',
    conceptsIntro: 'कैलकुलेटर के परिणाम का अर्थ, भुजाओं के नाम और सही सेटअप यहां देखें।',
    examples: 'उदाहरण',
    practice: 'अभ्यास',
    examplesHeading: 'हल किए गए छोटे उदाहरण',
    examplesIntro: 'इन उदाहरणों से अपने इनपुट और गणना को जल्दी जांचें।',
    uses: 'उपयोग',
    apply: 'लागू करें',
    usesHeading: 'यह परिणाम कहाँ उपयोग होता है',
    usesIntro: 'ये अनुभाग बताते हैं कि परिणाम कब उपयोगी है और वह पास के सूत्रों से कैसे जुड़ता है।',
    checks: 'जांच',
    verify: 'सत्यापित करें',
    checksHeading: 'उत्तर उपयोग करने से पहले जांचें',
    checksIntro: 'उत्तर को आगे उपयोग करने से पहले इकाई, सामान्य गलती और मान्यता नियम देखें।',
    faqDescription: 'इस कैलकुलेटर और समकोण त्रिभुज माप से जुड़े सामान्य प्रश्नों के सरल उत्तर।',
    positiveError: 'कृपया धनात्मक मान दर्ज करें।',
    invalidError: 'कृपया मान सही दर्ज करें।',
    hypotenuseKnownLegError: 'कर्ण c सबसे लंबी भुजा होना चाहिए।'
  },
  ko: {
    home: '홈',
    badge: '측정 계산기',
    quickAnswer: '빠른 답',
    structuredGuide: '구성된 안내',
    chooseSection: '필요한 섹션을 선택하세요',
    pageSections: '페이지 섹션',
    formula: '공식',
    steps: '단계',
    example: '예제',
    coreConcepts: '핵심 개념',
    learn: '학습',
    conceptsHeading: '{name} 이해하기',
    conceptsIntro: '계산 결과의 의미, 변 이름, 올바른 입력 설정을 먼저 확인하세요.',
    examples: '예제',
    practice: '연습',
    examplesHeading: '풀이 예제와 빠른 참고',
    examplesIntro: '예제로 입력값을 비교하고 계산 과정을 빠르게 확인하세요.',
    uses: '사용',
    apply: '적용',
    usesHeading: '이 결과가 쓰이는 곳',
    usesIntro: '결과가 언제 필요한지, 관련 직각삼각형 공식과 어떻게 연결되는지 설명합니다.',
    checks: '확인',
    verify: '검산',
    checksHeading: '답을 사용하기 전 확인할 점',
    checksIntro: '다른 계산에 사용하기 전에 단위, 흔한 실수, 검산 규칙을 확인하세요.',
    faqDescription: '이 계산기와 직각삼각형 측정에 대해 자주 묻는 질문을 간단히 정리했습니다.',
    positiveError: '양수 값을 입력하세요.',
    invalidError: '올바른 값을 입력하세요.',
    hypotenuseKnownLegError: '빗변 c는 가장 긴 변이어야 합니다.'
  }
};

const measurementUi = {
  ...measurementUiDefaults,
  ...(measurementUiByLocale[locale] || {})
};

const homeLabel = pick(nav, 'home', measurementUi.home);
const measurementCalculatorLabel = pick(
  groupedPages['right-triangle-measurements-calculator'] || {},
  'h1',
  'Right Triangle Measurements Calculator'
);
const canonicalPath = localizePath(locale, page.url);

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  {
    label: measurementCalculatorLabel,
    href: localizePath(locale, '/right-triangle-measurements-calculator/')
  },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: measurementUi.positiveError,
  invalid: measurementUi.invalidError,
  hypotenuseKnownLeg: measurementUi.hypotenuseKnownLegError
};

const measurementSideEntries = page.diagram
  ? [
      page.diagram.sides.a,
      page.diagram.sides.b,
      page.diagram.sides.c,
      page.diagram.result
    ]
  : [];

const relatedHeading = pick(groupedUi, 'relatedCalculatorsTitle', 'Related Calculators');
const openToolLabel = pick(solver, 'openTool', 'Open Tool');
const faqHeading = pick(faqHub, 'heading', 'Frequently Asked Questions');
const badge = measurementUi.badge;

const makeSectionId = (heading: string, index: number) =>
  `${page.slug}-section-${index}-${heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 42)}`;

const contentSections = page.extraSections.map((section, index) => ({
  ...section,
  id: makeSectionId(section.h2, index)
}));

const calculatorName = page.h1.replace(/\s+Calculator$/, '');
const isExampleSection = (heading: string) => /example|triple|उदाहरण|예시|예제|계산 예/i.test(heading);
const isCheckSection = (heading: string) => /unit|mistake|properties|tip|check|इकाई|गलती|जांच|단위|실수|확인/i.test(heading);
const isUseSection = (heading: string) =>
  /application|when to use|relationship|connects|matters|vs\.?|real-world|उपयोग|कब|संबंध|사용|쓰이는|차이/i.test(heading);

const exampleSections = contentSections.filter((section) => isExampleSection(section.h2));
const checkSections = contentSections.filter((section) => isCheckSection(section.h2));
const useSections = contentSections.filter(
  (section) => !isExampleSection(section.h2) && !isCheckSection(section.h2) && isUseSection(section.h2)
);
const conceptSections = contentSections.filter(
  (section) =>
    !isExampleSection(section.h2) &&
    !isCheckSection(section.h2) &&
    !isUseSection(section.h2)
);

const contentGroups = [
  {
    id: `${page.slug}-concepts`,
    label: measurementUi.coreConcepts,
    eyebrow: measurementUi.learn,
    h2: measurementUi.conceptsHeading.replace('{name}', calculatorName),
    intro: measurementUi.conceptsIntro,
    sections: conceptSections,
    style: 'feature'
  },
  {
    id: `${page.slug}-examples`,
    label: measurementUi.examples,
    eyebrow: measurementUi.practice,
    h2: measurementUi.examplesHeading,
    intro: measurementUi.examplesIntro,
    sections: exampleSections,
    style: 'examples'
  },
  {
    id: `${page.slug}-uses`,
    label: measurementUi.uses,
    eyebrow: measurementUi.apply,
    h2: measurementUi.usesHeading,
    intro: measurementUi.usesIntro,
    sections: useSections,
    style: 'split'
  },
  {
    id: `${page.slug}-checks`,
    label: measurementUi.checks,
    eyebrow: measurementUi.verify,
    h2: measurementUi.checksHeading,
    intro: measurementUi.checksIntro,
    sections: checkSections,
    style: 'checks'
  }
].filter((group) => group.sections.length > 0);

const guideLinks = [
  { href: '#formula', label: measurementUi.formula },
  { href: '#steps', label: measurementUi.steps },
  { href: '#example', label: measurementUi.example },
  ...contentGroups.map((group) => ({
    href: `#${group.id}`,
    label: group.label
  }))
].map((link, index) => ({
  ...link,
  number: String(index + 1).padStart(2, '0')
}));

const splitListItem = (item: string) => {
  const separators = [
    ` ${String.fromCharCode(0x2014)} `,
    ': ',
    ` ${String.fromCharCode(0x2192)} `,
    ' -> '
  ];
  for (const separator of separators) {
    const index = item.indexOf(separator);
    if (index > 0) {
      return {
        term: item.slice(0, index),
        detail: item.slice(index + separator.length)
      };
    }
  }

  return { term: '', detail: item };
};
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface">{item.label}</span>
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {badge}
    </p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{page.h1}</h1>
    <p class="mt-4 max-w-3xl text-on-surface-variant">{page.intro}</p>
  </header>

  <FormulaCalculator
    formula={calculatorFormula}
    locale={locale}
    messages={calculatorMessages}
  />

  {page.quickSummary && (
    <section
      class="measurement-overview mx-auto mt-8 w-full max-w-5xl"
      aria-labelledby={`${page.slug}-summary-heading`}
    >
      <div class="measurement-overview-copy">
        <p class="measurement-section-kicker">{measurementUi.quickAnswer}</p>
        <h2 id={`${page.slug}-summary-heading`}>{page.quickSummary.h2}</h2>
        <p>{page.quickSummary.intro}</p>
      </div>
      <div class="measurement-overview-grid">
        {page.quickSummary.cards.map((card) => (
          <article class="measurement-summary-card">
            <span>{card.label}</span>
            <p>{card.value}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {page.diagram && (
    <section class="measurement-visual-section mx-auto mt-8 w-full max-w-5xl">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.12fr)_minmax(17rem,0.88fr)] lg:items-center">
        <div class="min-w-0">
          <h2 class="text-2xl font-semibold">{page.diagram.h2}</h2>
          <p class="mt-3 leading-relaxed text-on-surface-variant">{page.diagram.intro}</p>

          <div class="measurement-diagram-canvas mt-5 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
            <svg
              class="measurement-diagram-svg"
              viewBox="0 0 560 380"
              role="img"
              aria-labelledby={`${page.slug}-measurement-diagram-title ${page.slug}-measurement-diagram-desc`}
            >
              <title id={`${page.slug}-measurement-diagram-title`}>{page.diagram.h2}</title>
              <desc id={`${page.slug}-measurement-diagram-desc`}>{page.diagram.caption}</desc>
              <rect
                x="14"
                y="14"
                width="532"
                height="352"
                rx="18"
                fill="var(--color-surface-container-low)"
                stroke="var(--color-outline-variant)"
                stroke-opacity="0.35"
              />
              <path
                d="M100 274 L100 82 L430 274 Z"
                fill="rgba(241, 201, 125, 0.06)"
                stroke="var(--color-outline-variant)"
                stroke-width="1.5"
                stroke-opacity="0.45"
              />
              <path
                d="M100 242 H132 V274"
                fill="none"
                stroke="var(--color-on-surface-variant)"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M100 274 L100 82 L430 274 L100 274"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <line
                x1="100"
                y1="274"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />
              <line
                x1="100"
                y1="82"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />

              <g class="measurement-diagram-label" transform="translate(224 293)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">a</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(54 158)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">b</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(332 136)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">c</text>
              </g>
              <g class="measurement-diagram-formula" transform="translate(174 188)">
                <rect width="210" height="42" rx="10" />
                <text x="105" y="27" text-anchor="middle">{page.diagram.formulaLabel}</text>
              </g>
            </svg>
          </div>
        </div>

        <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {page.diagram.keyLabel}
          </p>
          <div class="mt-4 grid gap-3">
            {measurementSideEntries.map((item) => (
              <div class="min-w-0 rounded-md border border-outline-variant/25 bg-surface-container-low/70 p-3">
                <p class="break-words font-semibold text-on-surface">{item.label}</p>
                <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.notes.map((note) => (
              <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2">
                {note}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="measurement-page-map mx-auto mt-8 w-full max-w-5xl">
    <div class="measurement-page-map-heading">
      <p class="measurement-section-kicker">{measurementUi.structuredGuide}</p>
      <h2>{measurementUi.chooseSection}</h2>
    </div>
    <nav aria-label={measurementUi.pageSections}>
      <ol>
        {guideLinks.map((link) => (
          <li>
            <a href={link.href}>
              <span>{link.number}</span>
              <strong>{link.label}</strong>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section id="formula" class="measurement-guide-section measurement-guide-section--formula mx-auto mt-10 w-full max-w-5xl">
    <div class="measurement-section-header">
      <span>01</span>
      <div>
        <p>{measurementUi.formula}</p>
        <h2>{page.formulaSection.h2}</h2>
      </div>
    </div>
    <div class="measurement-section-body grid gap-5 lg:grid-cols-[minmax(0,0.58fr)_minmax(18rem,0.42fr)]">
      <div class="measurement-copy">
        {page.formulaSection.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="grid gap-3">
        {page.formulaSection.formulas.map((expression) => (
          <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
            <div
              class="math-textbook min-w-max text-xl text-tertiary"
              set:html={renderMath(expression)}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="steps" class="measurement-guide-section measurement-guide-section--steps mx-auto mt-10 w-full max-w-5xl">
    <div class="measurement-section-header">
      <span>02</span>
      <div>
        <p>{measurementUi.steps}</p>
        <h2>{page.howTo.h2}</h2>
      </div>
    </div>
    <ol class="measurement-step-grid">
      {page.howTo.steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="example" class="measurement-guide-section measurement-guide-section--example mx-auto mt-10 w-full max-w-5xl">
    <div class="measurement-section-header">
      <span>03</span>
      <div>
        <p>{measurementUi.example}</p>
        <h2>{page.example.h2}</h2>
      </div>
    </div>
    <div class="measurement-section-body grid gap-5 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)]">
      <div class="measurement-copy">
        <p>{page.example.intro}</p>
        {page.example.answer && (
          <p class="rounded-lg border border-primary/20 bg-primary/10 p-4 font-semibold text-on-surface">
            {page.example.answer}
          </p>
        )}
      </div>
      <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
        <div class="grid gap-2">
        {page.example.lines.map((line) => (
          <div
            class="math-textbook min-w-max text-lg text-on-surface"
            set:html={renderMath(line, false)}
          />
        ))}
        </div>
      </div>
    </div>
  </section>

  {contentGroups.map((group, groupIndex) => (
    <section id={group.id} class="measurement-content-cluster mx-auto mt-12 w-full max-w-5xl">
      <div class="measurement-cluster-header">
        <span>{String(groupIndex + 4).padStart(2, '0')}</span>
        <div>
          <p>{group.eyebrow}</p>
          <h2>{group.h2}</h2>
          <small>{group.intro}</small>
        </div>
      </div>

      <div class={`measurement-topic-grid measurement-topic-grid--${group.style}`}>
        {group.sections.map((section, sectionIndex) => (
          <article id={section.id} class={`measurement-topic-card ${sectionIndex === 0 ? 'measurement-topic-card--lead' : ''}`}>
            <div class="measurement-topic-card-heading">
              <span>{String(sectionIndex + 1).padStart(2, '0')}</span>
              <h3>{section.h2}</h3>
            </div>

            <div class="measurement-topic-copy">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>

            {section.listItems && section.listItems.length > 0 && (
              <div class="measurement-topic-list">
                {section.listTitle && <h4>{section.listTitle}</h4>}
                <ul>
                  {section.listItems.map((item) => {
                    const parsed = splitListItem(item);
                    return (
                      <li>
                        {parsed.term && <strong>{parsed.term}</strong>}
                        <span>{parsed.detail}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <div class="mx-auto mt-8 w-full max-w-4xl">
    <Faq heading={faqHeading} description={measurementUi.faqDescription} items={page.faqs} />
  </div>

  <section class="mx-auto mt-8 w-full max-w-5xl section-shell">
    <h2 class="text-2xl font-semibold">{relatedHeading}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

