  </section>

  {page.diagram && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
      <h2 class="text-2xl font-semibold">{sectionHeading(page.diagram.h2)}</h2>
      <p class="mt-3 leading-relaxed text-on-surface-variant" set:html={formatRootBars(page.diagram.intro)} />
      <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
        <div class="min-w-0">
          <div class="rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
            <svg
              class="measurement-diagram-svg"
              viewBox="0 0 560 380"
              role="img"
              aria-labelledby={`${page.slug}-measurement-diagram-title ${page.slug}-measurement-diagram-desc`}
            >
              <title id={`${page.slug}-measurement-diagram-title`}>{page.diagram.h2}</title>
              <desc id={`${page.slug}-measurement-diagram-desc`}>{page.diagram.caption}</desc>
              <rect
                x="14"
                y="14"
                width="532"
                height="352"
                rx="18"
                fill="var(--color-surface-container-low)"
                stroke="var(--color-outline-variant)"
                stroke-opacity="0.35"
              />
              <path
                d="M100 274 L100 82 L430 274 Z"
                fill="rgba(241, 201, 125, 0.06)"
                stroke="var(--color-outline-variant)"
                stroke-width="1.5"
                stroke-opacity="0.45"
              />
              <path
                d="M100 242 H132 V274"
                fill="none"
                stroke="var(--color-on-surface-variant)"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M100 274 L100 82 L430 274 L100 274"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <line
                x1="100"
                y1="274"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />
              <line
                x1="100"
                y1="82"
                x2="430"
                y2="274"
                stroke="var(--color-tertiary-fixed)"
                stroke-width="3"
                stroke-dasharray="8 8"
                stroke-linecap="round"
              />

              <g class="measurement-diagram-label" transform="translate(224 293)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">a</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(54 158)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">b</text>
              </g>
              <g class="measurement-diagram-label" transform="translate(332 136)">
                <rect width="92" height="34" rx="8" />
                <text x="46" y="22" text-anchor="middle">c</text>
              </g>
              {showDiagramFormula && (
                <g class="measurement-diagram-formula" transform="translate(164 188)">
                  <rect width="230" height="42" rx="10" />
                  <text x="115" y="27" text-anchor="middle">{page.diagram.formulaLabel}</text>
                </g>
              )}
            </svg>
          </div>
        </div>

        <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {page.diagram.keyLabel}
          </p>
          <div class="mt-4 grid gap-3">
            {measurementSideEntries.map((item) => (
              <div class="min-w-0 rounded-md border border-outline-variant/25 bg-surface-container-low/70 p-3">
                <p class="break-words font-semibold text-on-surface" set:html={item.label} />
                <p class="mt-2 text-sm leading-relaxed text-on-surface-variant" set:html={formatRootBars(item.description)} />
              </div>
            ))}
          </div>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.notes.map((note) => (
              <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2" set:html={formatRootBars(note)} />
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.howTo.h2)}</h2>
    <ol>
      {page.howTo.steps.map((step) => (
