const looksLikeMojibake = (value: string) =>
  /[\uFFFD\u0080-\u009F]|[ÃÂÐÑØÙÄÅ]|[\u00E0-\u00EF][\u00A0-\u00BF]|\u00E2[\u0080-\u017F]/u.test(value);

const cleanMeasurementUi = (values: Partial<typeof measurementUiDefaults> | undefined) =>
  Object.fromEntries(
    Object.entries(values || {}).filter(
      ([, value]) => typeof value !== 'string' || !looksLikeMojibake(value)
    )
  ) as Partial<typeof measurementUiDefaults>;

const measurementUi = {
  ...measurementUiDefaults,
  ...cleanMeasurementUi(measurementUiByLocale[locale]),
  ...cleanMeasurementUi(measurementUiOverridesByLocale[locale])
};

const homeLabel = pick(nav, 'home', measurementUi.home);
const measurementCalculatorLabel = pick(
  groupedPages['right-triangle-measurements-calculator'] || {},
  'h1',
  'Right Triangle Measurements Calculator'
);
const areaCalculatorLabel = pick(
  groupedPages['right-triangle-area-calculator'] || {},
  'h1',
  'Right Triangle Area Calculator'
);
const areaChildCalculatorSlugs = new Set([
  'right-triangle-area-from-legs-calculator',
  'right-triangle-area-from-angle-calculator',
  'right-triangle-area-from-leg-and-angle-calculator',
  'right-triangle-area-from-semiperimeter-calculator',
  'right-triangle-area-from-inradius-and-semiperimeter-calculator',
  'right-triangle-area-from-altitude-calculator',
  'right-triangle-area-from-hypotenuse-and-altitude-calculator'
]);
const isAreaChildCalculator = areaChildCalculatorSlugs.has(page.slug);

// Page 17 of 45: full guide replaces the old thin template content on the
// area-from-altitude page (calculator itself stays untouched).
const isAreaFromAltitudePage =
  page.slug === 'right-triangle-area-from-altitude-calculator' &&
  (locale === 'en' || AREA_FROM_ALTITUDE_GUIDE_TRANSLATIONS[locale]);

// Page 18 of 45: full guide replaces the old thin template content on the
// area-from-angle page (calculator itself stays untouched).
const isAreaFromAnglePage =
  page.slug === 'right-triangle-area-from-angle-calculator' &&
  (locale === 'en' || AREA_FROM_ANGLE_GUIDE_TRANSLATIONS[locale]);

// Page 19 of 45: full guide replaces the old thin template content on the
// area-from-hypotenuse-and-altitude page (calculator itself stays untouched).
const isAreaFromHypotenuseAltitudePage =
  page.slug === 'right-triangle-area-from-hypotenuse-and-altitude-calculator' &&
  (locale === 'en' || AREA_FROM_HYPOTENUSE_ALTITUDE_GUIDE_TRANSLATIONS[locale]);

// Page 20 of 45: full guide replaces the old thin template content on the
// area-from-inradius-and-semiperimeter page (calculator itself stays untouched).
const isAreaFromInradiusSemiperimeterPage =
  page.slug === 'right-triangle-area-from-inradius-and-semiperimeter-calculator' &&
  (locale === 'en' || AREA_FROM_INRADIUS_SEMIPERIMETER_GUIDE_TRANSLATIONS[locale]);

// Page 21 of 45: full guide replaces the old thin template content on the
// area-from-leg-and-angle page (calculator itself stays untouched).
const isAreaFromLegAnglePage =
  page.slug === 'right-triangle-area-from-leg-and-angle-calculator' &&
  (locale === 'en' || AREA_FROM_LEG_ANGLE_GUIDE_TRANSLATIONS[locale]);

// Page 22 of 45: full guide replaces the old thin template content on the
// area-from-legs page (calculator itself stays untouched).
const isAreaFromLegsPage =
  page.slug === 'right-triangle-area-from-legs-calculator' &&
  (locale === 'en' || AREA_FROM_LEGS_GUIDE_TRANSLATIONS[locale]);

// Each area page is a standalone ranking page with a self-referencing canonical.
const canonicalPath = localizePath(locale, page.url);
const showDiagramFormula = !isAreaChildCalculator;
const parentCalculatorLabel = isAreaChildCalculator
  ? areaCalculatorLabel
  : measurementCalculatorLabel;
const parentCalculatorPath = isAreaChildCalculator
  ? '/right-triangle-area-calculator/'
  : '/right-triangle-measurements-calculator/';

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  {
    label: parentCalculatorLabel,
    href: localizePath(locale, parentCalculatorPath)
  },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: measurementUi.positiveError,
  invalid: measurementUi.invalidError,
  angleRange: measurementUi.angleRangeError,
  hypotenuseKnownLeg: measurementUi.hypotenuseKnownLegError
};

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

const calculatorName = page.h1.replace(/\s+Calculator$/, '');
const calculatorHeading =
  locale === DEFAULT_LOCALE ? `Calculate ${calculatorName}` : undefined;
const calculatorModes = page.calculatorModes?.length
  ? page.calculatorModes.map((mode) => ({
      ...mode,
      formula: buildCalculatorFormula({
        formulaSlug: mode.formulaSlug,
        outputLabel: mode.outputLabel,
        fields: mode.fields
      })
    }))
  : [
      {
        formulaSlug: page.formulaSlug,
        label: page.h1,
        heading: calculatorHeading,
        outputLabel: page.calculator.outputLabel,
        fields: page.calculator.fields,
        formula: calculatorFormula
      }
    ];
const hasMultipleCalculatorModes = calculatorModes.length > 1;
const howItWorksHeading =
  locale === DEFAULT_LOCALE
    ? `How This ${calculatorName} Calculator Works`
    : page.quickSummary?.h2 || page.h1;

const relatedHeading = pick(groupedUi, 'relatedCalculatorsTitle', measurementUi.relatedCalculators);
const modeTitle = pick(groupedUi, 'calculatorModeTitle', 'Calculator Mode');
const modeSelectLabel = pick(groupedUi, 'chooseCalculatorMode', 'Choose calculator mode');
const openToolLabel = pick(solver, 'openTool', measurementUi.openTool);
const faqHeading = pick(faqHub, 'heading', measurementUi.faqHeading);
const badge = measurementUi.badge;
const sectionHeading = (
  heading: string,
  intent?: Parameters<typeof seoSectionHeading>[1]
) =>
  locale === DEFAULT_LOCALE
    ? replaceGenericSeoHeading(heading, page, intent)
    : heading;

const measurementSideEntries = page.diagram
  ? [
      page.diagram.sides.a,
      page.diagram.sides.b,
      page.diagram.sides.c,
      page.diagram.result
    ]
  : [];


---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {badge}
    </p>
    <h1 class="mx-auto mt-3 max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{page.h1}</span>
    </h1>
    <p class="mx-auto mt-4 hidden max-w-2xl px-4 text-sm leading-relaxed text-on-surface sm:block sm:text-base lg:text-lg opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={formatRootBars(page.intro)} />
    <p class="mx-auto mt-3 max-w-xs text-xs tracking-[0.01em] text-on-surface sm:hidden opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={formatRootBars(page.intro)} />
  </header>

  {hasMultipleCalculatorModes ? (
    <section class="mx-auto w-full max-w-4xl section-shell" data-focused-measurement-modes>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h2 class="text-2xl font-semibold">{sectionHeading(modeTitle, 'calculatorMode')}</h2>
      </div>

      <label class="mt-6 block text-sm font-medium text-on-surface-variant sm:hidden">
        {modeSelectLabel}
        <select
          class="input-shell mt-2 rounded-lg border border-outline-variant/40"
          data-focused-measurement-mode-select
        >
          {calculatorModes.map((mode) => (
            <option value={mode.formulaSlug}>{mode.label}</option>
          ))}
        </select>
      </label>

      <div class="mt-6 hidden flex-wrap gap-2 sm:flex" role="tablist" aria-label={modeSelectLabel}>
        {calculatorModes.map((mode, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-focused-measurement-mode-button
            data-mode={mode.formulaSlug}
            class={`interactive-chip ${index === 0 ? 'is-active' : ''}`}
          >
            {mode.label}
          </button>
        ))}
      </div>

      <div class="mt-8 space-y-8">
        {calculatorModes.map((mode, index) => (
          <div
            data-focused-measurement-mode-panel
            data-mode={mode.formulaSlug}
            class={index === 0 ? '' : 'hidden'}
            role="tabpanel"
          >
            <FormulaCalculator
              formula={mode.formula}
              locale={locale}
              heading={mode.heading}
              messages={calculatorMessages}
            />
          </div>
        ))}
      </div>

      <script is:inline>
        (() => {
          const currentScript = document.currentScript;
          if (!currentScript) return;

          const root = currentScript.closest('[data-focused-measurement-modes]');
          if (!root) return;

          const buttons = Array.from(
            root.querySelectorAll('[data-focused-measurement-mode-button]')
          );
          const panels = Array.from(
            root.querySelectorAll('[data-focused-measurement-mode-panel]')
          );
          const select = root.querySelector('[data-focused-measurement-mode-select]');

          if (!panels.length) return;

          const setMode = (mode) => {
            panels.forEach((panel) => {
              const isActive = panel.getAttribute('data-mode') === mode;
              panel.classList.toggle('hidden', !isActive);
            });

            buttons.forEach((button) => {
              const isActive = button.getAttribute('data-mode') === mode;
              button.classList.toggle('is-active', isActive);
              button.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            if (select && select.value !== mode) {
              select.value = mode;
            }
          };

          const defaultMode = panels[0].getAttribute('data-mode');
          if (defaultMode) setMode(defaultMode);

          buttons.forEach((button) => {
            button.addEventListener('click', () => {
              const mode = button.getAttribute('data-mode');
              if (mode) setMode(mode);
            });
          });

          if (select) {
            select.addEventListener('change', (event) => {
              const target = event.target;
              if (!(target instanceof HTMLSelectElement)) return;
              setMode(target.value);
            });
          }
        })();
      </script>
    </section>
  ) : (
    <FormulaCalculator
      formula={calculatorModes[0].formula}
      locale={locale}
      heading={calculatorModes[0].heading}
      messages={calculatorMessages}
    />
