---
import type { FocusedProjectionCalculatorPage as FocusedProjectionCalculatorPageData } from 'src/data/focusedProjectionCalculatorPages';
import Faq from 'theme/components/Faq.astro';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { seoSectionHeading } from 'theme/utils/seoHeadings';
import { formatListItem, formatRootBars } from 'src/utils/formatList';
import katex from 'katex';
import 'katex/dist/katex.min.css';
// Page 30 of 45: full hypotenuse-from-projections guide (EN + 18 locales).
import HypotenuseFromProjectionsGuide from 'theme/components/HypotenuseFromProjectionsGuide.astro';
import HypotenuseFromProjectionsGuideLocalized from 'theme/components/HypotenuseFromProjectionsGuideLocalized.astro';
import { HYPOTENUSE_FROM_PROJECTIONS_GUIDE_TRANSLATIONS } from 'src/data/hypotenuseFromProjectionsGuideTranslations';
// Page 31 of 45: full leg-a-from-projection guide (EN + 18 locales).
import LegAFromProjectionGuide from 'theme/components/LegAFromProjectionGuide.astro';
import LegAFromProjectionGuideLocalized from 'theme/components/LegAFromProjectionGuideLocalized.astro';
import { LEG_A_FROM_PROJECTION_GUIDE_TRANSLATIONS } from 'src/data/legAFromProjectionGuideTranslations';
// Page 32 of 45: full leg-b-from-projection guide (EN + 18 locales).
import LegBFromProjectionGuide from 'theme/components/LegBFromProjectionGuide.astro';
import LegBFromProjectionGuideLocalized from 'theme/components/LegBFromProjectionGuideLocalized.astro';
import { LEG_B_FROM_PROJECTION_GUIDE_TRANSLATIONS } from 'src/data/legBFromProjectionGuideTranslations';
// Page 34 of 45: full projection-p guide (EN + 18 locales).
import ProjectionPGuide from 'theme/components/ProjectionPGuide.astro';
import ProjectionPGuideLocalized from 'theme/components/ProjectionPGuideLocalized.astro';
import { PROJP_GUIDE_TRANSLATIONS } from 'src/data/projectionPGuideTranslations';

interface Props {
  page: FocusedProjectionCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};

const parentCalculatorPath = '/right-triangle-projection-calculator/';
const canonicalPath = localizePath(locale, page.url);
const openToolLabel = pick(solver, 'openTool', 'Open Tool');

// Page 30 of 45: full guide replaces the old thin template content on the
// hypotenuse-from-projections page (calculator itself stays untouched).
const isHypotenuseFromProjectionsPage =
  page.slug === 'right-triangle-hypotenuse-from-projections-calculator' &&
  (locale === 'en' || HYPOTENUSE_FROM_PROJECTIONS_GUIDE_TRANSLATIONS[locale]);

// Page 31 of 45: full guide replaces the old thin template content on the
// leg-a-from-projection page (calculator itself stays untouched).
const isLegAFromProjectionPage =
  page.slug === 'right-triangle-leg-a-from-projection-calculator' &&
  (locale === 'en' || LEG_A_FROM_PROJECTION_GUIDE_TRANSLATIONS[locale]);

// Page 32 of 45: full guide replaces the old thin template content on the
// leg-b-from-projection page (calculator itself stays untouched).
const isLegBFromProjectionPage =
  page.slug === 'right-triangle-leg-b-from-projection-calculator' &&
  (locale === 'en' || LEG_B_FROM_PROJECTION_GUIDE_TRANSLATIONS[locale]);

// Page 34 of 45: full guide replaces the old thin template content on the
// projection-p page (calculator itself stays untouched).
const isProjectionPPage =
  page.slug === 'right-triangle-projection-p-calculator' &&
  (locale === 'en' || PROJP_GUIDE_TRANSLATIONS[locale]);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const defaultCalculatorMessages = {
  positive: 'Please enter positive values.',
  invalid: 'These values may not form a valid right triangle.',
  hypotenuseKnownLeg: 'The hypotenuse c must be greater than the known side.',
  projectionLessThanHypotenuse: 'Projection value must be less than hypotenuse c.',
  invalidTriangle: 'These values may not form a valid right triangle.'
};

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

type ProjectionPageStructure = {
  formulaHeading: string;
  diagramHeading: string;
  knownValues: string;
  finds: string;
  mainFormula: string;
  bestFor: string;
  exampleHeading: string;
  exampleLines: string[];
  whyFormulaWorks: string[];
  additionalExample: {
    h2: string;
    intro: string;
    listItems: string[];
  };
  diagramKey: {
    label: string;
    description: string;
  }[];
};

const projectionPageStructure: Record<string, ProjectionPageStructure> = {
  'right-triangle-projection-p-calculator': {
    formulaHeading: 'Right Triangle Projection p Formula',
    diagramHeading: 'Triangle Diagram: Projection p on the Hypotenuse',
    knownValues: 'Leg a and hypotenuse c',
    finds: 'Projection p, the hypotenuse segment paired with leg a',
    mainFormula: 'p = a\u00b2 / c',
    bestFor: 'Finding the p segment without solving the full triangle',
    exampleHeading: 'Worked Example: Find Projection p From a = 6 and c = 10',
    exampleLines: ['p = a^2 / c', 'p = 6^2 / 10', 'p = 36 / 10', 'p = 3.6'],
    whyFormulaWorks: [
      'Dropping altitude h to the hypotenuse creates smaller right triangles that are similar to the original triangle.',
      'From those similar triangles, leg a is the geometric mean between the full hypotenuse c and projection p. That gives a\u00b2 = c \u00d7 p, and solving for p gives p = a\u00b2 / c.'
    ],
    additionalExample: {
      h2: 'Additional Example: Projection p With Decimal Result',
      intro: 'Suppose leg a = 7 and hypotenuse c = 14.',
      listItems: [
        'p = 7\u00b2 / 14',
        'p = 49 / 14',
        'p = 3.5 units',
        'Projection p takes 3.5 units of the hypotenuse.'
      ]
    },
    diagramKey: [
      { label: 'a = leg paired with p', description: 'Leg a is the known leg used in this calculator.' },
      { label: 'b = other leg', description: 'Leg b is shown for orientation, but it is not entered here.' },
      { label: 'c = full hypotenuse', description: 'c is the longest side and must be greater than leg a.' },
      { label: 'p = projection result', description: 'p is the segment on the hypotenuse associated with leg a.' },
      { label: 'q = other projection', description: 'q is the remaining hypotenuse segment.' },
      { label: 'h = altitude', description: 'h divides the hypotenuse into p and q.' }
    ]
  },
  'right-triangle-projection-q-calculator': {
    formulaHeading: 'Right Triangle Projection q Formula',
    diagramHeading: 'Triangle Diagram: Projection q on the Hypotenuse',
    knownValues: 'Leg b and hypotenuse c',
    finds: 'Projection q, the hypotenuse segment paired with leg b',
    mainFormula: 'q = b\u00b2 / c',
    bestFor: 'Finding the q segment from the leg b side of the triangle',
    exampleHeading: 'Worked Example: Find Projection q From b = 8 and c = 10',
    exampleLines: ['q = b^2 / c', 'q = 8^2 / 10', 'q = 64 / 10', 'q = 6.4'],
    whyFormulaWorks: [
      'The altitude to the hypotenuse splits the original right triangle into two smaller triangles with the same angle relationships.',
      'That similarity links leg b with the full hypotenuse c and its projection q. The relation is b\u00b2 = c \u00d7 q, so q = b\u00b2 / c.'
    ],
    additionalExample: {
      h2: 'Additional Example: Projection q From a Larger Triangle',
      intro: 'Suppose leg b = 12 and hypotenuse c = 15.',
      listItems: [
        'q = 12\u00b2 / 15',
        'q = 144 / 15',
        'q = 9.6 units',
        'Projection q is 9.6 units along the hypotenuse.'
      ]
    },
    diagramKey: [
      { label: 'a = other leg', description: 'Leg a is part of the triangle but is not used in the q calculation.' },
      { label: 'b = leg paired with q', description: 'Leg b is the known leg used to find q.' },
      { label: 'c = full hypotenuse', description: 'c is the longest side and must be greater than leg b.' },
      { label: 'p = other projection', description: 'p is the projection associated with leg a.' },
      { label: 'q = projection result', description: 'q is the segment associated with leg b.' },
      { label: 'h = altitude', description: 'h marks the split point between p and q.' }
    ]
  },
  'right-triangle-leg-a-from-projection-calculator': {
    formulaHeading: 'Right Triangle Leg a From Projection Formula',
    diagramHeading: 'Triangle Diagram: Leg a From Projection p',
    knownValues: 'Hypotenuse c and projection p',
    finds: 'Leg a, the side paired with projection p',
    mainFormula: 'a = \u221a(c \u00d7 p)',
    bestFor: 'Recovering leg a from a hypotenuse projection',
    exampleHeading: 'Worked Example: Find Leg a From c = 10 and p = 3.6',
    exampleLines: [
      'a = \\sqrt{c \\times p}',
      'a = \\sqrt{10 \\times 3.6}',
      'a = \\sqrt{36}',
      'a = 6'
    ],
    whyFormulaWorks: [
      'Projection p is tied to leg a through similar triangles formed by the altitude to the hypotenuse.',
      'The theorem says a\u00b2 = c \u00d7 p. Multiplying c by p gives the squared side length, so the final step is taking the square root to get a.'
    ],
    additionalExample: {
      h2: 'Additional Example: Leg a From c and p',
      intro: 'Suppose hypotenuse c = 20 and projection p = 5.',
      listItems: [
        'a = \u221a(20 \u00d7 5)',
        'a = \u221a100',
        'a = 10 units',
        'The result is a side length, not a squared value.'
      ]
    },
    diagramKey: [
      { label: 'a = leg result', description: 'Leg a is the side this calculator finds.' },
      { label: 'b = other leg', description: 'Leg b is shown to complete the right triangle.' },
      { label: 'c = full hypotenuse', description: 'c is known and must be greater than projection p.' },
      { label: 'p = known projection', description: 'p is the hypotenuse segment paired with leg a.' },
      { label: 'q = other projection', description: 'q is not entered, but it is the remaining part of c.' },
      { label: 'h = altitude', description: 'h creates the projection segments on the hypotenuse.' }
    ]
  },
  'right-triangle-leg-b-from-projection-calculator': {
    formulaHeading: 'Right Triangle Leg b From Projection Formula',
    diagramHeading: 'Triangle Diagram: Leg b From Projection q',
    knownValues: 'Hypotenuse c and projection q',
    finds: 'Leg b, the side paired with projection q',
    mainFormula: 'b = \u221a(c \u00d7 q)',
    bestFor: 'Recovering leg b from its hypotenuse projection',
    exampleHeading: 'Worked Example: Find Leg b From c = 10 and q = 6.4',
    exampleLines: [
      'b = \\sqrt{c \\times q}',
      'b = \\sqrt{10 \\times 6.4}',
      'b = \\sqrt{64}',
      'b = 8'
    ],
    whyFormulaWorks: [
      'The altitude from the right angle creates similar triangles, and projection q belongs to the same side relationship as leg b.',
      'That relationship is b\u00b2 = c \u00d7 q. After multiplying c and q, the square root changes b\u00b2 into the actual leg length b.'
    ],
    additionalExample: {
      h2: 'Additional Example: Leg b From c and q',
      intro: 'Suppose hypotenuse c = 25 and projection q = 9.',
      listItems: [
        'b = \u221a(25 \u00d7 9)',
        'b = \u221a225',
        'b = 15 units',
        'Leg b is shorter than the hypotenuse, as it should be.'
      ]
    },
    diagramKey: [
      { label: 'a = other leg', description: 'Leg a is shown but is not part of this calculation.' },
      { label: 'b = leg result', description: 'Leg b is the side this calculator finds.' },
      { label: 'c = full hypotenuse', description: 'c is known and must be greater than projection q.' },
      { label: 'p = other projection', description: 'p is the segment paired with leg a.' },
      { label: 'q = known projection', description: 'q is the hypotenuse segment paired with leg b.' },
      { label: 'h = altitude', description: 'h separates projection p from projection q.' }
    ]
  },
  'right-triangle-hypotenuse-from-projections-calculator': {
    formulaHeading: 'Right Triangle Hypotenuse From Projections Formula',
    diagramHeading: 'Triangle Diagram: Hypotenuse From p and q',
    knownValues: 'Projection p and projection q',
    finds: 'Hypotenuse c, the full side made from both projections',
    mainFormula: 'c = p + q',
    bestFor: 'Adding the two hypotenuse segments into one full length',
    exampleHeading: 'Worked Example: Find Hypotenuse c From p = 3.6 and q = 6.4',
    exampleLines: ['c = p + q', 'c = 3.6 + 6.4', 'c = 10'],
    whyFormulaWorks: [
      'The altitude touches the hypotenuse at one point, dividing the same straight side into two adjacent segments.',
      'Since p and q are neighboring pieces of c, the whole hypotenuse is their sum. That is why the formula is c = p + q.'
    ],
    additionalExample: {
      h2: 'Additional Example: Hypotenuse From Two Projection Segments',
      intro: 'Suppose projection p = 5 and projection q = 12.',
      listItems: [
        'c = p + q',
        'c = 5 + 12',
        'c = 17 units',
        'The two projection segments combine to make the full hypotenuse.'
      ]
    },
    diagramKey: [
      { label: 'a = leg paired with p', description: 'Leg a is shown to identify the p side of the split.' },
      { label: 'b = leg paired with q', description: 'Leg b is shown to identify the q side of the split.' },
      { label: 'c = hypotenuse result', description: 'c is the full side found by adding p and q.' },
      { label: 'p = first projection', description: 'p is one part of the hypotenuse.' },
      { label: 'q = second projection', description: 'q is the other part of the hypotenuse.' },
      { label: 'h = altitude', description: 'h marks where the hypotenuse is divided.' }
    ]
  }
};

const pageStructure = page.structure ?? projectionPageStructure[page.slug];

if (!pageStructure) {
  throw new Error(`Missing projection page structure for ${page.slug}`);
}

const calculatorName = page.h1.replace(/\s+Calculator$/, '');
const quickSummaryLabels = {
  knownValues: 'Known values',
  finds: 'Finds',
  mainFormula: 'Main formula',
  bestFor: 'Best for',
  ...(page.ui?.quickSummaryLabels ?? {})
};
const calculatorMessages = {
  ...defaultCalculatorMessages,
  ...(page.ui?.calculatorMessages ?? {})
};
const calculatorRuntimeTranslations = page.ui?.calculationSteps
  ? { calculationSteps: page.ui.calculationSteps }
  : {};
const sectionHeading = (intent: Parameters<typeof seoSectionHeading>[1], fallback: string) =>
  locale === DEFAULT_LOCALE ? seoSectionHeading(page, intent, fallback) : fallback;
const pageUi = {
  badge: page.ui?.badge ?? 'Projection Calculator',
  calculatorHeading: page.ui?.calculatorHeading ?? `Calculate ${calculatorName}`,
  howItWorksHeading:
    page.ui?.howItWorksHeading ?? `How This ${calculatorName} Calculator Works`,
  howToHeading: page.ui?.howToHeading ?? sectionHeading('howTo', 'How to Use This Calculator'),
  resultMeaningHeading:
    page.ui?.resultMeaningHeading ?? sectionHeading('result', 'What the Result Means'),
  whenUseHeading:
    page.ui?.whenUseHeading ?? sectionHeading('useCases', 'When to Use This Calculator'),
  whenUseIntro:
    page.ui?.whenUseIntro ??
    'This method is useful when your known values match this projection relation and you want a direct result.',
  whenUseListTitle:
    page.ui?.whenUseListTitle ?? 'Common situations where this calculator helps:',
  whyFormulaWorksHeading:
    page.ui?.whyFormulaWorksHeading ?? sectionHeading('whyFormulaWorks', 'Why This Formula Works'),
  commonMistakesHeading:
    page.ui?.commonMistakesHeading ?? sectionHeading('commonMistakes', 'Common Mistakes'),
  commonMistakesIntro:
    page.ui?.commonMistakesIntro ??
    'Projection formulas are short, but it is easy to use the wrong segment or stop one step early. Check these points before trusting the result.',
  faqHeading: page.ui?.faqHeading ?? sectionHeading('faqs', 'Frequently Asked Questions'),
  faqDescription:
    page.ui?.faqDescription ??
    'Answers to common questions about right-triangle projection calculations.',
  relatedHeading: page.ui?.relatedHeading ?? sectionHeading('related', 'Related Calculators'),
  diagramKeyLabel: page.ui?.diagramKeyLabel ?? 'Diagram Key',
  homeLabel: page.ui?.homeLabel ?? pick(nav, 'home', 'Home'),
  parentCalculatorLabel:
    page.ui?.parentCalculatorLabel ?? 'Right Triangle Projection Calculator'
};
const diagramSvgLabels = {
  rightAngle: '90°',
  legA: 'leg a',
  legB: 'leg b',
  hypotenuseC: 'hypotenuse c',
  projectionP: 'projection p',
  projectionQ: 'projection q',
  altitudeH: 'altitude h',
  ...(page.diagram.svgLabels ?? {})
};
const breadcrumbItems = [
  { label: pageUi.homeLabel, href: localizePath(locale, '/') },
  {
    label: pageUi.parentCalculatorLabel,
    href: localizePath(locale, parentCalculatorPath)
  },
  { label: page.h1, href: canonicalPath }
];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};
const introText = page.intro[0];
const howItWorksIntro = page.intro[1] || page.calculatorNote;
const quickSummaryCards = [
  { label: quickSummaryLabels.knownValues, value: pageStructure.knownValues },
  { label: quickSummaryLabels.finds, value: pageStructure.finds },
  { label: quickSummaryLabels.mainFormula, value: pageStructure.mainFormula },
  { label: quickSummaryLabels.bestFor, value: pageStructure.bestFor }
];
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {pageUi.badge}
    </p>
    <h1 class="mx-auto mt-3 max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{page.h1}</span>
    </h1>
    <p class="mx-auto mt-4 hidden max-w-2xl px-4 text-sm leading-relaxed text-on-surface sm:block sm:text-base lg:text-lg opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={introText} />
    <p class="mx-auto mt-3 max-w-xs text-xs tracking-[0.01em] text-on-surface sm:hidden opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={introText} />
  </header>

  <FormulaCalculator
    formula={page.formula}
    locale={locale}
    heading={pageUi.calculatorHeading}
    messages={calculatorMessages}
    runtimeTranslations={calculatorRuntimeTranslations}
  />

{!isHypotenuseFromProjectionsPage && !isLegAFromProjectionPage && !isLegBFromProjectionPage && !isProjectionPPage && (
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2 set:html={pageUi.howItWorksHeading} />
    <p set:html={howItWorksIntro} />
    <p set:html={page.calculatorNote} />
    <div class="not-prose mt-5 grid gap-3 sm:grid-cols-2">
      {quickSummaryCards.map((card) => (
        <div class="min-w-0 rounded-lg border border-outline-variant/25 bg-surface-container-lowest/55 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {card.label}
          </p>
          <p class="mt-2 break-words text-sm leading-relaxed text-on-surface-variant">
            {card.value}
          </p>
        </div>
      ))}
    </div>
  </section>
  )}

{!isHypotenuseFromProjectionsPage && !isLegAFromProjectionPage && !isLegBFromProjectionPage && !isProjectionPPage && (
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2 set:html={pageStructure.formulaHeading} />
    <div class="not-prose mt-4 grid gap-3">
      {page.formulaSection.formulas.map((expression) => (
        <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
          <div
            class="math-textbook min-w-max text-2xl text-tertiary"
            dir="ltr"
            set:html={renderMath(expression)}
          />
        </div>
      ))}
    </div>
    {page.formulaSection.paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </section>
)}

{!isHypotenuseFromProjectionsPage && !isLegAFromProjectionPage && !isLegBFromProjectionPage && !isProjectionPPage && (
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold" set:html={pageStructure.diagramHeading} />
    <p class="mt-3 leading-relaxed text-on-surface-variant" set:html={formatRootBars(page.diagram.intro)} />

    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
      <div class="min-w-0">
        <div class="overflow-hidden rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
        <svg
          class="mx-auto block h-auto w-full max-w-full"
          viewBox="0 0 620 390"
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-labelledby={`${page.slug}-diagram-title ${page.slug}-diagram-desc`}
        >
          <title id={`${page.slug}-diagram-title`}>{pageStructure.diagramHeading}</title>
          <desc id={`${page.slug}-diagram-desc`}>{page.diagram.caption}</desc>
          <rect
            x="16"
            y="16"
            width="588"
            height="358"
            rx="18"
            fill="var(--color-surface-container-low)"
            stroke="var(--color-outline-variant)"
            stroke-opacity="0.35"
          />
          <path
            d="M90 300 L250 88 L530 300 Z"
            fill="rgba(241, 201, 125, 0.06)"
            stroke="var(--color-outline-variant)"
            stroke-width="2"
            stroke-opacity="0.7"
          />
          <line
            x1="250"
            y1="88"
            x2="250"
            y2="300"
            stroke="var(--color-tertiary)"
            stroke-width="2.5"
            stroke-dasharray="8 7"
            stroke-linecap="round"
          />
          <line
            x1="90"
            y1="300"
            x2="250"
            y2="300"
            stroke="var(--color-primary)"
            stroke-width="4"
            stroke-linecap="round"
          />
          <line
            x1="250"
            y1="300"
            x2="530"
            y2="300"
            stroke="var(--color-secondary)"
            stroke-width="4"
            stroke-linecap="round"
          />
          <path
            d="M233 110 L255 127 L272 105"
            fill="none"
            stroke="var(--color-primary)"
            stroke-width="3"
            stroke-linejoin="round"
          />
          <path
