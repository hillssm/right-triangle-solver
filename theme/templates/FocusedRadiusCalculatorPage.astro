---
import type { FocusedRadiusCalculatorPage as FocusedRadiusCalculatorPageData } from 'src/data/focusedRadiusCalculatorPages';
import {
  getFocusedRadiusCalculatorRuntimeTranslations,
  getFocusedRadiusCalculatorUi,
  localizeFocusedRadiusCalculatorPage
} from 'src/data/focusedRadiusCalculatorTranslations';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { seoSectionHeading } from 'theme/utils/seoHeadings';

interface Props {
  page: FocusedRadiusCalculatorPageData;
  locale?: Locale;
}

const { page: sourcePage, locale = DEFAULT_LOCALE } = Astro.props;
const page = localizeFocusedRadiusCalculatorPage(sourcePage, locale);
const radiusUi = getFocusedRadiusCalculatorUi(locale);
const runtimeTranslations = getFocusedRadiusCalculatorRuntimeTranslations(page, locale);

const baseFormula = getFormulaBySlug(page.formulaSlug);

if (!baseFormula || !baseFormula.calculator) {
  throw new Error(`Focused radius calculator formula is missing: ${page.formulaSlug}`);
}

const calculatorFormula = {
  ...baseFormula,
  calculator: {
    ...baseFormula.calculator,
    ...page.calculator
  }
};

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};

const canonicalPath = localizePath(locale, page.url);
const homeLabel = pick(nav, 'home', 'Home');
const parentLabel = radiusUi.parentBreadcrumbLabel;
const parentPath = '/right-triangle-radius-calculator/';
const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  { label: parentLabel, href: localizePath(locale, parentPath) },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const calculatorMessages = radiusUi.messages;

const openToolLabel = pick(solver, 'openTool', radiusUi.openTool);
const calculatorHeading = radiusUi.calculatorHeadings[page.calculatorKind];
const sectionHeading = (intent: Parameters<typeof seoSectionHeading>[1], fallback: string) =>
  locale === DEFAULT_LOCALE ? seoSectionHeading(page, intent, fallback) : fallback;
const radiusRelationHeading =
  locale === DEFAULT_LOCALE
    ? page.calculatorKind === 'inradius'
      ? 'Right Triangle Inradius Relation r'
      : 'Right Triangle Circumradius Relation R'
    : radiusUi.sectionHeadings.radiusRelation;
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface">{item.label}</span>
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {radiusUi.badge}
    </p>
    <h1 class="mt-3 break-words text-3xl font-bold leading-tight sm:text-4xl">
      {page.h1}
    </h1>
    <div class="mt-5 max-w-3xl space-y-3 text-base leading-7 text-on-surface-variant">
      {page.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>

  <section class="mx-auto mb-8 w-full max-w-4xl section-shell prose-shell">
    <p>{page.calculatorNote}</p>
  </section>

  <section class="mx-auto w-full max-w-4xl">
    <FormulaCalculator
      formula={calculatorFormula}
      locale={locale}
      heading={calculatorHeading}
      messages={calculatorMessages}
      runtimeTranslations={runtimeTranslations}
    />
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('formula', radiusUi.sectionHeadings.formula)}</h2>
    <p class="math-textbook text-tertiary" dir="ltr">{page.formulaSection.formula}</p>
    {page.formulaSection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <ul>
      {page.formulaSection.points.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('diagram', radiusUi.sectionHeadings.diagram)}</h2>
    {page.diagram.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

    <div class="not-prose mt-6 overflow-x-auto rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
      {page.diagram.kind === 'inradius' ? (
        <svg
          class="radius-diagram-svg"
          viewBox="0 0 640 420"
          role="img"
          aria-labelledby="inradiusDiagramTitle inradiusDiagramDescription"
        >
          <title id="inradiusDiagramTitle">{radiusUi.diagram.inradiusTitle}</title>
          <desc id="inradiusDiagramDescription">
            {radiusUi.diagram.inradiusDescription}
          </desc>
          <path class="diagram-fill" d="M120 320 L500 320 L120 110 Z"></path>
          <path class="diagram-side" d="M120 320 L500 320 L120 110 Z"></path>
          <path class="diagram-angle" d="M120 288 L152 288 L152 320"></path>
          <circle class="diagram-circle" cx="198" cy="242" r="78"></circle>
          <circle class="diagram-dot" cx="198" cy="242" r="4"></circle>
          <path class="diagram-radius" d="M198 242 L198 320"></path>
          <path class="diagram-leader" d="M282 242 L396 232"></path>
          <text class="diagram-label" x="298" y="372">{radiusUi.diagram.legA}</text>
          <text class="diagram-label" x="54" y="222">{radiusUi.diagram.legB}</text>
          <text class="diagram-label" x="328" y="178">{radiusUi.diagram.hypotenuseC}</text>
          <text class="diagram-label" x="216" y="286">{radiusUi.diagram.inradiusR}</text>
          <text class="diagram-label" x="404" y="236">{radiusUi.diagram.incircle}</text>
          <text class="diagram-label small" x="158" y="304">{radiusUi.diagram.rightAngle}</text>
        </svg>
      ) : (
        <svg
          class="radius-diagram-svg"
          viewBox="0 0 640 460"
          role="img"
          aria-labelledby="circumradiusDiagramTitle circumradiusDiagramDescription"
        >
          <title id="circumradiusDiagramTitle">{radiusUi.diagram.circumradiusTitle}</title>
          <desc id="circumradiusDiagramDescription">
            {radiusUi.diagram.circumradiusDescription}
          </desc>
          <circle class="diagram-circle" cx="310" cy="230" r="214.7"></circle>
          <path class="diagram-fill" d="M120 330 L500 330 L120 130 Z"></path>
          <path class="diagram-side" d="M120 330 L500 330 L120 130 Z"></path>
          <path class="diagram-angle" d="M120 298 L152 298 L152 330"></path>
          <path class="diagram-radius" d="M310 230 L500 330"></path>
          <circle class="diagram-dot" cx="310" cy="230" r="4"></circle>
          <path class="diagram-leader" d="M420 76 L514 66"></path>
          <text class="diagram-label" x="318" y="176">{radiusUi.diagram.hypotenuseC}</text>
          <text class="diagram-label" x="416" y="280">{radiusUi.diagram.circumradiusR}</text>
          <text class="diagram-label" x="328" y="246">{radiusUi.diagram.circumcenter}</text>
          <text class="diagram-label" x="444" y="62">{radiusUi.diagram.circumcircle}</text>
          <text class="diagram-label small" x="158" y="314">{radiusUi.diagram.rightAngle}</text>
        </svg>
      )}
    </div>

    <ul>
      {page.diagram.notes.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('howTo', radiusUi.sectionHeadings.howToUse)}</h2>
    <ol>
      {page.howToUse.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('examples', radiusUi.sectionHeadings.example)}</h2>
    <p>{radiusUi.sectionHeadings.given}</p>
    <ul>
      {page.example.given.map((item) => <li>{item}</li>)}
    </ul>
    <div class="not-prose my-5 rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
      <ol class="space-y-2 text-sm text-on-surface-variant">
        {page.example.steps.map((step) => (
          <li class="math-textbook text-tertiary" dir="ltr">{step}</li>
        ))}
      </ol>
    </div>
    <p>{page.example.result}</p>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('result', radiusUi.sectionHeadings.resultMeaning)}</h2>
    {page.resultMeaning.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{radiusRelationHeading}</h2>
    {page.radiusRelation.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('useCases', radiusUi.sectionHeadings.useCases)}</h2>
    <ul>
      {page.useCases.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('commonMistakes', radiusUi.sectionHeadings.commonMistakes)}</h2>
    <ul>
      {page.commonMistakes.map((mistake) => <li>{mistake}</li>)}
    </ul>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('related', radiusUi.sectionHeadings.relatedCalculators)}</h2>
    <div class="not-prose mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-lg border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-2 text-sm leading-6 text-on-surface-variant">{link.description}</p>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('faqs', radiusUi.sectionHeadings.faqs)}</h2>
    <div class="not-prose mt-5 space-y-4">
      {page.faqs.map((faq) => (
        <article class="rounded-lg border border-outline-variant/30 bg-surface-container-low p-4">
          <h3 class="text-base font-semibold text-on-surface">{faq.question}</h3>
          <p class="mt-2 text-sm leading-6 text-on-surface-variant">{faq.answer}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .radius-diagram-svg {
    display: block;
    min-width: 520px;
    width: 100%;
    height: auto;
  }

  .diagram-fill {
    fill: rgb(99 102 241 / 0.08);
  }

  .diagram-side,
  .diagram-circle,
  .diagram-radius,
  .diagram-leader,
  .diagram-angle {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram-side {
    stroke: currentColor;
    stroke-width: 4;
    color: rgb(var(--color-on-surface, 17 24 39));
  }

  .diagram-circle {
    stroke: rgb(var(--color-primary, 79 70 229));
    stroke-width: 3;
  }

  .diagram-radius,
  .diagram-leader {
    stroke: rgb(var(--color-tertiary, 14 116 144));
    stroke-width: 3;
  }

  .diagram-leader {
    stroke-width: 2;
  }

  .diagram-angle {
    stroke: rgb(var(--color-primary, 79 70 229));
    stroke-width: 3;
  }

  .diagram-dot {
    fill: rgb(var(--color-tertiary, 14 116 144));
  }

  .diagram-label {
    fill: currentColor;
    color: rgb(var(--color-on-surface, 17 24 39));
    font-size: 20px;
    font-weight: 700;
  }

  .diagram-label.small {
    font-size: 16px;
    font-weight: 600;
  }
</style>
