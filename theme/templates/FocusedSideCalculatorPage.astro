---
import type { FocusedSideCalculatorPage as FocusedSideCalculatorPageData } from 'src/data/focusedSideCalculatorPages';
import {
  getFocusedSideAngleCalculatorMessages,
  getFocusedSideAngleCalculatorRuntimeTranslations,
  isFocusedSideAngleCalculatorSlug
} from 'src/data/focusedSideAngleCalculatorTranslations';
import { getFocusedSideCalculatorUi } from 'src/data/focusedSideCalculatorUiTranslations';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import Faq from 'theme/components/Faq.astro';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { replaceGenericSeoHeading, seoSectionHeading } from 'theme/utils/seoHeadings';
import { formatListItem, formatRootBars } from 'src/utils/formatList';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: FocusedSideCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;
const formula = getFormulaBySlug(page.formulaSlug);

if (!formula || !formula.calculator) {
  throw new Error(`Focused side calculator formula is missing: ${page.formulaSlug}`);
}

const calculatorFormula = {
  ...formula,
  calculator: {
    ...formula.calculator,
    outputLabel: page.calculator.outputLabel,
    fields: page.calculator.fields
  }
};

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const content = (bundle.content as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};
const groupedPages = ((content.grouped as Record<string, any>)?.pages as Record<string, any>) || {};
const groupedUi = ((content.grouped as Record<string, any>)?.ui as Record<string, string>) || {};
const faqHub = (content.faqHub as Record<string, string>) || {};
const focusedUi = getFocusedSideCalculatorUi(locale);
const isSideAngleChild = isFocusedSideAngleCalculatorSlug(page.slug);
const sideAngleMessages = getFocusedSideAngleCalculatorMessages(locale);
const sideAngleRuntimeTranslations = getFocusedSideAngleCalculatorRuntimeTranslations(page, locale);

const homeLabel = pick(nav, 'home', 'Home');
const parentPageSlug = isSideAngleChild
  ? 'right-triangle-side-from-angle-calculator'
  : 'right-triangle-side-calculator';
const parentPageFallback = isSideAngleChild
  ? 'Right Triangle Side From Angle Calculator'
  : 'Right Triangle Side Calculator';
const sideCalculatorLabel = pick(
  groupedPages[parentPageSlug] || {},
  'h1',
  parentPageFallback
);
const canonicalPath = localizePath(locale, page.url);

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  {
    label: sideCalculatorLabel,
    href: localizePath(locale, `/${parentPageSlug}/`)
  },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: isSideAngleChild ? sideAngleMessages.positive : focusedUi.positive,
  invalid: isSideAngleChild ? sideAngleMessages.angleRange : focusedUi.positive,
  hypotenuseKnownLeg: isSideAngleChild
    ? sideAngleMessages.hypotenuseKnownSide
    : focusedUi.hypotenuseKnownLeg
};

type DiagramSideStatus =
  FocusedSideCalculatorPageData['diagram']['sides']['a']['status'];

const getDiagramStroke = (status: DiagramSideStatus) =>
  status === 'unknown' ? 'var(--color-tertiary-fixed)' : 'var(--color-primary)';

const getDiagramDash = (status: DiagramSideStatus) =>
  status === 'unknown' ? '12 8' : 'none';

const getDiagramStatusLabel = (status: DiagramSideStatus) =>
  status === 'unknown' ? focusedUi.sideToFind : focusedUi.knownSide;

const relatedHeading = pick(groupedUi, 'relatedCalculatorsTitle', 'Related Calculators');
const openToolLabel = pick(solver, 'openTool', 'Open Tool');
const faqHeading = pick(faqHub, 'heading', 'Frequently Asked Questions');
const sideCalculatorBadge = pick(common.categories || {}, 'sides', 'Side Calculator');
const sectionHeading = (
  heading: string,
  intent?: Parameters<typeof seoSectionHeading>[1]
) =>
  locale === DEFAULT_LOCALE
    ? replaceGenericSeoHeading(heading, page, intent)
    : heading;
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {sideCalculatorBadge}
    </p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{page.h1}</h1>
    <p class="truncate mt-4 max-w-3xl text-on-surface-variant" set:html={formatRootBars(page.intro)} />
  </header>

  <FormulaCalculator
    formula={calculatorFormula}
    locale={locale}
    messages={calculatorMessages}
    runtimeTranslations={sideAngleRuntimeTranslations}
  />

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeading(page.quickSummary.h2)}</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-on-surface-variant" set:html={formatRootBars(page.quickSummary.intro)} />
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      {page.quickSummary.cards.map((card) => (
        <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {card.label}
          </p>
          <p class="mt-2 break-words text-sm leading-relaxed text-on-surface" dir={card.value.includes('=') ? 'ltr' : undefined} set:html={formatRootBars(card.value)} />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(17rem,0.85fr)] lg:items-center">
      <div class="min-w-0">
        <h2 class="text-2xl font-semibold">{sectionHeading(page.diagram.h2)}</h2>
        <p class="mt-3 leading-relaxed text-on-surface-variant" set:html={formatRootBars(page.diagram.intro)} />

        <div class="focused-diagram-canvas mt-5 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
          <svg
            class="focused-diagram-svg"
            viewBox="0 0 520 340"
            role="img"
            aria-labelledby={`${page.slug}-diagram-title ${page.slug}-diagram-desc`}
          >
            <title id={`${page.slug}-diagram-title`}>{page.diagram.h2}</title>
            <desc id={`${page.slug}-diagram-desc`}>{page.diagram.caption}</desc>
            <rect
              x="12"
              y="12"
              width="496"
              height="316"
              rx="18"
              fill="var(--color-surface-container-low)"
              stroke="var(--color-outline-variant)"
              stroke-opacity="0.35"
            />
            <path
              d="M90 250 L90 70 L390 250 Z"
              fill="rgba(241, 201, 125, 0.05)"
              stroke="var(--color-outline-variant)"
              stroke-width="1.5"
              stroke-opacity="0.45"
            />
            <path
              d="M90 222 H118 V250"
              fill="none"
              stroke="var(--color-on-surface-variant)"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <line
              x1="90"
              y1="250"
              x2="390"
              y2="250"
              stroke={getDiagramStroke(page.diagram.sides.a.status)}
              stroke-width="8"
              stroke-linecap="round"
              stroke-dasharray={getDiagramDash(page.diagram.sides.a.status)}
            />
            <line
              x1="90"
              y1="250"
              x2="90"
              y2="70"
              stroke={getDiagramStroke(page.diagram.sides.b.status)}
              stroke-width="8"
              stroke-linecap="round"
              stroke-dasharray={getDiagramDash(page.diagram.sides.b.status)}
            />
            <line
              x1="90"
              y1="70"
              x2="390"
              y2="250"
              stroke={getDiagramStroke(page.diagram.sides.c.status)}
              stroke-width="8"
              stroke-linecap="round"
              stroke-dasharray={getDiagramDash(page.diagram.sides.c.status)}
            />

            <g class="focused-diagram-label" transform="translate(178 266)">
              <rect width="132" height="34" rx="8" />
              <text x="66" y="22" text-anchor="middle">{page.diagram.sides.a.label}</text>
            </g>
            <g class="focused-diagram-label" transform="translate(24 138)">
              <rect width="132" height="34" rx="8" />
              <text x="66" y="22" text-anchor="middle">{page.diagram.sides.b.label}</text>
            </g>
            <g class="focused-diagram-label" transform="translate(292 112)">
              <rect width="132" height="34" rx="8" />
              <text x="66" y="22" text-anchor="middle">{page.diagram.sides.c.label}</text>
            </g>
          </svg>
        </div>
      </div>

      <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
        <p class="font-label text-[11px] uppercase tracking-widest text-primary">
          {focusedUi.diagramKey}
        </p>
        <div class="mt-4 grid gap-3">
          {Object.values(page.diagram.sides).map((side) => (
            <div class="min-w-0 rounded-md border border-outline-variant/25 bg-surface-container-low/70 p-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex rounded-md border border-outline-variant/30 px-2 py-1 font-label text-[10px] uppercase tracking-wider text-primary">
                  {getDiagramStatusLabel(side.status)}
                </span>
                <span class="font-semibold text-on-surface" set:html={side.label} />
              </div>
              <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
                {side.description}
              </p>
            </div>
          ))}
        </div>
        <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
          {page.diagram.notes.map((note) => (
            <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2" set:html={formatRootBars(note)} />
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.formulaSection.h2)}</h2>
    {page.formulaSection.paragraphs.map((paragraph) => (
      <p set:html={formatRootBars(paragraph)} />
    ))}
    <div class="not-prose mt-5 grid gap-3">
      {page.formulaSection.formulas.map((expression) => (
        <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
          <div
            class="math-textbook min-w-max text-xl text-tertiary"
            dir="ltr"
            set:html={renderMath(expression)}
          />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.howTo.h2)}</h2>
    <ol>
      {page.howTo.steps.map((step) => (
        <li set:html={formatListItem(step)} />
      ))}
    </ol>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading(page.example.h2)}</h2>
    <p set:html={formatRootBars(page.example.intro)} />
    <div class="not-prose mt-5 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
      <div class="grid gap-2">
        {page.example.lines.map((line) => (
          <div
            class="math-textbook min-w-max text-lg text-on-surface"
            dir="ltr"
            set:html={renderMath(line, false)}
          />
        ))}
      </div>
    </div>
  </section>

  {page.extraSections.map((section) => (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2>{sectionHeading(section.h2)}</h2>
      {section.paragraphs.map((paragraph) => (
        <p set:html={formatRootBars(paragraph)} />
      ))}
      {section.listItems && section.listItems.length > 0 && (
        <>
          {section.listTitle && <h3>{sectionHeading(section.listTitle)}</h3>}
          <ul>
            {section.listItems.map((item) => (
              <li set:html={formatListItem(item)} />
            ))}
          </ul>
        </>
      )}
    </section>
  ))}

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeading(relatedHeading, 'related')}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>

  <div class="mx-auto mt-8 w-full max-w-4xl">
    <Faq heading={sectionHeading(faqHeading, 'faqs')} items={page.faqs} />
  </div>
</BaseLayout>

<style>
  .focused-diagram-canvas {
    min-width: 0;
  }

  .focused-diagram-svg {
    display: block;
    width: 100%;
    min-height: 15rem;
    height: auto;
  }

  .focused-diagram-label rect {
    fill: var(--color-surface-container-high);
    stroke: var(--color-outline-variant);
    stroke-opacity: 0.65;
  }

  .focused-diagram-label text {
    fill: var(--color-on-surface);
    font-family: var(--font-label);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  @media (max-width: 28rem) {
    .focused-diagram-svg {
      min-height: 13rem;
    }

    .focused-diagram-label text {
      font-size: 0.8125rem;
    }
  }
</style>
