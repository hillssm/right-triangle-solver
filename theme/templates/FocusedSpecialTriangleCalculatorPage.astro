---
import { formatRootBars } from 'src/utils/formatList';
import type { FocusedSpecialTriangleCalculatorPage as FocusedSpecialTriangleCalculatorPageData } from 'src/data/focusedSpecialTriangleCalculatorPages';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import Faq from 'theme/components/Faq.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { seoSectionHeading } from 'theme/utils/seoHeadings';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: FocusedSpecialTriangleCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;

const calculatorModes = page.modes.map((mode) => {
  const formula = getFormulaBySlug(mode.formulaSlug);

  if (!formula || !formula.calculator) {
    throw new Error(`Focused special triangle calculator formula is missing: ${mode.formulaSlug}`);
  }

  const localizedFields = mode.calculator?.fields
    ? formula.calculator.fields.map((field) => ({
        ...field,
        ...(mode.calculator?.fields?.find((item) => item.key === field.key) || {})
      }))
    : formula.calculator.fields;

  return {
    ...mode,
    formula: {
      ...formula,
      calculator: {
        ...formula.calculator,
        outputLabel: mode.calculator?.outputLabel ?? formula.calculator.outputLabel,
        outputUnit: mode.calculator?.outputUnit ?? formula.calculator.outputUnit,
        fields: localizedFields
      }
    }
  };
});

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};

const canonicalPath = localizePath(locale, page.url);
const homeLabel = pick(nav, 'home', 'Home');

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  { label: page.parentLabel, href: localizePath(locale, page.parentPath) },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = page.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
} : null;

const specialUiDefaults = {
  modeTitle: 'Calculator Mode',
  modeSelectLabel: 'Choose calculator mode',
  formulaHeading: 'Formula',
  diagramHeading: 'Triangle Diagram',
  howToUseHeading: 'How to Use This Calculator',
  examplesHeading: 'Step-by-Step Examples',
  resultMeaningHeading: 'What the Result Means',
  sideRatioHeading: 'Side Ratio',
  useCasesHeading: 'When to Use This Calculator',
  commonMistakesHeading: 'Common Mistakes',
  relatedHeading: 'Related Calculators',
  faqHeading: 'FAQs',
  faqDescription: 'Answers to the most common right-triangle solving questions.',
  diagramAriaLabel45: '45-45-90 Triangle Diagram',
  diagramAriaLabel30: '30-60-90 Triangle Diagram',
  calculatorMessages: {
    positive: 'Please enter a positive value.',
    invalid: 'Input value must be greater than 0.'
  }
};

const specialUi = {
  ...specialUiDefaults,
  ...(page.ui || {}),
  calculatorMessages: {
    ...specialUiDefaults.calculatorMessages,
    ...(page.ui?.calculatorMessages || {})
  }
};

const calculatorMessages = specialUi.calculatorMessages;

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });

const modeTitle = specialUi.modeTitle;
const modeSelectLabel = specialUi.modeSelectLabel;
const openToolLabel = pick(solver, 'openTool', 'Open Tool');
const diagramAriaLabel = page.diagram.kind === '45-45-90'
  ? specialUi.diagramAriaLabel45
  : specialUi.diagramAriaLabel30;
const sectionHeading = (intent: Parameters<typeof seoSectionHeading>[1], fallback: string) =>
  locale === DEFAULT_LOCALE ? seoSectionHeading(page, intent, fallback) : fallback;
--- 

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  {faqSchema && (
    <script
      is:inline
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  )}

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {page.badge}
    </p>
    <h1 class="mt-3 break-words text-3xl font-bold leading-tight sm:text-4xl">
      {page.h1}
    </h1>
    <div class="mt-5 max-w-3xl space-y-3 text-base leading-7 text-on-surface-variant">
      {page.intro.map((paragraph) => <p set:html={paragraph} />)}
    </div>
  </header>

  <section class="mx-auto w-full max-w-4xl section-shell" data-focused-special-triangle-page>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <h2 class="text-2xl font-semibold">{sectionHeading('calculatorMode', modeTitle)}</h2>
      <a href={localizePath(locale, page.parentPath)} class="btn-secondary text-xs sm:text-sm">
        {page.parentLabel}
      </a>
    </div>

    <label class="mt-6 block text-sm font-medium text-on-surface-variant sm:hidden">
      {modeSelectLabel}
      <select
        class="input-shell mt-2 rounded-lg border border-outline-variant/40"
        data-focused-special-mode-select
      >
        {calculatorModes.map((mode) => (
          <option value={mode.formulaSlug}>{mode.label}</option>
        ))}
      </select>
    </label>

    <div class="mt-6 hidden flex-wrap gap-2 sm:flex" role="tablist" aria-label={modeSelectLabel}>
      {calculatorModes.map((mode, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          data-focused-special-mode-button
          data-mode={mode.formulaSlug}
          class={`interactive-chip ${index === 0 ? 'is-active' : ''}`}
        >
          {mode.label}
        </button>
      ))}
    </div>

    <div class="mt-8 space-y-8">
      {calculatorModes.map((mode, index) => (
        <div
          data-focused-special-mode-panel
          data-mode={mode.formulaSlug}
          class={index === 0 ? '' : 'hidden'}
          role="tabpanel"
        >
          <FormulaCalculator
            formula={mode.formula}
            locale={locale}
            heading={mode.heading}
            messages={calculatorMessages}
            runtimeTranslations={locale === DEFAULT_LOCALE ? {} : {
              specialTriangleSteps: {
                [mode.formula.calculator.kind]: {
                  title: mode.heading
                }
              }
            }}
          />
        </div>
      ))}
    </div>

    <script is:inline>
      (() => {
        const currentScript = document.currentScript;
        if (!currentScript) return;

        const root = currentScript.closest('[data-focused-special-triangle-page]');
        if (!root) return;

        const buttons = Array.from(
          root.querySelectorAll('[data-focused-special-mode-button]')
        );
        const panels = Array.from(
          root.querySelectorAll('[data-focused-special-mode-panel]')
        );
        const select = root.querySelector('[data-focused-special-mode-select]');

        if (!panels.length) return;

        const setMode = (mode) => {
          panels.forEach((panel) => {
            const isActive = panel.getAttribute('data-mode') === mode;
            panel.classList.toggle('hidden', !isActive);
          });

          buttons.forEach((button) => {
            const isActive = button.getAttribute('data-mode') === mode;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          if (select && select.value !== mode) {
            select.value = mode;
          }
        };

        const defaultMode = panels[0].getAttribute('data-mode');
        if (defaultMode) setMode(defaultMode);

        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const mode = button.getAttribute('data-mode');
            if (mode) setMode(mode);
          });
        });

        if (select) {
          select.addEventListener('change', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLSelectElement)) return;
            setMode(target.value);
          });
        }
      })();
    </script>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <p set:html={page.calculatorNote} />
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('formula', specialUi.formulaHeading)}</h2>
    <div class="not-prose mt-4 grid gap-3 sm:grid-cols-2">
      {page.formulaSection.formulas.map((expression) => (
        <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
          <div
            class="math-textbook min-w-max text-2xl text-tertiary"
            dir="ltr"
            set:html={renderMath(expression)}
          />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeading('diagram', specialUi.diagramHeading)}</h2>
    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
      <div class="min-w-0">
        <div class="rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
          {page.diagram.kind === '45-45-90' ? (
            <svg
              class="special-diagram-svg"
              viewBox="0 0 640 420"
              role="img"
              aria-label={diagramAriaLabel}
            >
              <path class="diagram-fill" d="M120 340 L420 340 L120 40 Z"></path>
              <path class="diagram-side" d="M120 340 L420 340 L120 40 Z"></path>
              <path class="diagram-angle" d="M120 308 L152 308 L152 340"></path>
              <path class="diagram-angle" d="M370 340 A 50 50 0 0 1 384.6 304.6"></path>
              <path class="diagram-angle" d="M120 90 A 50 50 0 0 0 155.4 75.4"></path>
              <text class="diagram-label" x="90" y="200">a</text>
              <text class="diagram-label" x="260" y="375">a</text>
              <text class="diagram-label" x="285" y="170">c</text>
              <text class="diagram-label small" x="325" y="325">45°</text>
              <text class="diagram-label small" x="135" y="125">45°</text>
              <text class="diagram-label small" x="160" y="325">90°</text>
            </svg>
          ) : (
            <svg
              class="special-diagram-svg"
              viewBox="0 0 640 420"
              role="img"
              aria-label={diagramAriaLabel}
            >
              <path class="diagram-fill" d="M120 340 L460 340 L120 144 Z"></path>
              <path class="diagram-side" d="M120 340 L460 340 L120 144 Z"></path>
              <path class="diagram-angle" d="M120 308 L152 308 L152 340"></path>
              <path class="diagram-angle" d="M400 340 A 60 60 0 0 1 408 310"></path>
              <path class="diagram-angle" d="M120 194 A 50 50 0 0 0 163.3 169"></path>
              <text class="diagram-label" x="90" y="250">a</text>
              <text class="diagram-label" x="270" y="375">a√3</text>
              <text class="diagram-label" x="290" y="225">c</text>
              <text class="diagram-label small" x="375" y="328">30°</text>
              <text class="diagram-label small" x="140" y="210">60°</text>
              <text class="diagram-label small" x="160" y="325">90°</text>
            </svg>
          )}
        </div>
      </div>
      <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
        <p class="font-label text-[11px] uppercase tracking-widest text-primary">
          {page.diagram.keyLabel}
        </p>
        <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
          {page.diagram.notes.map((note) => (
            <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2" set:html={formatRootBars(note)} />
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('howTo', specialUi.howToUseHeading)}</h2>
    <ol>
      {page.howToUse.map((step) => <li set:html={step} />)}
    </ol>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('examples', specialUi.examplesHeading)}</h2>
    <div class="space-y-6 mt-4">
      {page.example.map((ex) => (
        <div>
          <p class="font-semibold" set:html={ex.title} />
          <div class="not-prose mt-3 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
            <div class="grid gap-2">
              {ex.steps.map((step) => (
                <div
                  class="math-textbook min-w-max text-lg text-on-surface"
                  dir="ltr"
                  set:html={renderMath(step, false)}
                />
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('result', specialUi.resultMeaningHeading)}</h2>
    {page.resultMeaning.map((paragraph) => <p set:html={paragraph} />)}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('sideRatio', specialUi.sideRatioHeading)}</h2>
    {page.sideRatio.map((paragraph) => <p set:html={paragraph} />)}
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('useCases', specialUi.useCasesHeading)}</h2>
    <ul>
      {page.useCases.map((useCase) => <li set:html={useCase} />)}
    </ul>
  </section>

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('commonMistakes', specialUi.commonMistakesHeading)}</h2>
    <ul>
      {page.commonMistakes.map((mistake) => <li set:html={mistake} />)}
    </ul>
  </section>

  {page.faqs.length > 0 && (
    <div class="mx-auto mt-8 w-full max-w-4xl">
      <Faq
        heading={sectionHeading('faqs', specialUi.faqHeading)}
        description={specialUi.faqDescription}
        items={page.faqs}
      />
    </div>
  )}

  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeading('related', specialUi.relatedHeading)}</h2>
    <div class="not-prose mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .special-diagram-svg {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin-inline: auto;
  }

  .diagram-fill {
    fill: rgb(99 102 241 / 0.08);
  }

  .diagram-side,
  .diagram-angle {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram-side {
    stroke: currentColor;
    stroke-width: 4;
    color: rgb(var(--color-on-surface, 17 24 39));
  }

  .diagram-angle {
    stroke: rgb(var(--color-primary, 79 70 229));
    stroke-width: 3;
  }

  .diagram-label {
    fill: currentColor;
    color: rgb(var(--color-on-surface, 17 24 39));
    font-size: 20px;
    font-weight: 700;
  }

  .diagram-label.small {
    font-size: 16px;
    font-weight: 600;
  }
</style>
