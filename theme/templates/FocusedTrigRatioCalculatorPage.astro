---
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import { toAbsoluteUrl } from 'theme/utils/site';
import { localizePath, DEFAULT_LOCALE } from 'theme/i18n/locales';

export interface Props {
  h1: string;
  metaTitle: string;
  metaDescription: string;
  formulaSlug: string;
  calculatorOutputLabel: string;
  fields: { key: string; label: string; min?: number }[];
  formulaDisplay: string;
  relatedLinks: { href: string; label: string; }[];
}

const {
  h1,
  metaTitle,
  metaDescription,
  formulaSlug,
  calculatorOutputLabel,
  fields,
  formulaDisplay,
  relatedLinks
} = Astro.props;

const locale = DEFAULT_LOCALE;
const formula = getFormulaBySlug(formulaSlug);

if (!formula || !formula.calculator) {
  throw new Error(`Formula not found: ${formulaSlug}`);
}

const calculatorFormula = {
  ...formula,
  calculator: {
    ...formula.calculator,
    outputLabel: calculatorOutputLabel,
    fields: fields
  }
};

const pageSlug = formulaSlug + '-calculator';
const canonicalPath = localizePath(locale, `/${pageSlug}/`);
const parentPageLabel = 'Right Triangle Trig Ratios Calculator';
const parentPageHref = localizePath(locale, '/right-triangle-trig-ratios-calculator/');

const breadcrumbItems = [
  { label: 'Home', href: localizePath(locale, '/') },
  { label: parentPageLabel, href: parentPageHref },
  { label: h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const calculatorMessages = {
  positive: 'Please enter positive values.',
  invalid: 'Please enter positive values.',
  hypotenuseKnownLeg: 'The hypotenuse c must be greater than the known side.'
};
---
<BaseLayout
  locale={locale}
  title={metaTitle}
  description={metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface">{item.label}</span>
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mx-auto mb-8 w-full max-w-4xl">
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{h1}</h1>
  </header>

  <FormulaCalculator
    formula={calculatorFormula}
    locale={locale}
    messages={calculatorMessages}
  />
  
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>Formula</h2>
    <div class="not-prose mt-5 grid gap-3">
      <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-4 py-3">
        <div class="min-w-max text-xl text-tertiary font-mono">
          {formulaDisplay}
        </div>
      </div>
    </div>
    
    <h2>How to Use This Calculator</h2>
    <p>Content will be added soon.</p>
    
    <h2>Example</h2>
    <p>Content will be added soon.</p>

    <h2>Related Calculators</h2>
    <ul>
      {relatedLinks.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <h2>FAQs</h2>
    <p>Content will be added soon.</p>
  </section>
</BaseLayout>
