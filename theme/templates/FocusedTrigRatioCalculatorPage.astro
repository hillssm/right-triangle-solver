---
import type { FocusedTrigRatioCalculatorPage as PageData } from 'src/data/focusedTrigRatioCalculatorPages';
import { getFocusedSideCalculatorUi } from 'src/data/focusedSideCalculatorUiTranslations';
import {
  getFocusedTrigRatioRuntimeTranslations,
  getFocusedTrigRatioUi
} from 'src/data/focusedTrigRatioCalculatorTranslations';
import { getFormulaBySlug } from 'src/data/rightTriangleFormulas';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import Faq from 'theme/components/Faq.astro';
import CosecantRatioGuide from 'theme/components/CosecantRatioGuide.astro';
import CosecantRatioGuideLocalized from 'theme/components/CosecantRatioGuideLocalized.astro';
import { COSECANT_GUIDE_TRANSLATIONS } from 'src/data/cosecantGuideTranslations';
import CosineRatioGuide from 'theme/components/CosineRatioGuide.astro';
import CosineRatioGuideLocalized from 'theme/components/CosineRatioGuideLocalized.astro';
import { COSINE_GUIDE_TRANSLATIONS } from 'src/data/cosineGuideTranslations';
import CotangentRatioGuide from 'theme/components/CotangentRatioGuide.astro';
import CotangentRatioGuideLocalized from 'theme/components/CotangentRatioGuideLocalized.astro';
import { COTANGENT_GUIDE_TRANSLATIONS } from 'src/data/cotangentGuideTranslations';
import SecantRatioGuide from 'theme/components/SecantRatioGuide.astro';
import SecantRatioGuideLocalized from 'theme/components/SecantRatioGuideLocalized.astro';
import { SECANT_GUIDE_TRANSLATIONS } from 'src/data/secantGuideTranslations';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { seoSectionHeading } from 'theme/utils/seoHeadings';
import { formatListItem, formatRootBars } from 'src/utils/formatList';

interface Props {
  page: PageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;
const isCosecantPage = page.slug === 'cosecant-ratio-calculator' && (locale === 'en' || COSECANT_GUIDE_TRANSLATIONS[locale]);
const isCosinePage = page.slug === 'cosine-ratio-calculator' && (locale === 'en' || COSINE_GUIDE_TRANSLATIONS[locale]);
const isCotangentPage = page.slug === 'cotangent-ratio-calculator' && (locale === 'en' || COTANGENT_GUIDE_TRANSLATIONS[locale]);
const isSecantPage = page.slug === 'secant-ratio-calculator' && (locale === 'en' || SECANT_GUIDE_TRANSLATIONS[locale]);
const trigUi = getFocusedTrigRatioUi(locale);
const runtimeTranslations = getFocusedTrigRatioRuntimeTranslations(page, locale);
const sharedCalculatorUi = getFocusedSideCalculatorUi(locale);

const formula = getFormulaBySlug(page.formulaSlug);
if (!formula || !formula.calculator) {
  throw new Error(`Formula not found: ${page.formulaSlug}`);
}

const calculatorFormula = {
  ...formula,
  calculator: {
    ...formula.calculator,
    outputLabel: page.calculator.outputLabel,
    fields: page.calculator.fields
  }
};

const canonicalPath = localizePath(locale, page.url);
const parentPageLabel = trigUi.parentPageLabel;
const parentPageHref = localizePath(locale, '/right-triangle-trig-ratios-calculator/');

const breadcrumbItems = [
  { label: trigUi.home, href: localizePath(locale, '/') },
  { label: parentPageLabel, href: parentPageHref },
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const calculatorMessages = {
  positive: sharedCalculatorUi.positive,
  invalid: sharedCalculatorUi.positive,
  hypotenuseKnownLeg: sharedCalculatorUi.hypotenuseKnownLeg
};

type TriangleSide = 'a' | 'b' | 'c';

type RatioDiagram = {
  label: string;
  numerator: TriangleSide;
  denominator: TriangleSide;
  numeratorLabel: string;
  denominatorLabel: string;
  relationship: string;
  rangeNote: string;
};

const sideInfo: Record<TriangleSide, { role: string; description: string }> = {
  a: {
    role: trigUi.sideRoles.a.role,
    description: trigUi.sideRoles.a.description
  },
  b: {
    role: trigUi.sideRoles.b.role,
    description: trigUi.sideRoles.b.description
  },
  c: {
    role: trigUi.sideRoles.c.role,
    description: trigUi.sideRoles.c.description
  }
};

const ratioDiagrams: Record<string, RatioDiagram> = {
  'sine-ratio-calculator': {
    label: 'sin(A)',
    numerator: 'a',
    denominator: 'c',
    numeratorLabel: 'opposite side a',
    denominatorLabel: 'hypotenuse c',
    relationship: 'Sine compares the height across from angle A with the full slanted side.',
    rangeNote: 'For an acute right-triangle angle, sin(A) is greater than 0 and less than 1.'
  },
  'cosine-ratio-calculator': {
    label: 'cos(A)',
    numerator: 'b',
    denominator: 'c',
    numeratorLabel: 'adjacent side b',
    denominatorLabel: 'hypotenuse c',
    relationship: 'Cosine compares the base next to angle A with the full slanted side.',
    rangeNote: 'For an acute right-triangle angle, cos(A) is greater than 0 and less than 1.'
  },
  'tangent-ratio-calculator': {
    label: 'tan(A)',
    numerator: 'a',
    denominator: 'b',
    numeratorLabel: 'opposite side a',
    denominatorLabel: 'adjacent side b',
    relationship: 'Tangent compares vertical rise with horizontal run from angle A.',
    rangeNote: 'tan(A) can be below 1, equal to 1, or above 1 depending on the two leg lengths.'
  },
  'cotangent-ratio-calculator': {
    label: 'cot(A)',
    numerator: 'b',
    denominator: 'a',
    numeratorLabel: 'adjacent side b',
    denominatorLabel: 'opposite side a',
    relationship: 'Cotangent flips tangent and compares horizontal run with vertical rise.',
    rangeNote: 'cot(A) can be any positive value, and it equals 1 when both legs are equal.'
  },
  'secant-ratio-calculator': {
    label: 'sec(A)',
    numerator: 'c',
    denominator: 'b',
    numeratorLabel: 'hypotenuse c',
    denominatorLabel: 'adjacent side b',
    relationship: 'Secant compares the full slanted side with the base next to angle A.',
    rangeNote: 'sec(A) is always greater than 1 for an acute right-triangle angle.'
  },
  'cosecant-ratio-calculator': {
    label: 'csc(A)',
    numerator: 'c',
    denominator: 'a',
    numeratorLabel: 'hypotenuse c',
    denominatorLabel: 'opposite side a',
    relationship: 'Cosecant compares the full slanted side with the height across from angle A.',
    rangeNote: 'csc(A) is always greater than 1 for an acute right-triangle angle.'
  }
};

const baseRatioDiagram = ratioDiagrams[page.slug];
if (!baseRatioDiagram) {
  throw new Error(`Ratio diagram not found: ${page.slug}`);
}

const ratioDiagram = {
  ...baseRatioDiagram,
  numeratorLabel: trigUi.sideRoles[baseRatioDiagram.numerator].label,
  denominatorLabel: trigUi.sideRoles[baseRatioDiagram.denominator].label,
  relationship: page.diagramExplanation[1] || baseRatioDiagram.relationship,
  rangeNote: page.whatResultMeans[1] || baseRatioDiagram.rangeNote
};

const sideKeys = ['a', 'b', 'c'] as TriangleSide[];
const usedSideSet = new Set<TriangleSide>([
  ratioDiagram.numerator,
  ratioDiagram.denominator
]);

const sideVisual = (side: TriangleSide) => {
  const active = usedSideSet.has(side);
  return {
    stroke: active ? 'var(--color-primary)' : 'var(--color-outline)',
    labelFill: active ? 'var(--color-primary)' : 'var(--color-on-surface-variant)',
    strokeWidth: active ? 7 : 4,
    opacity: active ? 1 : 0.45
  };
};

const sideAVisual = sideVisual('a');
const sideBVisual = sideVisual('b');
const sideCVisual = sideVisual('c');
const sectionHeading = (intent: Parameters<typeof seoSectionHeading>[1], fallback: string) =>
  locale === DEFAULT_LOCALE ? seoSectionHeading(page, intent, fallback) : fallback;
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  ></script>

  <!-- Breadcrumb -->
  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <!-- Header -->
  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {trigUi.badge}
    </p>
    <h1 class="mx-auto mt-3 max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{page.h1}</span>
    </h1>
    <p class="mx-auto mt-4 hidden max-w-2xl px-4 text-sm leading-relaxed text-on-surface sm:block sm:text-base lg:text-lg opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={page.headerSummary} />
    <p class="mx-auto mt-3 max-w-xs text-xs tracking-[0.01em] text-on-surface sm:hidden opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={page.headerSummary} />
  </header>

  <!-- Calculator -->
  <FormulaCalculator
    formula={calculatorFormula}
    locale={locale}
    heading={page.calculator.heading}
    messages={calculatorMessages}
    runtimeTranslations={runtimeTranslations}
  />

  <!-- Intro -->
  {!isCosecantPage && !isCosinePage && !isCotangentPage && !isSecantPage && (
  <>
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2 set:html={page.introHeading} />
    {page.intro.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
    <div class="not-prose mt-5 rounded-lg border border-outline-variant/25 bg-surface-container-lowest/55 p-4">
      <p class="text-sm leading-relaxed text-on-surface-variant" set:html={page.calculatorNote} />
    </div>
  </section>

  <!-- Formula -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('formula', trigUi.formula)}</h2>
    <div class="not-prose mt-4 grid gap-3">
      <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
        <div class="min-w-max text-2xl text-tertiary font-mono tracking-wide">
          {page.formula.display}
        </div>
      </div>
    </div>
    {page.formula.paragraphs.map((p) => (
      <p set:html={p} />
    ))}
  </section>

  <!-- Triangle Diagram -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeading('diagram', trigUi.triangleDiagram)}</h2>
    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
      <div class="min-w-0">
        <div class="rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
          <svg
            class="block w-full max-w-md mx-auto"
            viewBox="0 0 520 370"
            role="img"
            aria-label={`${trigUi.triangleDiagram}: ${ratioDiagram.label}, ${ratioDiagram.numeratorLabel}, ${ratioDiagram.denominatorLabel}`}
          >
            <rect
              x="10" y="10" width="500" height="350" rx="16"
              fill="var(--color-surface-container-low)"
              stroke="var(--color-outline-variant)" stroke-opacity="0.3"
            />
            <!-- Triangle fill -->
            <path
              d="M100 290 L100 80 L400 290 Z"
              fill="rgba(241, 201, 125, 0.06)"
              stroke="var(--color-outline-variant)"
              stroke-width="1.5"
              stroke-opacity="0.4"
            />
            <!-- Right angle marker at B (100, 290) -->
            <path
              d="M100 262 L128 262 L128 290"
              fill="none"
              stroke="var(--color-on-surface-variant)"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <!-- Side a — vertical (opposite) -->
            <line x1="100" y1="290" x2="100" y2="80"
              stroke={sideAVisual.stroke} stroke-width={sideAVisual.strokeWidth} stroke-linecap="round" opacity={sideAVisual.opacity} />
            <!-- Side b — horizontal (adjacent) -->
            <line x1="100" y1="290" x2="400" y2="290"
              stroke={sideBVisual.stroke} stroke-width={sideBVisual.strokeWidth} stroke-linecap="round" opacity={sideBVisual.opacity} />
            <!-- Side c — hypotenuse -->
            <line x1="100" y1="80" x2="400" y2="290"
              stroke={sideCVisual.stroke} stroke-width={sideCVisual.strokeWidth} stroke-linecap="round" opacity={sideCVisual.opacity} />

            <!-- Angle A arc near vertex A (400, 290) -->
            <path
              d="M 365 290 A 35 35 0 0 0 378 268"
              fill="none"
              stroke="var(--color-tertiary)"
              stroke-width="2.5"
              stroke-linecap="round"
            />

            <!-- Label: angle A -->
            <text x="348" y="278" fill="var(--color-tertiary)"
              font-family="'Noto Serif', serif" font-size="15" font-weight="700"
              text-anchor="end">A</text>
            <!-- Label: vertex B -->
            <text x="82" y="308" fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif" font-size="14" font-style="italic"
              text-anchor="end">B</text>
            <!-- Label: vertex C -->
            <text x="82" y="72" fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif" font-size="14" font-style="italic"
              text-anchor="end">C</text>
            <!-- Label: side a (opposite) — left of vertical -->
            <text x="56" y="188" fill={sideAVisual.labelFill}
              font-family="'Noto Serif', serif" font-size="16" font-weight="700"
              text-anchor="middle">a</text>
            <text x="56" y="206" fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif" font-size="10"
              text-anchor="middle">{`(${trigUi.sideRoles.a.short})`}</text>
            <!-- Label: side b (adjacent) — below horizontal -->
            <text x="250" y="324" fill={sideBVisual.labelFill}
              font-family="'Noto Serif', serif" font-size="16" font-weight="700"
              text-anchor="middle">b</text>
            <text x="250" y="342" fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif" font-size="10"
              text-anchor="middle">{`(${trigUi.sideRoles.b.short})`}</text>
            <!-- Label: side c (hypotenuse) — right of diagonal -->
            <text x="286" y="160" fill={sideCVisual.labelFill}
              font-family="'Noto Serif', serif" font-size="16" font-weight="700"
              text-anchor="start">c</text>
            <text x="286" y="178" fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif" font-size="10"
              text-anchor="start">{`(${trigUi.sideRoles.c.short})`}</text>
            <!-- Right angle label -->
            <text x="140" y="258" fill="var(--color-on-surface-variant)"
              font-family="'Noto Serif', serif" font-size="12"
              text-anchor="start">90°</text>
          </svg>
        </div>
      </div>
      <div class="min-w-0 space-y-3">
        {page.diagramExplanation.map((p) => (
          <p class="text-sm leading-relaxed text-on-surface-variant" set:html={p} />
        ))}
        <div class="mt-4 rounded-lg border border-outline-variant/25 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {trigUi.ratioHighlight}
          </p>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-stretch">
            <div class="min-w-0 flex-1 rounded-md border border-primary/30 bg-primary/10 px-3 py-3">
              <span class="block text-[11px] uppercase tracking-widest text-primary" set:html={trigUi.numerator} />
              <strong class="mt-1 block break-words text-on-surface">{ratioDiagram.numeratorLabel}</strong>
            </div>
            <div class="flex items-center justify-center text-xl text-outline" aria-hidden="true">/</div>
            <div class="min-w-0 flex-1 rounded-md border border-primary/30 bg-primary/10 px-3 py-3">
              <span class="block text-[11px] uppercase tracking-widest text-primary" set:html={trigUi.denominator} />
              <strong class="mt-1 block break-words text-on-surface">{ratioDiagram.denominatorLabel}</strong>
            </div>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-on-surface-variant" set:html={ratioDiagram.relationship} />
        </div>
        <div class="mt-4 rounded-lg border border-outline-variant/25 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {trigUi.sideKey}
          </p>
          <ul class="mt-3 grid gap-2 text-sm text-on-surface-variant">
            {sideKeys.map((side) => {
              const info = sideInfo[side];
              const active = usedSideSet.has(side);
              return (
                <li class={`rounded-md border px-3 py-2 ${active ? 'border-primary/30 bg-primary/10' : 'border-outline-variant/20 bg-surface-container-low/50'}`}>
                  <strong class="text-on-surface">{side}</strong> = {info.role} ({info.description})
                  <span class="mt-1 block text-xs text-outline">
                    {active ? trigUi.usedIn(ratioDiagram.label) : trigUi.notUsedIn(ratioDiagram.label)}
                  </span>
                </li>
              );
            })}
          </ul>
          <p class="mt-3 text-sm leading-relaxed text-on-surface-variant" set:html={ratioDiagram.rangeNote} />
        </div>
      </div>
    </div>
  </section>

  <!-- How to Use -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('howTo', trigUi.howToUse)}</h2>
    <ol>
      {page.howToSteps.map((step) => (
        <li set:html={formatListItem(step)} />
      ))}
    </ol>
  </section>

  <!-- Step-by-Step Example -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('examples', trigUi.stepByStepExample)}</h2>
    <p set:html={formatRootBars(page.example.intro)} />
    <div class="not-prose mt-5 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
      <div class="grid gap-2">
        {page.example.steps.map((line) => (
          <div class="min-w-max text-lg text-on-surface font-mono">
            {line}
          </div>
        ))}
      </div>
    </div>
    <p class="mt-4" set:html={page.example.conclusion} />
  </section>

  <!-- What the Result Means -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('result', trigUi.whatResultMeans)}</h2>
    {page.whatResultMeans.map((p) => (
      <p set:html={p} />
    ))}
  </section>

  <!-- When to Use This Ratio -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('useCases', trigUi.whenToUse)}</h2>
    <p set:html={page.whenToUse.intro} />
    <ul>
      {page.whenToUse.items.map((item) => (
        <li set:html={formatListItem(item)} />
      ))}
    </ul>
  </section>

  <!-- Common Mistakes -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
    <h2>{sectionHeading('commonMistakes', trigUi.commonMistakes)}</h2>
    <p set:html={page.commonMistakes.intro} />
    <ul>
      {page.commonMistakes.items.map((item) => (
        <li set:html={formatListItem(item)} />
      ))}
    </ul>
  </section>

  <!-- FAQs -->
  <div class="mx-auto mt-8 w-full max-w-4xl">
    <Faq heading={sectionHeading('faqs', trigUi.faqHeading)} items={page.faqs} />
  </div>

  <!-- Related Calculators -->
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeading('related', trigUi.relatedCalculators)}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {trigUi.openTool}
          </p>
        </a>
      ))}
    </div>
  </section>
  </>
  )}

  {page.slug === 'cosecant-ratio-calculator' && locale === 'en' ? <CosecantRatioGuide /> : null}
  {page.slug === 'cosecant-ratio-calculator' && locale !== 'en' && COSECANT_GUIDE_TRANSLATIONS[locale] ? <CosecantRatioGuideLocalized guide={COSECANT_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}

  {page.slug === 'cosine-ratio-calculator' && locale === 'en' ? <CosineRatioGuide /> : null}
  {page.slug === 'cosine-ratio-calculator' && locale !== 'en' && COSINE_GUIDE_TRANSLATIONS[locale] ? <CosineRatioGuideLocalized guide={COSINE_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}

  {page.slug === 'cotangent-ratio-calculator' && locale === 'en' ? <CotangentRatioGuide /> : null}
  {page.slug === 'cotangent-ratio-calculator' && locale !== 'en' && COTANGENT_GUIDE_TRANSLATIONS[locale] ? <CotangentRatioGuideLocalized guide={COTANGENT_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}

  {page.slug === 'secant-ratio-calculator' && locale === 'en' ? <SecantRatioGuide /> : null}
  {page.slug === 'secant-ratio-calculator' && locale !== 'en' && SECANT_GUIDE_TRANSLATIONS[locale] ? <SecantRatioGuideLocalized guide={SECANT_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
</BaseLayout>
