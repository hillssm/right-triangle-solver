---
import type { FocusedTriplesCalculatorPage as FocusedTriplesCalculatorPageData } from 'src/data/focusedTriplesCalculatorPages';
import TriplesCalculator from 'theme/components/TriplesCalculator.astro';
import Faq from 'theme/components/Faq.astro';
// Page 42 of 45: full 3-4-5 guide (EN + 18 locales).
import ThreeFourFiveGuide from 'theme/components/ThreeFourFiveGuide.astro';
import ThreeFourFiveGuideLocalized from 'theme/components/ThreeFourFiveGuideLocalized.astro';
import { THREEFOURFIVE_GUIDE_TRANSLATIONS } from 'src/data/threeFourFiveGuideTranslations';
// Page 43 of 45: full 5-12-13 guide (EN + 18 locales).
import FiveTwelveThirteenGuide from 'theme/components/FiveTwelveThirteenGuide.astro';
import FiveTwelveThirteenGuideLocalized from 'theme/components/FiveTwelveThirteenGuideLocalized.astro';
import { FIVETWELVETHIRTEEN_GUIDE_TRANSLATIONS } from 'src/data/fiveTwelveThirteenGuideTranslations';
// Page 44 of 45: full Pythagorean Triples guide (EN + 18 locales).
import PythagoreanTriplesGuide from 'theme/components/PythagoreanTriplesGuide.astro';
import PythagoreanTriplesGuideLocalized from 'theme/components/PythagoreanTriplesGuideLocalized.astro';
import { PYTHAGOREANTRIPLES_GUIDE_TRANSLATIONS } from 'src/data/pythagoreanTriplesGuideTranslations';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { seoSectionHeading } from 'theme/utils/seoHeadings';
import { formatListItem, formatRootBars } from 'src/utils/formatList';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  page: FocusedTriplesCalculatorPageData;
  locale?: Locale;
}

const { page, locale = DEFAULT_LOCALE } = Astro.props;

const bundle = getTranslations(locale);
const common = (bundle.common as Record<string, any>) || {};
const nav = (common.nav as Record<string, string>) || {};
const solver = (common.solver as Record<string, string>) || {};

const canonicalPath = localizePath(locale, page.url);
const homeLabel = pick(nav, 'home', 'Home');
const pageUi = page.calculatorUi ?? {};
const openToolLabel = pageUi.openToolLabel ?? pick(solver, 'openTool', 'Open Tool');
const relatedHeading = 'Related Calculators';
const faqHeading = 'FAQs';
const sectionHeadings = {
  formula: pageUi.sectionHeadings?.formula ?? seoSectionHeading(page, 'formula'),
  diagram: pageUi.sectionHeadings?.diagram ?? seoSectionHeading(page, 'diagram'),
  howTo: pageUi.sectionHeadings?.howTo ?? seoSectionHeading(page, 'howTo'),
  examples: pageUi.sectionHeadings?.examples ?? seoSectionHeading(page, 'examples'),
  result: pageUi.sectionHeadings?.result ?? seoSectionHeading(page, 'result'),
  sideRatio: pageUi.sectionHeadings?.sideRatio ?? seoSectionHeading(page, 'sideRatio'),
  useCases: pageUi.sectionHeadings?.useCases ?? seoSectionHeading(page, 'useCases'),
  commonMistakes: pageUi.sectionHeadings?.commonMistakes ?? seoSectionHeading(page, 'commonMistakes'),
  related: pageUi.sectionHeadings?.related ?? seoSectionHeading(page, 'related'),
  faqs: pageUi.sectionHeadings?.faqs ?? seoSectionHeading(page, 'faqs')
};
const diagramKeyLabel = pageUi.diagramKeyLabel ?? 'Triangle Diagram Key';
const diagramScaleFactorLabel = pageUi.diagramScaleFactorLabel ?? 'k = scale factor';

// Page 42 of 45: full guide replaces the old thin template content on the
// 3-4-5 page (calculator itself stays untouched).
const isThreeFourFivePage =
  page.slug === '3-4-5-triangle-calculator' &&
  (locale === 'en' || THREEFOURFIVE_GUIDE_TRANSLATIONS[locale]);

// Page 43 of 45: full guide replaces the old thin template content on the
// 5-12-13 page (calculator itself stays untouched).
const isFiveTwelveThirteenPage =
  page.slug === '5-12-13-triangle-calculator' &&
  (locale === 'en' || FIVETWELVETHIRTEEN_GUIDE_TRANSLATIONS[locale]);

// Page 44 of 45: full guide replaces the old thin template content on the
// Pythagorean Triples page (calculator itself stays untouched).
const isPythagoreanTriplesPage =
  page.slug === 'pythagorean-triples-calculator' &&
  (locale === 'en' || PYTHAGOREANTRIPLES_GUIDE_TRANSLATIONS[locale]);

const breadcrumbItems = [
  { label: homeLabel, href: localizePath(locale, '/') },
  ...(page.breadcrumbParent
    ? [
        {
          label: page.breadcrumbParent.label,
          href: localizePath(locale, page.breadcrumbParent.href)
        }
      ]
    : []),
  { label: page.h1, href: canonicalPath }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const faqSchema = page.faqs && page.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
} : null;

const renderMath = (expression: string, displayMode = true) =>
  katex.renderToString(expression, {
    throwOnError: false,
    displayMode
  });
---

<BaseLayout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={canonicalPath}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  {faqSchema && (
    <script
      is:inline
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  )}

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    {page.badge && (
      <p class="font-label text-xs uppercase tracking-widest text-primary">
        {page.badge}
      </p>
    )}
    <h1 class="mx-auto mt-3 max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{page.h1}</span>
    </h1>
  </header>

  <TriplesCalculator page={page} locale={locale} />

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.intro && page.intro.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      {page.intro.map((paragraph) => <p set:html={formatRootBars(paragraph)} />)}
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.calculatorNote && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <p set:html={formatRootBars(page.calculatorNote)} />
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.formulaSection && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.formula} />
      {page.formulaSection.paragraphs.map((p) => <p set:html={formatRootBars(p)} />)}
      <div class="not-prose mt-4 grid gap-3 sm:grid-cols-2">
        {page.formulaSection.formulas.map((expression) => (
          <div class="min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
            <div
              class="math-textbook min-w-max text-2xl text-tertiary"
              dir="ltr"
              set:html={renderMath(expression)}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.diagram && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
      <h2 class="text-2xl font-semibold" set:html={sectionHeadings.diagram} />
      <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(14rem,0.85fr)] lg:items-start">
        <div class="min-w-0">
          <div class="rounded-lg border border-outline-variant/30 bg-surface-container-lowest/60 p-3">
            {page.diagram.kind === '3-4-5' ? (
              <svg
                class="triples-diagram-svg"
                viewBox="0 0 640 420"
                role="img"
                aria-label={page.diagram.caption}
              >
                <path class="diagram-fill" d="M120 340 L420 340 L120 140 Z"></path>
                <path class="diagram-side" d="M120 340 L420 340 L120 140 Z"></path>
                <path class="diagram-angle" d="M120 308 L152 308 L152 340"></path>
                <text class="diagram-label" x="90" y="245">a = 3k</text>
                <text class="diagram-label" x="245" y="375">b = 4k</text>
                <text class="diagram-label" x="290" y="218">c = 5k</text>
                <text class="diagram-label small" x="160" y="325">90°</text>
              </svg>
            ) : page.diagram.kind === '5-12-13' ? (
              <svg
                class="triples-diagram-svg"
                viewBox="0 0 640 420"
                role="img"
                aria-label={page.diagram.caption}
              >
                <path class="diagram-fill" d="M80 340 L520 340 L80 220 Z"></path>
                <path class="diagram-side" d="M80 340 L520 340 L80 220 Z"></path>
                <path class="diagram-angle" d="M80 308 L112 308 L112 340"></path>
                <text class="diagram-label" x="50" y="285">a = 5k</text>
                <text class="diagram-label" x="270" y="375">b = 12k</text>
                <text class="diagram-label" x="310" y="262">c = 13k</text>
                <text class="diagram-label small" x="120" y="325">90°</text>
              </svg>
            ) : page.diagram.kind === 'similar' ? (
              <svg
                class="triples-diagram-svg"
                viewBox="0 0 640 420"
                role="img"
                aria-label={page.diagram.caption}
              >
                <path class="diagram-fill-secondary" d="M60 360 L320 360 L60 200 Z"></path>
                <path class="diagram-side-secondary" d="M60 360 L320 360 L60 200 Z"></path>
                <path class="diagram-angle" d="M60 328 L92 328 L92 360"></path>
                <text class="diagram-label small" x="35" y="286">a</text>
                <text class="diagram-label small" x="175" y="390">b</text>
                <text class="diagram-label small" x="210" y="262">c</text>

                <path class="diagram-fill" d="M360 360 L580 360 L360 252 Z"></path>
                <path class="diagram-side" d="M360 360 L580 360 L360 252 Z"></path>
                <path class="diagram-angle" d="M360 328 L392 328 L392 360"></path>
                <text class="diagram-label small" x="332" y="312">a·k</text>
                <text class="diagram-label small" x="452" y="390">b·k</text>
                <text class="diagram-label small" x="490" y="290">c·k</text>

                <text class="diagram-label callout" x="300" y="190">{diagramScaleFactorLabel}</text>
              </svg>
            ) : (
              <svg
                class="triples-diagram-svg"
                viewBox="0 0 640 420"
                role="img"
                aria-label={page.diagram.caption}
              >
                <path class="diagram-fill" d="M120 340 L420 340 L120 80 Z"></path>
                <path class="diagram-side" d="M120 340 L420 340 L120 80 Z"></path>
                <path class="diagram-angle" d="M120 308 L152 308 L152 340"></path>
                <text class="diagram-label" x="90" y="218">a</text>
                <text class="diagram-label" x="255" y="375">b</text>
                <text class="diagram-label" x="290" y="190">c</text>
                <text class="diagram-label small" x="160" y="325">90°</text>
              </svg>
            )}
          </div>
        </div>
        <div class="min-w-0 rounded-lg border border-outline-variant/30 bg-surface-container-lowest/50 p-4">
          <p class="font-label text-[11px] uppercase tracking-widest text-primary">
            {diagramKeyLabel}
          </p>
          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-on-surface-variant">
            {page.diagram.notes.map((note) => (
              <li class="min-w-0 rounded-md border border-outline-variant/20 bg-surface-container-low/50 px-3 py-2" set:html={formatRootBars(note)} />
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.howToUse && page.howToUse.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.howTo} />
      <ol>
        {page.howToUse.map((step) => <li set:html={formatListItem(step)} />)}
      </ol>
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.example && page.example.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.examples} />
      <div class="space-y-6 mt-4">
        {page.example.map((ex) => (
          <div>
            <p class="font-semibold" set:html={ex.title} />
            <div class="not-prose mt-3 min-w-0 overflow-x-auto rounded-lg border border-outline-variant/25 bg-surface-container-lowest/65 px-5 py-4">
              <div class="grid gap-2">
                {ex.steps.map((step) => (
                  <div
                    class="math-textbook min-w-max text-lg text-on-surface"
                    dir="ltr"
                    set:html={renderMath(step, false)}
                  />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.resultMeaning && page.resultMeaning.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.result} />
      {page.resultMeaning.map((paragraph) => <p set:html={formatRootBars(paragraph)} />)}
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.sideRatio && page.sideRatio.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.sideRatio} />
      {page.sideRatio.map((paragraph) => <p set:html={formatRootBars(paragraph)} />)}
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.useCases && page.useCases.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.useCases} />
      <ul>
        {page.useCases.map((useCase) => <li set:html={formatListItem(useCase)} />)}
      </ul>
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.commonMistakes && page.commonMistakes.length > 0 && (
    <section class="mx-auto mt-8 w-full max-w-4xl section-shell prose-shell">
      <h2 set:html={sectionHeadings.commonMistakes} />
      <ul>
        {page.commonMistakes.map((mistake) => <li set:html={formatListItem(mistake)} />)}
      </ul>
    </section>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && page.faqs && page.faqs.length > 0 && (
    <div class="mx-auto mt-8 w-full max-w-4xl">
      <Faq
        heading={sectionHeadings.faqs || faqHeading}
        items={page.faqs}
        description={pageUi.faqDescription}
      />
    </div>
  )}

  {!isThreeFourFivePage && !isFiveTwelveThirteenPage && !isPythagoreanTriplesPage && (
  <section class="mx-auto mt-8 w-full max-w-4xl section-shell">
    <h2 class="text-2xl font-semibold">{sectionHeadings.related || relatedHeading}</h2>
    <div class="not-prose mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {page.relatedLinks.map((link) => (
        <a
          href={localizePath(locale, link.href)}
          class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
        >
          <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
            {link.label}
          </h3>
          <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
            {openToolLabel}
          </p>
        </a>
      ))}
    </div>
  </section>
  )}
  {isThreeFourFivePage && locale === 'en' ? <ThreeFourFiveGuide /> : null}
  {isThreeFourFivePage && locale !== 'en' && THREEFOURFIVE_GUIDE_TRANSLATIONS[locale] ? <ThreeFourFiveGuideLocalized guide={THREEFOURFIVE_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isFiveTwelveThirteenPage && locale === 'en' ? <FiveTwelveThirteenGuide /> : null}
  {isFiveTwelveThirteenPage && locale !== 'en' && FIVETWELVETHIRTEEN_GUIDE_TRANSLATIONS[locale] ? <FiveTwelveThirteenGuideLocalized guide={FIVETWELVETHIRTEEN_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
  {isPythagoreanTriplesPage && locale === 'en' ? <PythagoreanTriplesGuide /> : null}
  {isPythagoreanTriplesPage && locale !== 'en' && PYTHAGOREANTRIPLES_GUIDE_TRANSLATIONS[locale] ? <PythagoreanTriplesGuideLocalized guide={PYTHAGOREANTRIPLES_GUIDE_TRANSLATIONS[locale]} locale={locale} /> : null}
</BaseLayout>

<style>
  .triples-diagram-svg {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin-inline: auto;
  }

  .diagram-fill {
    fill: rgb(99 102 241 / 0.08);
  }

  .diagram-fill-secondary {
    fill: rgb(234 179 8 / 0.08);
  }

  .diagram-side,
  .diagram-side-secondary,
  .diagram-angle {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram-side {
    stroke: currentColor;
    stroke-width: 4;
    color: rgb(var(--color-on-surface, 17 24 39));
  }

  .diagram-side-secondary {
    stroke: rgb(234 179 8);
    stroke-width: 3;
    stroke-dasharray: 8 4;
  }

  .diagram-angle {
    stroke: rgb(var(--color-primary, 79 70 229));
    stroke-width: 3;
  }

  .diagram-label {
    fill: currentColor;
    color: rgb(var(--color-on-surface, 17 24 39));
    font-size: 18px;
    font-weight: 700;
  }

  .diagram-label.small {
    font-size: 15px;
    font-weight: 600;
  }

  .diagram-label.callout {
    font-size: 16px;
    font-weight: 600;
    fill: rgb(var(--color-primary, 79 70 229));
  }
</style>
