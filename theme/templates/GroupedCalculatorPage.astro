---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES,
  getGroupedPageBySlug,
  getGroupedPageFormulas
} from 'src/data/rightTriangleGroupedPages';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { localizePath, type Locale } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { toAbsoluteUrl } from 'theme/utils/site';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const groupedPage = getGroupedPageBySlug(slug);
const isHubPage = slug === RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.slug;

if (!groupedPage && !isHubPage) {
  throw new Error(`Unknown grouped calculator slug: ${slug}`);
}

const activePage = isHubPage ? RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE : groupedPage!;
const canonicalPath = localizePath(locale, activePage.url);
const pageTitle = `${activePage.h1} | Right Triangle Solver`;
const pageDescription = isHubPage
  ? RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.purpose
  : groupedPage!.intent;

const formulas = groupedPage ? getGroupedPageFormulas(groupedPage) : [];
const relatedPages = groupedPage
  ? groupedPage.relatedSlugs
      .map((relatedSlug) =>
        RIGHT_TRIANGLE_GROUPED_PAGES.find((item) => item.slug === relatedSlug)
      )
      .filter(
        (item): item is (typeof RIGHT_TRIANGLE_GROUPED_PAGES)[number] =>
          Boolean(item)
      )
  : RIGHT_TRIANGLE_GROUPED_PAGES;

const homePath = localizePath(locale, '/');
const hubPath = localizePath(locale, RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url);

const breadcrumbItems = isHubPage
  ? [
      { label: 'Home', href: homePath },
      { label: RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1, href: hubPath }
    ]
  : [
      { label: 'Home', href: homePath },
      { label: RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1, href: hubPath },
      { label: groupedPage!.h1, href: localizePath(locale, groupedPage!.url) }
    ];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const bundle = getTranslations(locale);
const common = (bundle.common as any) || {};
const solver = (common.solver as any) || {};
const nav = (common.nav as any) || {};

const uiHome = pick(nav, 'home', 'Home');
const uiHub = RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1;
const uiModeTitle = pick(solver, 'calculatorMode', 'Calculator Mode');
const uiSelectMode = pick(solver, 'chooseCalculator', 'Choose calculator mode');
const uiRelated = pick(solver, 'relatedTools', 'Related Calculators');
const uiOpen = pick(solver, 'openTool', 'Open Tool');
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>

  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface">
                {index === 0 ? uiHome : item.label}
              </span>
            ) : (
              <a href={item.href} class="hover:text-primary">
                {index === 0 ? uiHome : index === 1 ? uiHub : item.label}
              </a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="mb-8">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {isHubPage ? 'Calculator Hub' : 'Grouped Calculator'}
    </p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{activePage.h1}</h1>
    <p class="mt-4 max-w-3xl text-on-surface-variant">
      {isHubPage ? RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.purpose : groupedPage!.intent}
    </p>
  </header>

  {isHubPage ? (
    <>
      <section class="section-shell prose-shell">
        <h2>{RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h2[0]}</h2>
        <p>
          Use this hub to jump into the exact right triangle workflow you need.
          Each page groups calculators by practical user intent, not by fragmented formula pages.
        </p>
        <h2>{RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h2[1]}</h2>
        <p>
          Every grouped page includes multiple tool modes in one interface, so users can solve
          related tasks without moving across overlapping pages.
        </p>
      </section>

      <section class="mt-8 section-shell">
        <h2 class="text-2xl font-semibold">All Grouped Calculator Pages</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => (
            <a
              href={localizePath(locale, page.url)}
              class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
            >
              <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
                {page.h1}
              </h3>
              <p class="mt-2 text-sm text-on-surface-variant">{page.intent}</p>
              <p class="mt-2 text-xs text-outline">
                {page.includedToolIds.length} integrated tool modes
              </p>
            </a>
          ))}
        </div>
      </section>
    </>
  ) : (
    <>
      <section class="section-shell prose-shell">
        <h2>{groupedPage!.h2[0]}</h2>
        <p>
          This page combines related calculator modes into a single workflow so users can solve
          the same intent without jumping between thin pages.
        </p>
        <h2>{groupedPage!.h2[1]}</h2>
        <p>
          Switch modes below to use the exact formula you need. The formula names stay inside the
          page content and calculator modules while the page title remains broad and user-focused.
        </p>
      </section>

      <section class="mt-8 section-shell" data-grouped-calculator-page>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <h2 class="text-2xl font-semibold">{uiModeTitle}</h2>
          <a href={hubPath} class="btn-secondary text-xs sm:text-sm">Back To {uiHub}</a>
        </div>

        <label class="mt-6 block text-sm font-medium text-on-surface-variant sm:hidden">
          {uiSelectMode}
          <select
            class="input-shell mt-2 rounded-lg border border-outline-variant/40"
            data-grouped-mode-select
          >
            {formulas.map((formula) => (
              <option value={formula.slug}>{formula.title}</option>
            ))}
          </select>
        </label>

        <div class="mt-6 hidden flex-wrap gap-2 sm:flex" role="tablist" aria-label={uiSelectMode}>
          {formulas.map((formula, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              data-grouped-mode-button
              data-mode={formula.slug}
              class={`interactive-chip ${index === 0 ? 'is-active' : ''}`}
            >
              {formula.title}
            </button>
          ))}
        </div>

        <div class="mt-8 space-y-8">
          {formulas.map((formula, index) => (
            <div
              data-grouped-mode-panel
              data-mode={formula.slug}
              class={index === 0 ? '' : 'hidden'}
              role="tabpanel"
            >
              <FormulaCalculator formula={formula} locale={locale} />
            </div>
          ))}
        </div>

        <script is:inline>
          (() => {
            const currentScript = document.currentScript;
            if (!currentScript) return;

            const root = currentScript.closest('[data-grouped-calculator-page]');
            if (!root) return;

            const buttons = Array.from(
              root.querySelectorAll('[data-grouped-mode-button]')
            );
            const panels = Array.from(
              root.querySelectorAll('[data-grouped-mode-panel]')
            );
            const select = root.querySelector('[data-grouped-mode-select]');

            if (!panels.length) return;

            const setMode = (mode) => {
              panels.forEach((panel) => {
                const isActive = panel.getAttribute('data-mode') === mode;
                panel.classList.toggle('hidden', !isActive);
              });

              buttons.forEach((button) => {
                const isActive = button.getAttribute('data-mode') === mode;
                button.classList.toggle('is-active', isActive);
                button.setAttribute('aria-selected', isActive ? 'true' : 'false');
              });

              if (select && select.value !== mode) {
                select.value = mode;
              }

              const url = new URL(window.location.href);
              url.searchParams.set('tool', mode);
              window.history.replaceState({}, '', url.toString());
            };

            const searchMode = new URL(window.location.href).searchParams.get('tool');
            const defaultMode = searchMode || panels[0].getAttribute('data-mode');
            if (defaultMode) setMode(defaultMode);

            buttons.forEach((button) => {
              button.addEventListener('click', () => {
                const mode = button.getAttribute('data-mode');
                if (mode) setMode(mode);
              });
            });

            if (select) {
              select.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLSelectElement)) return;
                setMode(target.value);
              });
            }
          })();
        </script>
      </section>

      <section class="mt-8 section-shell">
        <h2 class="text-2xl font-semibold">{uiRelated}</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPages.map((page) => (
            <a
              href={localizePath(locale, page.url)}
              class="group rounded-xl border border-outline-variant/30 bg-surface-container-low p-4 transition-all hover:border-primary/45 hover:shadow-sm"
            >
              <h3 class="text-base font-semibold text-on-surface group-hover:text-primary">
                {page.h1}
              </h3>
              <p class="mt-2 text-sm text-on-surface-variant">{page.intent}</p>
              <p class="mt-3 text-[11px] uppercase tracking-widest text-primary">
                {uiOpen}
              </p>
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>
