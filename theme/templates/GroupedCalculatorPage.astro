---
import {
  RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE,
  RIGHT_TRIANGLE_GROUPED_PAGES,
  getGroupedPageBySlug,
  getGroupedPageFormulas
} from 'src/data/rightTriangleGroupedPages';
import { FOCUSED_ANGLE_CALCULATOR_PAGES } from 'src/data/focusedAngleCalculatorPages';
import { GROUPED_PAGE_FAQS } from 'src/data/groupedPageFaqs';
import FormulaCalculator from 'theme/components/FormulaCalculator.astro';
import { RIGHT_TRIANGLE_FORMULAS } from 'src/data/rightTriangleFormulas';
import Faq from 'theme/components/Faq.astro';
import { DEFAULT_LOCALE, localizePath, type Locale } from 'theme/i18n/locales';

import BaseLayout from 'theme/layouts/BaseLayout.astro';
import HubGuide from 'theme/components/HubGuide.astro';
import { toAbsoluteUrl } from 'theme/utils/site';
import { replaceGenericSeoHeading, seoSectionHeading } from 'theme/utils/seoHeadings';
import { formatListItem } from 'src/utils/formatList';
import { getTranslations, pick } from 'theme/i18n/translations';

interface Props {
  locale: Locale;
  slug: string;
}

type GroupedPageCopy = {
  h1: string;
  h2: [string, string];
  intent: string;
  content: {
    intro: string;
    method: string;
    useCases: string[];
    inputTips: string[];
    proTip: string;
  };
};

const { locale, slug } = Astro.props;
const groupedPage = getGroupedPageBySlug(slug);
const isHubPage = slug === RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.slug;

if (!groupedPage && !isHubPage) {
  throw new Error(`Unknown grouped calculator slug: ${slug}`);
}

const bundle = getTranslations(locale);
const common = (bundle.common as any) || {};
const content = (bundle.content as any) || {};
const formulasBundle = (bundle.formulas as any) || {};
const nav = (common.nav as any) || {};

const groupedContent = (content.grouped as any) || {};
const groupedUi = (groupedContent.ui as any) || {};
const groupedHub = (groupedContent.hub as any) || {};
const groupedPages = (groupedContent.pages as Record<string, any>) || {};
const groupedFaqs = (groupedContent.faqs as Record<string, any>) || {};

const defaultHubIntro = [
  'Use this hub to jump into the exact right triangle workflow you need. Each page groups calculators by practical user intent, not by fragmented formula pages.',
  'Every grouped page includes multiple tool modes in one interface, so users can solve related tasks without moving across overlapping pages.'
];
const defaultChooseBestSteps = [
  'Start with what you already know: sides, angles, area, altitude, projections, or radii.',
  'Open the grouped page matching that intent, then select the exact mode from tabs.',
  'Use one related grouped page to verify your final output before using it in class or work.'
];
const defaultCommonMistakes = [
  'Mixing units in a single calculation. Keep all values in one unit system before solving.',
  'Choosing a mode that does not match known inputs. Start with the closest mode to your available values.',
  'Rounding too early. Keep full precision until the final result output.',
  'Skipping verification. Recheck using one related calculator before using results in high-stakes work.'
];
const defaultQuickStartTemplates = [
  'Choose the tab that matches your known values before entering numbers.',
  'Enter values in consistent units and verify that your triangle inputs are valid.',
  'Review the calculated result, then cross-check with a related calculator when accuracy matters.',
  'Use related pages such as {first} and {second} for advanced checks.'
];
const defaultWorkflows = [
  {
    href: '/right-triangle-side-calculator/',
    label: 'Side -> Angle -> Area workflow',
    description: 'for full triangle completion.'
  },
  {
    href: '/right-triangle-trig-ratios-calculator/',
    label: 'Trig ratios -> Angle -> Side workflow',
    description: 'for trigonometry tasks.'
  },
  {
    href: '/right-triangle-area-calculator/',
    label: 'Area + Altitude + Radius workflow',
    description: 'for geometry validation.'
  }
];

const formatText = (template: string, replacements: Record<string, string>) =>
  Object.entries(replacements).reduce(
    (acc, [key, value]) => acc.replaceAll(`{${key}}`, value),
    template
  );

const localizeGroupedPage = (
  page: (typeof RIGHT_TRIANGLE_GROUPED_PAGES)[number]
): GroupedPageCopy => {
  const copy = groupedPages[page.slug] || {};
  const contentCopy = copy.content || {};

  const h2 =
    Array.isArray(copy.h2) && copy.h2.length === 2
      ? [String(copy.h2[0]), String(copy.h2[1])]
      : page.h2;

  return {
    h1: pick(copy, 'h1', page.h1),
    h2: h2 as [string, string],
    intent: pick(copy, 'intent', page.intent),
    content: {
      intro: pick(contentCopy, 'intro', page.content.intro),
      method: pick(contentCopy, 'method', page.content.method),
      useCases: Array.isArray(contentCopy.useCases)
        ? contentCopy.useCases
        : page.content.useCases,
      inputTips: Array.isArray(contentCopy.inputTips)
        ? contentCopy.inputTips
        : page.content.inputTips,
      proTip: pick(contentCopy, 'proTip', page.content.proTip),
      guidance: pick(contentCopy, 'guidance', page.content.guidance)
    }
  };
};

const localizedHub = {
  h1: pick(groupedHub, 'h1', RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h1),
  h2:
    Array.isArray(groupedHub.h2) && groupedHub.h2.length === 2
      ? [String(groupedHub.h2[0]), String(groupedHub.h2[1])]
      : RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.h2,
  purpose: pick(groupedHub, 'purpose', RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.purpose)
};

const localizedGroupedPages = RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => ({
  base: page,
  copy: localizeGroupedPage(page)
}));

const hubGuide = (groupedHub.guide as any) || {};

// Placeholder -> localized calculator name map for the hub guide.
const guideCalcName = (slug: string, fallback: string) =>
  localizedGroupedPages.find((p) => p.base.slug === slug)?.copy.h1 || fallback;
const hubGuideNames: Record<string, string> = {
  __SIDE_CALC__: guideCalcName('right-triangle-side-calculator', 'Right Triangle Side Calculator'),
  __SIDEANGLE_CALC__: guideCalcName('right-triangle-side-from-angle-calculator', 'Right Triangle Side Calculator Using Angle'),
  __ANGLE_CALC__: guideCalcName('right-triangle-angle-calculator', 'Right Triangle Angle Calculator'),
  __TRIG_CALC__: guideCalcName('right-triangle-trig-ratios-calculator', 'Trigonometric Ratios Calculator'),
  __AREA_CALC__: guideCalcName('right-triangle-area-calculator', 'Right Triangle Area Calculator'),
  __MEAS_CALC__: guideCalcName('right-triangle-measurements-calculator', 'Right Triangle Perimeter and Semiperimeter Calculator'),
  __ALT_CALC__: guideCalcName('right-triangle-altitude-calculator', 'Right Triangle Height (Altitude) Calculator'),
  __PROJ_CALC__: guideCalcName('right-triangle-projection-calculator', 'Right Triangle Projection and Segment Calculator'),
  __RAD_CALC__: guideCalcName('right-triangle-radius-calculator', 'Right Triangle Inradius and Circumradius Calculator'),
  __SPECIAL_CALC__: guideCalcName('special-right-triangle-calculator', 'Special Right Triangle Calculator'),
  __TRIPLES_CALC__: (hubGuide as any).triplesCalc || 'Pythagorean Triples Calculator',
  __SCALED__: (hubGuide as any).sTriples?.scaled || 'scaled 3-4-5',
  __SIDE_SHORT__: (hubGuide as any).shortLabels?.side || 'Side',
  __SIDEANGLE_SHORT__: (hubGuide as any).shortLabels?.sideAngle || 'Side from Angle',
  __ANGLE_SHORT__: (hubGuide as any).shortLabels?.angle || 'Angle',
  __TRIG_SHORT__: (hubGuide as any).shortLabels?.trig || 'Trig Ratios',
  __AREA_SHORT__: (hubGuide as any).shortLabels?.area || 'Area',
  __MEAS_SHORT__: (hubGuide as any).shortLabels?.meas || 'Measurements',
  __ALT_SHORT__: (hubGuide as any).shortLabels?.alt || 'Altitude',
  __PROJ_SHORT__: (hubGuide as any).shortLabels?.proj || 'Projection',
  __RAD_SHORT__: (hubGuide as any).shortLabels?.rad || 'Radius'
};

const activePage = isHubPage
  ? {
      h1: localizedHub.h1,
      h2: localizedHub.h2,
      intent: localizedHub.purpose,
      content: null
    }
  : localizeGroupedPage(groupedPage!);

const sectionHeading = (
  heading: string,
  intent?: Parameters<typeof seoSectionHeading>[1]
) =>
  locale === DEFAULT_LOCALE
    ? replaceGenericSeoHeading(heading, { h1: activePage.h1 }, intent)
    : heading;

const canonicalPath = localizePath(locale, isHubPage ? RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url : groupedPage!.url);
const hubSeoTitle = 'Right Triangle Calculator \u2013 Sides, Angles & Steps';
const hubSeoDescription =
  'Calculate right triangle sides, angles, area, and perimeter. Enter two valid measurements, view interactive diagrams, and explore step-by-step solutions.';
const hubGuideMeta = (hubGuide.meta as any) || {};
const pageTitle = isHubPage
  ? `${hubGuideMeta.title || hubSeoTitle} | Right Triangle Solver`
  : `${activePage.h1} | Right Triangle Solver`;
const pageDescription = isHubPage
  ? hubGuideMeta.description || hubSeoDescription
  : activePage.intent;

const formulas = groupedPage
  ? getGroupedPageFormulas(groupedPage).map((formula) => {
      const localizedFormula = formulasBundle?.[formula.slug] || {};
      return {
        ...formula,
        title: pick(localizedFormula, 'title', formula.title),
        description: pick(localizedFormula, 'description', formula.description)
      };
    })
  : [];

const relatedPages = groupedPage
  ? groupedPage.relatedSlugs
      .map((relatedSlug) =>
        RIGHT_TRIANGLE_GROUPED_PAGES.find((item) => item.slug === relatedSlug)
      )
      .filter(
        (item): item is (typeof RIGHT_TRIANGLE_GROUPED_PAGES)[number] =>
          Boolean(item)
      )
  : RIGHT_TRIANGLE_GROUPED_PAGES;

const localizedRelatedPages = relatedPages.map((page) => ({
  base: page,
  copy: localizeGroupedPage(page)
}));

const uiHome = pick(groupedUi, 'homeLabel', pick(nav, 'home', 'Home'));
const uiHub = localizedHub.h1;
const uiModeTitle = pick(groupedUi, 'calculatorModeTitle', 'Calculator Mode');
const uiSelectMode = pick(groupedUi, 'chooseCalculatorMode', 'Choose calculator mode');
const uiRelated = pick(groupedUi, 'relatedCalculatorsTitle', 'Related Calculators');

const BLOG_POSTS: Record<string, { slug: string; title: string }> = {
  'right-triangle-side-calculator': { slug: 'how-to-find-a-missing-side', title: 'How to Find a Missing Side of a Right Triangle' },
  'right-triangle-side-from-angle-calculator': { slug: 'how-to-find-a-missing-side', title: 'How to Find a Missing Side of a Right Triangle' },
  'right-triangle-angle-calculator': { slug: 'sine-cosine-tangent', title: 'Sine, Cosine and Tangent Explained' },
  'right-triangle-trig-ratios-calculator': { slug: 'sine-cosine-tangent', title: 'Sine, Cosine and Tangent Explained' },
  'right-triangle-area-calculator': { slug: 'how-to-solve-a-right-triangle', title: 'How to Solve a Right Triangle' },
  'right-triangle-measurements-calculator': { slug: 'pythagorean-theorem-formula', title: 'Pythagorean Theorem Formula' },
  'special-right-triangle-calculator': { slug: 'pythagorean-theorem-formula', title: 'Pythagorean Theorem Formula' },
  'right-triangle-hypotenuse-calculator': { slug: 'hypotenuse-formula', title: 'Hypotenuse Formula' },
};
const relatedPost = BLOG_POSTS[groupedPage?.slug ?? ''];
const generalSolverFormula = RIGHT_TRIANGLE_FORMULAS.find((f) => f.slug === 'general-right-triangle-solver');
const uiOpen = pick(groupedUi, 'openTool', 'Open Tool');
const uiBackTo = pick(groupedUi, 'backTo', 'Back To');

const relatedPageNames = localizedRelatedPages.map((item) => item.copy.h1);
const relatedSideCalculatorLinks = [
  {
    href: '/pythagorean-theorem-calculator/',
    label: 'Pythagorean Theorem Calculator'
  },
  {
    href: '/missing-leg-from-c-and-a-calculator/',
    label: 'Missing Leg From c and a Calculator'
  },
  {
    href: '/missing-leg-from-c-and-b-calculator/',
    label: 'Missing Leg From c and b Calculator'
  }
];
const showRelatedSideCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-side-calculator';

const relatedTrigRatioCalculatorLinks = [
  { href: '/sine-ratio-calculator/', label: 'Sine Ratio Calculator' },
  { href: '/cosine-ratio-calculator/', label: 'Cosine Ratio Calculator' },
  { href: '/tangent-ratio-calculator/', label: 'Tangent Ratio Calculator' },
  { href: '/cotangent-ratio-calculator/', label: 'Cotangent Ratio Calculator' },
  { href: '/secant-ratio-calculator/', label: 'Secant Ratio Calculator' },
  { href: '/cosecant-ratio-calculator/', label: 'Cosecant Ratio Calculator' }
];
const showRelatedTrigRatioCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-trig-ratios-calculator';

const relatedMeasurementCalculatorLinks = [
  {
    href: '/right-triangle-perimeter-calculator/',
    label: 'Right Triangle Perimeter Calculator'
  },
  {
    href: '/right-triangle-semiperimeter-calculator/',
    label: 'Right Triangle Semiperimeter Calculator'
  }
];
const showRelatedMeasurementCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-measurements-calculator';

const relatedAreaCalculatorLinks = [
  { href: '/right-triangle-area-from-legs-calculator/', label: 'Right Triangle Area From Legs Calculator' },
  { href: '/right-triangle-area-from-angle-calculator/', label: 'Right Triangle Area From Angle Calculator' },
  { href: '/right-triangle-area-from-semiperimeter-calculator/', label: 'Right Triangle Area From Semiperimeter Calculator' },
  { href: '/right-triangle-area-from-altitude-calculator/', label: 'Right Triangle Area From Altitude Calculator' }
];
const showRelatedAreaCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-area-calculator';

const relatedAltitudeCalculatorLinks = [
  {
    href: '/right-triangle-altitude-from-sides-calculator/',
    label: 'Right Triangle Altitude From Sides Calculator'
  },
  {
    href: '/right-triangle-altitude-from-projections-calculator/',
    label: 'Right Triangle Altitude From Projections Calculator'
  }
];
const showRelatedAltitudeCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-altitude-calculator';

const relatedProjectionCalculatorLinks = [
  {
    href: '/right-triangle-projection-p-calculator/',
    label: 'Right Triangle Projection p Calculator'
  },
  {
    href: '/right-triangle-projection-q-calculator/',
    label: 'Right Triangle Projection q Calculator'
  },
  {
    href: '/right-triangle-leg-a-from-projection-calculator/',
    label: 'Right Triangle Leg a From Projection Calculator'
  },
  {
    href: '/right-triangle-leg-b-from-projection-calculator/',
    label: 'Right Triangle Leg b From Projection Calculator'
  },
  {
    href: '/right-triangle-hypotenuse-from-projections-calculator/',
    label: 'Right Triangle Hypotenuse From Projections Calculator'
  }
];
const showRelatedProjectionCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-projection-calculator';

const relatedRadiusCalculatorLinks = [
  {
    href: '/right-triangle-inradius-calculator/',
    label: 'Right Triangle Inradius Calculator'
  },
  {
    href: '/right-triangle-circumradius-calculator/',
    label: 'Right Triangle Circumradius Calculator'
  }
];
const showRelatedRadiusCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-radius-calculator';

const relatedSpecialTriangleCalculatorLinks = [
  {
    href: '/45-45-90-triangle-calculator/',
    label: '45 45 90 Triangle Calculator'
  },
  {
    href: '/30-60-90-triangle-calculator/',
    label: '30 60 90 Triangle Calculator'
  }
];
const showRelatedSpecialTriangleCalculators =
  locale === 'en' && groupedPage?.slug === 'special-right-triangle-calculator';

const relatedAngleCalculatorLinks = FOCUSED_ANGLE_CALCULATOR_PAGES.map((page) => ({
  href: page.url,
  label: page.h1,
  description: page.headerSummary
}));
const showRelatedAngleCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-angle-calculator';

const relatedSideFromAngleCalculatorLinks = [
  {
    href: '/right-triangle-side-from-sine-calculator/',
    label: 'Right Triangle Side From Sine Calculator'
  },
  {
    href: '/right-triangle-side-from-cosine-calculator/',
    label: 'Right Triangle Side From Cosine Calculator'
  },
  {
    href: '/right-triangle-side-from-tangent-calculator/',
    label: 'Right Triangle Side From Tangent Calculator'
  },
  {
    href: '/right-triangle-adjacent-side-from-tangent-calculator/',
    label: 'Right Triangle Adjacent Side From Tangent Calculator'
  }
];
const showRelatedSideFromAngleCalculators =
  locale === 'en' && groupedPage?.slug === 'right-triangle-side-from-angle-calculator';

const quickStartTemplates = Array.isArray(groupedUi.quickStartSteps)
  ? groupedUi.quickStartSteps
  : defaultQuickStartTemplates;

const quickStartSteps = groupedPage
  ? [
      quickStartTemplates[0] ?? defaultQuickStartTemplates[0],
      quickStartTemplates[1] ?? defaultQuickStartTemplates[1],
      quickStartTemplates[2] ?? defaultQuickStartTemplates[2],
      formatText(
        quickStartTemplates[3] ?? defaultQuickStartTemplates[3],
        {
          first: relatedPageNames[0] ?? 'related calculators',
          second: relatedPageNames[1] ?? relatedPageNames[0] ?? 'other pages'
        }
      )
    ]
  : [];

const groupedPageFaqItems = groupedPage
  ? groupedFaqs[groupedPage.slug] ?? GROUPED_PAGE_FAQS[groupedPage.slug] ?? []
  : [];

const groupedPageFaqSchema = groupedPage && groupedPageFaqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: groupedPageFaqItems.map((item: any) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer
        }
      }))
    }
  : null;

const applyHubGuideNames = (s: string): string => {
  let out = s || '';
  for (const [k, v] of Object.entries(hubGuideNames)) out = out.split(k).join(v);
  return out;
};
const schemaPlainText = (s: string): string =>
  applyHubGuideNames(s)
    .replace(/\[\[\[(.+?)\]\]\]/g, '$1')
    .replace(/\[\[(.+?)\]\]/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const hubGuideFaqs = Array.isArray((hubGuide as any).faqs) ? (hubGuide as any).faqs : [];
const hubFaqSchema =
  isHubPage && hubGuideFaqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: hubGuideFaqs.map((item: any) => ({
          '@type': 'Question',
          name: schemaPlainText(item.q),
          acceptedAnswer: {
            '@type': 'Answer',
            text: schemaPlainText(item.a)
          }
        }))
      }
    : null;

const homePath = localizePath(locale, '/');
const hubPath = localizePath(locale, RIGHT_TRIANGLE_CALCULATOR_HUB_PAGE.url);

const breadcrumbItems = isHubPage
  ? [
      { label: uiHome, href: homePath },
      { label: uiHub, href: hubPath }
    ]
  : [
      { label: uiHome, href: homePath },
      { label: uiHub, href: hubPath },
      { label: activePage.h1, href: localizePath(locale, groupedPage!.url) }
    ];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: toAbsoluteUrl(item.href)
  }))
};

const hubIntroParagraphs = Array.isArray(groupedUi.hubIntroParagraphs)
  ? groupedUi.hubIntroParagraphs
  : defaultHubIntro;
const chooseBestSteps = Array.isArray(groupedUi.chooseBestSteps)
  ? groupedUi.chooseBestSteps
  : defaultChooseBestSteps;
const workflows = Array.isArray(groupedUi.workflows)
  ? groupedUi.workflows
  : defaultWorkflows;
const commonMistakes = Array.isArray(groupedUi.commonMistakes)
  ? groupedUi.commonMistakes
  : defaultCommonMistakes;
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  ></script>
  {groupedPageFaqSchema && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(groupedPageFaqSchema)}
    ></script>
  )}
  {hubFaqSchema && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(hubFaqSchema)}
    ></script>
  )}

  <nav class="mx-auto mb-6 w-full max-w-4xl" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-on-surface-variant">
      {breadcrumbItems.map((item, index) => (
        <>
          <li>
            {index === breadcrumbItems.length - 1 ? (
              <span aria-current="page" class="text-on-surface" set:html={item.label} />
            ) : (
              <a href={item.href} class="hover:text-primary">{item.label}</a>
            )}
          </li>
          {index < breadcrumbItems.length - 1 && (
            <li aria-hidden="true" class="text-outline">/</li>
          )}
        </>
      ))}
    </ol>
  </nav>

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {isHubPage
        ? pick(groupedUi, 'hubBadge', 'Calculator Hub')
        : pick(groupedUi, 'groupedBadge', 'Grouped Calculator')}
    </p>
    <h1 class="mx-auto mt-3 max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{activePage.h1}</span>
    </h1>
    <p class="mx-auto mt-4 hidden max-w-2xl px-4 text-sm leading-relaxed text-on-surface sm:block sm:text-base lg:text-lg opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={activePage.intent} />
    <p class="mx-auto mt-3 max-w-xs text-xs tracking-[0.01em] text-on-surface sm:hidden opacity-90" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;" set:html={activePage.intent} />
  </header>

  {isHubPage ? (
    <>
      {generalSolverFormula && (
        <section id="hub-calculator" class="mx-auto w-full max-w-4xl scroll-mt-24">
          <div class="mb-4" data-hub-presets>
            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{(hubGuide as any).presetsLabel || 'Try an example'}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              <button type="button" class="interactive-chip" data-hub-preset data-leg-a="3" data-leg-b="4">{((hubGuide as any).presets ?? [])[0] || '3–4–5 Triangle'}</button>
              <button type="button" class="interactive-chip" data-hub-preset data-leg-a="5" data-leg-b="12">{((hubGuide as any).presets ?? [])[1] || '5–12–13 Triangle'}</button>
              <button type="button" class="interactive-chip" data-hub-preset data-leg-c="10" data-angle-a="30">{((hubGuide as any).presets ?? [])[2] || 'Hypotenuse 10, Angle 30°'}</button>
              <button type="button" class="interactive-chip" data-hub-preset data-leg-c="13" data-leg-b="12">{((hubGuide as any).presets ?? [])[3] || 'Hypotenuse 13, Leg 12'}</button>
            </div>
          </div>
          <FormulaCalculator formula={generalSolverFormula} locale={locale} widgetStrings={(hubGuide as any).widget} />
        </section>
      )}
        <script is:inline>
          (() => {
            const section = document.getElementById('hub-calculator');
            if (!section) return;
            const form = section.querySelector('form[data-calc-form]');
            if (!form) return;
            const fillAndSolve = (values) => {
              ['a', 'b', 'c', 'A', 'B'].forEach((key) => {
                const input = form.querySelector('input[name="' + key + '"]');
                if (input) input.value = values[key] != null ? values[key] : '';
              });
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
              window.setTimeout(() => form.requestSubmit(), 400);
            };
            const readValues = (btn) => ({
              a: btn.dataset.legA, b: btn.dataset.legB, c: btn.dataset.legC,
              A: btn.dataset.angleA, B: btn.dataset.angleB
            });
            document.querySelectorAll('[data-hub-preset]').forEach((btn) => {
              btn.addEventListener('click', () =>
                fillAndSolve(readValues(btn))
              );
            });
            document.querySelectorAll('[data-try-calc]').forEach((btn) => {
              btn.addEventListener('click', () =>
                fillAndSolve(readValues(btn))
              );
            });
          })();
        </script>
