---
import CalculatorCatalog from 'theme/components/CalculatorCatalog.astro';
import ChartTableSection from 'theme/components/ChartTableSection.astro';
import Faq from 'theme/components/Faq.astro';
import HomeSchema from 'theme/components/HomeSchema.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import RightTriangleTool from 'theme/components/RightTriangleTool.astro';
import { localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import type { Locale } from 'theme/i18n/locales';
import { formatListItem } from 'src/utils/formatList';

interface Props {
  locale: Locale;
}

type LinkItem = { href: string; label: string; description: string };

const { locale } = Astro.props;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const home = (content.home as Record<string, unknown>) ?? {};
const homeAny = home as Record<string, any>;
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = pick(home, 'title', `${siteTitle} | Geometry`);
const pageDescription = pick(
  home,
  'description',
  'Solve right triangles quickly with formulas and examples.'
);

const longContent = (homeAny.longContent as Record<string, any>) ?? {};
const introSection = (longContent.introSection as Record<string, any>) ?? {};
const formulaSection = (longContent.formulaSection as Record<string, any>) ?? {};
const solveSection = (longContent.solveSection as Record<string, any>) ?? {};
const calculatorSection = (longContent.calculatorSection as Record<string, any>) ?? {};
const validationSection = (longContent.validationSection as Record<string, any>) ?? {};

const defaultChartRows = [
  { label: '3-4-5 triangle', value: '5.000', ratio: 5, href: '/3-4-5-triangle-calculator/' },
  { label: '5-12-13 triangle', value: '13.000', ratio: 13, href: '/5-12-13-triangle-calculator/' },
  { label: '8-15-17 triangle', value: '17.000', ratio: 17 },
  { label: '9-12-15 triangle', value: '15.000', ratio: 15 }
];

const chartRows = (Array.isArray(homeAny.chartRows) ? homeAny.chartRows : defaultChartRows).map((row) => ({
  ...row,
  href: row.href ? localizePath(locale, row.href) : undefined
}));

const introNotationItems = Array.isArray(introSection.notationItems)
  ? introSection.notationItems
  : [
      'a: one leg of the triangle.',
      'b: the other leg of the triangle.',
      'c: hypotenuse (always the longest side).',
      'A and B: acute angles, where A + B = 90°.',
      'h: altitude to the hypotenuse.',
      'p and q: hypotenuse segments created by the altitude.',
      'r and R: inradius and circumradius.'
    ];

const formulaSideItems = Array.isArray(formulaSection.sideItems)
  ? formulaSection.sideItems
  : [
      'Pythagorean relation: a² + b² = c².',
      'Missing leg from hypotenuse: b = √(c² - a²) or a = √(c² - b²).',
      'Special triangles: 45-45-90 and 30-60-90 shortcuts for fast side solving.'
    ];

const formulaAngleItems = Array.isArray(formulaSection.angleItems)
  ? formulaSection.angleItems
  : [
      'sin(A) = a / c, cos(A) = b / c, tan(A) = a / b.',
      'Inverse trig for angle finding: A = sin⁻¹(a/c), cos⁻¹(b/c), tan⁻¹(a/b).',
      'Complement relation for the second angle: B = 90° - A.'
    ];

const formulaGeometryItems = Array.isArray(formulaSection.geometryItems)
  ? formulaSection.geometryItems
  : [
      'Area = (a × b) / 2, Perimeter = a + b + c, Semiperimeter = (a + b + c) / 2.',
      'Altitude relation: h = (a × b) / c.',
      'Projection relations: p = a²/c, q = b²/c, and p + q = c.',
      'Radius relations: r = (a + b - c) / 2 and R = c / 2.'
    ];

const solveSteps = Array.isArray(solveSection.steps)
  ? solveSection.steps
  : [
      'Define the known values: list sides, angles, and units exactly as given.',
      'Choose the correct relation: side, angle, area, altitude, projection, or radius formula.',
      'Apply the formula: start from the symbolic equation before inserting values.',
      'Substitute the values: replace variables with your known numbers and units.',
      'Simplify carefully: compute in order and keep intermediate precision.',
      'Read the final answer: confirm unit and value format for your use case.',
      'Validate: check geometric conditions (c must be longest, A + B = 90°, units consistent).'
    ];

const resultItems = Array.isArray(solveSection.resultsItems)
  ? solveSection.resultsItems
  : [
      'Formula: the exact relation selected for your inputs.',
      'Substitution: your input values placed into that relation.',
      'Answer: solved numeric output in the proper unit format.',
      'Explanation: short clarity note for quicker understanding.'
    ];

const normalizeLinkItems = (value: unknown, fallback: LinkItem[]): LinkItem[] => {
  if (!Array.isArray(value)) return fallback;
  return value
    .map((item) => ({
      href: item?.href ?? '',
      label: item?.label ?? '',
      description: item?.description ?? ''
    }))
    .filter((item) => item.href && item.label);
};

const missingSidesItems = normalizeLinkItems(calculatorSection.missingSidesItems, [
  {
    href: '/right-triangle-side-calculator/',
    label: 'Right Triangle Side Calculator',
    description: 'to solve c, a, or b from Pythagorean relations.'
  },
  {
    href: '/right-triangle-side-from-angle-calculator/',
    label: 'Right Triangle Side from Angle Calculator',
    description: 'to find sides using trigonometric input.'
  },
  {
    href: '/special-right-triangle-calculator/',
    label: 'Special Right Triangle Calculator',
    description: 'for 45-45-90 and 30-60-90 shortcuts.'
  }
]);

const angleItems = normalizeLinkItems(calculatorSection.anglesItems, [
  {
    href: '/right-triangle-angle-calculator/',
    label: 'Right Triangle Angle Calculator',
    description: 'to find A or B with inverse trig.'
  },
  {
    href: '/right-triangle-trig-ratios-calculator/',
    label: 'Trigonometric Ratios Calculator',
    description: 'for sin, cos, tan, sec, csc, and cot.'
  }
]);

const measurementItems = normalizeLinkItems(calculatorSection.measurementsItems, [
  {
    href: '/right-triangle-area-calculator/',
    label: 'Right Triangle Area Calculator',
    description: 'for multiple area methods.'
  },
  {
    href: '/right-triangle-measurements-calculator/',
    label: 'Right Triangle Measurements Calculator',
    description: 'for perimeter and semiperimeter.'
  },
  {
    href: '/right-triangle-altitude-calculator/',
    label: 'Right Triangle Altitude Calculator',
    description: 'for altitude relations.'
  },
  {
    href: '/right-triangle-projection-calculator/',
    label: 'Right Triangle Projection Calculator',
    description: 'for segment and projection theorems.'
  },
  {
    href: '/right-triangle-radius-calculator/',
    label: 'Right Triangle Radius Calculator',
    description: 'for inradius and circumradius.'
  }
]);

const practicalItems = Array.isArray(validationSection.practicalItems)
  ? validationSection.practicalItems
  : [
      'Classroom and exam preparation with traceable formula-based steps.',
      'Site measurements for ramps, ladders, roof pitch, and wall offsets.',
      'Technical drafting where side-angle consistency must be validated quickly.',
      'Engineering and fabrication checks before final dimensions are approved.'
    ];

const checklistItems = Array.isArray(validationSection.checklistItems)
  ? validationSection.checklistItems
  : [
      'Keep all side inputs in consistent units before solving.',
      'Ensure hypotenuse c remains larger than both legs.',
      'Use the correct angle mode and trigonometric relation.',
      'Round only at the final answer, not during intermediate substitution.',
      'Cross-check with one related calculator when precision matters.'
    ];

const supportItems = normalizeLinkItems(validationSection.supportItems, [
  {
    href: '/faqs/',
    label: 'FAQs',
    description: 'for common calculation and usage questions.'
  },
  {
    href: '/library/',
    label: 'Library',
    description: 'for concept explanations and formula references.'
  },
  {
    href: '/practice/',
    label: 'Practice',
    description: 'for drill-based improvement.'
  },
  {
    href: '/about-us/',
    label: 'About Us',
    description: 'to learn about our mission and quality standards.'
  },
  {
    href: '/contact-us/',
    label: 'Contact Us',
    description: 'for direct support.'
  },
  {
    href: '/terms/',
    label: 'Terms',
    description: 'for policy details.'
  },
  {
    href: '/privacy/',
    label: 'Privacy',
    description: 'for privacy policy details.'
  }
]);

const localizedPath = localizePath(locale, '/');
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={localizedPath}
  mainClass="mx-auto w-full max-w-[1200px] px-4 pb-8 sm:px-6 lg:px-8"
>
  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 hidden h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30 sm:block"></div>
    <h1 class="mx-auto max-w-4xl text-3xl font-bold tracking-tight text-[#5b4000] sm:drop-shadow-sm sm:text-5xl lg:text-5xl" style="font-family: Georgia, 'Times New Roman', serif;">
      <span class="text-gradient-primary">{pick(home, 'heading', 'Right Triangle Solver')}</span>
    </h1>
    <p class="truncate mx-auto mt-4 hidden max-w-2xl px-4 text-sm leading-relaxed text-[#454744] sm:block sm:text-base lg:text-lg" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;">
      {pick(home, 'intro', 'Calculate hypotenuse, angles, area, and geometry instantly with our precision digital tool.')}
    </p>
    <p class="truncate mx-auto mt-3 max-w-xs text-xs tracking-[0.01em] text-on-surface-variant sm:hidden" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;">
      {pick(home, 'intro', 'Calculate hypotenuse, angles, area, and geometry instantly with our precision digital tool.')}
    </p>
  </header>

  <div class="relative w-full overflow-hidden">
    <div class="pointer-events-none absolute -left-10 -top-20 hidden h-64 w-64 rounded-full bg-primary/14 blur-3xl sm:block"></div>
    <div class="pointer-events-none absolute -bottom-20 right-8 hidden h-52 w-52 rounded-full bg-tertiary/14 blur-3xl sm:block"></div>
    <div class="relative w-full min-w-0">
      <RightTriangleTool
        locale={locale}
        shellClass="section-shell-lite"
        heading={pick(home, 'toolHeading', 'Right Triangle Solver')}
        labels={home.tool as any}
      />
    </div>
  </div>

  <div class="defer-render-mobile mx-auto mt-8 grid w-full max-w-4xl gap-6 sm:gap-8">
    <section class="section-shell prose-shell">
      <h2>{pick(introSection, 'title', 'What Is a Right Triangle?')}</h2>
      <p>{pick(introSection, 'paragraph1', 'A right triangle is a triangle that has one angle exactly equal to 90°. That fixed right angle creates a stable geometry model used in school math, engineering layouts, architecture drawings, surveying, navigation, and technical design.')}</p>
      <p>{pick(introSection, 'paragraph2', 'This homepage is structured to help you move in one clear flow: definition first, then formulas, then solving steps, then tool selection, and finally accuracy checks before you use the answer.')}</p>
      <h2>{pick(introSection, 'structureTitle', 'Right Triangle Definition and Structure')}</h2>
      <p>{pick(introSection, 'structureParagraph', 'In every right triangle, the side opposite the 90° angle is the hypotenuse. The other two sides are called legs. Most formulas and tools on this site use these standard symbols.')}</p>
      <h3>{pick(introSection, 'notationTitle', 'Standard notation used in the solver')}</h3>
      <ul>
        {introNotationItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>{pick(formulaSection, 'title', 'Core Right Triangle Formulas You Need First')}</h2>
      <p>{pick(formulaSection, 'intro', 'Before solving any question, identify what values are known and choose the formula family that matches that input type.')}</p>
      <h3>{pick(formulaSection, 'sideTitle', 'Side formulas')}</h3>
      <ul>
        {formulaSideItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>
      <h3>{pick(formulaSection, 'angleTitle', 'Angle and trigonometric formulas')}</h3>
      <ul>
        {formulaAngleItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>
      <h3>{pick(formulaSection, 'geometryTitle', 'Measurement and geometry formulas')}</h3>
      <ul>
        {formulaGeometryItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>{pick(solveSection, 'title', 'How To Solve Any Right Triangle (Clear Process)')}</h2>
      <ol>
        {solveSteps.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ol>

      <h2>{pick(solveSection, 'resultsTitle', 'How This Solver Presents Step-by-Step Results')}</h2>
      <p>{pick(solveSection, 'resultsIntro', 'Every calculator mode is designed to show a useful solution flow, not only a final number. You see the formula, then value substitution, then computed answer, followed by a short explanation line so each step is easier to verify and reuse.')}</p>
      <ul>
        {resultItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>{pick(calculatorSection, 'title', 'Choose the Right Calculator by Goal')}</h2>
      <h3>{pick(calculatorSection, 'missingSidesTitle', 'For missing sides')}</h3>
      <ul>
        {missingSidesItems.map((item) => (
          <li>
            <a href={localizePath(locale, item.href)}>{item.label}</a> {item.description}
          </li>
        ))}
      </ul>
      <h3>{pick(calculatorSection, 'anglesTitle', 'For angles and trig ratios')}</h3>
      <ul>
        {angleItems.map((item) => (
          <li>
            <a href={localizePath(locale, item.href)}>{item.label}</a> {item.description}
          </li>
        ))}
      </ul>
      <h3>{pick(calculatorSection, 'measurementsTitle', 'For measurements and geometric properties')}</h3>
      <ul>
        {measurementItems.map((item) => (
          <li>
            <a href={localizePath(locale, item.href)}>{item.label}</a> {item.description}
          </li>
        ))}
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>{pick(validationSection, 'practicalTitle', 'Practical Use Cases')}</h2>
      <ul>
        {practicalItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>

      <h2>{pick(validationSection, 'checklistTitle', 'Accuracy Checklist Before You Finalize')}</h2>
      <ul>
        {checklistItems.map((item: string) => (
          <li set:html={formatListItem(item)} />
        ))}
      </ul>

      <h2>{pick(validationSection, 'supportTitle', 'Helpful Support Pages')}</h2>
      <ul>
        {supportItems.map((item) => (
          <li>
            <a href={localizePath(locale, item.href)}>{item.label}</a> {item.description}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="defer-render-mobile mt-8">
    <HowItWorks heading={pick(home, 'howHeading', 'How Right Triangle Solver works')}>
      <p slot="intro" class="mt-3 max-w-2xl text-sm text-on-surface-variant">
        {pick(home, 'howIntro', 'From input to proof-ready output in three clean steps.')}
      </p>
      <Fragment slot="steps">
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">input</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step1Title', '1. Enter known values')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step1Desc', 'Provide any valid right-triangle inputs and keep units consistent.')}</p>
        </article>
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">bolt</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step2Title', '2. Solve instantly')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step2Desc', 'The solver applies Pythagorean and trigonometric relations in real time.')}</p>
        </article>
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">insights</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step3Title', '3. Validate the geometry')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step3Desc', 'Use live visualization, ratios, and derived metrics to verify your answer.')}</p>
        </article>
      </Fragment>
    </HowItWorks>
  </div>

  <div class="defer-render-mobile mt-8">
    <ChartTableSection
      heading={pick(home, 'chartHeading', 'Reference Values')}
      subHeading={pick(home, 'chartSubHeading', 'Compare common right-triangle families and their hypotenuse values.')}
      label1={pick(home, 'chartLabel1', 'Triangle')}
      label2={pick(home, 'chartLabel2', 'Hypotenuse')}
      rows={chartRows}
    />
    <div class="mx-auto mt-4 w-full max-w-4xl">
      <a href={localizePath(locale, '/pythagorean-triples-calculator/')} class="text-sm font-medium text-primary transition-colors hover:text-tertiary">
        View all Pythagorean triples
      </a>
    </div>
  </div>

  <div class="defer-render-mobile mt-8">
    <CalculatorCatalog
      locale={locale}
      heading={pick(home, 'catalogHeading', 'Premium Calculator Collection')}
      uiTools={pick(home, 'catalogTools', 'Precision Tools')}
    />
  </div>

  <div class="defer-render-mobile mt-8">
    <Faq heading={pick(home, 'faqHeading', 'Frequently Asked Questions')} items={bundle.faq.slice(0, 6)} />
    <div class="mt-6 flex justify-center">
      <a href={localizePath(locale, '/faqs/')} class="btn-secondary flex items-center gap-2">
        {pick(home, 'viewAllFaqs', 'View All Detailed FAQs')}
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>

  <HomeSchema
    locale={locale}
    title={pageTitle}
    description={pageDescription}
    path={localizedPath}
    faqs={bundle.faq.slice(0, 6)}
  />
</BaseLayout>
