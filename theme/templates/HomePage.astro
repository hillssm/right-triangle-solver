---
import CalculatorCatalog from 'theme/components/CalculatorCatalog.astro';
import ChartTableSection from 'theme/components/ChartTableSection.astro';
import Faq from 'theme/components/Faq.astro';
import HomeSchema from 'theme/components/HomeSchema.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import RightTriangleTool from 'theme/components/RightTriangleTool.astro';
import { localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import type { Locale } from 'theme/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const home = (content.home as Record<string, string>) ?? {};
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = pick(home, 'title', `${siteTitle} | Geometry`);
const pageDescription = pick(
  home,
  'description',
  'Solve right triangles quickly with formulas and examples.'
);

const localizedPath = localizePath(locale, '/');
const chartRows = [
  { label: '3-4-5 triangle', value: '5.000', ratio: 5 },
  { label: '5-12-13 triangle', value: '13.000', ratio: 13 },
  { label: '8-15-17 triangle', value: '17.000', ratio: 17 },
  { label: '9-12-15 triangle', value: '15.000', ratio: 15 }
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={localizedPath}
  mainClass="mx-auto w-full max-w-[1200px] px-4 pb-8 sm:px-6 lg:px-8"
>
  <HomeSchema
    slot="head"
    locale={locale}
    title={pageTitle}
    description={pageDescription}
    path={localizedPath}
    faqs={bundle.faq}
  />

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30"></div>
    <h1 class="mx-auto max-w-4xl font-headline text-3xl font-bold tracking-tight text-[#5b4000] drop-shadow-sm sm:text-5xl lg:text-5xl">
      <span class="text-gradient-primary">{pick(home, 'heading', 'Right Triangle Solver')}</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-sm leading-relaxed text-[#454744] sm:text-base lg:text-lg">
      {pick(home, 'intro', 'Calculate hypotenuse, angles, area, and geometry instantly with our precision digital tool.')}
    </p>
  </header>

  <section class="section-shell relative w-full overflow-hidden">
    <div class="pointer-events-none absolute -left-10 -top-20 h-64 w-64 rounded-full bg-primary/14 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 right-8 h-52 w-52 rounded-full bg-tertiary/14 blur-3xl"></div>
    <div class="relative w-full min-w-0">
      <RightTriangleTool
        locale={locale}
        heading={pick(home, 'toolHeading', 'Right Triangle Solver')}
        labels={home.tool as any}
      />
    </div>
  </section>

  <div class="mx-auto mt-8 grid w-full max-w-4xl gap-6 sm:gap-8">
    <section class="section-shell prose-shell">
      <h2>What Is a Right Triangle?</h2>
      <p>
        A right triangle is a triangle that has one angle exactly equal to 90&deg;. That fixed right angle creates a
        stable geometry model used in school math, engineering layouts, architecture drawings, surveying, navigation,
        and technical design.
      </p>
      <p>
        This homepage is structured to help you move in one clear flow: definition first, then formulas, then solving
        steps, then tool selection, and finally accuracy checks before you use the answer.
      </p>

      <h2>Right Triangle Definition and Structure</h2>
      <p>
        In every right triangle, the side opposite the 90&deg; angle is the <strong>hypotenuse</strong>. The other two
        sides are called <strong>legs</strong>. Most formulas and tools on this site use these standard symbols.
      </p>
      <h3>Standard notation used in the solver</h3>
      <ul>
        <li><strong>a</strong>: one leg of the triangle.</li>
        <li><strong>b</strong>: the other leg of the triangle.</li>
        <li><strong>c</strong>: hypotenuse (always the longest side).</li>
        <li><strong>A</strong> and <strong>B</strong>: acute angles, where A + B = 90&deg;.</li>
        <li><strong>h</strong>: altitude to the hypotenuse.</li>
        <li><strong>p</strong> and <strong>q</strong>: hypotenuse segments created by the altitude.</li>
        <li><strong>r</strong> and <strong>R</strong>: inradius and circumradius.</li>
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>Core Right Triangle Formulas You Need First</h2>
      <p>
        Before solving any question, identify what values are known and choose the formula family that matches that
        input type.
      </p>
      <h3>Side formulas</h3>
      <ul>
        <li>Pythagorean relation: a<sup>2</sup> + b<sup>2</sup> = c<sup>2</sup>.</li>
        <li>Missing leg from hypotenuse: b = &radic;(c<sup>2</sup> - a<sup>2</sup>) or a = &radic;(c<sup>2</sup> - b<sup>2</sup>).</li>
        <li>Special triangles: 45-45-90 and 30-60-90 shortcuts for fast side solving.</li>
      </ul>
      <h3>Angle and trigonometric formulas</h3>
      <ul>
        <li>sin(A) = a / c, cos(A) = b / c, tan(A) = a / b.</li>
        <li>Inverse trig for angle finding: A = sin<sup>-1</sup>(a/c), cos<sup>-1</sup>(b/c), tan<sup>-1</sup>(a/b).</li>
        <li>Complement relation for the second angle: B = 90&deg; - A.</li>
      </ul>
      <h3>Measurement and geometry formulas</h3>
      <ul>
        <li>Area = (a &times; b) / 2, Perimeter = a + b + c, Semiperimeter = (a + b + c) / 2.</li>
        <li>Altitude relation: h = (a &times; b) / c.</li>
        <li>Projection relations: p = a<sup>2</sup>/c, q = b<sup>2</sup>/c, and p + q = c.</li>
        <li>Radius relations: r = (a + b - c) / 2 and R = c / 2.</li>
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>How To Solve Any Right Triangle (Clear Process)</h2>
      <ol>
        <li><strong>Define the known values:</strong> list sides, angles, and units exactly as given.</li>
        <li><strong>Choose the correct relation:</strong> side, angle, area, altitude, projection, or radius formula.</li>
        <li><strong>Apply the formula:</strong> start from the symbolic equation before inserting values.</li>
        <li><strong>Substitute the values:</strong> replace variables with your known numbers and units.</li>
        <li><strong>Simplify carefully:</strong> compute in order and keep intermediate precision.</li>
        <li><strong>Read the final answer:</strong> confirm unit and value format for your use case.</li>
        <li><strong>Validate:</strong> check geometric conditions (c must be longest, A + B = 90&deg;, units consistent).</li>
      </ol>

      <h2>How This Solver Presents Step-by-Step Results</h2>
      <p>
        Every calculator mode is designed to show a useful solution flow, not only a final number. You see the formula,
        then value substitution, then computed answer, followed by a short explanation line so each step is easier to
        verify and reuse.
      </p>
      <ul>
        <li><strong>Formula:</strong> the exact relation selected for your inputs.</li>
        <li><strong>Substitution:</strong> your input values placed into that relation.</li>
        <li><strong>Answer:</strong> solved numeric output in the proper unit format.</li>
        <li><strong>Explanation:</strong> short clarity note for quicker understanding.</li>
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>Choose the Right Calculator by Goal</h2>
      <h3>For missing sides</h3>
      <ul>
        <li><a href={localizePath(locale, '/right-triangle-side-calculator/')}>Right Triangle Side Calculator</a> to solve c, a, or b from Pythagorean relations.</li>
        <li><a href={localizePath(locale, '/right-triangle-side-from-angle-calculator/')}>Right Triangle Side from Angle Calculator</a> to find sides using trigonometric input.</li>
        <li><a href={localizePath(locale, '/special-right-triangle-calculator/')}>Special Right Triangle Calculator</a> for 45-45-90 and 30-60-90 shortcuts.</li>
      </ul>
      <h3>For angles and trig ratios</h3>
      <ul>
        <li><a href={localizePath(locale, '/right-triangle-angle-calculator/')}>Right Triangle Angle Calculator</a> to find A or B with inverse trig.</li>
        <li><a href={localizePath(locale, '/right-triangle-trig-ratios-calculator/')}>Trigonometric Ratios Calculator</a> for sin, cos, tan, sec, csc, and cot.</li>
      </ul>
      <h3>For measurements and geometric properties</h3>
      <ul>
        <li><a href={localizePath(locale, '/right-triangle-area-calculator/')}>Right Triangle Area Calculator</a> for multiple area methods.</li>
        <li><a href={localizePath(locale, '/right-triangle-measurements-calculator/')}>Right Triangle Measurements Calculator</a> for perimeter and semiperimeter.</li>
        <li><a href={localizePath(locale, '/right-triangle-altitude-calculator/')}>Right Triangle Altitude Calculator</a> for altitude relations.</li>
        <li><a href={localizePath(locale, '/right-triangle-projection-calculator/')}>Right Triangle Projection Calculator</a> for segment and projection theorems.</li>
        <li><a href={localizePath(locale, '/right-triangle-radius-calculator/')}>Right Triangle Radius Calculator</a> for inradius and circumradius.</li>
      </ul>
    </section>

    <section class="section-shell prose-shell">
      <h2>Practical Use Cases</h2>
      <ul>
        <li>Classroom and exam preparation with traceable formula-based steps.</li>
        <li>Site measurements for ramps, ladders, roof pitch, and wall offsets.</li>
        <li>Technical drafting where side-angle consistency must be validated quickly.</li>
        <li>Engineering and fabrication checks before final dimensions are approved.</li>
      </ul>

      <h2>Accuracy Checklist Before You Finalize</h2>
      <ul>
        <li>Keep all side inputs in consistent units before solving.</li>
        <li>Ensure hypotenuse c remains larger than both legs.</li>
        <li>Use the correct angle mode and trigonometric relation.</li>
        <li>Round only at the final answer, not during intermediate substitution.</li>
        <li>Cross-check with one related calculator when precision matters.</li>
      </ul>

      <h2>Helpful Support Pages</h2>
      <ul>
        <li><a href={localizePath(locale, '/faqs/')}>FAQs</a> for common calculation and usage questions.</li>
        <li><a href={localizePath(locale, '/library/')}>Library</a> for concept explanations and formula references.</li>
        <li><a href={localizePath(locale, '/practice/')}>Practice</a> for drill-based improvement.</li>
        <li><a href={localizePath(locale, '/about-us/')}>About Us</a> and <a href={localizePath(locale, '/contact-us/')}>Contact Us</a> for support.</li>
        <li><a href={localizePath(locale, '/terms/')}>Terms</a> and <a href={localizePath(locale, '/privacy/')}>Privacy</a> for policy details.</li>
      </ul>
    </section>
  </div>

  <div class="mt-8">
    <HowItWorks heading={pick(home, 'howHeading', 'How Right Triangle Solver works')}>
      <p slot="intro" class="mt-3 max-w-2xl text-sm text-on-surface-variant">
        {pick(home, 'howIntro', 'From input to proof-ready output in three clean steps.')}
      </p>
      <Fragment slot="steps">
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">input</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step1Title', '1. Enter known values')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step1Desc', 'Provide any valid right-triangle inputs and keep units consistent.')}</p>
        </article>
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">bolt</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step2Title', '2. Solve instantly')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step2Desc', 'The solver applies Pythagorean and trigonometric relations in real time.')}</p>
        </article>
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">insights</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step3Title', '3. Validate the geometry')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step3Desc', 'Use live visualization, ratios, and derived metrics to verify your answer.')}</p>
        </article>
      </Fragment>
    </HowItWorks>
  </div>

  <div class="mt-8">
    <ChartTableSection
      heading={pick(home, 'chartHeading', 'Reference Values')}
      subHeading={pick(home, 'chartSubHeading', 'Compare common right-triangle families and their hypotenuse values.')}
      label1={pick(home, 'chartLabel1', 'Triangle')}
      label2={pick(home, 'chartLabel2', 'Hypotenuse')}
      rows={chartRows}
    />
  </div>

  <div class="mt-8">
    <CalculatorCatalog
      locale={locale}
      heading={pick(home, 'catalogHeading', 'Premium Calculator Collection')}
      uiTools={pick(home, 'catalogTools', 'Precision Tools')}
    />
  </div>

  <div class="mt-8">
    <Faq heading={pick(home, 'faqHeading', 'Frequently Asked Questions')} items={bundle.faq.slice(0, 6)} />
    <div class="mt-6 flex justify-center">
      <a href={localizePath(locale, '/faqs/')} class="btn-secondary flex items-center gap-2">
        {pick(home, 'viewAllFaqs', 'View All Detailed FAQs')}
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</BaseLayout>

