---
import CalculatorCatalog from 'theme/components/CalculatorCatalog.astro';
import ChartTableSection from 'theme/components/ChartTableSection.astro';
import Faq from 'theme/components/Faq.astro';
import HomeSchema from 'theme/components/HomeSchema.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import RightTriangleTool from 'theme/components/RightTriangleTool.astro';
import { RIGHT_TRIANGLE_GROUPED_PAGES } from 'src/data/rightTriangleGroupedPages';
import { localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import type { Locale } from 'theme/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, unknown>;
const home = (content.home as Record<string, string>) ?? {};
const siteContent = (content.site as Record<string, string>) ?? {};

const siteTitle = pick(siteContent, 'title', 'Right Triangle Solver');
const pageTitle = pick(home, 'title', `${siteTitle} | Geometry`);
const pageDescription = pick(
  home,
  'description',
  'Solve right triangles quickly with formulas and examples.'
);

const localizedPath = localizePath(locale, '/');
const chartRows = [
  { label: '3-4-5 triangle', value: '5.000', ratio: 5 },
  { label: '5-12-13 triangle', value: '13.000', ratio: 13 },
  { label: '8-15-17 triangle', value: '17.000', ratio: 17 },
  { label: '9-12-15 triangle', value: '15.000', ratio: 15 }
];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={localizedPath}
  mainClass="mx-auto w-full max-w-[1200px] px-4 pb-8 sm:px-6 lg:px-8"
>
  <HomeSchema
    slot="head"
    locale={locale}
    title={pageTitle}
    description={pageDescription}
    path={localizedPath}
    faqs={bundle.faq}
  />

  <header class="relative flex flex-col items-center justify-center py-10 text-center sm:py-16">
    <div class="pointer-events-none absolute -top-12 h-64 w-full bg-gradient-to-b from-[#1a1c19]/5 to-transparent opacity-30"></div>
    <h1 class="mx-auto max-w-4xl font-headline text-3xl font-bold tracking-tight text-[#5b4000] drop-shadow-sm sm:text-5xl lg:text-5xl">
      <span class="text-gradient-primary">{pick(home, 'heading', 'Right Triangle Solver')}</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-sm leading-relaxed text-[#454744] sm:text-base lg:text-lg">
      {pick(home, 'intro', 'Calculate hypotenuse, angles, area, and geometry instantly with our precision digital tool.')}
    </p>
  </header>

  <section class="section-shell relative w-full overflow-hidden">
    <div class="pointer-events-none absolute -left-10 -top-20 h-64 w-64 rounded-full bg-primary/14 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 right-8 h-52 w-52 rounded-full bg-tertiary/14 blur-3xl"></div>
    <div class="relative w-full min-w-0">
      <RightTriangleTool
        locale={locale}
        heading={pick(home, 'toolHeading', 'Right Triangle Solver')}
        labels={home.tool as any}
      />
    </div>
  </section>

  <section class="mt-8 section-shell prose-shell">
    <h2>Right Triangle Calculator for Students, Teachers, and Professionals</h2>
    <p>
      Right Triangle Solver is built for real use cases where speed and accuracy both matter. You can solve missing
      sides, angles, trigonometric ratios, area, altitude, projections, and circle relations in one connected
      ecosystem of calculators.
    </p>

    <h2>Right Angle Triangle Definition</h2>
    <p>
      A right angle triangle (also called a right triangle or right-angled triangle) is a triangle with one angle
      exactly equal to 90 degrees. The side opposite the 90-degree angle is the hypotenuse, and it is always the
      longest side. The other two sides are called legs.
    </p>
    <ul>
      <li>The two acute angles always add up to 90 degrees.</li>
      <li>The hypotenuse is always longer than each leg.</li>
      <li>The Pythagorean relation is always true: a^2 + b^2 = c^2.</li>
    </ul>

    <h2>Right Triangle Explained with a Simple Example</h2>
    <p>
      Consider a triangle with legs 3 and 4 units. Using the Pythagorean theorem, the hypotenuse is 5 units, so this
      is a classic 3-4-5 right triangle. Once sides are known, you can also find area, perimeter, and both acute
      angles from the same set of values.
    </p>
    <ol>
      <li>Identify known values (for example, two sides or one side and one acute angle).</li>
      <li>Use the matching calculator mode to find the missing side or angle.</li>
      <li>Verify with area, altitude, or trig-ratio calculators for stronger accuracy.</li>
    </ol>

    <h2>Step-by-Step Solved Question (Formula to Final Answer)</h2>
    <p>
      Here is a complete right triangle solving process using formulas, substitution of values, and final numeric
      answers.
    </p>

    <h3>Question</h3>
    <p>
      A ladder touches a wall, making a 60-degree angle with the ground. The horizontal distance from the wall is
      8 m. Find:
    </p>
    <ul>
      <li>The ladder length (hypotenuse)</li>
      <li>The height reached on the wall (opposite side)</li>
    </ul>

    <h3>Step 1: Understand the Triangle</h3>
    <ul>
      <li>Adjacent side (base) = 8 m</li>
      <li>Angle with ground = 60 degrees</li>
      <li>Hypotenuse = ladder length</li>
      <li>Opposite side = height on wall</li>
    </ul>

    <h3>Step 2: Use Trigonometric Formulas</h3>
    <p>For ladder length:</p>
    <p><code>cos(theta) = adjacent / hypotenuse</code></p>
    <p>For wall height:</p>
    <p><code>tan(theta) = opposite / adjacent</code></p>

    <h3>Step 3: Find the Ladder Length</h3>
    <p><code>cos(60) = 8 / ladder</code></p>
    <p><code>1/2 = 8 / ladder</code></p>
    <p><code>ladder = 16 m</code></p>

    <h3>Step 4: Find the Height on the Wall</h3>
    <p><code>tan(60) = height / 8</code></p>
    <p><code>sqrt(3) = height / 8</code></p>
    <p><code>height = 8 * sqrt(3) = 13.86 m (approx)</code></p>

    <h3>Final Answer</h3>
    <ul>
      <li>Ladder length = 16 m</li>
      <li>Height on wall = 13.86 m (approx)</li>
    </ul>

    <h2>Complete Right Triangle Calculator Directory by Goal</h2>
    <ul>
      {RIGHT_TRIANGLE_GROUPED_PAGES.map((page) => (
        <li>
          <a href={localizePath(locale, page.url)}>{page.h1}</a>: {page.intent}
        </li>
      ))}
    </ul>

    <h2>Recommended Right Triangle Solving Workflow</h2>
    <ol>
      <li>Start with the calculator matching your known values, such as side-based or angle-based inputs.</li>
      <li>Use grouped tool modes to avoid jumping across thin pages and keep solving in one focused workflow.</li>
      <li>Verify with one related calculator (for example, side -> angle -> area) before finalizing results.</li>
      <li>Apply final rounding only at the end for cleaner, more reliable geometry outputs.</li>
    </ol>

    <h2>Common Input Mistakes and How to Avoid Them</h2>
    <ul>
      <li>Mixing units across sides and angles in the same calculation flow.</li>
      <li>Using a formula mode that does not match what is actually known.</li>
      <li>Entering angle values in the wrong format for trig-based calculators.</li>
      <li>Skipping validity checks such as hypotenuse being the longest side.</li>
    </ul>

    <h2>Why Use a Dedicated Right Triangle Solver Website</h2>
    <p>
      This platform is structured around user intent, not isolated formulas. That means you can complete a full
      right triangle problem with fewer steps, better context, and stronger result verification through internal links.
    </p>

    <h2>Useful Pages Beyond the Calculators</h2>
    <ul>
      <li><a href={localizePath(locale, '/faqs/')}>FAQs</a> for quick answers and troubleshooting.</li>
      <li><a href={localizePath(locale, '/library/')}>Library</a> for formula references and concept review.</li>
      <li><a href={localizePath(locale, '/practice/')}>Practice</a> to train speed and accuracy.</li>
      <li><a href={localizePath(locale, '/about-us/')}>About Us</a> and <a href={localizePath(locale, '/contact-us/')}>Contact Us</a> for support and trust signals.</li>
      <li><a href={localizePath(locale, '/terms/')}>Terms</a> and <a href={localizePath(locale, '/privacy/')}>Privacy</a> for policy transparency.</li>
    </ul>

    <h2>How to Get More Accurate Results Every Time</h2>
    <p>
      Use consistent units, choose the mode that matches your known values, and cross-check with a second
      related calculator when possible. This quickly catches input mistakes and improves confidence in the result.
    </p>
    <ul>
      <li>Start with side or angle modes to establish a reliable base triangle.</li>
      <li>Use area, altitude, projection, and radius pages for derived geometry checks.</li>
      <li>Keep rounding to the final step so intermediate calculations stay stable.</li>
    </ul>
  </section>

  <div class="mt-8">
    <HowItWorks heading={pick(home, 'howHeading', 'How Right Triangle Solver works')}>
      <p slot="intro" class="mt-3 max-w-2xl text-sm text-on-surface-variant">
        {pick(home, 'howIntro', 'From input to proof-ready output in three clean steps.')}
      </p>
      <Fragment slot="steps">
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">input</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step1Title', '1. Enter known values')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step1Desc', 'Provide any valid right-triangle inputs and keep units consistent.')}</p>
        </article>
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">bolt</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step2Title', '2. Solve instantly')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step2Desc', 'The solver applies Pythagorean and trigonometric relations in real time.')}</p>
        </article>
        <article class="surface-card group flex flex-col gap-4 border-outline-variant/30">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <span class="material-symbols-outlined text-xl">insights</span>
          </div>
          <h3 class="text-base font-semibold text-on-surface">{pick(home, 'step3Title', '3. Validate the geometry')}</h3>
          <p class="text-sm leading-relaxed text-on-surface-variant">{pick(home, 'step3Desc', 'Use live visualization, ratios, and derived metrics to verify your answer.')}</p>
        </article>
      </Fragment>
    </HowItWorks>
  </div>

  <div class="mt-8">
    <ChartTableSection
      heading={pick(home, 'chartHeading', 'Reference Values')}
      subHeading={pick(home, 'chartSubHeading', 'Compare common right-triangle families and their hypotenuse values.')}
      label1={pick(home, 'chartLabel1', 'Triangle')}
      label2={pick(home, 'chartLabel2', 'Hypotenuse')}
      rows={chartRows}
    />
  </div>

  <div class="mt-8">
    <CalculatorCatalog
      locale={locale}
      heading={pick(home, 'catalogHeading', 'Premium Calculator Collection')}
      uiTools={pick(home, 'catalogTools', 'Precision Tools')}
    />
  </div>

  <div class="mt-8">
    <Faq heading={pick(home, 'faqHeading', 'Frequently Asked Questions')} items={bundle.faq.slice(0, 6)} />
    <div class="mt-6 flex justify-center">
      <a href={localizePath(locale, '/faqs/')} class="btn-secondary flex items-center gap-2">
        {pick(home, 'viewAllFaqs', 'View All Detailed FAQs')}
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</BaseLayout>
