---
import type { Locale } from 'theme/i18n/locales';
import { localizePath } from 'theme/i18n/locales';
import { getTranslations, pick } from 'theme/i18n/translations';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import { site } from 'theme/utils/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const bundle = getTranslations(locale);
const content = bundle.content as Record<string, any>;
const privacy = (content.privacy as Record<string, any>) ?? {};
const sections = (privacy.sections as Record<string, any>) ?? {};
const updatedLabel = pick(privacy, 'updatedLabel', 'Last updated: April 12, 2026');
const contactEmail = site.contactEmail || 'hello@righttrianglesolver.app';

const summaryItems = Array.isArray(privacy.quickSummaryItems)
  ? privacy.quickSummaryItems
  : [
      'You can use most of the site without creating an account.',
      'Calculator usage is generally anonymous and intended for educational use.',
      'If you contact us, we process the details you submit so we can respond.',
      'Basic technical data may be collected by hosting and security systems.',
      'You can contact us any time with privacy questions.'
    ];

const defaultToc = {
  scope: '1. Scope',
  collect: '2. Information We Collect',
  use: '3. How We Use Information',
  cookies: '4. Cookies and Similar Technologies',
  sharing: '5. Sharing and Third Parties',
  retention: '6. Data Retention',
  choices: '7. Your Choices',
  security: '8. Security',
  children: "9. Children's Privacy",
  changes: '10. Policy Changes',
  contact: '11. Contact'
};

const toc = (privacy.toc as Record<string, string>) ?? {};
const pageTitle = pick(privacy, 'title', 'Privacy');
const pageDescription = pick(privacy, 'description', 'Privacy policy');
const canonicalPath = localizePath(locale, '/privacy/');

const scopeSection = (sections.scope as Record<string, any>) ?? {};
const collectSection = (sections.collect as Record<string, any>) ?? {};
const useSection = (sections.use as Record<string, any>) ?? {};
const cookiesSection = (sections.cookies as Record<string, any>) ?? {};
const sharingSection = (sections.sharing as Record<string, any>) ?? {};
const retentionSection = (sections.retention as Record<string, any>) ?? {};
const choicesSection = (sections.choices as Record<string, any>) ?? {};
const securitySection = (sections.security as Record<string, any>) ?? {};
const childrenSection = (sections.children as Record<string, any>) ?? {};
const changesSection = (sections.changes as Record<string, any>) ?? {};
const contactSection = (sections.contact as Record<string, any>) ?? {};

const collectDirectItems = Array.isArray(collectSection.directItems)
  ? collectSection.directItems
  : [
      'Name, email address, and message details when you use the contact form.',
      'Any information you include voluntarily in support requests or feedback.'
    ];

const collectTechnicalItems = Array.isArray(collectSection.technicalItems)
  ? collectSection.technicalItems
  : [
      'IP address, browser type, device information, referral page, and timestamps.',
      'Diagnostic or security logs generated by hosting infrastructure.'
    ];

const useItems = Array.isArray(useSection.items)
  ? useSection.items
  : [
      'To provide and maintain the calculator and related educational pages.',
      'To respond to contact requests and improve support quality.',
      'To detect abuse, protect site integrity, and maintain security.',
      'To improve usability, performance, and content clarity.',
      'To comply with legal obligations when required.'
    ];

const choicesItems = Array.isArray(choicesSection.items)
  ? choicesSection.items
  : [
      'You may choose not to submit personal details through the contact form.',
      'You may request correction or deletion of contact-form data, subject to legal obligations.',
      'You can control cookies through browser settings.'
    ];
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
>
  <header class="mx-auto mb-10 w-full max-w-4xl text-center">
    <p class="font-label text-xs uppercase tracking-widest text-primary">
      {pick(privacy, 'badge', 'Compliance')}
    </p>
    <h1 class="mt-3 text-3xl font-headline text-on-surface sm:text-4xl lg:text-5xl">
      {pick(privacy, 'heading', 'Privacy Policy')}
    </h1>
    <p class="mt-2 text-xs uppercase tracking-wide text-outline">{updatedLabel}</p>
    <p class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-on-surface-variant">
      {pick(
        privacy,
        'intro',
        'This Privacy Policy explains what information Right Triangle Solver may collect, how it is used, and the choices you have.'
      )}
    </p>
  </header>

  <section class="mx-auto mb-6 w-full max-w-4xl section-shell">
    <h2 class="text-xl font-headline text-on-surface">
      {pick(privacy, 'quickSummaryTitle', 'Quick Summary')}
    </h2>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-on-surface-variant">
      {summaryItems.map((item: string) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="mx-auto mb-6 w-full max-w-4xl section-shell">
    <h2 class="text-xl font-headline text-on-surface">
      {pick(privacy, 'contentsTitle', 'Contents')}
    </h2>
    <nav aria-label="Privacy sections" class="mt-4 grid gap-2 sm:grid-cols-2">
      <a href="#scope" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'scope', defaultToc.scope)}
      </a>
      <a href="#collect" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'collect', defaultToc.collect)}
      </a>
      <a href="#use" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'use', defaultToc.use)}
      </a>
      <a href="#cookies" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'cookies', defaultToc.cookies)}
      </a>
      <a href="#sharing" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'sharing', defaultToc.sharing)}
      </a>
      <a href="#retention" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'retention', defaultToc.retention)}
      </a>
      <a href="#choices" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'choices', defaultToc.choices)}
      </a>
      <a href="#security" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'security', defaultToc.security)}
      </a>
      <a href="#children" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'children', defaultToc.children)}
      </a>
      <a href="#changes" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'changes', defaultToc.changes)}
      </a>
      <a href="#contact" class="text-sm text-primary hover:text-primary-fixed">
        {pick(toc, 'contact', defaultToc.contact)}
      </a>
    </nav>
  </section>

  <article class="mx-auto w-full max-w-4xl section-shell prose-shell">
    <div class="space-y-8 text-on-surface-variant">
      <section id="scope">
        <h2>{pick(scopeSection, 'title', '1. Scope')}</h2>
        <p>
          {pick(
            scopeSection,
            'paragraph1',
            'This policy applies to Right Triangle Solver websites, tools, and public pages that link to this Privacy Policy. It describes how information is handled when you browse, calculate, or contact us.'
          )}
        </p>
      </section>

      <section id="collect">
        <h2>{pick(collectSection, 'title', '2. Information We Collect')}</h2>
        <h3>
          {pick(
            collectSection,
            'directTitle',
            'Information you provide directly'
          )}
        </h3>
        <ul>
          {collectDirectItems.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>

        <h3>
          {pick(
            collectSection,
            'technicalTitle',
            'Technical information collected automatically'
          )}
        </h3>
        <ul>
          {collectTechnicalItems.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>

        <h3>
          {pick(
            collectSection,
            'usageTitle',
            'Calculator usage data'
          )}
        </h3>
        <p>
          {pick(
            collectSection,
            'usageParagraph',
            'Calculator interactions are primarily designed for immediate problem solving. Input and output values are generally processed within the site experience and are not intended to identify you personally.'
          )}
        </p>
      </section>

      <section id="use">
        <h2>{pick(useSection, 'title', '3. How We Use Information')}</h2>
        <ul>
          {useItems.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section id="cookies">
        <h2>{pick(cookiesSection, 'title', '4. Cookies and Similar Technologies')}</h2>
        <p>
          {pick(
            cookiesSection,
            'paragraph1',
            'The site may use essential cookies or local storage for functionality, security, and performance. You can manage browser settings to block or remove cookies, but some features may work less effectively.'
          )}
        </p>
      </section>

      <section id="sharing">
        <h2>{pick(sharingSection, 'title', '5. Sharing and Third Parties')}</h2>
        <p>
          {pick(
            sharingSection,
            'paragraph1',
            'We do not sell your personal information. We may share limited data with service providers who help operate the site, such as hosting or contact-form infrastructure, only as needed to deliver the service.'
          )}
        </p>
        <p>
          {pick(
            sharingSection,
            'paragraph2',
            'If you submit a form, your message may be processed by configured form-delivery providers to route your request to our support inbox.'
          )}
        </p>
      </section>

      <section id="retention">
        <h2>{pick(retentionSection, 'title', '6. Data Retention')}</h2>
        <p>
          {pick(
            retentionSection,
            'paragraph1',
            'We retain information only for as long as reasonably necessary to operate the service, respond to requests, resolve disputes, enforce agreements, and meet legal requirements.'
          )}
        </p>
      </section>

      <section id="choices">
        <h2>{pick(choicesSection, 'title', '7. Your Choices')}</h2>
        <ul>
          {choicesItems.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section id="security">
        <h2>{pick(securitySection, 'title', '8. Security')}</h2>
        <p>
          {pick(
            securitySection,
            'paragraph1',
            'We use reasonable technical and organizational measures to protect information from unauthorized access, loss, misuse, or alteration. No internet transmission or storage system is completely secure, so absolute security cannot be guaranteed.'
          )}
        </p>
      </section>

      <section id="children">
        <h2>{pick(childrenSection, 'title', "9. Children's Privacy")}</h2>
        <p>
          {pick(
            childrenSection,
            'paragraph1',
            'The service is designed for educational audiences, but it is not directed to children under 13 to submit personal information. If you believe a child has provided personal data through the site, contact us and we will review and remove it when appropriate.'
          )}
        </p>
      </section>

      <section id="changes">
        <h2>{pick(changesSection, 'title', '10. Policy Changes')}</h2>
        <p>
          {pick(
            changesSection,
            'paragraph1',
            'We may update this Privacy Policy from time to time to reflect service, legal, or operational changes. When updates are material, we will revise the "Last updated" date on this page.'
          )}
        </p>
      </section>

      <section id="contact">
        <h2>{pick(contactSection, 'title', '11. Contact')}</h2>
        <p>
          {pick(
            contactSection,
            'prefix',
            'For privacy questions or requests, email us at'
          )}{' '}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
